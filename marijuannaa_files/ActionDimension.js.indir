class avatar_view_CharacterStats extends openfl_display_Sprite {
	constructor() {
		openfl_events_EventDispatcher._hx_skip_constructor = true;
		super();
		openfl_events_EventDispatcher._hx_skip_constructor = false;
		this._hx_constructor();
	}
	_hx_constructor() {
		this.ownClothes = new haxe_ds_StringMap();
		this.ownMouth = 0;
		this.ownSkin = 0;
		this.ownHair = 0;
		this.ownEyes = 0;
		this.ownGender = "male";
		this.lastPotionSecond = -1;
		this.ownPotionExpiresAt = new haxe_ds_StringMap();
		this.ownPotionBonusPercents = new haxe_ds_StringMap();
		this.ownPopularity = 10;
		this.ownDexterity = 0;
		this.ownIntelligence = 0;
		this.ownToughness = 0;
		this.ownAgility = 0;
		this.ownXpForNextLevel = 8;
		this.ownXpIntoLevel = 0;
		this.ownLevel = 1;
		this.ownName = "";
		this.viewingOwnProfile = true;
		super._hx_constructor();
		this.panel = openfl_utils_Assets.getMovieClip("sportsbook_lobby:sportsbook_lobby_fla.char_menu_stats_279");
		this.panel.set_scaleX(1.2);
		this.panel.set_scaleY(1.2);
		this.characterName = this.textField("char_name");
		this.characterName.set_textColor(16777215);
		this.characterLevel = this.textField("char_level");
		this.characterExp = this.textField("char_experience");
		this.characterAgility = this.textField("char_agility");
		this.characterToughness = this.textField("char_toughness");
		this.characterIntelligence = this.textField("char_intelligence");
		this.characterDexterity = this.textField("char_dexterity");
		this.experienceBar = this.panel.getChildByName("char_experience_bar");
		this.setText("text_title",core_i18n_I18n.t("stats.title"));
		this.setText("text_player",core_i18n_I18n.t("stats.player"));
		this.setText("text_level",core_i18n_I18n.t("stats.level"));
		this.setText("text_experience",core_i18n_I18n.t("stats.experience"));
		this.setText("text_statistics",core_i18n_I18n.t("stats.statistics"));
		this.setText("text_agility",core_i18n_I18n.t("stat.agility"));
		this.setText("text_toughness",core_i18n_I18n.t("stat.toughness"));
		this.setText("text_intelligence",core_i18n_I18n.t("stat.intelligence"));
		this.setText("text_dexterity",core_i18n_I18n.t("stat.dexterity"));
		this.setText("text_popularity",core_i18n_I18n.t("stats.popularity"));
		this.popularityBar = this.panel.getChildByName("char_popularity_bar");
		this.experienceFill = this.createBarFill(this.experienceBar,false);
		this.popularityFill = this.createBarFill(this.popularityBar,true);
		this.raiseBarFill(this.experienceFill,this.characterExp);
		this.raiseBarFill(this.popularityFill);
		this.renderPopularity(this.ownPopularity);
		let popularityButton = this.panel.getChildByName("popularity_increase_button");
		if(popularityButton != null) {
			popularityButton.set_buttonMode(true);
			popularityButton.mouseEnabled = true;
			popularityButton.mouseChildren = false;
			popularityButton.addEventListener("mouseDown",function(event) {
				Action.instance.ui.blockedClick = true;
				if(Action.instance.ui.invitationLinkPopup != null) {
					Action.instance.ui.invitationLinkPopup.open();
				}
			});
		}
		let notification = this.panel.getChildByName("mini_instruction_notification");
		if(notification != null) {
			notification.set_visible(false);
		}
		let swfBounds = this.panel.getBounds(this.panel);
		this.panelLayoutBounds = new openfl_geom_Rectangle(swfBounds.x,swfBounds.y,swfBounds.width,swfBounds.height);
		this.createPortrait();
		this.addChild(this.panel);
		avatar_view_WindowDrag.attachSwf(this.panel);
		let closeButton = this.panel.getChildByName("char_menu_stats_close_button");
		if(closeButton != null) {
			closeButton.addEventListener("mouseDown",$bind(this,this.close));
		}
		this.addInfoButton("stats_info_agility",core_i18n_I18n.t("stats.info_agility"));
		this.addInfoButton("stats_info_toughness",core_i18n_I18n.t("stats.info_toughness"));
		this.addInfoButton("stats_info_intelligence",core_i18n_I18n.t("stats.info_intelligence"));
		this.addInfoButton("stats_info_dexterity",core_i18n_I18n.t("stats.info_dexterity"));
		avatar_view_WindowHelp.bind(this.panel,"stats");
		this.panel.addEventListener("mouseDown",function(event) {
			Action.instance.ui.blockedClick = true;
		});
		this.ownClothes.h["topwear"] = -1;
		this.ownClothes.h["lowerwear"] = -1;
		this.ownClothes.h["footwear"] = -1;
		this.ownClothes.h["handwear"] = -1;
		this.ownClothes.h["facewear"] = -1;
		this.ownClothes.h["hatwear"] = -1;
		this.renderOwnProfile();
		this.set_visible(false);
		this.layout();
		this.addEventListener("enterFrame",$bind(this,this.updatePotionEffectsTimer));
		if(openfl_Lib.get_current().stage != null) {
			openfl_Lib.get_current().stage.addEventListener("resize",$bind(this,this.layout));
		}
	}
	openOwn(name) {
		this.viewingOwnProfile = true;
		if(name != null && name.length > 0) {
			this.ownName = name;
		}
		this.show();
		this.renderOwnProfile();
	}
	openPlayer(player) {
		if(player == null) {
			return;
		}
		this.viewingOwnProfile = false;
		this.show();
		this.renderProfile(player.name,avatar_view_CharacterStats.safeInt(player.level,1),avatar_view_CharacterStats.safeInt(player.xpIntoLevel,0),avatar_view_CharacterStats.safeInt(player.xpForNextLevel,8),avatar_view_CharacterStats.safeInt(player.agility,0),avatar_view_CharacterStats.safeInt(player.toughness,0),avatar_view_CharacterStats.safeInt(player.intelligence,0),avatar_view_CharacterStats.safeInt(player.dexterity,0),avatar_view_CharacterStats.safeInt(player.popularity,10));
		this.applyPlayerAppearance(player);
	}
	setCharacterName(name) {
		if(name == null) {
			return;
		}
		this.ownName = name;
		if(this.viewingOwnProfile) {
			this.characterName.set_text(name);
		}
	}
	updateProgress(level,xpIntoLevel,xpForNextLevel) {
		this.ownLevel = level;
		this.ownXpIntoLevel = xpIntoLevel;
		this.ownXpForNextLevel = xpForNextLevel;
		if(this.viewingOwnProfile) {
			this.renderProgress(level,xpIntoLevel,xpForNextLevel);
		}
	}
	updateStats(agility,toughness,intelligence,dexterity) {
		this.ownAgility = agility;
		this.ownToughness = toughness;
		this.ownIntelligence = intelligence;
		this.ownDexterity = dexterity;
		if(this.viewingOwnProfile) {
			this.renderStats(agility,toughness,intelligence,dexterity);
		}
