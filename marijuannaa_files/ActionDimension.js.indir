			} else if(categoryName.indexOf("wear") > -1) {
				mainCategory = 1;
			} else if(categoryName.indexOf("modkit") > -1 || categoryName.indexOf("weapon") > -1 || categoryName.indexOf("armor") > -1) {
				mainCategory = 2;
			} else if(categoryName.indexOf("suite") > -1) {
				mainCategory = 3;
				if(item.is_equipped == true) {
