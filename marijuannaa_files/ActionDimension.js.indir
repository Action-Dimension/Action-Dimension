		let body = JSON.stringify({ name : name, skin : skin, hair : hair, mouth : mouth, eyes : eyes, gender : gender, token : userData.token});
		this.httpRequest("POST","" + Action.instance.serverModel.host + "/users/create_character",body,function(err,response) {
