				key = "skills.error_invalid";
				break;
			case 3:
				key = "skills.error_previous";
				break;
			case 4:
				key = "skills.error_no_points";
				break;
			default:
				key = "skills.error_failed";
			}
			Action.instance.ui.popupMessage.showMessage(core_i18n_I18n.t(key,{ count : this.unlockFrequency}));
		}
		this.render();
	}
	render() {
