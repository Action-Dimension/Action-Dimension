		if(this.playerConnectionState != null) {
			if(this.isActiveJetpack) {
				this.jetpackFlameSprite.set_visible(true);
				if(this.jetpackFlameSprite.get_currentFrame() == 0) {
					this.jetpackFlameSprite.set_currentFrame(1);
				} else if(this.jetpackFlameSprite.get_currentFrame() == 1) {
					this.jetpackFlameSprite.set_currentFrame(0);
