class avatar_view_PetShop extends openfl_display_Sprite {
	constructor() {
		openfl_events_EventDispatcher._hx_skip_constructor = true;
		super();
		openfl_events_EventDispatcher._hx_skip_constructor = false;
		this._hx_constructor();
	}
	_hx_constructor() {
		this.currentPage = 0;
		super._hx_constructor();
		let panel = openfl_utils_Assets.getMovieClip("sportsbook_lobby:sportsbook_lobby_fla.char_menu_pet_shop_358");
		panel.set_x(openfl_Lib.get_current().stage.stageWidth / 2 - 343.8 + 460);
		panel.set_y(openfl_Lib.get_current().stage.stageHeight / 2 - 244.799999999999983 + 240);
		panel.set_scaleX(1.2);
		panel.set_scaleY(1.2);
		this.cashText = panel.getChildByName("cash");
		this.premiumCashText = panel.getChildByName("premium_cash");
		this.cashText.set_text(core_i18n_I18n.t("currency.cash",{ amount : 1000}));
		let fh = this.premiumCashText;
		fh.set_x(fh.get_x() + 70);
		let fh1 = this.cashText;
		fh1.set_x(fh1.get_x() + 65);
		this.premiumCashText.set_text(core_i18n_I18n.t("currency.crystal",{ amount : 1000}));
		let title = panel.getChildByName("text_title");
		if(title != null) {
			title.set_text(core_i18n_I18n.t("pet.shop_title"));
		}
		panel.getChildByName("are_you_sure").set_visible(false);
		this.items = [];
		let _gthis = this;
		let item = panel.getChildByName("pet_shop_item" + 0);
		this.items.push(item);
		let textBuy = item.getChildByName("text_buy");
		textBuy.set_text(core_i18n_I18n.t("pet.buy"));
		textBuy.mouseEnabled = false;
		let slot = 0;
		item.getChildByName("buy_pet").addEventListener("mouseDown",function(e) {
			_gthis.buyPet(slot);
		});
		let item1 = panel.getChildByName("pet_shop_item" + 1);
		this.items.push(item1);
		let textBuy1 = item1.getChildByName("text_buy");
		textBuy1.set_text(core_i18n_I18n.t("pet.buy"));
		textBuy1.mouseEnabled = false;
		let slot1 = 1;
		item1.getChildByName("buy_pet").addEventListener("mouseDown",function(e) {
			_gthis.buyPet(slot1);
		});
		let item2 = panel.getChildByName("pet_shop_item" + 2);
		this.items.push(item2);
		let textBuy2 = item2.getChildByName("text_buy");
		textBuy2.set_text(core_i18n_I18n.t("pet.buy"));
		textBuy2.mouseEnabled = false;
		let slot2 = 2;
		item2.getChildByName("buy_pet").addEventListener("mouseDown",function(e) {
			_gthis.buyPet(slot2);
		});
		this.pageText = panel.getChildByName("pet_shop_page_text");
		this.prevPage = panel.getChildByName("pet_shop_page_prev");
		this.nextPage = panel.getChildByName("pet_shop_page_next");
		this.prevPage.addEventListener("mouseDown",function(e) {
			_gthis.changePage(-1);
		});
		this.nextPage.addEventListener("mouseDown",function(e) {
			_gthis.changePage(1);
		});
		panel.getChildByName("char_menu_pet_shop_close_button").addEventListener("mouseDown",function(e) {
			_gthis.set_visible(false);
		});
		panel.addEventListener("mouseDown",function(e) {
			Action.instance.ui.blockedClick = true;
		});
		this.addChild(panel);
		avatar_view_WindowDrag.attachSwf(panel);
		this.renderPage();
		this.set_visible(false);
	}
	shopEntries() {
		let result = [];
		let _g = 0;
		let _g1 = avatar_model_PetCatalog.SHOP_PETS;
		while(_g < _g1.length) {
			let pet = _g1[_g];
			++_g;
			let pet1 = pet.id;
			let tmp = avatar_model_PetCatalog.localizedName(pet);
			let petId = pet.id;
			result.push({ id : pet1, name : tmp, price : pet.price, priceType : petId == 15 || petId == 19 ? 2 : 1, thumb : pet.id});
		}
		return result;
	}
	totalPages() {
		return Math.ceil(this.shopEntries().length / 3) | 0;
	}
	changePage(delta) {
		let page = this.currentPage + delta;
		if(page < 0 || page >= this.totalPages()) {
			return;
		}
		this.currentPage = page;
		this.renderPage();
	}
	renderPage() {
		let entries = this.shopEntries();
		let _g = 0;
		while(_g < 3) {
			let slot = _g++;
			let item = this.items[slot];
			let index = this.currentPage * 3 + slot;
			let entry = index < entries.length ? entries[index] : null;
			item.set_visible(entry != null);
			if(entry == null) {
				continue;
			}
			item.getChildByName("pet_thumb").gotoAndStop(entry.thumb);
			item.getChildByName("pet_kind_name").set_text(entry.name);
			item.getChildByName("pet_price_text").set_text(Std.string(entry.price) + (entry.priceType == 2 ? " Crystal" : " Cash"));
		}
		this.pageText.set_text(this.currentPage + 1 + "/" + this.totalPages());
		this.prevPage.set_visible(this.currentPage > 0);
		this.nextPage.set_visible(this.currentPage < this.totalPages() - 1);
	}
	buyPet(slot) {
		let index = this.currentPage * 3 + slot;
		let entries = this.shopEntries();
		if(index < 0 || index >= entries.length) {
			return;
		}
		Action.instance.npcModel.buyPet(entries[index].id);
		this.set_visible(false);
	}
	open() {
		this.currentPage = 0;
		this.renderPage();
		this.set_visible(true);
	}
}
