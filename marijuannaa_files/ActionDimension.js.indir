	run_client_predicted_grenade_visuals(charge,muzzleX,muzzleY) {
		if(charge < 1) {
			return 0;
		}
		if(charge > 30) {
			charge = 30;
		}
		let weapon = this._paintball.loadoutModel._get_weapon_array(this._paintball.loadoutModel._paintball.state.weapon3arrayid);
		if(weapon == null || weapon.length < 16) {
			return 0;
		}
		let myPlayer = this._paintball.playerModel.getPlayer(this._paintball.state.playerId);
		if(myPlayer == null) {
			return 0;
		}
		let commandSequence = this.next_client_fire_sequence();
		let elevation = myPlayer.crouch == 0 ? this.projectile_fire_elevation_normal : this.projectile_fire_elevation_crouch;
		let speed = ((weapon[9] + (Math.random() * 2 | 0)) / 30 * charge | 0) + 2;
		let spawnX = muzzleX;
		let spawnY = muzzleY - elevation;
		let bodyClip = this._paintball.playerModel.player(this._paintball.state.playerId);
		if(bodyClip != null && this.muzzle_blocked_by_wall(bodyClip.get_x(),bodyClip.get_y(),muzzleX,spawnY,elevation)) {
			spawnX = bodyClip.get_x();
			spawnY = bodyClip.get_y();
		}
		this.create_particle(spawnX,spawnY,elevation,speed,weapon[13],this._paintball.playerModel.my_target_angle,weapon[7] | 0,this._paintball.state.timeMs,this._paintball.state.playerId,Math.random() * weapon[12] | 0,weapon[1] | 0,weapon[11] | 0,weapon[14],weapon[15] | 0,weapon[17],0,-1,true,(commandSequence & 8388607) << 8 | 0,true);
		myPlayer.weapon_visual_kind = weapon[7] | 0;
		myPlayer.weapon_visual_until = this._paintball.frameModel.sim_time + 300;
		this._paintball.playerModel.animate_weapon(this._paintball.state.playerId);
		return commandSequence;
	}
	my_create_particle_listener() {
		this.run_client_predicted_fire_visuals();
		this._paintball.inputModel.fire_latched = false;
		this.update_ammo_clip_bars();
	}
	update_ammo_clip_bars() {
