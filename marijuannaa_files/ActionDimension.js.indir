	}
	updateBottom() {
		let text = "";
		let linesLeft = Math.round(this._traceField.get_height() / this.get_style().traceFontSize);
		let maxchars = Math.round(this._traceField.get_width() * 5 / this.get_style().traceFontSize);
		let line = this.console.get_logs().last;
		let showch = this._viewingChannels.length != 1;
		while(line != null) {
			if(this.lineShouldShow(line)) {
				let numlines = Math.ceil(line.text.length / maxchars);
				if(line.html || linesLeft >= numlines) {
					text = this.makeLine(line,showch) + text;
				} else {
					line = line.clone();
					line.text = line.text.substring(Math.max(0,line.text.length - maxchars * linesLeft) | 0);
					text = this.makeLine(line,showch) + text;
					break;
				}
				linesLeft -= numlines;
				if(linesLeft <= 0) {
					break;
				}
			}
			line = line.prev;
		}
		this._lockScrollUpdate = true;
		this._traceField.set_htmlText("<logs>" + text + "</logs>");
		this._traceField.set_scrollV(this._traceField.get_maxScrollV());
		this._lockScrollUpdate = false;
		this.updateScroller();
