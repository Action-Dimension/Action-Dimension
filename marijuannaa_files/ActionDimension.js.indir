			this.winnerEarnedField.set_text(core_i18n_I18n.t("tennis.earned"));
			this.winnerCashField.set_text(this.model.winnerRewardCash >= 0 ? this.model.winnerRewardCash + " Cash!" : core_i18n_I18n.t("tennis.reward_calculating"));
			this.winnerXpField.set_text(this.model.winnerRewardXp >= 0 ? core_i18n_I18n.t("tennis.experience",{ count : this.model.winnerRewardXp}) : "");
