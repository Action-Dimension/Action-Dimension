		}
		this.panel.set_x((openfl_Lib.get_current().stage.stageWidth - this.layoutBounds.width * this.panel.get_scaleX()) / 2 - this.layoutBounds.x * this.panel.get_scaleX());
		this.panel.set_y((openfl_Lib.get_current().stage.stageHeight - this.layoutBounds.height * this.panel.get_scaleY()) / 2 - this.layoutBounds.y * this.panel.get_scaleY());
	}
	static setText(parent,name,value) {
		let field = parent.getChildByName(name);
		if(field == null) {
			return;
		}
		field.set_text(value);
		field.mouseEnabled = false;
	}
