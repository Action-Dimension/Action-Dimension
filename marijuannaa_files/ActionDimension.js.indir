		let stage = openfl_Lib.get_current().stage;
		Action.instance.scene.camera.lookAt(this.cameraTargetX,this.cameraTargetY);
		Action.instance.scene.refreshSuiteEditorPointer(stage.get_mouseX(),stage.get_mouseY());
		if(this.inventoryDragObject != null) {
			this.updateInventoryDrag(stage.get_mouseX(),stage.get_mouseY());
