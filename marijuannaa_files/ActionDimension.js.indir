				let c6 = new haxe_ui_containers_HBox();
				c6.set_height(22.);
				c6.set_percentWidth(100.);
				c6.set_styleString("padding: 0; vertical-spacing: 0; horizontal-spacing: 8px;");
				let c7 = new haxe_ui_components_Label();
