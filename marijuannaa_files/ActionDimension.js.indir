			}
			let advance = speed * step;
			this.progress += advance < gap ? advance : gap;
			let degrees = this.progress * 360;
			if(Math.abs(degrees - this.drawnDeg) >= 0.5 || this.progress >= 1) {
				this.drawDial(degrees);
			}
