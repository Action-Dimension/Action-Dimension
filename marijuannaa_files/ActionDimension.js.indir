	get_local_muzzle_position() {
		let myClip = this._paintball.playerModel.player(this._paintball.state.playerId);
		let playerIndex = this._paintball.playerModel.player_array_map[this._paintball.state.playerId];
		if(this.last_valid_muzzle_player_id != this._paintball.state.playerId) {
			this.local_muzzle_by_pose.h = Object.create(null);
			this.last_valid_muzzle_player_id = this._paintball.state.playerId;
		}
		let playerX = 0;
		let playerY = 0;
		if(myClip != null) {
			playerX = myClip.get_x();
			playerY = myClip.get_y();
		} else if(playerIndex >= 0 && playerIndex < this._paintball.playerModel.player_array.length) {
			playerX = this._paintball.playerModel.player_array[playerIndex].get_x();
			playerY = this._paintball.playerModel.player_array[playerIndex].get_y();
		}
		if(myClip != null && myClip.char_loaded) {
			let parts = this.get_player_weapon_parts(this._paintball.state.playerId);
			let poseKey = parts != null ? Std.string(parts.animName) + ":" + Std.string(parts.weaponFrame) : null;
			if(parts != null && parts.indicator != null) {
				let indicator = parts.indicator;
				let muzzle = this.muzzle_from_holder(parts.holder,indicator.get_x(),indicator.get_y());
				let muzzleDx = muzzle.x - playerX;
				let muzzleDy = muzzle.y - playerY;
				let tmp;
				let f = muzzle.x;
				if(!isNaN(f)) {
					let f = muzzle.y;
					tmp = !isNaN(f);
				} else {
					tmp = false;
				}
				if(tmp && muzzleDx * muzzleDx + muzzleDy * muzzleDy <= 147456.) {
					let poseMuzzle = this.local_muzzle_by_pose.h[poseKey];
					if(poseMuzzle == null) {
						poseMuzzle = new openfl_geom_Point(indicator.get_x(),indicator.get_y());
						this.local_muzzle_by_pose.h[poseKey] = poseMuzzle;
					} else {
						poseMuzzle.setTo(indicator.get_x(),indicator.get_y());
					}
					return muzzle;
				}
			}
			let cachedPoseMuzzle = poseKey != null ? this.local_muzzle_by_pose.h[poseKey] : null;
			if(parts != null && cachedPoseMuzzle != null) {
				let holderMuzzle = this.muzzle_from_holder(parts.holder,cachedPoseMuzzle.x,cachedPoseMuzzle.y);
				let holderDx = holderMuzzle.x - playerX;
				let holderDy = holderMuzzle.y - playerY;
				if(holderDx * holderDx + holderDy * holderDy <= 147456.) {
					return holderMuzzle;
				}
			}
		}
		return null;
	}
	refresh_local_muzzle_cache() {
