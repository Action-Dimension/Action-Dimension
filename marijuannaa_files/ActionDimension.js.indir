				this.setText(row,"annDate",this.formatDate(item.announcement.sentAt));
				this.setText(row,"annText",this.preview(item.announcement.text));
				let marker = row.findComponent("annUnread",haxe_ui_containers_Box);
				if(marker != null) {
					marker.set_hidden(seenAnnouncements >= this.freshAnnouncements);
