	showObjectEditors(value) {
		if(Action.instance == null || Action.instance.scene == null) {
			return;
		}
		let _g = 0;
		let _g1 = Action.instance.scene.mapObjects;
		while(_g < _g1.length) {
			let candidate = _g1[_g];
			++_g;
			if(!((candidate) instanceof avatar_view_scene_MapObjectSprite)) {
				continue;
			}
			let object = candidate;
			if(this.isSuiteObject(object)) {
				object.setEditorVisible(value);
			} else {
				object.set_alpha(value ? 0.5 : 1);
			}
		}
	}
	suiteMapData() {
		let data = [];
		let _g = 0;
		let _g1 = Action.instance.scene.mapObjects;
		while(_g < _g1.length) {
			let candidate = _g1[_g];
			++_g;
			if(!((candidate) instanceof avatar_view_scene_MapObjectSprite)) {
				continue;
			}
			let object = candidate;
			object.savePosition();
			let entry = { name : object.Objname, x : object.get_x(), y : object.get_y()};
			if(!object.get_isSuiteItem()) {
				entry.frame = object.frame;
			}
			if(object.tintIndex >= 0) {
				entry.tint = object.tintIndex;
			}
			if(object.rotationQuarter != 0) {
				entry.rotation = object.rotationQuarter;
			}
			if(object.stackOffset < 0) {
				entry.stack = object.stackOffset;
			}
			entry.mountType = object.mountType;
			data.push(entry);
		}
		return data;
	}
	saveCurrentLayout() {
		if(!this.editAllowed || Action.instance == null || Action.instance.scene == null) {
			return;
		}
		let playerModel = Action.instance.playerModel;
		if(playerModel != null) {
			playerModel.saveSuite(this.suiteMapData(),true);
		}
	}
	openFurnitureShop() {
		if(!this.editAllowed || Action.instance == null || Action.instance.ui == null) {
