			label.set_height(18);
			label.set_defaultTextFormat(avatar_view_kit_Skin.body(11,16578264,true));
			label.set_text(core_i18n_I18n.t("replay.copied"));
			this.copiedChip.addChild(label);
		}
		this.copiedChip.set_x(10);
		this.copiedChip.set_y(this.rowHolder.get_y() + row.get_y() + 15.);
		this.panel.content.addChild(this.copiedChip);
		if(this.copiedTimer != null) {
			this.copiedTimer.stop();
		}
		this.copiedTimer = haxe_Timer.delay($bind(this,this.hideCopied),1400);
	}
	hideCopied() {
		if(this.copiedTimer != null) {
			this.copiedTimer.stop();
			this.copiedTimer = null;
		}
		if(this.copiedChip != null && this.copiedChip.parent != null) {
			this.copiedChip.parent.removeChild(this.copiedChip);
		}
	}
	showError(message) {
		this.status.set_text(message);
	}
	metaLine(summary) {
		let parts = [];
		if(this.game == "paintball") {
			let mode = avatar_view_RoomBrowser.paintballModeLabel(summary.gameType);
			if(mode != "") {
				parts.push(mode);
			}
			parts.push(core_i18n_I18n.t("room_browser.map_number",{ number : summary.mapId}));
		} else {
			parts.push(core_i18n_I18n.t("tennis_lobby.court_number",{ number : summary.mapId}));
		}
		if(summary.playerLimit > 0) {
			parts.push(core_i18n_I18n.t("room_browser.capacity",{ count : summary.playerLimit}));
		}
		if(summary.scoreTeam1 > 0 || summary.scoreTeam2 > 0) {
			parts.push(core_i18n_I18n.t("replay.score",{ team1 : summary.scoreTeam1, team2 : summary.scoreTeam2}));
		}
		return parts.join("  •  ");
	}
	static playerLine(summary) {
		if(summary.players == null || summary.players.length == 0) {
			return "-";
		}
		let parts = [];
		let shown = summary.players.length < 3 ? summary.players.length : 3;
		let _g = 0;
		let _g1 = shown;
		while(_g < _g1) {
			let player = summary.players[_g++];
			parts.push(player.name + " (" + player.kills + "/" + player.deaths + ")");
		}
		if(summary.players.length > shown) {
			parts.push("+" + (summary.players.length - shown));
		}
		return parts.join(", ");
	}
	static lootLine(summary) {
		if(summary.loot == null || summary.loot.length == 0) {
			return "";
		}
		let parts = [];
		let shown = summary.loot.length < 2 ? summary.loot.length : 2;
		let _g = 0;
		let _g1 = shown;
		while(_g < _g1) {
			let entry = summary.loot[_g++];
			parts.push(entry.name + ": " + entry.itemName);
		}
		if(summary.loot.length > shown) {
			parts.push("+" + (summary.loot.length - shown));
		}
		return "  •  " + core_i18n_I18n.t("replay.loot") + " " + parts.join(", ");
	}
	static shortDate(iso) {
		if(iso == null || iso.length < 16) {
			if(iso == null) {
				return "";
			} else {
				return iso;
			}
		}
		return HxOverrides.substr(iso,8,2) + "." + HxOverrides.substr(iso,5,2) + " " + HxOverrides.substr(iso,11,5);
	}
	static duration(ms) {
		let totalSeconds = ms / 1000 | 0;
		let seconds = totalSeconds % 60;
		return (totalSeconds / 60 | 0) + ":" + (seconds < 10 ? "0" : "") + seconds;
	}
}
