	muzzle_from_holder(holder,localX,localY) {
		let matrix = atlas_AtlasHitTest.worldChain(holder,this._paintball.tileWorld.content);
		return new openfl_geom_Point(matrix.a * localX + matrix.c * localY + matrix.tx,matrix.b * localX + matrix.d * localY + matrix.ty);
	}
	get_player_muzzle_position(playerId) {
		let playerClip = this._paintball.playerModel.player(playerId);
		let parts = this.get_player_weapon_parts(playerId);
		if(playerClip == null || parts == null || parts.indicator == null) {
			return null;
		}
		let indicator = parts.indicator;
		let muzzle = this.muzzle_from_holder(parts.holder,indicator.get_x(),indicator.get_y());
		let dx = muzzle.x - playerClip.get_x();
		let dy = muzzle.y - playerClip.get_y();
		let tmp;
		let f = muzzle.x;
		if(!isNaN(f)) {
			let f = muzzle.y;
			tmp = isNaN(f);
		} else {
			tmp = true;
		}
		if(tmp || dx * dx + dy * dy > 147456.) {
			return null;
		}
		return muzzle;
