			Action.instance.npcModel.buyMarketListing(_gthis.itemData.listing_id);
			Action.instance.ui.transferLoader.set_visible(true);
			_gthis.close();
		});
		this.buttons.h["item_detail_button_buy"].addEventListener("click",function(e) {
			_gthis.close();
			if(_gthis.itemPriceType == 1 && Action.instance.ui.characterSmallStats.cashValue < _gthis.itemPriceValue) {
				Action.instance.ui.popupMessage.showMessage(core_i18n_I18n.t("currency.cash_insufficient"));
				return;
			}
			if(_gthis.itemPriceType == 2 && Action.instance.ui.characterSmallStats.premiumCashValue < _gthis.itemPriceValue) {
				Action.instance.ui.popupMessage.showMessage(core_i18n_I18n.t("currency.cash_insufficient"));
				return;
			}
			Action.instance.npcModel.buyItem(_gthis.itemID);
			Action.instance.ui.transferLoader.set_visible(true);
		});
		this.buttons.h["item_detail_button_sell"].addEventListener("click",function(e) {
			if(_gthis.itemPrivateID == null) {
				return;
			}
			_gthis.close();
			Action.instance.npcModel.sellItem(_gthis.itemPrivateID);
			Action.instance.ui.transferLoader.set_visible(true);
		});
		this.buttons.h["item_detail_button_equip"].addEventListener("click",function(e) {
			Action.instance.ui.inventoryWindow.character.changeClothes(_gthis.equipItemCategory,_gthis.equipItemFrame);
			Action.instance.scene.myPlayerSprite.changeClothes(_gthis.equipItemCategory,_gthis.equipItemFrame);
			Action.instance.ui.characterSmallStats.miniChar.changeClothes(_gthis.equipItemCategory,_gthis.equipItemFrame);
			if(Action.instance.ui.inventoryWindow.equipItems.h[_gthis.equipItemCategory].itemData != null) {
				let equippedItemId = Action.instance.ui.inventoryWindow.equipItems.h[_gthis.equipItemCategory].itemData.id;
				HxOverrides.remove(Action.instance.ui.inventoryWindow.equipItemsID,equippedItemId);
				Action.instance.ui.inventoryItemsData.h[equippedItemId].is_equipped = false;
				Action.instance.ui.inventoryWindow.equipItems.h[_gthis.equipItemCategory].itemData = null;
			}
			Action.instance.ui.inventoryItemsData.h[_gthis.itemPrivateID].is_equipped = true;
			Action.instance.ui.inventoryWindow.equipItemsID.push(_gthis.itemPrivateID);
			Action.instance.ui.inventoryWindow.equipItems.h[_gthis.equipItemCategory].setItem(_gthis.itemData,"equip_takeoff",true);
