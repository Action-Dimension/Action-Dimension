	addMenuHoverEffect(button) {
		if(button == null) {
			return;
		}
		let normalFilters = button.get_filters() == null ? [] : button.get_filters().slice();
		let hoverFilters = normalFilters.slice();
		hoverFilters.push(new openfl_filters_ColorMatrixFilter([1.15,0,0,0,22,0,1.15,0,0,22,0,0,1.15,0,22,0,0,0,1,0]));
		button.addEventListener("rollOver",function(_) {
			button.set_filters(hoverFilters);
		});
		button.addEventListener("rollOut",function(_) {
			button.set_filters(normalFilters);
		});
	}
	openChatBar() {
		this.chatBar.gotoAndStop(4);
		this.chatBar.getChildAt(0).set_x(-25);
		openfl_Lib.get_current().stage.set_focus(this.chatInput);
	}
	isChatFocused() {
		let stage = openfl_Lib.get_current().stage;
		if(stage != null) {
			return stage.get_focus() == this.chatInput;
		} else {
			return false;
		}
	}
	closeChatBar() {
		let stage = openfl_Lib.get_current().stage;
		if(stage.get_focus() == this.chatInput) {
			stage.set_focus(null);
		}
		this.chatBar.gotoAndStop(1);
	}
	updateBuddyNotification() {
		if(this.pendingFriendCount > 0 && this.notificationMenuOpen != this.isMenuOpen()) {
			this.refreshBuddyNotification();
		}
	}
	setPendingFriendCount(count) {
		this.pendingFriendCount = Math.max(0,count) | 0;
		if(this.pendingFriendCount == 0) {
			avatar_view_TopMenuBar.notificationDismissedForSession = false;
		}
		this.refreshBuddyNotification();
	}
	notifyFriendRequest() {
		avatar_view_TopMenuBar.notificationDismissedForSession = false;
		this.setPendingFriendCount(Math.max(1,this.pendingFriendCount) | 0);
	}
	refreshBuddyNotification() {
		this.notificationMenuOpen = this.isMenuOpen();
		this.buddyListNotification.gotoAndStop(this.notificationMenuOpen ? 2 : 1);
		if(this.notificationMenuOpen && this.buddyListOpenBtn != null) {
			let targetBounds = this.buddyListOpenBtn.getBounds(this);
			let notificationBounds = this.buddyListNotification.getBounds(this.buddyListNotification);
			this.buddyListNotification.set_y(Math.round(targetBounds.y + targetBounds.height / 2 - (notificationBounds.y + notificationBounds.height / 2) * this.buddyListNotification.get_scaleY() + 23.0));
		} else {
			this.buddyListNotification.set_y(110);
		}
		let text = this.buddyListNotification.getChildByName("text_buddyrequest");
		if(text != null) {
			text.set_text(core_i18n_I18n.t("menu.friend_request"));
			text.mouseEnabled = false;
		}
		let close = this.buddyListNotification.getChildByName("buddy_notification_close_button");
		if(close != null) {
			close.set_visible(true);
		}
		this.buddyListNotification.set_visible(this.pendingFriendCount > 0 && !avatar_view_TopMenuBar.notificationDismissedForSession);
	}
	isMenuOpen() {
		if(this.menu != null) {
			return this.menu.get_visible();
		} else {
			return false;
		}
	}
	static beginGameSession() {
		avatar_view_TopMenuBar.notificationDismissedForSession = false;
	}
}
