	stop() {
		if(this._group != null) {
			this.console.get_graphing().remove(this._group.name);
		}
	}
	get_group() {
		return this._group;
	}
	reset() {
		this._infoMap.h = Object.create(null);
		this.graph.get_graphics().clear();
		if(!this._group.fixed) {
			this._group.low = NaN;
			this._group.hi = NaN;
		}
	}
	set_width(value) {
