		let name = mapObject.Objname;
		let rotation = Std.parseInt(name.charAt(name.length - 1));
		if(rotation == null || rotation < 1 || rotation > 4) {
			return mapObject;
		}
		rotation = (rotation - 1 + delta + 4) % 4 + 1;
		let index = Action.instance.scene.mapObjects.indexOf(mapObject);
		let replacement = Action.instance.scene.createMapObject(HxOverrides.substr(name,0,name.length - 1) + rotation,mapObject.get_x(),mapObject.get_y(),mapObject.tintIndex);
		if(replacement == null) {
			return mapObject;
		}
		if(mapObject.stackOffset < 0) {
			replacement.setStackOffset(mapObject.stackOffset);
		}
		if(!Action.instance.scene.isSuiteObjectInsideMap(replacement)) {
			return mapObject;
		}
		replacement.setEditorVisible(this.editAllowed && this.get_visible() && this.panel != null && this.panel.get_visible());
		replacement.savePosition();
		mapObject.disposeEditor();
		Action.instance.scene.detachContent(mapObject);
		HxOverrides.remove(Action.instance.scene.mapObjects,mapObject);
		if(index < 0 || index > Action.instance.scene.mapObjects.length) {
			Action.instance.scene.mapObjects.push(replacement);
		} else {
			Action.instance.scene.mapObjects.splice(index,0,replacement);
