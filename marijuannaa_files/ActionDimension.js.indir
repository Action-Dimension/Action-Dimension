	setProgress(value) {
		let next = value < 0 ? 0 : value > 1 ? 1 : value;
		if(next > this.targetProgress) {
			this.targetProgress = next;
		}
	}
	isComplete() {
		if(this.completedAt >= 0) {
			return this.elapsed - this.completedAt >= 0.12;
		} else {
			return false;
