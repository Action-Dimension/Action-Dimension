	bindShell() {
		this.listView = this.view.findComponent("listView",haxe_ui_core_Component);
		this.createView = this.view.findComponent("createView",haxe_ui_core_Component);
		this.windowTitle = this.view.findComponent("windowTitle",haxe_ui_components_Label);
		this.headerNote = this.view.findComponent("headerNote",haxe_ui_components_Label);
		let closeButton = this.view.findComponent("closeButton",haxe_ui_components_Button);
		let _gthis = this;
		closeButton.set_onClick(function(_) {
			if(!_gthis.busy && _gthis.onClose != null) {
				_gthis.onClose();
			}
		});
		closeButton.addEventListener("mouseDown",function(event) {
			event.stopPropagation();
		});
		avatar_view_WindowDrag.pointerCursor(closeButton);
	}
	buildListView() {
		this.rowHost = this.view.findComponent("rowHost",haxe_ui_core_Component);
		this.rows.push(this.buildRow());
		this.rows.push(this.buildRow());
		this.rows.push(this.buildRow());
		this.rows.push(this.buildRow());
		this.rows.push(this.buildRow());
		this.emptyState = this.view.findComponent("emptyState",haxe_ui_core_Component);
		this.emptyTitle = this.view.findComponent("emptyTitle",haxe_ui_components_Label);
		this.emptyDetail = this.view.findComponent("emptyDetail",haxe_ui_components_Label);
