		let suiteEditor = Action.instance.ui != null ? Action.instance.ui.suiteEditorWindow : null;
		let editorCameraActive = Action.instance.ui != null && Action.instance.ui.adminEditorActive() || suiteEditor != null && (suiteEditor.editAllowed && suiteEditor.get_visible() && suiteEditor.panel != null && suiteEditor.panel.get_visible());
		let tutorialActive = Action.instance.ui != null && Action.instance.ui.interactiveHelp != null && Action.instance.ui.interactiveHelp.isActive();
		if(this.isMouseDown && !editorCameraActive && !tutorialActive) {
			if(this.myPlayerSprite != null && Action.instance.ui.blockedClick == false) {
				let getpos = this.camera.getWorldPosition(this.get_mouseX(),this.get_mouseY());
