		this.renderPaintballDetails(paintballConfig);
		if(buttonType == "buy_sell") {
			this.buttons.h["item_detail_button_sell"].set_visible(!buttonValue);
			this.buttons.h["item_detail_button_buy"].set_visible(buttonValue);
		} else if(buttonType == "equip_takeoff") {
			let atVendor = Action.instance.ui != null && Action.instance.ui.shopWindow != null && Action.instance.ui.shopWindow.get_visible();
			this.buttons.h["item_detail_button_sell"].set_visible(atVendor && this.itemSellValue > 0);
			if(!atVendor && category == 1) {
				let wearableButtonName = buttonValue ? "item_detail_button_takeoff" : "item_detail_button_equip";
				this.buttons.h[wearableButtonName].set_visible(true);
				if(isCrystalVoucher) {
					this.buttons.h["item_detail_button_use"].set_visible(true);
					this.layoutVoucherActions(this.buttons.h[wearableButtonName],false);
