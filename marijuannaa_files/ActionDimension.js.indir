		this._paintball.state.my_agility = effectiveStats.agility | 0;
		this._paintball.state.my_toughness = effectiveStats.toughness | 0;
		this._paintball.state.my_intelligence = effectiveStats.intelligence | 0;
		this._paintball.state.my_dexterity = effectiveStats.dexterity | 0;
		this._paintball.playerModel.update_my_stat_affected_variables(0,0,0,0);
		if(Action.instance.ui != null) {
			Action.instance.ui.progressionChanged(level,data.xp | 0,data.xpIntoLevel | 0,data.xpForNextLevel | 0);
			Action.instance.ui.statsChanged(data.agility | 0,data.toughness | 0,data.intelligence | 0,data.dexterity | 0);
			Action.instance.ui.cashChanged(data.cash | 0,data.premiumCash | 0);
		}
		data.xpReward = 0;
		data.cashReward = 0;
		data.premiumCashReward = 0;
		Action.instance.resolveLevelUp(data);
	}
