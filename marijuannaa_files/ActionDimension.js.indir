		this.exitBtn.addEventListener("mouseDown",function(e) {
			_gthis.menu.set_visible(false);
			$global.location.href = "/";
		});
		menuBtnHit.addEventListener("mouseDown",function(e) {
			_gthis.menu.set_visible(!_gthis.menu.get_visible());
			Action.instance.ui.blockedClick = true;
			_gthis.refreshBuddyNotification();
			if(Action.instance.ui.interactiveHelp != null) {
				Action.instance.ui.interactiveHelp.onMenuVisibilityChanged(_gthis.menu.get_visible());
