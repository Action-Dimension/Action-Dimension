			let selected_slot = this._paintball.state.selected_weapon;
			let _this = this._paintball.loadoutModel;
			let weapon_arrayid;
			switch(selected_slot) {
			case 1:
				weapon_arrayid = _this._paintball.state.weapon1arrayid;
				break;
			case 2:
				weapon_arrayid = _this._paintball.state.weapon2arrayid;
				break;
			case 3:
				weapon_arrayid = _this._paintball.state.weapon3arrayid;
				break;
			case 4:
				weapon_arrayid = _this.weapon4arrayid;
				break;
			default:
				weapon_arrayid = 0;
			}
			let wArr = this._paintball.loadoutModel._get_weapon_array(weapon_arrayid);
			if(wArr == null || wArr.length < 4) {
				return;
			}
			let ammo_bar = this._paintball.ammo_bar_holder.getChildByName("ammo_bar");
