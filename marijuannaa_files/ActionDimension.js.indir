			clickArea.addEventListener("mouseOut",function(_) {
				if(nameHolder != null) {
					nameHolder.set_visible(false);
				}
			});
		}
		let thumb = slot.getChildByName("thumb_type");
		if(thumb == null) {
			return;
		}
		let oldIcon = thumb.getChildByName("runtime_modkit_icon");
		if(oldIcon != null) {
			thumb.removeChild(oldIcon);
		}
		thumb.set_visible(modkit != null);
		if(modkit == null) {
			thumb.stop();
			return;
		}
		let frame = modkit.item_frame;
		if(frame < 1 || frame > thumb.get_totalFrames()) {
