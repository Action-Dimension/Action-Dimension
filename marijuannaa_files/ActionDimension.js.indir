		this.stage.addEventListener("mouseUp",$bind(this,this.onScrollBarUp),false,0,true);
	}
	onScrollBarFrame(e) {
		this._scrolldelay++;
		if(UInt.gt(this._scrolldelay,10)) {
			this._scrolldelay = 9;
			if(this._scrolldir < 0 && this._scroller.get_y() > this._scroll.get_mouseY() || this._scrolldir > 0 && this._scroller.get_y() + this._scroller.get_height() < this._scroll.get_mouseY()) {
				let fh = this._traceField;
				fh.set_scrollV(fh.get_scrollV() + this._scrolldir);
			}
		}
	}
	onScrollBarUp(e) {
