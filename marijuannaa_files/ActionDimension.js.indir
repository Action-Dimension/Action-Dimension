				return;
			}
			Action.instance.ui.inventoryItemDetails.open(_gthis.itemData,_gthis.imageData,_gthis.btnType,_gthis.btnValue);
		});
		this.item_container.addEventListener("mouseUp",function(e) {
			if(_gthis.btnType == "suite_item") {
				return;
			}
		});
		this.item_container.addEventListener("rollOver",function(e) {
			openfl_ui_Mouse.set_cursor("button");
			avatar_view_ItemTooltip.show(_gthis.item_container,_gthis.itemData);
		});
		this.item_container.addEventListener("rollOut",function(e) {
			openfl_ui_Mouse.set_cursor("auto");
			avatar_view_ItemTooltip.hideFor(_gthis.item_container);
		});
		this.item_container.addEventListener("removedFromStage",function(_) {
			avatar_view_ItemTooltip.hideFor(_gthis.item_container);
		});
	}
	clearItemImage(itemImage) {
		while(itemImage.get_numChildren() > 1) itemImage.removeChildAt(itemImage.get_numChildren() - 1);
	}
	opaqueBounds(asset,data,image) {
		let cached = avatar_view_InventoryItem.opaqueBoundsByAsset.h[asset];
		if(cached != null) {
			return cached;
		}
		let bounds = null;
		if(data != null) {
			bounds = data.getColorBoundsRect(-16777216,0,false);
			if(bounds != null && (bounds.width <= 0 || bounds.height <= 0)) {
				bounds = null;
			}
		}
		if(bounds == null) {
			bounds = new openfl_geom_Rectangle(0,0,image.get_width(),image.get_height());
		}
		avatar_view_InventoryItem.opaqueBoundsByAsset.h[asset] = bounds;
		return bounds;
	}
	setItem(inventoryItem,btnType,btnValue) {
		if(btnValue == null) {
			btnValue = false;
		}
		if(btnType == null) {
			btnType = "";
		}
		avatar_view_ItemTooltip.hideFor(this.item_container);
		this.btnType = btnType;
		this.btnValue = btnValue;
		this.itemData = inventoryItem;
		this.equip.gotoAndStop(1);
		if(btnType == "equip_takeoff") {
			this.equipped = btnValue;
		}
		if(btnType == "buy_sell" || btnType == "market_buy" || btnType == "market_own") {
			this.item_container.getChildByName("price_type_icon").gotoAndStop(inventoryItem.price_type);
			this.item_container.getChildByName("value").set_text(inventoryItem.price == null ? "null" : "" + inventoryItem.price);
		}
		if(btnType == "equip_takeoff" && btnValue == true || this.equipped == true) {
			this.equip.gotoAndStop(2);
		}
		this.itemCategory = inventoryItem.item_category;
		this.itemFrame = inventoryItem.item_frame;
		let itemImage = this.item_container.getChildByName("equipped");
		this.clearItemImage(itemImage);
		let category = inventoryItem.item_category == null ? "null" : "" + inventoryItem.item_category;
		let assetPath = "assets/images/items/item_" + (inventoryItem.image_item_id != null ? inventoryItem.image_item_id : inventoryItem.item_id) + ".png";
		let _gthis = this;
		openfl_utils_Assets.loadBitmapData(assetPath).onComplete(function(_) {
			let imageData = openfl_utils_Assets.getBitmapData(assetPath);
			let image = new openfl_display_Bitmap(imageData);
			image.smoothing = true;
			_gthis.imageData = imageData;
			_gthis.clearItemImage(itemImage);
			let content = _gthis.opaqueBounds(assetPath,imageData,image);
			let slotHeight = itemImage.get_height() > 95 ? 95 : itemImage.get_height();
			let imageScale = content.width > 64 ? 64 / content.width : 1.0;
			image.set_scaleX(imageScale);
			image.set_scaleY(imageScale);
			image.set_x(itemImage.get_width() / 2 - 35 - (content.x + content.width / 2) * imageScale);
			if(category == "armor") {
				image.set_y(slotHeight / 2 - 46 + image.get_height() / 2 - (content.y + content.height) * imageScale);
			} else {
				image.set_y(slotHeight / 2 - 46 - (content.y + content.height / 2) * imageScale);
			}
			itemImage.addChild(image);
		});
		let itemName = this.item_container.getChildByName("item_name_holder").getChildByName("item_name");
		itemName.set_text(core_i18n_I18n.itemName(inventoryItem));
		itemName.set_selectable(false);
	}
}
