					currentPlayer.animate = p_id != this._paintball.state.playerId && pState.server_moving ? 3 : 1;
				}
				if(pl_tmid == 1) {
					this.team_1_array.push(currentPlayer);
				} else if(pl_tmid == 2) {
					this.team_2_array.push(currentPlayer);
				}
				let pl_target_x = pState.target_x;
				let pl_target_y = pState.target_y;
				let pl_teleport = pState.teleport;
				if(currentPlayer.get_x() < 0 && pl_target_x > 0) {
					pState.teleport = true;
				}
				if(pl_teleport) {
					currentPlayer.set_x(pl_target_x);
					currentPlayer.set_y(pl_target_y);
					currentPlayer.sim_prev_x = pl_target_x;
					currentPlayer.sim_prev_y = pl_target_y;
					pState.teleport = false;
				}
				if(pState.pos_received) {
					pState.pos_received = false;
					if(this._paintball.state.playerId != p_id) {
						if(pState.pos_x == pState.pos_x_backup && pState.pos_y == pState.pos_y_backup) {
							pState.speed_x = 0;
							pState.speed_y = 0;
							pState.target_x = pState.pos_x;
							pState.target_y = pState.pos_y;
						}
						pState.pos_x_backup = pState.pos_x;
						pState.pos_y_backup = pState.pos_y;
						let errX = pState.pos_x - currentPlayer.get_x();
						let errY = pState.pos_y - currentPlayer.get_y();
						if(errX * errX + errY * errY > 3600) {
							currentPlayer.set_x(pState.pos_x);
							currentPlayer.set_y(pState.pos_y);
							currentPlayer.sim_prev_x = pState.pos_x;
							currentPlayer.sim_prev_y = pState.pos_y;
						} else {
							currentPlayer.set_x(currentPlayer.get_x() + errX * 0.35);
							currentPlayer.set_y(currentPlayer.get_y() + errY * 0.35);
						}
					}
				}
				let swimDepth = 0.0;
				if(currentPlayer.char_loaded) {
					if(isInCameraView || currentPlayer.player_id == this._paintball.state.playerId) {
						swimDepth = this._paintball.particleModel.check_if_swimming(currentPlayer.get_x(),currentPlayer.get_y());
						if(swimDepth != 0) {
							if(currentPlayer.player_shadow.get_alpha() != 0) {
								currentPlayer.swim_mask.set_visible(false);
								currentPlayer.player_shadow.set_alpha(0);
								currentPlayer.player_swimming = true;
							}
							currentPlayer.swim_mask.set_y(this.swim_mask_start_y - swimDepth / 255 * this.swim_mask_y_multiplier);
							if(currentPlayer.waterShader == null) {
								currentPlayer.waterShader = new atlas_WaterlineShader();
							}
							let waterline = currentPlayer.get_y() + currentPlayer.swim_mask.get_y() + currentPlayer.swimMaskBottom;
							let tmp = this._paintball.tileWorld.worldToLocalY(waterline);
							currentPlayer.waterShader.get_data().uWaterY.value = [tmp];
							if(currentPlayer.get_shader() != currentPlayer.waterShader) {
								currentPlayer.set_shader(currentPlayer.waterShader);
							}
							if(currentPlayer.player_id == this._paintball.state.playerId) {
								currentPlayer.swim_depth = swimDepth;
							}
						} else if(currentPlayer.player_shadow.get_alpha() != 1) {
							currentPlayer.player_shadow.set_alpha(1);
							currentPlayer.player_swimming = false;
							if(currentPlayer.get_shader() != null) {
								currentPlayer.set_shader(null);
							}
						}
					}
				}
				if(currentPlayer.char_loaded) {
					let currentAnim = atlas_AtlasTools.child(currentPlayer.pholder_inner,currentPlayer.anim_mc);
					currentPlayer.elevation_height = this.player_elevation_height_stand;
					if(pState.crouch == 1) {
						currentPlayer.elevation_height = this.player_elevation_height_crouch;
						currentPlayer.animate = 2;
						if(currentPlayer.name_holder.get_visible()) {
							currentPlayer.stamina_indicator.set_visible(false);
							currentPlayer.name_holder.set_visible(false);
						}
					} else if(pState.camo <= 0) {
						if(!currentPlayer.name_holder.get_visible()) {
							currentPlayer.stamina_indicator.set_visible(true);
							currentPlayer.name_holder.set_visible(true);
						}
					}
					let pl_hp = pState.hp;
					if(currentAnim != null) {
						this.animate_player(p_id,animSteps);
						let healthFrame = 12 - (pl_hp / (pState.hpmax / 12) | 0);
						if(healthFrame < 1) {
							healthFrame = 1;
						}
						if(healthFrame > 12) {
							healthFrame = 12;
						}
						let my_head = atlas_AtlasTools.child(currentAnim,"my_head");
						let my_body = atlas_AtlasTools.child(currentAnim,"my_body");
						if(my_head != null) {
							let headHealthFrame = Math.min(healthFrame,my_head.get_numFrames()) | 0;
							if(my_head.get_currentFrame() != headHealthFrame) {
								my_head.gotoAndStop(headHealthFrame);
							}
						}
						if(my_body != null) {
							let bodyHealthFrame = Math.min(healthFrame,my_body.get_numFrames()) | 0;
							if(my_body.get_currentFrame() != bodyHealthFrame) {
								my_body.gotoAndStop(bodyHealthFrame);
							}
						}
					}
					if(pl_hp > 0) {
						if(!currentPlayer.pholder_inner.get_visible()) {
							currentPlayer.player_death_anim.set_visible(false);
							currentPlayer.pholder_inner.set_visible(true);
						}
					} else if(currentPlayer.pholder_inner.get_visible()) {
						currentPlayer.player_death_anim.set_visible(true);
						currentPlayer.player_death_anim.gotoAndPlay(1);
						currentPlayer.pholder_inner.set_visible(false);
					}
					if(currentAnim != null && atlas_AtlasTools.child(currentAnim,"my_weapon") != null) {
						let my_weapon = atlas_AtlasTools.child(currentAnim,"my_weapon");
						let pl_weapon_kind = this.resolve_weapon_visual_kind(p_id);
						if(pState.weapon_visual_kind >= 0 && pState.weapon_visual_until <= this._paintball.frameModel.sim_time) {
							pState.weapon_visual_kind = -1;
						}
						if(pl_weapon_kind > 0 && my_weapon.get_currentFrame() != pl_weapon_kind) {
							my_weapon.gotoAndStop(pl_weapon_kind);
						}
					}
				}
				let mapIndicator = pState.small_map_indicator;
				mapIndicator.set_x(currentPlayer.get_x() / 20);
				mapIndicator.set_y(currentPlayer.get_y() / 20);
				if(p_id != this._paintball.state.playerId) {
					if(pl_tmid != mapIndicator.get_currentFrame()) {
						mapIndicator.gotoAndStop(pl_tmid);
					}
					if(pl_tmid != this.getPlayer(this._paintball.state.playerId).tmid) {
						if(mapIndicator.getChildByName("firing").get_currentFrame() == 1) {
							if(mapIndicator.get_visible()) {
								mapIndicator.set_visible(false);
							}
						} else if(!mapIndicator.get_visible()) {
							mapIndicator.set_visible(true);
						}
					} else if(!mapIndicator.get_visible()) {
						mapIndicator.set_visible(true);
					}
				}
				++playerIndex;
			}
		}
	}
	animate_weapon(pl) {
		try {
			let whichPlayer = this.player(pl);
			if(whichPlayer != null && whichPlayer.char_loaded) {
				let my_weapon = atlas_AtlasTools.child(atlas_AtlasTools.child(this.player_array[this.player_array_map[pl]].pholder_inner,whichPlayer.anim_mc),"my_weapon");
				let visualWeaponKind = this.resolve_weapon_visual_kind(pl);
				if(visualWeaponKind > 0 && my_weapon.get_currentFrame() != visualWeaponKind) {
					my_weapon.gotoAndStop(visualWeaponKind);
				}
				let weapon_holder = atlas_AtlasTools.child(my_weapon,"weapon_holder");
				if(weapon_holder != null) {
					weapon_holder.play();
				}
			}
		} catch( _g ) {
			haxe_NativeStackTrace.lastError = _g;
		}
	}
	resolve_weapon_visual_kind(pl) {
		let visualState = this.getPlayer(pl);
		let transientKind = -1;
		if(visualState.weapon_visual_kind >= 0 && visualState.weapon_visual_until > this._paintball.frameModel.sim_time) {
			transientKind = visualState.weapon_visual_kind;
		}
		if(this._paintball.state.npc_team_enabled && pl > this._paintball.matchModel.bot_player_id_start) {
			if(transientKind > 0) {
				return transientKind;
			}
			if(visualState.weapon_kind > 0) {
				return visualState.weapon_kind;
			}
		}
		if(transientKind >= 0) {
			return transientKind;
		} else {
			return visualState.weapon_kind;
		}
	}
	fix_weapon_animation(pl) {
		try {
			let whichPlayer = this.player(pl);
			if(whichPlayer != null && whichPlayer.char_loaded) {
				let weapon_holder = atlas_AtlasTools.child(atlas_AtlasTools.child(atlas_AtlasTools.child(this.player_array[this.player_array_map[pl]].pholder_inner,whichPlayer.anim_mc),"my_weapon"),"weapon_holder");
				if(weapon_holder != null) {
					if(weapon_holder.get_currentFrame() == 1) {
						weapon_holder.stop();
					}
				}
			}
		} catch( _g ) {
			haxe_NativeStackTrace.lastError = _g;
		}
	}
	handle_laser(pl) {
		let clearIndicator = null;
		let drawIndicator = null;
		let currentPlayer = this.player(pl);
		let data = this.getPlayer(pl);
		if(data.laser_drawn_to_indicator != "") {
			if(currentPlayer != null && currentPlayer.char_loaded) {
				let playerHolderInnerAnimMC = atlas_AtlasTools.child(this.player_array[this.player_array_map[pl]].pholder_inner,data.laser_drawn_to_indicator);
				let my_weapon = playerHolderInnerAnimMC != null ? atlas_AtlasTools.child(playerHolderInnerAnimMC,"my_weapon") : null;
				let weapon_holder = my_weapon != null ? atlas_AtlasTools.child(my_weapon,"weapon_holder") : null;
				clearIndicator = weapon_holder != null ? atlas_AtlasTools.child(weapon_holder,"fire_indicator") : null;
				this.clear_laser(clearIndicator);
				data.laser_drawn_to_indicator = "";
				if(pl == this._paintball.state.playerId) {
					this._paintball.inputModel.ctrl_pressed = false;
				}
			}
		}
		if(data.laser_x != 0 || data.laser_y != 0) {
			if(currentPlayer != null && currentPlayer.char_loaded) {
				let playerHolderInnerAnimMC = atlas_AtlasTools.child(this.player_array[this.player_array_map[pl]].pholder_inner,currentPlayer.anim_mc);
				let my_weapon = playerHolderInnerAnimMC != null ? atlas_AtlasTools.child(playerHolderInnerAnimMC,"my_weapon") : null;
				let weapon_holder = my_weapon != null ? atlas_AtlasTools.child(my_weapon,"weapon_holder") : null;
				drawIndicator = weapon_holder != null ? atlas_AtlasTools.child(weapon_holder,"fire_indicator") : null;
				if(drawIndicator != null) {
					let laserX = data.laser_x;
					let laserY = data.laser_y;
					if(pl >= this._paintball.matchModel.bot_player_id_start) {
						let elevation = data.crouch > 0 ? this._paintball.particleModel.projectile_fire_elevation_crouch : this._paintball.particleModel.projectile_fire_elevation_normal;
						let local = atlas_AtlasHitTest.worldToLocal(drawIndicator,this._paintball.tileWorld.content,currentPlayer.get_x() + laserX,currentPlayer.get_y() + laserY + elevation);
						laserX = local.x;
						laserY = local.y;
					}
					this.draw_laser(drawIndicator,laserX,laserY);
					data.laser_drawn_to_indicator = currentPlayer.anim_mc;
				}
			}
			if(pl == this._paintball.state.playerId) {
				this._paintball.inputModel.ctrl_pressed = true;
			}
		}
	}
	switch_weapon(id) {
		this.setSelectedWeapon(id);
		this.setCombatState(this._paintball.state.selected_weapon);
		let _this = this._paintball.loadoutModel;
		let arrayid;
		switch(this._paintball.state.selected_weapon) {
		case 1:
			arrayid = _this._paintball.state.weapon1arrayid;
			break;
		case 2:
			arrayid = _this._paintball.state.weapon2arrayid;
			break;
		case 3:
			arrayid = _this._paintball.state.weapon3arrayid;
			break;
		case 4:
			arrayid = _this.weapon4arrayid;
			break;
		default:
			arrayid = 0;
		}
		let wArr = this._paintball.loadoutModel._get_weapon_array(arrayid);
		let myPlayer = this.getPlayer(this._paintball.state.playerId);
		myPlayer.weapon_arrayid = arrayid;
		myPlayer.weapon_kind = wArr[7];
		this.current_weapon_scope = wArr[16];
		if(this.current_weapon_scope == 0) {
			myPlayer.laser_x = 0;
			myPlayer.laser_y = 0;
		}
		myPlayer.weapon_visual_kind = -1;
		myPlayer.weapon_visual_until = 0;
		let _this1 = this._paintball.loadoutModel;
		let tmp;
		switch(this._paintball.state.selected_weapon) {
		case 1:
			tmp = _this1.weapon1reload;
			break;
		case 2:
			tmp = _this1.weapon2reload;
			break;
		case 3:
			tmp = _this1.weapon3reload;
			break;
		case 4:
			tmp = _this1.weapon4reload;
			break;
		default:
			tmp = 0;
		}
		this.fire_reload_active = tmp > 0;
		let _this2 = this._paintball.loadoutModel;
		let tmp1;
		switch(this._paintball.state.selected_weapon) {
		case 1:
			tmp1 = _this2.weapon1ammo;
			break;
		case 2:
			tmp1 = _this2.weapon2ammo;
			break;
		case 3:
			tmp1 = _this2.weapon3ammo;
			break;
		case 4:
			tmp1 = _this2.weapon4ammo;
			break;
		default:
			tmp1 = 0;
		}
		this._paintball.particleModel.sync_client_predicted_ammo(tmp1);
	}
	weapon_scope_function() {
		let target_distance = 0;
		let my_fire_indicator_mc = null;
		let projectile_elevation = 0;
		let target_coordinate = null;
		let processed_coordinate = null;
		let laser_check_points = 0;
		let i3 = 0;
		let check_coordinate = null;
		let processed_check_coordinate = null;
		let currentPlayer = this.player(this._paintball.state.playerId);
		if(currentPlayer != null && currentPlayer.char_loaded) {
			let me = this.getPlayer(this._paintball.state.playerId);
			if(this.current_weapon_scope != 0) {
				this._paintball.cameraModel.camera_focus_divider = 3 - this.current_weapon_scope / 100;
				let x1 = this._paintball.bg.get_mouseX();
				let y1 = this._paintball.bg.get_mouseY();
				let x2 = currentPlayer.get_x();
				let y2 = currentPlayer.get_y();
				target_distance = Math.sqrt((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1));
				if(target_distance > this.laser_activate_distance && !currentPlayer.player_swimming) {
					try {
						let playerHolderInnerAnimMC = atlas_AtlasTools.child(this.player_array[this.player_array_map[this._paintball.state.playerId]].pholder_inner,currentPlayer.anim_mc);
						let my_weapon = playerHolderInnerAnimMC != null ? atlas_AtlasTools.child(playerHolderInnerAnimMC,"my_weapon") : null;
						let weapon_holder = my_weapon != null ? atlas_AtlasTools.child(my_weapon,"weapon_holder") : null;
						my_fire_indicator_mc = weapon_holder != null ? atlas_AtlasTools.child(weapon_holder,"fire_indicator") : null;
						if(my_fire_indicator_mc == null) {
							throw haxe_Exception.thrown("fire_indicator hazir degil");
						}
						if(me.crouch == 0) {
							projectile_elevation = this._paintball.particleModel.projectile_fire_elevation_normal;
						} else {
							projectile_elevation = this._paintball.particleModel.projectile_fire_elevation_crouch;
						}
						let targetInPaintball = new openfl_geom_Point(this._paintball.get_mouseX(),this._paintball.get_mouseY() + projectile_elevation);
						target_coordinate = this._paintball.localToGlobal(targetInPaintball);
						let targetInWorld = this._paintball.bg.globalToLocal(target_coordinate);
						let indicatorMatrix = atlas_AtlasHitTest.worldChain(my_fire_indicator_mc,this._paintball.tileWorld.content);
						processed_coordinate = atlas_AtlasHitTest.worldToLocal(my_fire_indicator_mc,this._paintball.tileWorld.content,targetInWorld.x,targetInWorld.y);
						me.laser_x = processed_coordinate.x;
						me.laser_y = processed_coordinate.y;
						laser_check_points = target_distance / this.laser_collision_check_unit_px | 0;
						if(laser_check_points > this.laser_collision_check_unit_max_point) {
							laser_check_points = this.laser_collision_check_unit_max_point;
						}
						i3 = laser_check_points - 1 | 0;
						while(i3 > 0) {
							check_coordinate = new openfl_geom_Point(processed_coordinate.x / laser_check_points * i3,processed_coordinate.y / laser_check_points * i3);
							processed_check_coordinate = indicatorMatrix.transformPoint(check_coordinate);
							if(this._paintball.particleModel.check_map_item_collision(processed_check_coordinate.x,processed_check_coordinate.y)) {
								me.laser_x = check_coordinate.x;
								me.laser_y = check_coordinate.y;
								i3 = 0;
							}
							--i3;
						}
					} catch( _g ) {
						haxe_NativeStackTrace.lastError = _g;
					}
				} else {
					me.laser_x = 0;
					me.laser_y = 0;
				}
			}
		}
	}
	handle_my_grenade() {
		if(this._paintball.state.spawn_timer_now == 0) {
			let currentPlayer = this.player(this._paintball.state.playerId);
			if(currentPlayer == null) {
				return;
			}
			let grenade_bar_holder = currentPlayer.grenade_bar_holder;
			if(grenade_bar_holder == null) {
				return;
			}
			let grenade_bar = atlas_AtlasTools.child(grenade_bar_holder,"grenade_bar");
			if(grenade_bar == null) {
				return;
			}
			if(this._paintball.my_grenade_amount_text != null && this._paintball.loadoutModel.weapon3clip != Std.parseInt(this._paintball.my_grenade_amount_text.get_text())) {
				this._paintball.my_grenade_amount_text.set_text(Std.string(this._paintball.loadoutModel.weapon3clip));
			}
			if(this._paintball.inputModel.e_pressed) {
				if(this._paintball.loadoutModel.weapon3clip > 0) {
					if(this._paintball.state.my_hp > 0 && !this._paintball.uiModel.weapon_select.get_visible() && !this._paintball.winner_screen.get_visible()) {
						grenade_bar.set_rotation(this.my_target_angle - 110);
						if(!grenade_bar.get_visible()) {
							grenade_bar.set_visible(true);
							grenade_bar.gotoAndStop(1);
							this.my_grenade_charge = 1;
							this.switch_weapon(3);
						} else {
							let chargeSteps = this._paintball.frameModel.anim_steps;
							let chargeFrame = grenade_bar.get_currentFrame();
							if(chargeSteps > 0 && chargeFrame < grenade_bar.get_numFrames()) {
								chargeFrame += chargeSteps;
								if(chargeFrame > grenade_bar.get_numFrames()) {
									chargeFrame = grenade_bar.get_numFrames();
								}
								grenade_bar.gotoAndStop(chargeFrame);
							}
							this.my_grenade_charge = chargeFrame;
						}
					}
				}
			} else if(grenade_bar.get_visible()) {
				grenade_bar.set_visible(false);
				let thrownCharge = 0;
				let thrownMuzzleX = 0;
				let thrownMuzzleY = 0;
				if(this.my_grenade_charge > 0 && this._paintball.state.my_hp > 0 && this._paintball.loadoutModel.weapon3clip > 0) {
					let grenadeMuzzle = this._paintball.particleModel.get_local_muzzle_position();
					if(grenadeMuzzle == null) {
						grenade_bar.set_visible(true);
						return;
					}
					this.fire_grenade_throw_request = this.my_grenade_charge;
					this.fire_grenade_throw_x = grenadeMuzzle.x;
					this.fire_grenade_throw_y = grenadeMuzzle.y;
					if(this._paintball.loadoutModel.weapon3ammo <= 0) {
						let tmp = this._paintball.loadoutModel._get_weapon_array(this._paintball.state.weapon3arrayid);
						this._paintball.loadoutModel.weapon3ammo = tmp[2];
						this._paintball.loadoutModel.weapon3clip--;
					}
					this._paintball.loadoutModel.weapon3ammo--;
					thrownCharge = this.my_grenade_charge;
					thrownMuzzleX = grenadeMuzzle.x;
					thrownMuzzleY = grenadeMuzzle.y;
				}
				this.my_grenade_charge = 0;
				this.switch_weapon(1);
				if(thrownCharge > 0) {
					this.fire_grenade_throw_sequence = this._paintball.particleModel.run_client_predicted_grenade_visuals(thrownCharge,thrownMuzzleX,thrownMuzzleY);
				}
			}
		}
	}
	run_movement_functions() {
		let myState = this.getPlayer(this._paintball.state.playerId);
		if(this.isSpawnReady() && !this._paintball.uiModel.weapon_select.get_visible() && !this._paintball.winner_screen.get_visible()) {
			let myPlayer = this.player(this._paintball.state.playerId);
			if(!this._paintball.uiModel.isChatInputReady()) {
				this._paintball.inputModel.w_pressed = false;
				this._paintball.inputModel.s_pressed = false;
				this._paintball.inputModel.a_pressed = false;
				this._paintball.inputModel.d_pressed = false;
				this._paintball.inputModel.space_pressed = false;
			}
			atlas_AtlasTools.child(myPlayer.stamina_indicator,"stamina_bar").set_scaleX(this.my_player_stamina / this.my_player_stamina_max);
			if(this._paintball.inputModel.ctrl_pressed && !this._paintball.inputModel.w_pressed && !this._paintball.inputModel.a_pressed && !this._paintball.inputModel.s_pressed && !this._paintball.inputModel.d_pressed && this._paintball.state.selected_weapon != 4) {
				myState.crouch = 1;
			} else {
				myState.crouch = 0;
			}
		}
	}
	update_local_vitals() {
		if(this._paintball.state.spawn_timer_now == 0) {
			if(this._paintball.state.my_hp < 1 && this.resurrect_timer == 0) {
				this.resurrect_timer = this._paintball.frameModel.sim_time + this._paintball.state.resurrect_timer_max;
				this._paintball.uiModel.setWeaponSelectVisible(true);
				this._paintball.uiModel.showKilledBySign(this.player(this.player_hit_me_last).player_name);
				this._paintball.uiModel.setSpawnCounterMaskVisible(true);
				if(this.player_hit_me_last >= 100) {
					this.getPlayer(this.player_hit_me_last).kills = this.getPlayer(this.player_hit_me_last).kills + 1;
				}
			}
