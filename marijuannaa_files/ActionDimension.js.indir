class avatar_view_PlayerProfile extends avatar_view_social_SocialWindow {
	constructor() {
		openfl_events_EventDispatcher._hx_skip_constructor = true;
		super();
		openfl_events_EventDispatcher._hx_skip_constructor = false;
		this._hx_constructor();
	}
	_hx_constructor() {
		this.games = [];
		this.metrics = [];
		super._hx_constructor("social.profile_title",720,520);
		let host = avatar_view_social_SocialUI.box(this.body,-1,410);
		this.loadState = avatar_view_social_SocialUI.column(host,-1,130,16);
		this.loadState.set_verticalAlign("center");
		this.loading = avatar_view_social_SocialUI.label(this.loadState,avatar_view_social_SocialUI.t("team.loading"),-1,60,19,"#44351f",true);
		let fh = this.loading;
		fh.set_styleString(fh.get_styleString() + "text-align: center;");
		let _gthis = this;
		this.retry = avatar_view_social_SocialUI.button(this.loadState,avatar_view_social_SocialUI.t("social.retry"),180,function() {
			if(_gthis.userId != null) {
				_gthis.open(_gthis.userId);
			}
		},true);
		this.retry.set_horizontalAlign("center");
		this.retry.set_hidden(true);
		this.content = avatar_view_social_SocialUI.column(host,-1,410,8);
		this.content.set_hidden(true);
		let hero = avatar_view_social_SocialUI.row(this.content,-1,166,16);
		this.portrait = avatar_view_social_SocialUI.box(hero,144,166);
		this.portrait.set_styleString("padding: 10px; background-color: #fffdf5; background-color-end: #fff8e7; background-gradient-style: vertical; border: 1px solid #d7c69f; border-radius: 12px;" + "background-color: #e7e9c9;");
		let info = avatar_view_social_SocialUI.column(hero,-1,166,6);
		let heading = avatar_view_social_SocialUI.row(info,-1,29);
		this.nameLabel = avatar_view_social_SocialUI.label(heading,"",-1,29,25,"#5b4220",true);
		this.online = avatar_view_social_SocialUI.label(heading,"",110,20,12,"#4e6a34");
		this.online.set_verticalAlign("center");
		this.team = avatar_view_social_SocialUI.button(info,"",-1,null,false,30);
		this.level = avatar_view_social_SocialUI.label(info,"",-1,23,18,"#44351f",true);
		this.progress = new haxe_ui_components_HorizontalProgress();
		this.progress.set_percentWidth(100);
		this.progress.set_height(12);
		this.progress.set_min(0);
		this.progress.set_max(100);
		this.progress.set_styleString("background-color: #dfd1b1; border: 0px; border-radius: 6px;");
		info.addComponent(this.progress);
		this.progress.registerEvent(haxe_ui_events_UIEvent.READY,function(_) {
			let fill = _gthis.progress.findComponent(_gthis.progress.get_cssName() + "-value");
			if(fill != null) {
				fill.set_styleString("background-color: #a9bf73; background-color-end: #839f50; border: 0px; border-radius: 6px;");
			}
		});
		this.progressText = avatar_view_social_SocialUI.label(info,"",-1,20,12,"#6d6049");
		this.rank = avatar_view_social_SocialUI.label(info,"",-1,22,14,"#5b4220");
		let xp = avatar_view_social_SocialUI.row(this.content,-1,66);
		this.metrics.push(avatar_view_social_SocialUI.metric(xp,avatar_view_social_SocialUI.t("social.total_xp"),"—"));
		this.metrics.push(avatar_view_social_SocialUI.metric(xp,avatar_view_social_SocialUI.t("leaderboard.month"),"—"));
		this.metrics.push(avatar_view_social_SocialUI.metric(xp,avatar_view_social_SocialUI.t("leaderboard.week"),"—"));
		avatar_view_social_SocialUI.label(this.content,avatar_view_social_SocialUI.t("social.recorded_matches"),-1,22,18,"#5b4220",true);
		let gameRow = avatar_view_social_SocialUI.row(this.content,-1,66);
		this.games.push(avatar_view_social_SocialUI.metric(gameRow,avatar_view_social_SocialUI.t("social.game_" + "paintball"),"0"));
		this.games.push(avatar_view_social_SocialUI.metric(gameRow,avatar_view_social_SocialUI.t("social.game_" + "tennis"),"0"));
		this.games.push(avatar_view_social_SocialUI.metric(gameRow,avatar_view_social_SocialUI.t("social.game_" + "soccer"),"0"));
		this.combat = avatar_view_social_SocialUI.label(this.content,"",-1,18,12,"#6d6049");
		avatar_view_social_SocialUI.label(this.content,avatar_view_social_SocialUI.t("social.archive_note"),-1,32,12,"#76664c");
	}
	open(id,knownName) {
		this.userId = id;
		this.content.set_hidden(true);
		this.loadState.set_hidden(false);
		this.retry.set_hidden(true);
		this.loading.set_text(avatar_view_social_SocialUI.t("social.profile_loading",{ name : knownName == null ? "" : knownName}));
		if(this.figure != null) {
			this.figure.setActive(false);
		}
		this.present();
		let _gthis = this;
		this.waitForData(function() {
			_gthis.loading.set_text(avatar_view_social_SocialUI.t("social.load_failed"));
			_gthis.retry.set_hidden(false);
		});
		Action.instance.leaderboardModel.sendGetPlayerProfile(id);
	}
	dismiss() {
		this.userId = null;
		if(this.figure != null) {
			this.figure.setActive(false);
		}
		super.dismiss();
	}
	load(data) {
		if(data == null || !this.get_visible() || data.id != this.userId) {
			return;
		}
		this.finishWaiting();
		this.loadState.set_hidden(true);
		this.content.set_hidden(false);
		if(this.figure == null) {
			this.figure = new avatar_view_kit_CharacterFigure(72,158,2.0);
			this.portrait.addChild(this.figure);
		}
		this.figure.applyLook(data);
		this.figure.setActive(true);
		this.nameLabel.set_text(data.name);
		this.online.set_text(avatar_view_social_SocialUI.t(data.online ? "profile.online" : "social.offline"));
		let _gthis = this;
		if(data.team != null) {
			let id = data.team.id;
			this.team.set_text("[" + data.team.tag + "] " + data.team.name + "  ›");
			avatar_view_social_SocialUI.enabled(this.team,true);
			this.team.set_onClick(function(_) {
				_gthis.dismiss();
				Action.instance.ui.teamListWindow.openTeam(id);
			});
		} else {
			this.team.set_text(avatar_view_social_SocialUI.t("profile.no_team"));
			avatar_view_social_SocialUI.enabled(this.team,false);
		}
		this.level.set_text(avatar_view_social_SocialUI.t("profile.level",{ level : data.level}));
		this.progress.set_pos(data.xpForNextLevel > 0 ? Math.min(100,data.xpIntoLevel / data.xpForNextLevel * 100) : 100);
		this.progressText.set_text(data.xpForNextLevel > 0 ? avatar_view_social_SocialUI.t("social.level_progress",{ current : avatar_view_social_SocialUI.number(data.xpIntoLevel), total : avatar_view_social_SocialUI.number(data.xpForNextLevel), remaining : avatar_view_social_SocialUI.number(Math.max(0,data.xpForNextLevel - data.xpIntoLevel))}) : avatar_view_social_SocialUI.t("social.max_level"));
		this.rank.set_text(data.rank > 0 ? avatar_view_social_SocialUI.t("social.overall_rank",{ rank : data.rank}) : avatar_view_social_SocialUI.t("profile.no_xp"));
		let xp_1 = data.monthXp;
		let xp_2 = data.weekXp;
		this.metrics[0].set_text(avatar_view_social_SocialUI.number(data.xp));
		this.metrics[1].set_text(avatar_view_social_SocialUI.number(xp_1));
		this.metrics[2].set_text(avatar_view_social_SocialUI.number(xp_2));
		let m = data.matchStats;
		this.games[0].set_text(avatar_view_social_SocialUI.number(m.paintball));
		this.games[1].set_text(avatar_view_social_SocialUI.number(m.tennis));
		this.games[2].set_text(avatar_view_social_SocialUI.number(m.soccer));
		this.combat.set_text(avatar_view_social_SocialUI.t("social.paintball_combat",{ kills : avatar_view_social_SocialUI.number(m.kills), deaths : avatar_view_social_SocialUI.number(m.deaths)}));
	}
}
