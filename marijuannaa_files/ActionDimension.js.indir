	activeEditorCameraOwner() {
		let ui = Action.instance != null ? Action.instance.ui : null;
		if(ui == null) {
			return null;
		}
		if(ui.adminEditorActive()) {
			return "admin";
		}
		let suiteEditor = ui.suiteEditorWindow;
		if(suiteEditor != null && (suiteEditor.editAllowed && suiteEditor.get_visible() && suiteEditor.panel != null && suiteEditor.panel.get_visible())) {
			return "suite";
