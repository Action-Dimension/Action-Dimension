class sim_logic_Heal {
	static step(player,world,currentTimeMs) {
		if(player == null) {
			return;
		}
		if(player.isBot && world.match.botAi == 1) {
			return;
		}
		if(!player.alive || player.hp <= 0) {
			player.baseHealTimer = 0;
			return;
		}
		if(player.hp >= player.hpMax) {
			player.baseHealTimer = 0;
			return;
		}
		if(!sim_logic_Heal.isNearBase(player,world)) {
			player.baseHealTimer = 0;
			return;
		}
		let base = world.match.baseHealTimerMax;
		let interval;
		if(!player.isBot) {
			interval = base;
		} else {
			let multiplier = player.botProfile != null ? player.botProfile.healMultiplier : 1;
			interval = multiplier > 0 ? base / multiplier : base;
		}
		if(player.baseHealTimer == 0) {
			player.baseHealTimer = currentTimeMs + interval;
			return;
		}
		if(currentTimeMs >= player.baseHealTimer) {
			player.hp += 1;
			if(player.hp > player.hpMax) {
				player.hp = player.hpMax;
			}
			player.baseHealTimer = currentTimeMs + interval;
		}
	}
	static isNearBase(player,world) {
		let radius = world.match.baseProximityRadius;
		if(world.match.teamsEnabled) {
			let sx;
			let sy;
			if(player.team == 1) {
				sx = world.match.spawnPointX1;
				sy = world.match.spawnPointY1;
			} else {
				sx = world.match.spawnPointX2;
				sy = world.match.spawnPointY2;
			}
			let dx = player.x - sx;
			let dy = player.y - sy;
			return dx * dx + dy * dy <= radius * radius;
		}
		let dx = player.x - world.match.spawnPointX1;
		let dy = player.y - world.match.spawnPointY1;
		if(!(dx * dx + dy * dy <= radius * radius)) {
			let dx = player.x - world.match.spawnPointX2;
			let dy = player.y - world.match.spawnPointY2;
			return dx * dx + dy * dy <= radius * radius;
		} else {
			return true;
		}
	}
}
