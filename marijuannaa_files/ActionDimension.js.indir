		this.panel.gotoAndStop(3);
		this.panel.set_x(openfl_Lib.get_current().stage.stageWidth / 2 - 343.8 + 350);
		this.panel.set_y(openfl_Lib.get_current().stage.stageHeight / 2 - 244.799999999999983 + 240);
		this.panel.set_scaleX(1.2);
		this.panel.set_scaleY(1.2);
		this.addChild(this.panel);
		avatar_view_WindowDrag.attachSwf(this.panel);
		this.setText(this.panel,"text_title",core_i18n_I18n.t("suite.shop_title"));
		this.setText(this.panel,"text_content",core_i18n_I18n.t("suite.shop_content"));
		this.setText(this.panel,"text_smallsuite",core_i18n_I18n.t("suite.small"));
		this.setText(this.panel,"text_mediumsuite",core_i18n_I18n.t("suite.medium"));
		this.setText(this.panel,"text_largesuite",core_i18n_I18n.t("suite.large"));
		this.setText(this.panel,"text_penthouse",core_i18n_I18n.t("suite.penthouse"));
		this.bindSuiteButton("suite_shop_1",1);
		this.bindSuiteButton("suite_shop_2",2);
		this.bindSuiteButton("suite_shop_3",3);
		this.bindSuiteButton("suite_shop_4",4);
		this.suitePanel = this.panel.getChildByName("suite_shop");
		this.suitePanel.gotoAndStop(1);
		this.suitePanel.set_visible(false);
		let _gthis = this;
		this.panel.getChildByName("map_dynitem_menu_close_button").addEventListener("mouseDown",function(_) {
			_gthis.suitePanel.set_visible(false);
			_gthis.set_visible(false);
		});
		this.setText(this.suitePanel,"text_takeatour",core_i18n_I18n.t("suite.tour"));
		this.setText(this.suitePanel,"text_buy",core_i18n_I18n.t("suite.buy"));
		this.suitePrice = this.suitePanel.getChildByName("suite_price");
		this.suitePanel.getChildByName("suite_shop_close_button").addEventListener("mouseDown",function(_) {
			_gthis.suitePanel.set_visible(false);
		});
		this.suitePanel.getChildByName("button_suite_shop_buy").addEventListener("mouseDown",$bind(this,this.buySuite));
		this.suitePanel.getChildByName("button_suite_shop_taketour").addEventListener("mouseDown",$bind(this,this.tourSuite));
		this.panel.addEventListener("mouseDown",function(_) {
			Action.instance.ui.blockedClick = true;
		});
		this.set_visible(false);
	}
	setText(container,name,value) {
		let field = container.getChildByName(name);
		field.mouseEnabled = false;
		field.set_text(value);
		return field;
	}
	bindSuiteButton(name,index) {
		let _gthis = this;
		this.panel.getChildByName(name).addEventListener("mouseDown",function(_) {
			_gthis.showSuite(index);
		});
	}
	showSuite(index) {
		this.suiteIndex = index;
		this.suitePanel.gotoAndStop(index);
		let tmp = this.suitePrice;
		let tmp1;
		switch(index) {
		case 1:
			tmp1 = core_i18n_I18n.t("suite.price",{ price : "1000 Cash"});
			break;
		case 2:
			tmp1 = core_i18n_I18n.t("suite.price",{ price : "5000 Cash"});
			break;
		case 3:
			tmp1 = core_i18n_I18n.t("suite.price",{ price : "15000 Cash"});
			break;
		case 4:
			tmp1 = core_i18n_I18n.t("suite.price",{ price : "125 Crystal"});
			break;
		default:
			tmp1 = "";
		}
		tmp.set_text(tmp1);
		this.suitePanel.set_visible(true);
		Action.instance.ui.blockedClick = true;
	}
	buySuite(_) {
		let itemPriceValue;
		switch(this.suiteIndex) {
		case 1:
			itemPriceValue = 1000;
			break;
		case 2:
			itemPriceValue = 5000;
			break;
		case 3:
			itemPriceValue = 15000;
			break;
		case 4:
			itemPriceValue = 125;
			break;
		default:
			itemPriceValue = 0;
		}
		let usesCrystal = this.suiteIndex == 4;
		let priceText = usesCrystal ? core_i18n_I18n.t("price.crystal",{ amount : itemPriceValue}) : core_i18n_I18n.t("price.cash",{ amount : itemPriceValue});
		let _gthis = this;
		Action.instance.ui.actionPermission.open(core_i18n_I18n.t("suite.buy_confirm",{ price : priceText}),function() {
			if(!usesCrystal && Action.instance.ui.characterSmallStats.cashValue < itemPriceValue) {
				Action.instance.ui.popupMessage.showMessage(core_i18n_I18n.t("currency.cash_insufficient"));
			} else if(usesCrystal && Action.instance.ui.characterSmallStats.premiumCashValue < itemPriceValue) {
				Action.instance.ui.popupMessage.showMessage(core_i18n_I18n.t("currency.crystal_insufficient"));
			} else {
				Action.instance.npcModel.buySuite(_gthis.suiteIndex);
				_gthis.suitePanel.set_visible(false);
				_gthis.set_visible(false);
			}
		},function() {
		});
	}
	tourSuite(_) {
		let playerModel = Action.instance.playerModel;
		if(playerModel == null) {
			Action.instance.ui.popupMessage.showMessage(core_i18n_I18n.t("suite.preview_failed"));
			return;
		}
		this.suitePanel.set_visible(false);
		this.set_visible(false);
		Action.instance.ui.blockedClick = true;
		playerModel.previewSuite(this.suiteIndex);
	}
	open() {
		this.panel.gotoAndStop(3);
		this.suitePanel.set_visible(false);
		this.set_visible(true);
		Action.instance.ui.blockedClick = true;
	}
}
