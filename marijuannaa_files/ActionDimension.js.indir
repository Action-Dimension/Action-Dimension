		setCashDoneBtn.addEventListener("mouseDown",function(e) {
			if(_gthis.offerLocked) {
				_gthis.cashMenu.set_visible(false);
				return;
			}
			_gthis.myOfferCash.set_text(offerCash == null ? "null" : "" + offerCash);
			_gthis.cashMenu.set_visible(false);
			Action.instance.playerModel.setTradeOfferCash(_gthis.tradeId,offerCash);
			_gthis.myOfferApprovalBtn.gotoAndStop(1);
			_gthis.otherOfferApprovalBtn.gotoAndStop(1);
		});
	}
	addOfferItem(itemData) {
		if(this.offerLocked || Lambda.count(this.myOfferData) > 4) {
			return false;
		}
