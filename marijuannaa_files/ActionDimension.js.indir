			let nameFormat = new openfl_text_TextFormat("_sans",9,16777215,true);
			runtimeName.set_defaultTextFormat(nameFormat);
			runtimeName.set_text(core_i18n_I18n.itemName(modkit));
			while(fontSize > 6 && runtimeName.get_textWidth() > runtimeName.get_width() - 4) {
				--fontSize;
