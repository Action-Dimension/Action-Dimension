			}
		}
	}
	onPetDead(data) {
		Action.instance.ui.petInfoMenu.close();
		Action.instance.ui.petDeadWindow.open(data.cost);
	}
	dispose() {
		this.disposed = true;
		this.pendingPositionUpdates = new haxe_ds_StringMap();
	}
}
