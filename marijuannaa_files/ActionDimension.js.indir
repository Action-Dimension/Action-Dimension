	panCamera(screenDeltaX,screenDeltaY) {
		if(!(this.editAllowed && this.get_visible() && this.panel != null && this.panel.get_visible()) || Action.instance == null || Action.instance.scene == null || Action.instance.scene.camera == null) {
			return;
		}
		let camera = Action.instance.scene.camera;
		this.cameraTargetX -= screenDeltaX / camera.zoom;
		this.cameraTargetY -= screenDeltaY / camera.zoom;
		this.clampCameraTarget(camera);
		this.updateCamera();
	}
	clampCameraTarget(camera) {
		let stage = openfl_Lib.get_current().stage;
		let halfWidth = stage.stageWidth / (2 * camera.zoom);
		let halfHeight = stage.stageHeight / (2 * camera.zoom);
		let minX = halfWidth - 0.5;
		let minY = halfHeight - 0.5;
		let maxX = camera.boundsWidth - halfWidth - 0.5;
		let maxY = camera.boundsHeight - halfHeight - 0.5;
		this.cameraTargetX = maxX < minX ? camera.boundsWidth / 2 : Math.max(minX,Math.min(maxX,this.cameraTargetX));
		this.cameraTargetY = maxY < minY ? camera.boundsHeight / 2 : Math.max(minY,Math.min(maxY,this.cameraTargetY));
	}
	beginInventoryDrag(invItem,stageX,stageY) {
		if(!(this.editAllowed && this.get_visible() && this.panel != null && this.panel.get_visible()) || invItem == null || invItem.itemData == null) {
			return;
		}
		this.cancelInventoryDrag();
		let item = invItem.itemData;
		if(item.suite_frames == null || item.suite_frames.length == 0) {
			return;
		}
		this.inventoryDragItem = invItem;
		this.inventoryDragObject = this.addAtlasObject(Std.string(item.suite_frames[0]),0,0,-1,false);
		if(this.inventoryDragObject == null) {
			this.inventoryDragItem = null;
			return;
		}
		let stage = openfl_Lib.get_current().stage;
		stage.addEventListener("mouseMove",$bind(this,this.onInventoryDragMove),false,1000);
		stage.addEventListener("mouseUp",$bind(this,this.onInventoryDragEnd),false,1000);
		this.updateInventoryDrag(stageX,stageY);
		Action.instance.ui.blockedClick = true;
		Action.instance.scene.cancelMovementPointer();
