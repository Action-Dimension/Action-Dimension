	updateSwimMask(swim_value,width_value,y_value,x_value,radius) {
		if(width_value == null) {
			width_value = this.body.cacheRight - this.body.cacheLeft;
		}
		if(y_value == null) {
			y_value = -50;
		}
		if(x_value == null) {
			x_value = -40;
		}
		if(this.gender == "female") {
			y_value -= 14.15;
			x_value -= 2.4;
		}
		if(this.isActiveJetpack && radius == null) {
			swim_value += this.body.get_y() / 5;
		}
		if(radius != null) {
			if(this.previewClip == null) {
				this.previewClip = new openfl_geom_Rectangle();
			}
			this.previewClip.setTo(x_value,y_value,width_value,swim_value);
		} else if(Action.instance != null && Action.instance.scene != null && Action.instance.scene.world != null) {
			if(this.waterShader == null) {
				this.waterShader = new atlas_WaterlineShader();
			}
			let waterline = this.get_y() + this.body.get_y() + y_value + (86 - swim_value + 40);
			let tmp = Action.instance.scene.world.worldToLocalY(waterline);
			this.waterShader.get_data().uWaterY.value = [tmp];
			if(this.container != null) {
				if(this.container.get_shader() != this.waterShader) {
					this.container.set_shader(this.waterShader);
				}
			} else if(this.get_shader() != this.waterShader) {
				this.set_shader(this.waterShader);
			}
		}
		this.characterIndicatorVisible = false;
	}
	calculateAngle(param1,param2,param3,param4) {
		let _loc5_ = 0;
		_loc5_ = Math.atan2(param3 - param1,param4 - param2) * -180 / Math.PI;
		if((_loc5_ -= 180) < 0) {
			_loc5_ = 360 + _loc5_;
		}
		return _loc5_;
	}
	calculateVectorX(param1,param2) {
		return param1 * Math.cos(Math.PI / 180 * param2 - 90);
	}
	calculateVectorY(param1,param2) {
		return param1 * Math.sin(Math.PI / 180 * param2 - 90);
	}
	checkAllCollision(x,y) {
		let scene = Action.instance.scene;
		let worldContent = scene.world.content;
		let _g = 0;
		let _g1 = scene.mapObjects;
		while(_g < _g1.length) {
			let mapCol = _g1[_g];
			++_g;
			if(((mapCol) instanceof avatar_view_scene_MapObjectSprite)) {
				let mapObject = mapCol;
				if(mapObject.collision != null) {
					if(mapObject.collision.hitTestWorld(worldContent,x,y)) {
						return true;
					}
