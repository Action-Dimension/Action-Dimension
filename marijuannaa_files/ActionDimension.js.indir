		this.ps_skin_price_text.set_text(core_i18n_I18n.t("price.cash",{ amount : 0}));
		this.ps_eyes_price_text = panel.getChildByName("ps_eyes_price_text");
		this.ps_eyes_price_text.set_text(core_i18n_I18n.t("price.cash",{ amount : 0}));
		this.ps_mouth_price_text = panel.getChildByName("ps_mouth_price_text");
		this.ps_mouth_price_text.set_text(core_i18n_I18n.t("price.cash",{ amount : 0}));
		let fh2 = this.ps_skin_price_text;
		fh2.set_x(fh2.get_x() + 70);
		let fh3 = this.ps_eyes_price_text;
		fh3.set_x(fh3.get_x() + 70);
		let fh4 = this.ps_mouth_price_text;
		fh4.set_x(fh4.get_x() + 70);
		this.addChild(panel);
		avatar_view_WindowDrag.attachSwf(panel);
		let skinLength = 8;
		let mouthLength = 46;
		let eyesLength = 12;
		let _gthis = this;
		skinNextBtn.addEventListener("mouseDown",function(e) {
			_gthis.skinIndex++;
			if(_gthis.skinIndex >= skinLength) {
				_gthis.skinIndex = 0;
			}
			_gthis.character.changeSkin(_gthis.skinIndex);
			_gthis.priceUpdate();
		});
		skinPrevBtn.addEventListener("mouseDown",function(e) {
			_gthis.skinIndex--;
			if(_gthis.skinIndex < 0) {
				_gthis.skinIndex = skinLength - 1;
			}
			_gthis.character.changeSkin(_gthis.skinIndex);
			_gthis.priceUpdate();
		});
		mouthNextBtn.addEventListener("mouseDown",function(e) {
			_gthis.mouthIndex++;
			if(_gthis.mouthIndex >= mouthLength) {
				_gthis.mouthIndex = 0;
			}
			_gthis.character.changeMouth(_gthis.mouthIndex);
			_gthis.priceUpdate();
		});
		mouthPrevBtn.addEventListener("mouseDown",function(e) {
			_gthis.mouthIndex--;
			if(_gthis.mouthIndex < 0) {
				_gthis.mouthIndex = mouthLength - 1;
			}
			_gthis.character.changeMouth(_gthis.mouthIndex);
			_gthis.priceUpdate();
		});
		eyesNextBtn.addEventListener("mouseDown",function(e) {
			_gthis.eyesIndex++;
			if(_gthis.eyesIndex >= eyesLength) {
				_gthis.eyesIndex = 0;
			}
			_gthis.character.changeEyes(_gthis.eyesIndex);
			_gthis.priceUpdate();
		});
		eyesPrevBtn.addEventListener("mouseDown",function(e) {
			_gthis.eyesIndex--;
			if(_gthis.eyesIndex < 0) {
				_gthis.eyesIndex = eyesLength - 1;
			}
			_gthis.character.changeEyes(_gthis.eyesIndex);
			_gthis.priceUpdate();
		});
		panel.addEventListener("mouseDown",function(e) {
			Action.instance.ui.blockedClick = true;
		});
		closeBtn.addEventListener("mouseDown",function(e) {
			_gthis.set_visible(false);
		});
		plasticSurgeryOkBtn.addEventListener("mouseDown",function(e) {
			if(Action.instance.ui.characterSmallStats.cashValue >= _gthis.totalPriceValue) {
				Action.instance.npcModel.sendPlasticSurgeryRequest(_gthis.skinIndex,_gthis.mouthIndex,_gthis.eyesIndex);
			} else {
				Action.instance.ui.popupMessage.showMessage(core_i18n_I18n.t("currency.cash_insufficient"));
			}
			_gthis.set_visible(false);
		});
		noThanksBtn.addEventListener("mouseDown",function(e) {
			_gthis.set_visible(false);
		});
		this.set_visible(false);
	}
	priceUpdate() {
		let skinPrice = 0;
		let mouthPrice = 0;
		let eyesPrice = 0;
		if(this.skinIndex != this.oldSkinIndex) {
			skinPrice = 1400;
		}
		if(this.mouthIndex != this.oldMouthIndex) {
			mouthPrice = 400;
		}
		if(this.eyesIndex != this.oldEyesIndex) {
			eyesPrice = 600;
		}
		this.ps_skin_price_text.set_text(core_i18n_I18n.t("price.cash",{ amount : skinPrice}));
		this.ps_eyes_price_text.set_text(core_i18n_I18n.t("price.cash",{ amount : eyesPrice}));
		this.ps_mouth_price_text.set_text(core_i18n_I18n.t("price.cash",{ amount : mouthPrice}));
		this.totalPriceValue = skinPrice + mouthPrice + eyesPrice;
	}
	open() {
		let data = Action.instance.scene.myPlayerSprite.playerConnectionState;
		this.skinIndex = data.skin;
		this.mouthIndex = data.mouth;
		this.eyesIndex = data.eyes;
		this.oldSkinIndex = data.skin;
		this.oldMouthIndex = data.mouth;
		this.oldEyesIndex = data.eyes;
		this.character.changeSkin(this.skinIndex);
		this.character.changeMouth(this.mouthIndex);
		this.character.changeEyes(this.eyesIndex);
		this.priceUpdate();
		this.set_visible(true);
	}
}
