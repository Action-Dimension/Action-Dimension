				let frameBeforeClamp = this.body.get_currentFrame();
				if(this.playEmote(this.activeEmote) && this.body.get_currentFrame() != frameBeforeClamp) {
					this.body.composeRender();
				}
			}
		}
		let h = this.clothesParts.h;
		let part_keys = Object.keys(h);
		let part_length = part_keys.length;
		let part_current = 0;
		while(part_current < part_length) {
			let part = h[part_keys[part_current++]];
			if(part != null) {
				part.updateFrame(delta);
			}
		}
		if(this.jetpackFlameSprite != null) {
			this.jetpackFlameSprite.updateFrame(delta);
		}
	}
	forceEmote(emote,durationMilliseconds) {
		if(durationMilliseconds == null) {
