				if(message == null) {
					message = response.output;
				}
				if(message == null) {
					message = core_i18n_I18n.t("error.unexpected",{ error : ""});
				}
				callback(message,response);
			} else {
				callback(null,response);
			}
		};
		req.onError = function(err) {
			let response = null;
			try {
