	showDetail(skillId) {
		let skill = skillId >= 0 && skillId < skills_SkillCatalog.all.length ? skills_SkillCatalog.all[skillId] : null;
		if(skill == null || this.detail == null) {
			return;
		}
		this.selectedSkillId = skillId;
		this.detail.set_visible(true);
		avatar_view_Skills.setText(this.detail,"text_title",core_i18n_I18n.t("skills.details"));
		avatar_view_Skills.setText(this.detail,"skill_name",core_i18n_I18n.t(skill.nameKey));
		avatar_view_Skills.setText(this.detail,"skill_level",core_i18n_I18n.t("skills.level",{ level : skill.level}));
		avatar_view_Skills.setText(this.detail,"skill_description",core_i18n_I18n.t(skill.descriptionKey));
		avatar_view_Skills.setText(this.detail,"text_staminacost",core_i18n_I18n.t("skills.stamina_cost"));
		let thumb = this.detail.getChildByName("skill_thumb");
		if(thumb != null) {
			thumb.gotoAndStop(skill.icon);
			thumb.special_icon_arrow.set_visible(false);
			thumb.special_icon_lock.set_visible(false);
			thumb.special_icon_disabled.set_visible(false);
		}
		let stamina = this.detail.getChildByName("skill_stamina_cost");
		if(stamina != null) {
			let bar = stamina.getChildByName("stamina_bar");
			if(bar != null) {
				bar.set_scaleX(Math.max(0,Math.min(1,skill.stamina / 20)));
			}
		}
		let id = skill.id;
		let unlocked = id >= 0 && id < 21 && (this.unlockedMask & 1 << id) != 0;
		let highestId = skills_SkillCatalog.highestInBranch(this.unlockedMask,skill.category,skill.branch);
		let highestSkill = highestId >= 0 && highestId < skills_SkillCatalog.all.length ? skills_SkillCatalog.all[highestId] : null;
		let previousReady = skill.level == 1 || highestSkill != null && highestSkill.level >= skill.level - 1;
		let unlockButton = this.detail.getChildByName("skill_detail_button_unlock");
		if(unlockButton != null) {
			unlockButton.set_visible(!unlocked && previousReady);
		}
		avatar_view_Skills.setText(this.detail,"lock_text",unlocked ? core_i18n_I18n.t("skills.unlocked") : previousReady ? core_i18n_I18n.t("skills.remaining",{ count : this.remainingPoints}) : core_i18n_I18n.t("skills.locked_previous"));
		avatar_view_Skills.block();
	}
	setupDetail() {
		if(this.detail == null) {
			return;
		}
		let field = this.detail.getChildByName("skill_name");
		if(field != null) {
			field.set_x(field.get_x() + 80);
		}
		let field1 = this.detail.getChildByName("skill_level");
		if(field1 != null) {
			field1.set_x(field1.get_x() + 80);
		}
		let field2 = this.detail.getChildByName("text_staminacost");
		if(field2 != null) {
			field2.set_x(field2.get_x() + 80);
		}
		let field3 = this.detail.getChildByName("skill_description");
		if(field3 != null) {
			field3.set_x(field3.get_x() + 80);
		}
		let field4 = this.detail.getChildByName("lock_text");
		if(field4 != null) {
