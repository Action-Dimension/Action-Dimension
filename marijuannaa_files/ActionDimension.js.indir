	rememberMiniGameReturnLocation(serverModel) {
		this.miniGameReturnX = null;
		this.miniGameReturnY = null;
		if(serverModel == null || !Action.isWorldMap(serverModel.map)) {
			return;
		}
		this.miniGameReturnMap = serverModel.map;
		if(this.scene == null || this.scene.myPlayerSprite == null) {
			return;
		}
		let x = this.scene.myPlayerSprite.get_x();
		let y = this.scene.myPlayerSprite.get_y();
		if(!isFinite(x) || !isFinite(y)) {
			return;
		}
		this.miniGameReturnX = x;
		this.miniGameReturnY = y;
	}
	miniGameReturnData(token) {
		let data = { map : Action.isWorldMap(this.miniGameReturnMap) ? this.miniGameReturnMap : "map_1", token : token, first_login : false};
		if(this.miniGameReturnX != null && this.miniGameReturnY != null) {
			data.resume_x = this.miniGameReturnX;
			data.resume_y = this.miniGameReturnY;
		}
		return data;
	}
	leavePaintballToMap() {
		let serverModel = this.serverModel;
		if(serverModel == null) {
			return;
		}
		let data = this.miniGameReturnData(serverModel.token);
		serverModel.disconnect();
		this.dispose();
		this.init(data);
	}
