		let skinPrevBtn = this.panel.getChildByName("my_skin_prev");
		let eyesNextBtn = this.panel.getChildByName("my_eyes_next");
		let eyesPrevBtn = this.panel.getChildByName("my_eyes_prev");
		let mouthNextBtn = this.panel.getChildByName("my_mouth_next");
		let mouthPrevBtn = this.panel.getChildByName("my_mouth_prev");
		let hairNextBtn = this.panel.getChildByName("my_hair_next");
		let hairPrevBtn = this.panel.getChildByName("my_hair_prev");
