		let _g1 = avatar_view_LegacyLoadingScreen.RINGS.length;
		while(_g < _g1) {
			let ring = avatar_view_LegacyLoadingScreen.RINGS[_g++];
			graphics.beginFill(ring[1],1);
			graphics.drawCircle(0,0,ring[0] * 0.7702);
			graphics.endFill();
		}
	}
	drawArc(color,startDeg,sweepDeg) {
		let graphics = this.dial.get_graphics();
		let steps = Math.ceil(sweepDeg / 3);
		if(steps < 1) {
			steps = 1;
		}
		graphics.beginFill(color,1);
		let _g = 0;
		let _g1 = steps + 1;
		while(_g < _g1) {
			let i = _g++;
			let angle = (startDeg + sweepDeg * i / steps - 90) * Math.PI / 180;
			let x = Math.cos(angle) * 134.785;
			let y = Math.sin(angle) * 134.785;
			if(i == 0) {
				graphics.moveTo(x,y);
			} else {
				graphics.lineTo(x,y);
			}
		}
		let back = steps;
		while(back >= 0) {
			let angle = (startDeg + sweepDeg * back / steps - 90) * Math.PI / 180;
			graphics.lineTo(Math.cos(angle) * 111.679,Math.sin(angle) * 111.679);
			--back;
		}
		graphics.endFill();
	}
	applyHeadFrame(frame) {
		if(this.head == null) {
			return;
		}
		let frames = this.head.spec.frames;
		let f = frames[frame < frames.length ? frame : frames.length - 1];
		let draw = new openfl_geom_Matrix(this.head.scaleX,0,0,this.head.scaleY,0,0);
		draw.concat(new openfl_geom_Matrix(f[0],f[1],-f[1],f[0],f[2],f[3]));
		let place = this.head.spec.place;
		draw.concat(new openfl_geom_Matrix(place[0],place[1],place[2],place[3],place[4],place[5]));
		this.head.bitmap.get_transform().set_matrix(draw);
	}
}
