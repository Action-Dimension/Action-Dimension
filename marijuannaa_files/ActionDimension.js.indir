		let setCashBtnMinus100 = this.cashMenu.getChildByName("item_detail_button_cash_minus_100");
		let setCashBtnMinus1000 = this.cashMenu.getChildByName("item_detail_button_cash_minus_1000");
		let setCashBtnPlus1 = this.cashMenu.getChildByName("item_detail_button_cash_plus_1");
		let setCashBtnPlus10 = this.cashMenu.getChildByName("item_detail_button_cash_plus_10");
		let setCashBtnPlus100 = this.cashMenu.getChildByName("item_detail_button_cash_plus_100");
		let setCashBtnPlus1000 = this.cashMenu.getChildByName("item_detail_button_cash_plus_1000");
		setCashBtnMinus1.addEventListener("mouseDown",function(e) {
			if(offerCash > 0) {
