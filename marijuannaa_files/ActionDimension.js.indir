			});
			this.categoryDrop.addChild(row);
			this.categoryRows.push(row);
			this.categoryRowLabels.push(rowLabel);
		}
		this.categoryDrop.addEventListener("mouseDown",function(event) {
			event.stopImmediatePropagation();
			avatar_view_Skills.block();
		});
		this.categoryDrop.addEventListener("mouseUp",function(event) {
			event.stopImmediatePropagation();
			avatar_view_Skills.block();
		});
		this.categoryDrop.set_visible(false);
		this.panel.addChild(this.categoryDrop);
	}
	drawSelectorFace(sprite,width,height,selected,main) {
		let graphics = sprite.get_graphics();
		graphics.clear();
		let gradient = new openfl_geom_Matrix();
		gradient.createGradientBox(width,height,Math.PI / 2);
		graphics.lineStyle(1,main ? 5791587 : 12040892,1);
		graphics.beginGradientFill(0,selected ? [14348799,10082302] : main ? [16777215,13882838] : [16777215,15658734],[1,1],[0,255],gradient);
		graphics.drawRoundRect(0,0,width,height,main ? 4 : 2,main ? 4 : 2);
		graphics.endFill();
		if(main) {
			let arrowX = width - 22;
			graphics.lineStyle(1,12040892,1);
			graphics.moveTo(arrowX,1);
			graphics.lineTo(arrowX,height - 1);
			graphics.lineStyle();
			graphics.beginFill(3883075,1);
			graphics.moveTo(width - 15,10);
			graphics.lineTo(width - 7,10);
			graphics.lineTo(width - 11,15);
			graphics.lineTo(width - 15,10);
			graphics.endFill();
		}
	}
	label(x,y,width,height,align,text) {
		if(text == null) {
			text = "";
		}
		let field = new openfl_text_TextField();
		field.set_x(x);
		field.set_y(y);
		field.set_width(width);
		field.set_height(height);
		field.set_selectable(false);
		field.mouseEnabled = false;
		let format = field.get_defaultTextFormat();
		format.set_font("Arial");
		format.set_size(12);
		format.color = 2105376;
		format.align = align;
		field.set_defaultTextFormat(format);
		field.set_text(text);
		return field;
	}
