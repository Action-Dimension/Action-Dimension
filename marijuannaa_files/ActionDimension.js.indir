			if(this._paintball.matchModel.npc_body_type != 0 && p_id > this._paintball.matchModel.bot_player_id_start) {
				targetArmorFrame = this._paintball.matchModel.boss_bot_player_id != p_id ? this._paintball.matchModel.npc_body_type : this._paintball.matchModel.npc_boss_body_type;
			}
			if(currentPlayer.char_loaded) {
				if(currentPlayer.pholder_inner.get_numFrames() < targetArmorFrame) {
					targetArmorFrame = currentPlayer.pholder_inner.get_numFrames();
				}
				if(pl_tmid > 0 && currentPlayer.pholder_inner.get_currentFrame() != targetArmorFrame) {
