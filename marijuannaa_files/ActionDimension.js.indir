		let sprite = Action.instance.scene.createMapObject(name,x,y,tint);
		if(sprite == null) {
			return null;
		}
		sprite.setEditorVisible(showEditor && (this.editAllowed && this.get_visible() && this.panel != null && this.panel.get_visible()));
		Action.instance.scene.mapObjects.push(sprite);
		Action.instance.scene.attachContent(sprite);
