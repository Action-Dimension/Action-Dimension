class avatar_view_PetInfoMenu extends openfl_display_Sprite {
	constructor() {
		super();
		this.panel = openfl_utils_Assets.getMovieClip("sportsbook_lobby:sportsbook_lobby_fla.pet_info_menu_262");
		this.actions = this.panel.getChildByName("pet_info_menu_actions");
		this.setText("text_happiness",core_i18n_I18n.t("pet.happiness"));
		this.setText("text_health",core_i18n_I18n.t("pet.health"));
		this.setText("text_hygiene",core_i18n_I18n.t("pet.hygiene"));
		this.setText("text_mood",core_i18n_I18n.t("pet.mood"));
		this.setTextFrom(this.actions,"text_feed",core_i18n_I18n.t("pet.feed"));
		this.setTextFrom(this.actions,"text_play",core_i18n_I18n.t("pet.play"));
		this.setTextFrom(this.actions,"text_wash",core_i18n_I18n.t("pet.wash"));
		let _gthis = this;
		this.panel.getChildByName("pet_info_menu_close_button").addEventListener("mouseDown",function(_) {
			_gthis.close();
		});
		let feed = this.actions.getChildByName("pet_feed");
		let play = this.actions.getChildByName("pet_play");
		let wash = this.actions.getChildByName("pet_wash");
		feed.addEventListener("mouseDown",function(_) {
			if(_gthis.openedPet == null) {
				return;
			}
			Action.instance.ui.petFeederWindow.open(avatar_model_FoodType.nameOf(_gthis.openedPet.petConnectionState.food_type));
			_gthis.close();
		});
		play.addEventListener("mouseDown",function(_) {
			if(Action.instance.scene != null) {
				Action.instance.scene.lockPetAction();
			}
			Action.instance.petModel.playPet();
			_gthis.close();
		});
		wash.addEventListener("mouseDown",function(_) {
			if(_gthis.openedPet == null || !_gthis.openedPet.isInWater) {
				Action.instance.ui.popupMessage.showMessage(core_i18n_I18n.t("pet.wash_required"));
				return;
			}
			if(Action.instance.scene != null) {
				Action.instance.scene.lockPetAction();
			}
			Action.instance.petModel.washPet(true);
			_gthis.close();
		});
		this.panel.addEventListener("mouseDown",function(_) {
			Action.instance.ui.blockedClick = true;
		});
		this.addChild(this.panel);
		avatar_view_WindowDrag.attachSwf(this.panel);
		this.set_visible(false);
	}
	open(pet,screenX,screenY) {
		if(pet == null || pet.petConnectionState == null) {
			return;
		}
		this.openedPet = pet;
		let data = pet.petConnectionState;
		this.panel.set_x(Math.min(screenX,openfl_Lib.get_current().stage.stageWidth - this.panel.get_width()));
		this.panel.set_y(Math.min(screenY,openfl_Lib.get_current().stage.stageHeight - this.panel.get_height()));
		let isMine = false;
		let room = Action.instance.serverRoomController.room;
		if(room != null) {
			isMine = data.id == room.sessionId;
		}
		this.actions.set_visible(isMine);
		this.set_visible(true);
		this.refresh();
	}
	refresh() {
		if(!this.get_visible() || this.openedPet == null || this.openedPet.petConnectionState == null) {
			return;
		}
		let data = this.openedPet.petConnectionState;
		let nameField = this.text("pet_name");
		nameField.set_text(data.name);
		nameField.set_autoSize(1);
		nameField.set_wordWrap(false);
		nameField.set_multiline(false);
		nameField.set_x(this.text("pet_age_text").get_x() + 19);
		this.text("pet_age_text").set_text(core_i18n_I18n.t("pet.age",{ days : data.age | 0}));
		this.bar("pet_happiness_bar",data.happiness,data.happiness_max);
		this.bar("pet_health_bar",data.health,data.health_max);
		this.bar("pet_hygiene_bar",data.hygiene,data.hygiene_max);
		this.bar("pet_mood_bar",data.mood,100);
	}
	close() {
		this.set_visible(false);
		this.openedPet = null;
	}
	closeIfPet(pet) {
		if(this.openedPet == pet) {
			this.close();
		}
	}
	bar(name,value,maximum) {
		let max = parseFloat(Std.string(maximum));
		let current = parseFloat(Std.string(value));
		let ratio = max > 0 && !isNaN(current);
		this.panel.getChildByName(name).set_scaleX(Math.max(0,Math.min(1,ratio ? current / max : 0)));
	}
	text(name) {
		return this.panel.getChildByName(name);
	}
	setText(name,value) {
		this.text(name).set_text(value);
	}
	setTextFrom(parent,name,value) {
		let field = parent.getChildByName(name);
		field.set_text(value);
		field.mouseEnabled = false;
	}
}
