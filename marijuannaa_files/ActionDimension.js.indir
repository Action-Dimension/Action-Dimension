		let _gthis = this;
		this.emptyAction.set_onClick(function(_) {
			if(!_gthis.busy) {
				_gthis.showCreate();
			}
		});
		this.createButton = this.view.findComponent("createButton",haxe_ui_components_Button);
		this.createButton.set_text(core_i18n_I18n.t("room_browser.create"));
		this.createButton.set_onClick(function(_) {
			if(!_gthis.busy) {
				_gthis.showCreate();
			}
		});
		this.replaysButton = this.view.findComponent("replaysButton",haxe_ui_components_Button);
		this.replaysButton.set_text(core_i18n_I18n.t("replay.open"));
		this.replaysButton.set_onClick(function(_) {
			if(_gthis.busy || _gthis.onReplays == null) {
				return;
			}
			_gthis.dismissError();
			_gthis.onReplays();
		});
		this.refreshButton = this.view.findComponent("refreshButton",haxe_ui_components_Button);
		this.refreshButton.set_text(core_i18n_I18n.t("room_browser.refresh"));
		this.refreshButton.set_onClick(function(_) {
			if(_gthis.busy || _gthis.onRefresh == null) {
				return;
			}
			_gthis.dismissError();
			_gthis.onRefresh();
		});
		this.pageLabel = this.view.findComponent("pageLabel",haxe_ui_components_Label);
		this.prevButton = this.view.findComponent("prevButton",haxe_ui_components_Button);
		this.prevButton.set_onClick(function(_) {
			_gthis.step(-1);
		});
		this.nextButton = this.view.findComponent("nextButton",haxe_ui_components_Button);
		this.nextButton.set_onClick(function(_) {
			_gthis.step(1);
		});
	}
	buildRow() {
