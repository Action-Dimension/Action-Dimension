		c5.set_verticalAlign("center");
		c3.addComponent(c5);
		c2.addComponent(c3);
		let c6 = new haxe_ui_containers_HBox();
		c6.set_height(17.);
		c6.set_percentWidth(100.);
		c6.set_styleString("padding: 0; vertical-spacing: 0; horizontal-spacing: 8px;");
		let c7 = new haxe_ui_components_Label();
		c7.set_id("rowMode");
		c7.set_percentWidth(100.);
		c7.set_text("");
		c7.set_styleString("padding: 0; font-size: 13px; color: #514c3e;");
		c6.addComponent(c7);
		c2.addComponent(c6);
		c01.addComponent(c2);
		let c8 = new haxe_ui_containers_VBox();
		c8.set_width(96.);
		c8.set_height(46.);
		c8.set_styleString("padding: 0; horizontal-spacing: 0; vertical-spacing: 4px;");
		c8.set_verticalAlign("center");
		let c9 = new haxe_ui_containers_Box();
		c9.set_id("rowMeter");
		c9.set_width(96.);
		c9.set_height(14.);
		c9.set_styleString("padding: 0; horizontal-spacing: 0; vertical-spacing: 0;");
		c8.addComponent(c9);
		let c10 = new haxe_ui_components_Label();
		c10.set_id("rowCount");
		c10.set_width(96.);
		c10.set_height(18.);
		c10.set_text("");
		c10.set_styleString("padding: 0; font-name: BilboPro; font-size: 13px; color: #514c3e; text-align: right;");
		c8.addComponent(c10);
		c01.addComponent(c8);
		let c11 = new haxe_ui_components_Button();
		c11.set_id("rowWatch");
		c11.set_width(54.);
		c11.set_height(28.);
		c11.set_text("");
		c11.set_styleString("padding: 0; font-size: 12px; color: #f2f9fc; background-color: #1c557d; border: 2px solid #133b57; border-radius: 8px;");
		c11.set_verticalAlign("center");
		c01.addComponent(c11);
		c0.addComponent(c01);
