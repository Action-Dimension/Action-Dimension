		let overPanel = this.isPointerOverPanel(stageX,stageY);
		this.setDropHighlight(overPanel);
		this.inventoryDropValid = Action.instance.scene.moveSuiteObjectToPointer(this.inventoryDragObject,stageX,stageY,true) && !overPanel;
	}
	onInventoryDragEnd(event) {
		if(this.inventoryDragObject == null) {
			return;
		}
		this.updateInventoryDrag(event.stageX,event.stageY);
		let object = this.inventoryDragObject;
		let invItem = this.inventoryDragItem;
		this.removeInventoryDragListeners();
		this.inventoryDragObject = null;
		this.inventoryDragItem = null;
		this.setDropHighlight(false);
		if(!this.inventoryDropValid) {
			object.disposeEditor();
			Action.instance.scene.detachContent(object);
			HxOverrides.remove(Action.instance.scene.mapObjects,object);
		} else {
			let item = invItem.itemData;
			Action.instance.ui.inventoryItemsData.h[item.id].is_equipped = true;
			this.removedItems.h[item.id] = item;
			object.savePosition();
			object.setEditorVisible(true);
			this.ItemsOrder();
			this.saveCurrentLayout();
		}
		this.inventoryDropValid = false;
		Action.instance.ui.blockedClick = false;
	}
	removeInventoryDragListeners() {
		let stage = openfl_Lib.get_current().stage;
		if(stage == null) {
			return;
		}
		stage.removeEventListener("mouseMove",$bind(this,this.onInventoryDragMove));
		stage.removeEventListener("mouseUp",$bind(this,this.onInventoryDragEnd));
	}
	cancelInventoryDrag() {
		this.removeInventoryDragListeners();
		if(this.inventoryDragObject != null && Action.instance != null && Action.instance.scene != null) {
			this.inventoryDragObject.disposeEditor();
			Action.instance.scene.detachContent(this.inventoryDragObject);
			HxOverrides.remove(Action.instance.scene.mapObjects,this.inventoryDragObject);
		}
		this.inventoryDragObject = null;
		this.inventoryDragItem = null;
		this.inventoryDropValid = false;
		this.setDropHighlight(false);
	}
	ItemsOrder() {
		let itemCount = 0;
		let start = (this.curPage - 1) * 6;
		let end = start + 6;
		let activeItemCount = 0;
		let h = this.items.h;
		let item_keys = Object.keys(h);
		let item_length = item_keys.length;
		let item_current = 0;
		while(item_current < item_length) h[item_keys[item_current++]].item_container.set_visible(false);
		let i = -1;
		let h1 = Action.instance.ui.inventoryItemsData.h;
		let item_keys1 = Object.keys(h1);
		let item_length1 = item_keys1.length;
		let item_current1 = 0;
		while(item_current1 < item_length1) {
			let item = h1[item_keys1[item_current1++]];
			if(Object.prototype.hasOwnProperty.call(this.removedItems.h,item.id)) {
				continue;
			}
			if(item.item_category == "suite_item") {
				if(item.is_equipped == true) {
					continue;
				}
				++i;
				++itemCount;
				if(i < start || i >= end) {
					continue;
				}
				if(activeItemCount > 6) {
					continue;
				}
				this.items.h["inv_item_" + activeItemCount].setItem(item,"suite_item",true);
				this.items.h["inv_item_" + activeItemCount].item_container.set_visible(true);
				++activeItemCount;
			}
		}
		this.maxPage = Math.ceil(itemCount / 6);
		if(this.maxPage < 1) {
			this.maxPage = 1;
		}
		if(this.curPage > this.maxPage) {
			this.curPage = this.maxPage;
		}
		this.pageText.set_text(Std.string(this.curPage) + "/" + Std.string(this.maxPage));
	}
}
