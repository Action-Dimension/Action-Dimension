	buildStatsOverlay() {
		this.statsOverlay = new openfl_display_Sprite();
		this.statsOverlay.set_visible(false);
		this.statsOverlay.mouseEnabled = false;
		this.statsOverlay.mouseChildren = false;
		this.hud.addChild(this.statsOverlay);
		let rows = [{ key : "agility", labelKey : "stat.agility", labelX : 511.85, valueX : 619.85, y : 48.2, labelWidth : 104.1, valueWidth : 43.05},{ key : "toughness", labelKey : "stat.toughness", labelX : 511.85, valueX : 619.85, y : 67.4, labelWidth : 104.55, valueWidth : 42.05},{ key : "intelligence", labelKey : "stat.intelligence", labelX : 511.85, valueX : 619.85, y : 86.65, labelWidth : 105.05, valueWidth : 42.05},{ key : "dexterity", labelKey : "stat.dexterity", labelX : 511.85, valueX : 619.85, y : 105, labelWidth : 104.6, valueWidth : 42.05},{ key : "speed", labelKey : "soccer.stat_speed", labelX : 530.85, valueX : 619.85, y : 136.7, labelWidth : 86.05, valueWidth : 33.6},{ key : "staminaMax", labelKey : "soccer.stat_stamina", labelX : 530.85, valueX : 619.85, y : 155.9, labelWidth : 86.05, valueWidth : 33.1},{ key : "rewardBuff", labelKey : "soccer.stat_reward_buff", labelX : 530.85, valueX : 619.85, y : 175.15, labelWidth : 86.05, valueWidth : 33.1},{ key : "kick", labelKey : "soccer.stat_kick", labelX : 530.85, valueX : 619.85, y : 194.65, labelWidth : 86.1, valueWidth : 33.6}];
		let _g = 0;
		while(_g < rows.length) {
			let row = rows[_g];
			++_g;
			let label = soccer_view_SoccerView.makeText(row.labelX,row.y,row.labelWidth,16,10,16775392,"Arial",3);
			label.set_text(core_i18n_I18n.t(row.labelKey));
			this.statsOverlay.addChild(label);
			let value = soccer_view_SoccerView.makeText(row.valueX,row.y - 0.35,row.valueWidth,16,10,16775392,"Helvetica CE",3);
			this.statsValueFields.h[row.key] = value;
			this.statsOverlay.addChild(value);
		}
	}
	buildHudButtons() {
		let _gthis = this;
		let _g = 0;
		while(_g < 4) {
			let index = _g++;
			let key = soccer_view_SoccerView.makeText(18.9 + index * 44,25.8,14,19,12,16777215,"Arial",4);
			key.set_text(Std.string(index + 1));
			key.set_visible(false);
			this.specialKeyFields.push(key);
			this.hud.addChild(key);
			let hit = soccer_view_SoccerView.transparentHit(30.4 + index * 44,13.4,25,25);
			let slot = index;
			hit.addEventListener("click",function(_event) {
				if(_gthis.onSpecialPressed != null) {
					_gthis.onSpecialPressed(slot);
				}
			});
			hit.addEventListener("mouseOver",function(_event) {
				_gthis.showSpecialDetail(slot,true);
			});
			hit.addEventListener("mouseOut",function(_event) {
				_gthis.showSpecialDetail(slot,false);
			});
			hit.set_visible(false);
			this.specialHitAreas.push(hit);
			this.hud.addChild(hit);
			let tooltip = new openfl_display_Sprite();
			tooltip.mouseEnabled = false;
			tooltip.mouseChildren = false;
			tooltip.set_visible(false);
			let tooltipName = soccer_view_SoccerView.makeText(21.95 + index * 44,42.3,123.5,18.15,12,16777215,"Arial",0);
			this.specialTooltipNameFields.push(tooltipName);
			tooltip.addChild(tooltipName);
			let tooltipUsage = soccer_view_SoccerView.makeText(21.95 + index * 44,58.55,123.25,47,11,13421772,"Arial",0);
			tooltipUsage.set_wordWrap(true);
			tooltipUsage.set_multiline(true);
			tooltipUsage.set_text(core_i18n_I18n.t("soccer.special_usage",{ key : Std.string(index + 1)}));
			tooltip.addChild(tooltipUsage);
			this.specialTooltipOverlays.push(tooltip);
			this.hud.addChild(tooltip);
		}
		let statsHit = soccer_view_SoccerView.transparentHit(614,8,34,22);
		statsHit.addEventListener("click",function(_event) {
			_gthis.model.statsOpen = !_gthis.model.statsOpen;
			_gthis.refreshStats();
		});
		this.hud.addChild(statsHit);
		this.trainingOkHit = soccer_view_SoccerView.transparentHit(294.65,288,135,22);
		this.trainingOkHit.set_visible(false);
		this.trainingOkHit.addEventListener("click",function(_event) {
			if(_gthis.onTrainingOk != null) {
				_gthis.onTrainingOk();
			}
		});
		this.hud.addChild(this.trainingOkHit);
		let infoRows = [{ key : "soccer.info_speed", y : 143.35},{ key : "soccer.info_stamina", y : 162.35},{ key : "soccer.info_reward_buff", y : 181.35},{ key : "soccer.info_kick", y : 200.35}];
		let _g1 = 0;
		while(_g1 < infoRows.length) {
			let row = infoRows[_g1];
			++_g1;
			let hit = soccer_view_SoccerView.transparentHit(511.65,row.y - 7,16,16);
			let textKey = row.key;
			hit.addEventListener("mouseOver",function(event) {
				_gthis.openCursorInfo(core_i18n_I18n.t(textKey),event.stageX,event.stageY);
			});
			hit.addEventListener("mouseOut",function(_event) {
				_gthis.closeCursorInfo();
			});
			hit.set_visible(false);
			this.infoHitAreas.push(hit);
			this.hud.addChild(hit);
		}
		this.buildCursorInfoPop();
		this.exitButton = soccer_view_SoccerView.makeExitButton();
		this.exitButton.addEventListener("click",function(_event) {
			if(_gthis.onExitPressed != null) {
				_gthis.onExitPressed();
			}
		});
		this.hud.addChild(this.exitButton);
