	setupDurationSelector() {
		this.durationOptions = [{ hours : 24, fee : 50, label : core_i18n_I18n.t("market.duration_option",{ days : 1, fee : 50})},{ hours : 72, fee : 125, label : core_i18n_I18n.t("market.duration_option",{ days : 3, fee : 125})},{ hours : 168, fee : 250, label : core_i18n_I18n.t("market.duration_option",{ days : 7, fee : 250})}];
		this.durationCombo = this.listingDialog.getChildByName("item_list_duration_combo");
		if(this.durationCombo == null) {
			return;
		}
		let bounds = this.durationCombo.getBounds(this.listingDialog);
		this.durationCombo.stop();
		this.durationCombo.gotoAndStop(1);
		this.durationCombo.visible = false;
		this.durationCombo.alpha = 0;
		this.durationCombo.mouseEnabled = false;
		this.durationCombo.mouseChildren = false;
		if(this.durationCombo.parent != null) {
			this.durationCombo.parent.removeChild(this.durationCombo);
		}
		let comboWidth = Math.max(145,Math.min(190,bounds.width));
		let comboHeight = 22;
		let durationButton = new openfl_display_Sprite();
		durationButton.set_x(bounds.x);
		durationButton.set_y(bounds.y);
		durationButton.get_graphics().lineStyle(1,9141085);
		durationButton.get_graphics().beginFill(16117721);
		durationButton.get_graphics().drawRoundRect(0,0,comboWidth,comboHeight,5,5);
		durationButton.get_graphics().endFill();
		durationButton.get_graphics().moveTo(comboWidth - 25,0);
		durationButton.get_graphics().lineTo(comboWidth - 25,comboHeight);
		durationButton.get_graphics().beginFill(3282958);
		durationButton.get_graphics().moveTo(comboWidth - 17,9.);
		durationButton.get_graphics().lineTo(comboWidth - 9,9.);
		durationButton.get_graphics().lineTo(comboWidth - 13,14.);
		durationButton.get_graphics().lineTo(comboWidth - 17,9.);
		durationButton.get_graphics().endFill();
		durationButton.set_buttonMode(true);
		let _gthis = this;
		durationButton.addEventListener("mouseDown",function(_) {
			_gthis.priceMenu.set_visible(false);
			_gthis.durationMenu.set_visible(!_gthis.durationMenu.get_visible());
			if(_gthis.durationMenu.get_visible()) {
				_gthis.listingDialog.setChildIndex(_gthis.durationMenu,_gthis.listingDialog.get_numChildren() - 1);
			}
		});
		this.listingDialog.addChild(durationButton);
		this.durationValueText = new openfl_text_TextField();
		this.durationValueText.set_defaultTextFormat(new openfl_text_TextFormat("_sans",11,3282958));
		this.durationValueText.set_x(bounds.x + 7);
		this.durationValueText.set_y(bounds.y + 2. - 1);
		this.durationValueText.set_width(comboWidth - 23);
		this.durationValueText.set_height(18);
		this.durationValueText.mouseEnabled = false;
		this.durationValueText.set_selectable(false);
		this.listingDialog.addChild(this.durationValueText);
		this.durationMenu = new openfl_display_Sprite();
		this.durationMenu.set_x(bounds.x);
		this.durationMenu.set_y(bounds.y + comboHeight);
		let _g = 0;
		let _g1 = this.durationOptions.length;
		while(_g < _g1) {
			let index = _g++;
			this.addDurationOptionRow(this.durationOptions[index],index,comboWidth);
		}
		this.durationMenu.set_visible(false);
		this.listingDialog.addChild(this.durationMenu);
		this.selectDuration(this.durationOptions[0]);
	}
	addDurationOptionRow(option,index,width) {
		let row = new openfl_display_Sprite();
		row.set_y(index * 22);
		row.get_graphics().lineStyle(1,9141085);
		row.get_graphics().beginFill(16117721);
		row.get_graphics().drawRect(0,0,width,22);
		row.get_graphics().endFill();
		row.set_buttonMode(true);
		let label = new openfl_text_TextField();
		label.set_defaultTextFormat(new openfl_text_TextFormat("_sans",11,3282958));
		label.set_x(7);
		label.set_y(2);
		label.set_width(width - 12);
		label.set_height(18);
		label.set_text(option.label);
		label.mouseEnabled = false;
		label.set_selectable(false);
		row.addChild(label);
		let _gthis = this;
		row.addEventListener("mouseDown",function(_) {
			_gthis.selectDuration(option);
		});
		this.durationMenu.addChild(row);
	}
	selectDuration(option) {
		this.listingDurationHours = option.hours;
		this.listingFee = option.fee;
		if(this.durationValueText != null) {
			this.durationValueText.set_text(option.label);
		}
		if(this.durationMenu != null) {
			this.durationMenu.set_visible(false);
		}
	}
	bindPriceButton(name,delta) {
		let _gthis = this;
		this.priceMenu.getChildByName(name).addEventListener("mouseDown",function(_) {
			_gthis.listingPrice = Math.max(1,Math.min(1000000000,_gthis.listingPrice + delta)) | 0;
			_gthis.updatePriceText();
		});
	}
	bindPagingButton(name,handler) {
		let button = this.panel.getChildByName(name);
		if(button != null) {
			button.addEventListener("mouseDown",function(_) {
				handler();
			});
		}
	}
	setText(container,name,value) {
		let field = container.getChildByName(name);
		if(field != null) {
			field.set_text(value);
			field.mouseEnabled = false;
		}
	}
	open() {
		this.set_visible(true);
		Action.instance.ui.blockedClick = true;
		this.inventoryPage = 1;
		this.marketPage = 1;
		this.activeTab = 0;
		this.inventoryTabs.gotoAndStop(1);
		this.listingDialog.set_visible(false);
		this.loading.set_visible(true);
		this.orderInventory();
		this.requestListings();
	}
	close() {
		this.set_visible(false);
		this.listingDialog.set_visible(false);
		this.priceMenu.set_visible(false);
		if(this.durationMenu != null) {
			this.durationMenu.set_visible(false);
		}
		Action.instance.ui.inventoryItemDetails.close();
	}
	requestListings() {
		Action.instance.npcModel.getMarketListings();
	}
	loadListings(data) {
		this.listings = data.items == null ? [] : data.items;
		this.loading.set_visible(false);
		if(this.marketPage < 1) {
			this.marketPage = 1;
		}
		this.orderMarket();
	}
	openListingDialog(item) {
		if(item == null || item.is_equipped == true) {
			return;
		}
		if(avatar_view_ItemTransferPolicy.isTransferBlocked(item)) {
			Action.instance.ui.popupMessage.showMessage(core_i18n_I18n.t("market.crystal_blocked_client"));
			return;
		}
		this.listingItem = item;
		this.listingPrice = Math.max(1,item.price == null ? 0 : item.price) | 0;
		this.setText(this.listingDialog,"item_name",core_i18n_I18n.itemName(item));
		if(this.durationOptions != null && this.durationOptions.length > 0) {
			this.selectDuration(this.durationOptions[0]);
		}
		this.updatePriceText();
		this.priceMenu.set_visible(false);
		this.listingDialog.set_visible(true);
		this.panel.setChildIndex(this.listingDialog,this.panel.get_numChildren() - 1);
	}
	handleResult(data) {
		Action.instance.ui.transferLoader.set_visible(false);
		if(!data.success && this.get_visible()) {
			this.requestListings();
		}
	}
	handleSale(data) {
		if(this.get_visible()) {
			this.requestListings();
		}
	}
	ItemsOrder() {
		this.orderInventory();
		this.orderMarket();
	}
	updatePriceText() {
		this.listingPriceText.set_text(Std.string(this.listingPrice));
		this.priceMenuText.set_text(Std.string(this.listingPrice));
		this.layoutPriceRow();
	}
	layoutPriceRow() {
		if(this.listingPriceLabel == null || this.listingPriceText == null) {
			return;
		}
		this.listingPriceText.set_x(this.listingPriceLabel.get_x() + this.listingPriceLabel.get_textWidth() + 8);
		if(this.listingPriceIcon != null) {
			this.listingPriceIcon.set_x(this.listingPriceText.get_x() + Math.max(32,this.listingPriceText.get_textWidth() + 6));
			if(this.listingPriceButton != null) {
				let tmp = this.listingPriceIcon.get_x() + this.listingPriceIcon.get_width();
				this.listingPriceButton.x = tmp + 10;
			}
		}
		if(this.listingPriceButton != null && this.listingPriceButtonLabel != null) {
			let buttonBounds = this.listingPriceButton.getBounds(this.listingDialog);
			this.listingPriceButtonLabel.set_x(buttonBounds.x);
			this.listingPriceButtonLabel.set_y(buttonBounds.y + (buttonBounds.height - this.listingPriceButtonLabel.get_height()) / 2);
			this.listingPriceButtonLabel.set_width(buttonBounds.width);
			this.listingPriceButtonLabel.set_visible(true);
		}
	}
	orderInventory() {
		let h = this.inventoryItems.h;
		let slot_keys = Object.keys(h);
		let slot_length = slot_keys.length;
		let slot_current = 0;
		while(slot_current < slot_length) h[slot_keys[slot_current++]].item_container.set_visible(false);
		let filtered = [];
		let h1 = Action.instance.ui.inventoryItemsData.h;
		let item_keys = Object.keys(h1);
		let item_length = item_keys.length;
		let item_current = 0;
		while(item_current < item_length) {
			let item = h1[item_keys[item_current++]];
			if(item.is_equipped == true) {
				continue;
			}
			if(avatar_view_ItemTransferPolicy.isTransferBlocked(item)) {
				continue;
			}
			if(this.activeTab == 0 || this.categoryFor(item) == this.activeTab) {
				filtered.push(item);
			}
		}
		this.inventoryMaxPage = Math.max(1,Math.ceil(filtered.length / 9)) | 0;
		if(this.inventoryPage > this.inventoryMaxPage) {
			this.inventoryPage = this.inventoryMaxPage;
		}
		let start = (this.inventoryPage - 1) * 9;
		let visibleCount = Math.min(9,filtered.length - start) | 0;
		let _g = 0;
		while(_g < visibleCount) {
			let index = _g++;
			let slot = this.inventoryItems.h["inv_item_" + index];
			slot.setItem(filtered[start + index],"market_list",false);
			slot.item_container.set_visible(true);
		}
		this.inventoryPageText.set_text(this.inventoryPage + "/" + this.inventoryMaxPage);
	}
	orderMarket() {
		let h = this.marketItems.h;
		let slot_keys = Object.keys(h);
		let slot_length = slot_keys.length;
		let slot_current = 0;
		while(slot_current < slot_length) h[slot_keys[slot_current++]].item_container.set_visible(false);
		this.marketMaxPage = Math.max(1,Math.ceil(this.listings.length / 9)) | 0;
		if(this.marketPage > this.marketMaxPage) {
			this.marketPage = this.marketMaxPage;
		}
		let start = (this.marketPage - 1) * 9;
		let visibleCount = Math.min(9,this.listings.length - start) | 0;
		let _g = 0;
		while(_g < visibleCount) {
			let index = _g++;
			let item = this.listings[start + index];
			let slot = this.marketItems.h["vend_item_" + index];
			slot.setItem(item,item.is_own == true ? "market_own" : "market_buy",false);
			slot.item_container.set_visible(true);
		}
		this.marketPageText.set_text(this.marketPage + "/" + this.marketMaxPage);
	}
	categoryFor(item) {
		let category = item.item_category;
		if(category.indexOf("handwear") > -1) {
			return 4;
		}
		if(category.indexOf("wear") > -1) {
			return 1;
		}
		if(category.indexOf("modkit") > -1 || category.indexOf("weapon") > -1 || category.indexOf("armor") > -1) {
			return 2;
		}
		if(category.indexOf("suite") > -1) {
			return 3;
		}
		return 4;
	}
}
