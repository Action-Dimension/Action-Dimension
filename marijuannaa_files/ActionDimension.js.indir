		}
		if(this._settingKey) {
			this.txtField.set_htmlText("<high><menu>Press a key to set [ <a href=\"event:cancel\"><b>cancel</b></a> ]</menu></high>");
		} else {
			this.txtField.set_htmlText("<low>" + this.getMapString(false) + "</low>");
			this.txtField.set_autoSize(1);
			this.txtField.setSelection(0,0);
		}
		this.set_width(this.txtField.get_width() + 4);
		this.set_height(this.txtField.get_height());
	}
	getMapString(dolink) {
		let stg = this.console.stage;
		let str = "";
		if(!dolink) {
			str = "<menu> <a href=\"event:close\"><b>X</b></a></menu> Capture key: <menu><a href=\"event:capture\">" + (this.console.get_rollerCaptureKey() != null ? this.console.get_rollerCaptureKey().get_key() : "unassigned") + "</a></menu><br/>";
		}
		let p = new openfl_geom_Point(stg.get_mouseX(),stg.get_mouseY());
		if(stg.areInaccessibleObjectsUnderPoint(p)) {
			str += "<p9>Inaccessible objects detected</p9><br/>";
		}
		let objs = stg.getObjectsUnderPoint(p);
		let stepMap = new haxe_ds_ObjectMap();
		if(objs.length == 0) {
			objs.push(stg);
		}
		let _g = 0;
		while(_g < objs.length) {
			let child = objs[_g];
			++_g;
			let chain = [child];
			let par = child.parent;
			while(par != null) {
				chain.unshift(par);
				par = par.parent;
			}
			let len = chain.length;
			let _g1 = 0;
			while(_g1 < len) {
				let i = _g1++;
				let obj = chain[i];
				if(stepMap.h[obj.__id__] == null) {
					stepMap.set(obj,i);
					let j = i;
					while(j > 0) {
						str += j == 1 ? " ∟" : " -";
						--j;
					}
					let n;
					if(((obj) instanceof openfl_display_DisplayObject)) {
						n = (js_Boot.__cast(obj , openfl_display_DisplayObject)).get_name();
					} else if(Object.prototype.hasOwnProperty.call(obj,"name")) {
						n = obj.name;
					} else {
