		holder.set_scaleY(scale);
		holder.set_x(Math.round((viewportWidth - 720.0 * scale) / 2));
		holder.set_y(Math.round((viewportHeight - 480.0 * scale) / 2));
		holder.addChild(this.view);
		this.addChild(holder);
		this.bindShell();
		this.buildListView();
		this.buildCreateView();
		this.attachDrag(holder);
		this.showList();
