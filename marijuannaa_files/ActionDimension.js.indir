	drawTargetArrow(body,target) {
		let g = this.targetArrow.get_graphics();
		g.clear();
		if(target == null) {
			return;
		}
		let sx = body.x + body.width / 2;
		let sy = body.get_top() - 6;
		let tx = target.x + target.width / 2;
		let ty = target.get_bottom() + 10;
		let angle = -Math.PI / 2;
		if(this.currentStep == 3 || this.currentStep == 7) {
			sx = body.get_left() - 8;
			sy = body.y + body.height / 2;
			tx = target.get_right() + 10;
			ty = target.y + target.height / 2;
			angle = Math.PI;
			if(this.currentStep == 3) {
				sx = body.x + body.width / 2;
				sy = body.get_top() - 8;
				tx = target.get_left() - 10;
				angle = 0;
			}
		} else if(this.currentStep == 4) {
			if(target.intersects(body)) {
				return;
			}
			g.lineStyle(3,15540245,0.95);
			g.drawRoundRect(target.x - 4,target.y - 4,target.width + 8,target.height + 8,8);
			sx = target.get_right() + 40;
			tx = target.get_right() + 10;
			ty = target.y + target.height / 2;
			sy = ty;
			angle = Math.PI;
		}
		g.lineStyle(5,15540245,0.95);
		g.moveTo(sx,sy);
		if(this.currentStep == 3 || this.currentStep == 7) {
			g.lineTo(sx,ty);
		} else {
