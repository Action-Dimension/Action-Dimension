class avatar_view_LevelUp extends openfl_display_Sprite {
	constructor() {
		openfl_events_EventDispatcher._hx_skip_constructor = true;
		super();
		openfl_events_EventDispatcher._hx_skip_constructor = false;
		this._hx_constructor();
	}
	_hx_constructor() {
		this.dexterityPoints = 0;
		this.intelligencePoints = 0;
		this.toughnessPoints = 0;
		this.agilityPoints = 0;
		this.confirming = false;
		super._hx_constructor();
		this.blocker = new openfl_display_Sprite();
		this.blocker.addEventListener("mouseDown",$bind(this,this.stopMouse));
		this.blocker.addEventListener("click",$bind(this,this.stopMouse));
		this.addChild(this.blocker);
		this.panel = openfl_utils_Assets.getMovieClip("sportsbook_lobby:sportsbook_lobby_fla.char_menu_levelup_311");
		this.panel.set_scaleX(1.2);
		this.panel.set_scaleY(1.2);
		this.panel.addEventListener("mouseDown",$bind(this,this.stopMouse));
		this.addChild(this.panel);
		avatar_view_WindowDrag.attachSwf(this.panel);
		this.loading = this.panel.getChildByName("loading");
		if(this.loading != null) {
			this.loading.set_visible(false);
		}
		avatar_view_LevelUp.setVisible(this.panel,"mini_instruction_notification",false);
		avatar_view_WindowHelp.bind(this.panel,"levelup");
		avatar_view_LevelUp.setVisible(this.panel,"levelup_instructions",false);
		this.bindStatButton("char_agility_bonus_plus","agility",1);
		this.bindStatButton("char_toughness_bonus_plus","toughness",1);
		this.bindStatButton("char_intelligence_bonus_plus","intelligence",1);
		this.bindStatButton("char_dexterity_bonus_plus","dexterity",1);
		this.bindStatButton("char_agility_bonus_minus","agility",-1);
		this.bindStatButton("char_toughness_bonus_minus","toughness",-1);
		this.bindStatButton("char_intelligence_bonus_minus","intelligence",-1);
		this.bindStatButton("char_dexterity_bonus_minus","dexterity",-1);
		this.doneButton = this.panel.getChildByName("level_up_done_button");
		if(this.doneButton != null) {
			this.doneButton.gotoAndStop(1);
			this.doneButton.set_buttonMode(true);
			this.doneButton.mouseChildren = false;
			avatar_view_LevelUp.setText(this.doneButton,"text_done",core_i18n_I18n.t("common.done"));
			this.doneButton.addEventListener("click",$bind(this,this.confirmCurrent));
		}
		if(openfl_Lib.get_current().stage != null) {
			openfl_Lib.get_current().stage.addEventListener("resize",$bind(this,this.layout));
		}
		this.layout();
		this.set_visible(false);
	}
	showPending(data,onConfirm) {
		if(data == null || data.levelUpAvailable != true) {
			return;
		}
		if(this.get_visible() && this.pending != null && (this.pending.level | 0) == (data.level | 0)) {
			this.pending = data;
			this.confirmCallback = onConfirm;
			return;
		}
		core_audio_GameAudio.play("level_up");
		this.pending = data;
		this.confirmCallback = onConfirm;
		this.confirming = false;
		this.resetAllocation();
		this.renderPending();
		this.set_visible(true);
		this.layout();
	}
	resolveConfirmation(data) {
		if(data == null) {
			return;
		}
		if(data.error == true) {
			this.confirming = false;
			this.setLoading(false);
			avatar_view_LevelUp.setText(this.panel,"text_woncrystal",core_i18n_I18n.resolve(data));
			return;
		}
		if(data.levelUpAvailable == true) {
			this.pending = data;
			this.confirming = false;
			this.resetAllocation();
			this.renderPending();
			this.set_visible(true);
			this.layout();
			return;
		}
		this.pending = null;
		this.confirming = false;
		this.setLoading(false);
		this.set_visible(false);
	}
	renderPending() {
		this.setLoading(false);
		avatar_view_LevelUp.setText(this.panel,"text_title",core_i18n_I18n.t("levelup.title"));
		avatar_view_LevelUp.setText(this.panel,"text_1bonus",core_i18n_I18n.t("levelup.bonus"));
		avatar_view_LevelUp.setText(this.panel,"text_extrapoint",core_i18n_I18n.t("levelup.extra"));
		avatar_view_LevelUp.setText(this.panel,"text_agility",core_i18n_I18n.t("stat.agility"));
		avatar_view_LevelUp.setText(this.panel,"text_toughness",core_i18n_I18n.t("stat.toughness"));
		avatar_view_LevelUp.setText(this.panel,"text_intelligence",core_i18n_I18n.t("stat.intelligence"));
		avatar_view_LevelUp.setText(this.panel,"text_dexterity",core_i18n_I18n.t("stat.dexterity"));
		avatar_view_LevelUp.setText(this.panel,"char_agility",Std.string(this.pending.agility));
		avatar_view_LevelUp.setText(this.panel,"char_toughness",Std.string(this.pending.toughness));
		avatar_view_LevelUp.setText(this.panel,"char_intelligence",Std.string(this.pending.intelligence));
		avatar_view_LevelUp.setText(this.panel,"char_dexterity",Std.string(this.pending.dexterity));
		let premiumReward = this.pending.levelUpPremiumCash | 0;
		if(premiumReward <= 0) {
			premiumReward = 1;
		}
		avatar_view_LevelUp.setText(this.panel,"text_woncrystal",core_i18n_I18n.t("levelup.crystal_reward",{ amount : premiumReward}));
		this.updateAllocationTexts();
		avatar_view_LevelUp.setVisible(this.panel,"levelup_instructions",false);
	}
	confirmCurrent(event) {
		event.stopImmediatePropagation();
		if(this.confirming || this.confirmCallback == null) {
			return;
		}
		if(this.remainingPoints() > 0) {
			avatar_view_LevelUp.setText(this.panel,"text_woncrystal",core_i18n_I18n.t("levelup.assign_remaining",{ count : this.remainingPoints()}));
			return;
		}
		this.confirming = true;
		this.setLoading(true);
		this.confirmCallback({ agility : this.agilityPoints, toughness : this.toughnessPoints, intelligence : this.intelligencePoints, dexterity : this.dexterityPoints});
	}
	setLoading(value) {
		if(this.loading != null) {
			this.loading.set_visible(value);
			avatar_view_LevelUp.setText(this.loading,"text_loading",core_i18n_I18n.t("levelup.saving"));
		}
		if(this.doneButton != null) {
			this.doneButton.set_visible(!value);
			this.doneButton.mouseEnabled = !value;
			this.doneButton.set_buttonMode(!value);
			if(!value) {
				avatar_view_LevelUp.setText(this.doneButton,"text_done",core_i18n_I18n.t("common.done"));
			}
		}
	}
	bindStatButton(name,stat,delta) {
		let button = this.panel.getChildByName(name);
		if(button == null) {
			return;
		}
		button.set_visible(true);
		let _gthis = this;
		button.addEventListener("click",function(event) {
			event.stopImmediatePropagation();
			if(!_gthis.confirming) {
				_gthis.adjustStat(stat,delta);
			}
		});
	}
	adjustStat(stat,delta) {
		let current;
		switch(stat) {
		case "agility":
			current = this.agilityPoints;
			break;
		case "dexterity":
			current = this.dexterityPoints;
			break;
		case "intelligence":
			current = this.intelligencePoints;
			break;
		case "toughness":
			current = this.toughnessPoints;
			break;
		default:
			current = 0;
		}
		if(delta > 0 && this.remainingPoints() <= 0) {
			return;
		}
		if(delta < 0 && current <= 0) {
			return;
		}
		switch(stat) {
		case "agility":
			this.agilityPoints += delta;
			break;
		case "dexterity":
			this.dexterityPoints += delta;
			break;
		case "intelligence":
			this.intelligencePoints += delta;
			break;
		case "toughness":
			this.toughnessPoints += delta;
			break;
		}
		this.updateAllocationTexts();
	}
	resetAllocation() {
		this.agilityPoints = 0;
		this.toughnessPoints = 0;
		this.intelligencePoints = 0;
		this.dexterityPoints = 0;
	}
	distributablePoints() {
		let value = this.pending.distributableStatPoints | 0;
		if(value > 0) {
			return value;
		} else {
			return 2;
		}
	}
	automaticBonus() {
		let value = this.pending.automaticStatBonus | 0;
		if(value > 0) {
			return value;
		} else {
			return 1;
		}
	}
	remainingPoints() {
		return this.distributablePoints() - this.agilityPoints - this.toughnessPoints - this.intelligencePoints - this.dexterityPoints;
	}
	updateAllocationTexts() {
		let automatic = this.automaticBonus();
		avatar_view_LevelUp.setText(this.panel,"bonus_points",Std.string(this.remainingPoints()));
		avatar_view_LevelUp.setText(this.panel,"char_agility_bonus",Std.string(automatic + this.agilityPoints));
		avatar_view_LevelUp.setText(this.panel,"char_toughness_bonus",Std.string(automatic + this.toughnessPoints));
		avatar_view_LevelUp.setText(this.panel,"char_intelligence_bonus",Std.string(automatic + this.intelligencePoints));
		avatar_view_LevelUp.setText(this.panel,"char_dexterity_bonus",Std.string(automatic + this.dexterityPoints));
		if(this.doneButton != null) {
			this.doneButton.set_alpha(this.remainingPoints() == 0 ? 1 : 0.55);
		}
		this.updateButtonAlpha("char_agility_bonus_minus",this.agilityPoints > 0);
		this.updateButtonAlpha("char_toughness_bonus_minus",this.toughnessPoints > 0);
		this.updateButtonAlpha("char_intelligence_bonus_minus",this.intelligencePoints > 0);
		this.updateButtonAlpha("char_dexterity_bonus_minus",this.dexterityPoints > 0);
		let canAdd = this.remainingPoints() > 0;
		this.updateButtonAlpha("char_agility_bonus_plus",canAdd);
		this.updateButtonAlpha("char_toughness_bonus_plus",canAdd);
		this.updateButtonAlpha("char_intelligence_bonus_plus",canAdd);
		this.updateButtonAlpha("char_dexterity_bonus_plus",canAdd);
	}
	updateButtonAlpha(name,enabled) {
		let button = this.panel.getChildByName(name);
		if(button != null) {
			button.set_alpha(enabled ? 1 : 0.45);
		}
	}
	stopMouse(event) {
		event.stopImmediatePropagation();
	}
	layout(event) {
		if(openfl_Lib.get_current().stage == null) {
			return;
		}
		let stageWidth = openfl_Lib.get_current().stage.stageWidth;
		let stageHeight = openfl_Lib.get_current().stage.stageHeight;
		this.blocker.get_graphics().clear();
		this.blocker.get_graphics().beginFill(0,0.45);
		this.blocker.get_graphics().drawRect(0,0,stageWidth,stageHeight);
		this.blocker.get_graphics().endFill();
		let bounds = (this.panel.get_numChildren() > 0 ? this.panel.getChildAt(0) : this.panel).getBounds(this.panel);
		this.panel.set_x((stageWidth - bounds.width * this.panel.get_scaleX()) / 2 - bounds.x * this.panel.get_scaleX());
		this.panel.set_y((stageHeight - bounds.height * this.panel.get_scaleY()) / 2 - bounds.y * this.panel.get_scaleY());
	}
	static setText(container,name,value) {
		let field = container.getChildByName(name);
		if(field != null) {
			field.set_text(value);
			field.mouseEnabled = false;
		}
	}
	static setVisible(container,name,value) {
		let child = container.getChildByName(name);
		if(child != null) {
			child.set_visible(value);
		}
	}
}
