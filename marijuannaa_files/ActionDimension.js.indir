	paintThreadCategory(row,category) {
		let complaint = category == "complaint";
		let notice = category == "notice";
		let medium = notice ? 9217469 : complaint ? 13011560 : 10401134;
		let dark = notice ? 3497085 : complaint ? 9194287 : 6848829;
		let icon = row.findComponent("threadIcon",haxe_ui_containers_Box);
		let paper = row.findComponent("threadPaper",haxe_ui_containers_Box);
		let line1 = row.findComponent("threadLine1",haxe_ui_containers_Box);
		let line2 = row.findComponent("threadLine2",haxe_ui_containers_Box);
		let tag = row.findComponent("threadTag",haxe_ui_components_Label);
		if(icon != null) {
			icon.get_customStyle().backgroundColor = notice ? 14411505 : complaint ? 16244176 : 15331548;
			icon.get_customStyle().borderColor = medium;
			icon.invalidateComponent("style",false);
		}
		if(paper != null) {
			paper.get_customStyle().borderColor = dark;
			paper.invalidateComponent("style",false);
		}
		if(line1 != null) {
			line1.get_customStyle().backgroundColor = medium;
			line1.invalidateComponent("style",false);
		}
		if(line2 != null) {
			line2.get_customStyle().backgroundColor = medium;
			line2.invalidateComponent("style",false);
		}
		if(tag != null) {
			tag.get_customStyle().backgroundColor = notice ? 14411505 : complaint ? 15975594 : 14412216;
			tag.get_customStyle().borderColor = medium;
			tag.get_customStyle().color = dark;
			tag.invalidateComponent("style",false);
		}
	}
	bindOpen(row,action) {
		row.registerEvent(haxe_ui_events_MouseEvent.CLICK,function(_) {
			action();
		});
		avatar_view_WindowDrag.pointerCursor(row);
	}
	setText(root,id,value) {
		let label = root.findComponent(id,haxe_ui_components_Label);
		if(label != null) {
			label.set_text(value);
		}
	}
	merged() {
		let items = [];
		let _g = 0;
		let _g1 = this.announcements;
		while(_g < _g1.length) {
			let entry = _g1[_g];
			++_g;
			items.push({ time : this.timeOf(entry.sentAt), announcement : entry, thread : null});
		}
		let _g2 = 0;
		let _g3 = this.threads;
		while(_g2 < _g3.length) {
			let thread = _g3[_g2];
			++_g2;
			items.push({ time : this.timeOf(thread.lastAt), announcement : null, thread : thread});
		}
		items.sort(function(a,b) {
			if(a.time > b.time) {
				return -1;
			} else if(a.time < b.time) {
				return 1;
			} else {
				return 0;
			}
		});
		return items;
	}
	showEmpty(message) {
		if(this.list != null) {
			this.list.removeAllComponents();
		}
		if(this.emptyLabel == null) {
			return;
		}
		this.emptyLabel.set_hidden(false);
		this.emptyLabel.set_text(message);
	}
	timeOf(iso) {
		if(iso == null || iso == "") {
			return 0;
		}
		let value = new Date(iso).getTime();
		if(isNaN(value)) {
			return 0;
		} else {
			return value;
		}
	}
	formatDate(iso) {
		if(iso == null || iso == "") {
			return "";
		}
		try {
			let value = new Date(iso);
			let f = value.getTime();
			if(isNaN(f)) {
				return iso;
			}
			return this.pad(value.getDate()) + "." + this.pad(value.getMonth() + 1) + "." + value.getFullYear() + "  " + this.pad(value.getHours()) + ":" + this.pad(value.getMinutes());
		} catch( _g ) {
			haxe_NativeStackTrace.lastError = _g;
			return iso;
		}
	}
	pad(value) {
		if(value < 10) {
			return "0" + value;
		} else if(value == null) {
			return "null";
		} else {
			return "" + value;
		}
	}
}
