				_gthis.menu.set_visible(false);
				_gthis.refreshBuddyNotification();
			});
		}
		if(skillsOpenBtn != null) {
			skillsOpenBtn.addEventListener("mouseDown",function(e) {
				let ui = Action.instance.ui;
				if(ui.skillsWindow != null) {
					ui.skillsWindow.open();
				}
				_gthis.menu.set_visible(false);
				_gthis.refreshBuddyNotification();
			});
