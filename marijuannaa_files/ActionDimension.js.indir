class avatar_view_PetFeeder extends openfl_display_Sprite {
	constructor() {
		openfl_events_EventDispatcher._hx_skip_constructor = true;
		super();
		openfl_events_EventDispatcher._hx_skip_constructor = false;
		this._hx_constructor();
	}
	_hx_constructor() {
		this.page = 0;
		this.foodType = "animal";
		this.slots = [];
		super._hx_constructor();
		this.panel = openfl_utils_Assets.getMovieClip("sportsbook_lobby:sportsbook_lobby_fla.char_menu_pet_feeder_182");
		this.panel.set_x(openfl_Lib.get_current().stage.stageWidth / 2 - this.panel.get_width() / 2);
		this.panel.set_y(openfl_Lib.get_current().stage.stageHeight / 2 - this.panel.get_height() / 2);
		this.panel.getChildByName("text_pickafood").set_text(core_i18n_I18n.t("pet.pick_food"));
		this.pageText = this.panel.getChildByName("inv_inventory_page_text");
		let slot = new avatar_view_InventoryItem(this.panel.getChildByName("inv_item_" + 0));
		slot.selectionHandler = $bind(this,this.selectFood);
		this.slots.push(slot);
		let slot1 = new avatar_view_InventoryItem(this.panel.getChildByName("inv_item_" + 1));
		slot1.selectionHandler = $bind(this,this.selectFood);
		this.slots.push(slot1);
		let slot2 = new avatar_view_InventoryItem(this.panel.getChildByName("inv_item_" + 2));
		slot2.selectionHandler = $bind(this,this.selectFood);
		this.slots.push(slot2);
		let slot3 = new avatar_view_InventoryItem(this.panel.getChildByName("inv_item_" + 3));
		slot3.selectionHandler = $bind(this,this.selectFood);
		this.slots.push(slot3);
		let slot4 = new avatar_view_InventoryItem(this.panel.getChildByName("inv_item_" + 4));
		slot4.selectionHandler = $bind(this,this.selectFood);
		this.slots.push(slot4);
		let slot5 = new avatar_view_InventoryItem(this.panel.getChildByName("inv_item_" + 5));
		slot5.selectionHandler = $bind(this,this.selectFood);
		this.slots.push(slot5);
		let previous = this.panel.getChildByName("inv_item_prev");
		let next = this.panel.getChildByName("inv_item_next");
		let close = this.panel.getChildByName("char_menu_pet_feeder_close_button");
		let _gthis = this;
		previous.addEventListener("mouseDown",function(_) {
			if(_gthis.page > 0) {
				_gthis.page--;
				_gthis.render();
			}
		});
		next.addEventListener("mouseDown",function(_) {
			if(_gthis.page + 1 < _gthis.pages()) {
				_gthis.page++;
				_gthis.render();
			}
		});
		close.addEventListener("mouseDown",function(_) {
			_gthis.set_visible(false);
		});
		this.panel.addEventListener("mouseDown",function(_) {
			Action.instance.ui.blockedClick = true;
		});
		this.addChild(this.panel);
		avatar_view_WindowDrag.attachSwf(this.panel);
		this.set_visible(false);
	}
	open(type) {
		this.foodType = type == "robot" ? "robot" : "animal";
		this.page = 0;
		this.render();
		this.set_visible(true);
	}
	foods() {
		let result = [];
		let h = Action.instance.ui.inventoryItemsData.h;
		let item_keys = Object.keys(h);
		let item_length = item_keys.length;
		let item_current = 0;
		while(item_current < item_length) {
			let item = h[item_keys[item_current++]];
			if((item.item_category == null ? "null" : "" + item.item_category) == "food_" + this.foodType) {
				result.push(item);
			}
		}
		return result;
	}
	pages() {
		return Math.max(1,Math.ceil(this.foods().length / 6)) | 0;
	}
	render() {
		let data = this.foods();
		let item = this.page * 6 < data.length ? data[this.page * 6] : null;
		this.slots[0].item_container.set_visible(item != null);
		if(item != null) {
			this.slots[0].setItem(item);
		}
		let item1 = 1 + this.page * 6 < data.length ? data[1 + this.page * 6] : null;
		this.slots[1].item_container.set_visible(item1 != null);
		if(item1 != null) {
			this.slots[1].setItem(item1);
		}
		let item2 = 2 + this.page * 6 < data.length ? data[2 + this.page * 6] : null;
		this.slots[2].item_container.set_visible(item2 != null);
		if(item2 != null) {
			this.slots[2].setItem(item2);
		}
		let item3 = 3 + this.page * 6 < data.length ? data[3 + this.page * 6] : null;
		this.slots[3].item_container.set_visible(item3 != null);
		if(item3 != null) {
			this.slots[3].setItem(item3);
		}
		let item4 = 4 + this.page * 6 < data.length ? data[4 + this.page * 6] : null;
		this.slots[4].item_container.set_visible(item4 != null);
		if(item4 != null) {
			this.slots[4].setItem(item4);
		}
		let item5 = 5 + this.page * 6 < data.length ? data[5 + this.page * 6] : null;
		this.slots[5].item_container.set_visible(item5 != null);
		if(item5 != null) {
			this.slots[5].setItem(item5);
		}
		this.pageText.set_text(this.page + 1 + "/" + this.pages());
	}
	selectFood(item) {
		if(item == null) {
			return;
		}
		Action.instance.petModel.feedPet(Std.string(item.id));
		this.set_visible(false);
	}
}
