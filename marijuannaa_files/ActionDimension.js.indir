		let ownPlayerId = Action.instance.scene != null && Action.instance.scene.myPlayerSprite != null && Action.instance.scene.myPlayerSprite.playerConnectionState != null ? Action.instance.scene.myPlayerSprite.playerConnectionState.id : null;
		let tmp;
		if(serverModel != null) {
			let map = serverModel.map;
			tmp = map == "suite1" || map == "suite2" || map == "suite3" || map == "suite4";
		} else {
			tmp = false;
		}
		this.suiteActionsMenu.set_visible(tmp && serverModel.suiteCanEdit && ownPlayerId != null && ownPlayerId != playerId);
	}
}
