	updatePointerFeedback(pointerX,pointerY) {
		let ui = Action.instance != null ? Action.instance.ui : null;
		let candidate = null;
		let petCandidate = null;
		let overInteractive = false;
		if(!(this.world == null || this.camera == null || ui == null || ui.blockedClick || this.mapEditorInteraction != null)) {
