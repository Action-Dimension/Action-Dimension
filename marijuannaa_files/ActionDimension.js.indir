		let _g = 0;
		let _g1 = pelletCount;
		while(_g < _g1) {
			let pelletIndex = _g++;
			let shotRotation = baseAngle + sim_logic_ShotRandom.range(this._paintball.state.playerId,weaponArrayId,commandSequence,pelletIndex,1,accuracy | 0) - (accuracy / 2 | 0);
