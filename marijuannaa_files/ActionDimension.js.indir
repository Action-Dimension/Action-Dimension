	ItemsOrder() {
		let itemCount = 0;
		let start = (this.curPage - 1) * 9;
		let end = start + 9;
		let activeItemCount = 0;
		let h = this.items.h;
		let item_keys = Object.keys(h);
		let item_length = item_keys.length;
		let item_current = 0;
		while(item_current < item_length) h[item_keys[item_current++]].item_container.set_visible(false);
