class avatar_view_PaintballLoadingOverlay extends openfl_display_Sprite {
	constructor() {
		openfl_events_EventDispatcher._hx_skip_constructor = true;
		super();
		openfl_events_EventDispatcher._hx_skip_constructor = false;
		this._hx_constructor();
	}
	_hx_constructor() {
		this.progress = 0;
		super._hx_constructor();
		this.blocker = new openfl_display_Shape();
		this.addChild(this.blocker);
		this.panel = new openfl_display_Sprite();
		this.panel.get_graphics().lineStyle(2,14266746,1);
		this.panel.get_graphics().beginFill(2364431,0.98);
		this.panel.get_graphics().drawRoundRect(0,0,380,168,16,16);
		this.panel.get_graphics().endFill();
		this.addChild(this.panel);
		this.logo = new avatar_view_MinifalLogo(230);
		this.logo.set_x((380 - this.logo.get_width()) / 2);
		this.logo.set_y(13);
		this.panel.addChild(this.logo);
		this.statusText = avatar_view_PaintballLoadingOverlay.makeText(18,84,344.,28,15,true);
		this.statusText.set_text(core_i18n_I18n.t("loading.paintball_files"));
		this.panel.addChild(this.statusText);
		let barBackground = new openfl_display_Shape();
		barBackground.get_graphics().lineStyle(1,9265219,1);
		barBackground.get_graphics().beginFill(919558,1);
		barBackground.get_graphics().drawRoundRect(0,0,300,18,8,8);
		barBackground.get_graphics().endFill();
		barBackground.set_x(20);
		barBackground.set_y(128);
		this.panel.addChild(barBackground);
		this.barFill = new openfl_display_Shape();
		this.barFill.set_x(22);
		this.barFill.set_y(130);
		this.panel.addChild(this.barFill);
		this.percentText = avatar_view_PaintballLoadingOverlay.makeText(328.,127,42,22,12,true);
		this.percentText.set_text("0%");
		this.panel.addChild(this.percentText);
		this.mouseChildren = false;
		this.addEventListener("mouseDown",$bind(this,this.stopMouse));
		this.addEventListener("click",$bind(this,this.stopMouse));
		if(openfl_Lib.get_current().stage != null) {
			openfl_Lib.get_current().stage.addEventListener("resize",$bind(this,this.layout));
		}
		this.set_visible(false);
		this.drawProgress();
		this.layout();
	}
	show(message) {
		this.progress = 0;
		this.statusText.set_text(message == null ? core_i18n_I18n.t("loading.paintball_files") : message);
		this.set_visible(true);
		this.drawProgress();
		this.layout();
	}
	setProgress(value,message) {
		this.progress = Math.max(0,Math.min(1,value));
		if(message != null) {
			this.statusText.set_text(message);
		}
		this.drawProgress();
	}
	setStatus(message) {
		this.statusText.set_text(message);
	}
	hide() {
		this.set_visible(false);
	}
	drawProgress() {
		let fillWidth = 296. * this.progress;
		this.barFill.get_graphics().clear();
		if(fillWidth > 0) {
			this.barFill.get_graphics().beginFill(15227428,1);
			this.barFill.get_graphics().drawRoundRect(0,0,fillWidth,14,6,6);
			this.barFill.get_graphics().endFill();
		}
		this.percentText.set_text((this.progress * 100 | 0) + "%");
	}
	layout(event) {
		if(openfl_Lib.get_current().stage == null) {
			return;
		}
		let stageWidth = openfl_Lib.get_current().stage.stageWidth;
		let stageHeight = openfl_Lib.get_current().stage.stageHeight;
		this.blocker.get_graphics().clear();
		this.blocker.get_graphics().beginFill(0,0.72);
		this.blocker.get_graphics().drawRect(0,0,stageWidth,stageHeight);
		this.blocker.get_graphics().endFill();
		this.panel.set_x((stageWidth - 380) / 2);
		this.panel.set_y((stageHeight - 168) / 2);
	}
	stopMouse(event) {
		event.stopImmediatePropagation();
	}
	static makeText(x,y,width,height,size,bold) {
		let field = new openfl_text_TextField();
		field.set_x(x);
		field.set_y(y);
		field.set_width(width);
		field.set_height(height);
		field.set_selectable(false);
		field.mouseEnabled = false;
		field.set_defaultTextFormat(new openfl_text_TextFormat("_sans",size,16774364,bold,false,false,null,null,0));
		return field;
	}
}
