class sim_logic_CollisionShapes {
	static isBlockedByDynamic(world,x,y) {
		if(world == null) {
			return false;
		}
		let s = world.collisions.iterator();
		while(s.hasNext()) {
			let s1 = s.next();
			if((s1.flags & 1) == 0) {
				continue;
			}
			if(s1.type == 0) {
				if(x >= s1.x && x <= s1.x + s1.w && y >= s1.y && y <= s1.y + s1.h) {
					return true;
				}
			} else if(s1.type == 1) {
				let dx = x - s1.x;
				let dy = y - s1.y;
				if(dx * dx + dy * dy <= s1.w * s1.w) {
					return true;
				}
			}
		}
		return false;
