avatar_model_PetCatalog.SHOP_PETS = (function($this) {
	var $r;
	let _g = [];
	{
		let _g1 = 0;
		let _g2 = avatar_model_PetCatalog.PETS;
		while(_g1 < _g2.length) {
			let pet = _g2[_g1];
			++_g1;
			if(pet.id % 2 == 1) {
				_g.push(pet);
			}
		}
	}
	$r = _g;
	return $r;
}(this));
