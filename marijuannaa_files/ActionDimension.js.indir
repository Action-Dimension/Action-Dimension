		if(this._viewingChannels[0] == "⌂" && (a == null || a[0] != this._viewingChannels[0])) {
			this.console.get_refs().exitFocus();
		}
		this._ignoredChannels.splice(0,this._ignoredChannels.length);
		this._viewingChannels.splice(0,this._viewingChannels.length);
		if(a.indexOf(" * ") < 0 && a.indexOf(null) < 0) {
			let _g = 0;
			while(_g < a.length) {
				let ch = a[_g];
				++_g;
				if(ch != null) {
					this._viewingChannels.push(ch);
				}
			}
		}
		this.updateToBottom();
		this.console.get_panels().updateMenu();
	}
	setIgnoredChannels(...channels) {
		let a = [];
		let _g_current = 0;
		while(_g_current < channels.length) a.push(com_junkbyte_console_Console.MakeChannelName(channels[_g_current++]));
		if(this._viewingChannels[0] == "⌂") {
			this.console.get_refs().exitFocus();
		}
		this._ignoredChannels.splice(0,this._ignoredChannels.length);
		this._viewingChannels.splice(0,this._viewingChannels.length);
		if(a.indexOf(" * ") < 0 && a.indexOf(null) < 0) {
			let _g = 0;
