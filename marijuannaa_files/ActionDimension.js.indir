		g.lineTo(this.get_width() - this.startOffset,value);
		return value;
	}
	update(group,draw) {
		this._group = group;
		let push = 1;
		if(group.idle > 0) {
			push = 0;
			if(!this._needRedraw) {
				return;
			}
		}
		if(this._needRedraw) {
			draw = true;
		}
		this._needRedraw = false;
