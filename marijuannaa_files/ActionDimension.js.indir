class avatar_view_PopupMessage extends openfl_display_Sprite {
	constructor() {
		super();
		let panel = openfl_utils_Assets.getMovieClip("sportsbook_lobby:sportsbook_lobby_fla.popup_message_31");
		panel.set_x(openfl_Lib.get_current().stage.stageWidth / 2 - 343.8 + 350);
		panel.set_y(openfl_Lib.get_current().stage.stageHeight / 2 - 244.799999999999983 + 240);
		panel.set_scaleX(1.2);
		panel.set_scaleY(1.2);
		this.textMessage = panel.getChildByName("errortext");
		this.textMessage.set_selectable(false);
		this.textMessage.set_text("Text Message");
		let _gthis = this;
		panel.getChildByName("okbutton").addEventListener("mouseDown",function(e) {
			if(Action.instance.ui != null) {
				Action.instance.ui.blockedClick = true;
			}
			_gthis.set_visible(false);
		});
		this.addChild(panel);
		avatar_view_WindowDrag.attachSwf(panel,16);
		this.set_visible(false);
	}
	showMessage(text) {
		if(Action.instance.ui != null) {
			Action.instance.ui.blockedClick = true;
		}
		this.textMessage.set_text(text);
		this.set_visible(true);
	}
	showPayload(data) {
		if(data == null) {
