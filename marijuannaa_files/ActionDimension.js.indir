			if(data.tmid == 1) {
				playerClip.set_x(this._paintball.mapModel.spawn_point_x_1);
				playerClip.set_y(this._paintball.mapModel.spawn_point_y_1);
				data.target_x = this._paintball.mapModel.spawn_point_x_1;
				data.target_y = this._paintball.mapModel.spawn_point_y_1;
			} else {
				playerClip.set_x(this._paintball.mapModel.spawn_point_x_2);
				playerClip.set_y(this._paintball.mapModel.spawn_point_y_2);
				data.target_x = this._paintball.mapModel.spawn_point_x_2;
				data.target_y = this._paintball.mapModel.spawn_point_y_2;
			}
			data.teleport = false;
			data.speed = this._paintball.state.my_player_speed;
