				c7.set_text("DUYURU");
				c7.set_styleString("padding: 3px; padding-left: 8px; padding-right: 8px; font-size: 11px; color: #6d5014; background-color: #fae1a3; border: 1px solid #c8a75f; border-radius: 7px; font-bold: true;");
				c7.set_verticalAlign("center");
				c6.addComponent(c7);
				let c8 = new haxe_ui_components_Label();
				c8.set_id("annDate");
				c8.set_percentWidth(100.);
				c8.set_text("");
				c8.set_styleString("padding: 0; font-size: 11px; color: #8b7b5b; text-align: right;");
				c8.set_verticalAlign("center");
				c6.addComponent(c8);
				c5.addComponent(c6);
				let c9 = new haxe_ui_components_Label();
				c9.set_id("annText");
				c9.set_percentWidth(100.);
				c9.set_text("");
				c9.set_styleString("padding: 0; font-size: 15px; color: #33280f; word-wrap: true;");
