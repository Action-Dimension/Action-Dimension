class avatar_view_SuiteHelp extends openfl_display_Sprite {
	constructor() {
		openfl_events_EventDispatcher._hx_skip_constructor = true;
		super();
		openfl_events_EventDispatcher._hx_skip_constructor = false;
		this._hx_constructor();
	}
	_hx_constructor() {
		this.layoutKey = "";
		super._hx_constructor();
		this.mouseEnabled = false;
		this.mouseChildren = false;
		this.clip = openfl_utils_Assets.getMovieClip("sportsbook_lobby:sportsbook_lobby_fla.suite_interactive_help_inner_401");
		this.clip.stop();
		this.addChild(this.clip);
		let text = this.clip.getChildByName("text_suite_help");
		text.set_multiline(text.set_wordWrap(true));
		text.set_defaultTextFormat(new openfl_text_TextFormat("_sans",12,3355443));
		text.set_text(core_i18n_I18n.t("help.room_short"));
		text.setTextFormat(text.get_defaultTextFormat());
		this.set_visible(false);
	}
	pointAt(button) {
		if(this.stage == null || button == null) {
			return;
		}
		let target = button.getBounds(this);
		let bounds = this.clip.getChildAt(0).getBounds(this.clip);
		let scale = Math.min(1.2,(this.stage.stageWidth - 40) / bounds.width);
		let x = target.get_right() + 8 + 166.4 * scale;
		let y = target.y + target.height / 2 + 25.25 * scale;
		x = Math.max(20 - bounds.get_left() * scale,Math.min(x,this.stage.stageWidth - 20 - bounds.get_right() * scale));
		y = Math.max(54 - bounds.get_top() * scale,Math.min(y,this.stage.stageHeight - 20 - bounds.get_bottom() * scale));
		let key = [x,y,scale].join(":");
		if(key == this.layoutKey) {
			return;
		}
		this.layoutKey = key;
		this.clip.set_scaleX(this.clip.set_scaleY(scale));
		this.clip.set_x(x);
		this.clip.set_y(y);
	}
}
