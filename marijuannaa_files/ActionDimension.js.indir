class com_junkbyte_console_view_GraphingPanel extends com_junkbyte_console_view_ConsolePanel {
	constructor(m,W,H,type) {
		openfl_events_EventDispatcher._hx_skip_constructor = true;
		super();
		openfl_events_EventDispatcher._hx_skip_constructor = false;
		this._hx_constructor(m,W,H,type);
	}
	_hx_constructor(m,W,H,type) {
		this.startOffset = 5;
		this._infoMap = new haxe_ds_StringMap();
		super._hx_constructor(m);
		this._type = type;
		this.registerDragger(this.bg);
		this.minWidth = 32;
		this.minHeight = 26;
		let textFormat = new openfl_text_TextFormat();
		let lowStyle = this.get_style().get_styleSheet().getStyle("low");
		textFormat.set_font(lowStyle.fontFamily);
		textFormat.set_size(lowStyle.fontSize);
		textFormat.color = this.get_style().lowColor;
		this.lowTxt = new openfl_text_TextField();
		this.lowTxt.set_name("lowestField");
		this.lowTxt.set_defaultTextFormat(textFormat);
		this.lowTxt.mouseEnabled = false;
		this.lowTxt.set_height(this.get_style().menuFontSize + 2);
		this.addChild(this.lowTxt);
		this.highTxt = new openfl_text_TextField();
		this.highTxt.set_name("highestField");
		this.highTxt.set_defaultTextFormat(textFormat);
		this.highTxt.mouseEnabled = false;
		this.highTxt.set_height(this.get_style().menuFontSize + 2);
		this.highTxt.set_y(this.get_style().menuFontSize - 4);
		this.addChild(this.highTxt);
		this.txtField = this.makeTF("menuField");
		this.txtField.set_height(this.get_style().menuFontSize + 4);
		this.txtField.set_y(-3);
		this.txtField.set_selectable(false);
		this.registerTFRoller(this.txtField,$bind(this,this.onMenuRollOver),$bind(this,this.linkHandler));
		this.registerDragger(this.txtField);
		this.addChild(this.txtField);
		this.underlay = new openfl_display_Shape();
		this.addChild(this.underlay);
		this.graph = new openfl_display_Shape();
		this.graph.set_name("graph");
		this.graph.set_y(this.get_style().menuFontSize);
		this.addChild(this.graph);
