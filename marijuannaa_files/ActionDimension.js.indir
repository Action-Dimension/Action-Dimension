			let selected = category == this.selectedCategory;
			this.drawSelectorFace(this.categoryRows[category],158,24,selected,false);
			this.categoryRowLabels[category].set_text((selected ? "✓  " : "    ") + this.categoryName(category));
			let format = this.categoryRowLabels[category].get_defaultTextFormat();
			format.set_bold(selected);
			this.categoryRowLabels[category].set_defaultTextFormat(format);
			this.categoryRowLabels[category].setTextFormat(format);
		}
		let highest = [];
		let _g2 = 0;
		let _g3 = skills_SkillCatalog.inCategory(this.selectedCategory);
		while(_g2 < _g3.length) {
			let skill = _g3[_g2];
			++_g2;
			if(highest[skill.branch] == null) {
				highest[skill.branch] = 0;
			}
			let id = skill.id;
			if(id >= 0 && id < 21 && (this.unlockedMask & 1 << id) != 0 && skill.level > highest[skill.branch]) {
				highest[skill.branch] = skill.level;
			}
		}
		let _g4 = 0;
		let _g5 = skills_SkillCatalog.inCategory(this.selectedCategory);
		while(_g4 < _g5.length) {
			let skill = _g5[_g4];
			++_g4;
			this.addSkillIcon(skill,highest[skill.branch] < skill.level - 1);
		}
	}
	addSkillIcon(skill,disabled) {
		let icon = new Special_$icons_$big();
		icon.gotoAndStop(skill.icon);
		icon.set_x(75 * skill.level - 45);
		icon.set_y(60 * skill.branch);
		icon.special_icon_arrow.gotoAndStop(skill.level == 1 ? 2 : 1);
		let id = skill.id;
		icon.special_icon_lock.set_visible(!(id >= 0 && id < 21 && (this.unlockedMask & 1 << id) != 0));
		icon.special_icon_disabled.set_visible(disabled);
		icon.mouseChildren = false;
		icon.set_buttonMode(true);
		let skillId = skill.id;
		let _gthis = this;
		icon.addEventListener("mouseUp",function(_) {
