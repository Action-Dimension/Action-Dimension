			let staminaCost = this.special_array[this.picked_special_move][4];
			if(this.special_move_rate_backup < this._paintball.frameModel.sim_time) {
				if(this.my_player_stamina >= staminaCost) {
					this.my_player_stamina -= staminaCost;
					this.special_move_rate_backup = this._paintball.frameModel.sim_time + this.special_move_rate;
					this.fire_special_move_request = this.picked_special_move;
					this.picked_special_move = -1;
				} else {
					atlas_AtlasTools.child(this.player(this._paintball.state.playerId).stamina_indicator,"stamina_insufficent").gotoAndPlay(1);
