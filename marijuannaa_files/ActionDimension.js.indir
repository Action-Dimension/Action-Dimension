class paintball_model_CameraModel {
	constructor(paintball) {
		this.camera_distance = 0;
		this.camera_focus_divider = 0;
		this.camera_zoom_speed = 0;
		this.camera_distance_min = 0;
		this.camera_distance_max = 0;
		this.screen_height = 0;
		this.screen_width = 0;
		this.depthItems = [];
		this._paintball = paintball;
	}
	init() {
	}
	initTimelineState() {
		this.screen_width = 735;
		this.screen_height = 450;
		this.camera_distance_max = 1;
		this.camera_distance_min = 0.7;
		this.camera_zoom_speed = 0.01;
		this.camera_focus_divider = 0;
		this.camera_distance = 1;
	}
	focus_camera(focusPl,x,y) {
		let smoothFactor = 10;
		let focusX = 0;
		let focusY = 0;
		if(this._paintball.inputModel.zoomin_pressed) {
			this.camera_distance += this.camera_zoom_speed;
		}
		if(this._paintball.inputModel.zoomout_pressed) {
			this.camera_distance -= this.camera_zoom_speed;
		}
		if(this._paintball.bg.get_scaleX() != this.camera_distance) {
			if(this.camera_distance > this.camera_distance_max) {
				this.camera_distance = this.camera_distance_max;
			}
			if(this.camera_distance < this.camera_distance_min) {
				this.camera_distance = this.camera_distance_min;
			}
			this._paintball.bg.set_scaleX(this.camera_distance);
			this._paintball.bg.set_scaleY(this.camera_distance);
			smoothFactor = 2;
		}
		if(focusPl == 0) {
			if(x < 0) {
				if(this._paintball.playerModel.getPlayer(this._paintball.state.playerId).tmid == 1) {
					focusX = this._paintball.mapModel.spawn_point_x_1;
					focusY = this._paintball.mapModel.spawn_point_y_1;
				} else {
					focusX = this._paintball.mapModel.spawn_point_x_2;
					focusY = this._paintball.mapModel.spawn_point_y_2;
				}
			} else {
				focusX = x;
				focusY = y;
			}
		} else {
			let focusPlayer = this._paintball.playerModel.player(focusPl);
			if(focusPlayer != null) {
				focusX = focusPlayer.get_x();
				focusY = focusPlayer.get_y();
			}
		}
		let focusScreenX = this._paintball.bg.get_x() + focusX * this._paintball.bg.get_scaleX();
		let focusScreenY = this._paintball.bg.get_y() + focusY * this._paintball.bg.get_scaleY();
		this._paintball.bg.set_x(this._paintball.bg.get_x() + (this._paintball.state.stage_width / 2 - focusScreenX) / smoothFactor);
		this._paintball.bg.set_y(this._paintball.bg.get_y() + (this._paintball.state.stage_height / 2 - focusScreenY) / smoothFactor);
		if(this._paintball.bg.get_x() > 0) {
			this._paintball.bg.set_x(0);
		}
		if(this._paintball.bg.get_y() > 0) {
			this._paintball.bg.set_y(0);
		}
		let background = this._paintball.tileWorld != null ? this._paintball.tileWorld.background : null;
		if(background != null) {
			let backgroundBounds = background.getBounds(this._paintball.tileWorld.content);
			if(this._paintball.bg.get_x() < (backgroundBounds.width - this.screen_width) * -1) {
				this._paintball.bg.set_x((backgroundBounds.width - this.screen_width) * -1);
			}
			if(this._paintball.bg.get_y() < (backgroundBounds.height - this.screen_height) * -1) {
				this._paintball.bg.set_y((backgroundBounds.height - this.screen_height) * -1);
			}
		}
		if(this._paintball.small_map != null) {
			let small_map_inner = this._paintball.small_map.getChildByName("small_map_inner");
			if(small_map_inner != null) {
				let small_map_bitmap_mc = small_map_inner.getChildByName("small_map_bitmap_mc");
				if(small_map_bitmap_mc != null) {
					small_map_inner.set_x(this._paintball.bg.get_x() / 20 + 25);
					small_map_inner.set_y(this._paintball.bg.get_y() / 20 + 25);
					if(small_map_inner.get_x() > 0) {
						small_map_inner.set_x(0);
					}
					if(small_map_inner.get_y() > 0) {
						small_map_inner.set_y(0);
					}
					if(small_map_inner.get_x() < (small_map_bitmap_mc.get_width() - 80) * -1) {
