	switchView(next) {
		let _g = 0;
		let _g1 = this.listRows;
		while(_g < _g1.length) _g1[_g++].active(false);
		let _g2 = 0;
		let _g3 = this.memberRows;
		while(_g2 < _g3.length) _g3[_g2++].active(false);
		this.mode = next;
		this.listView.set_hidden(next != "list");
		this.detailView.set_hidden(next != "detail");
		this.createView.set_hidden(next != "create");
		this.setPanelHeight(next == "list" ? 524 : 620);
		this.setTitle(next == "create" ? "team.create_title" : next == "detail" ? "team.detail_title" : "team.title");
	}
	open() {
		this.present();
		this.switchView("list");
		this.refreshList();
	}
	refreshList() {
		this.failed = false;
		this.loading = this.teams.length == 0;
		this.renderList();
		let _gthis = this;
		this.waitForData(function() {
			_gthis.loading = false;
			_gthis.failed = true;
			_gthis.renderList();
		});
		this.model().sendGetTeamList();
	}
	openTeam(id) {
		this.present();
		this.openDetail(id);
		this.model().sendGetTeamList();
	}
	dismiss() {
		let _g = 0;
		let _g1 = this.listRows;
		while(_g < _g1.length) _g1[_g++].active(false);
		let _g2 = 0;
		let _g3 = this.memberRows;
		while(_g2 < _g3.length) _g3[_g2++].active(false);
		super.dismiss();
	}
	findTeam(id) {
		let _g = 0;
		let _g1 = this.teams;
		while(_g < _g1.length) {
			let t = _g1[_g];
			++_g;
			if(t.id == id) {
				return t;
			}
		}
		return null;
	}
	loadTeams(data) {
		if(data == null) {
			return;
		}
		this.teams = data.teams != null ? data.teams : [];
		this.applications = data.applications != null ? data.applications : [];
		this.myTeamId = data.myTeamId;
		this.appliedTeamId = data.appliedTeamId;
		this.isOwner = data.isOwner == true;
		this.loading = false;
		this.failed = false;
		if(this.mode != "detail") {
			this.finishWaiting();
		}
		if(this.mode == "create" && this.myTeamId != null) {
			this.openDetail(this.myTeamId);
			return;
		}
		if(this.mode == "detail") {
			let t = this.findTeam(this.selectedId);
			if(t != null) {
				this.detailTeam = t;
			}
			this.renderHeader();
			this.renderMembers();
			this.model().sendGetTeamMembers(this.selectedId);
		} else {
			this.renderList();
		}
	}
	onNewApplication(data) {
		if(this.get_visible()) {
			this.model().sendGetTeamList();
		}
	}
	renderList() {
		let _gthis = this;
		let _this = this.teams;
		let _g = [];
		let _g1 = 0;
		while(_g1 < _this.length) {
			let v = _this[_g1];
			++_g1;
			let t = v;
			if(avatar_view_social_SocialUI.matches(t.name + " " + t.tag,_gthis.search.get_text() == null ? "" : _gthis.search.get_text())) {
				_g.push(v);
			}
		}
		this.pager.update(_g.length,5);
		this.listStatus.set_text(avatar_view_social_SocialUI.t("social.teams_count",{ count : _g.length}));
		this.myButton.set_hidden(this.myTeamId == null && this.appliedTeamId == null);
		this.myButton.set_text(avatar_view_social_SocialUI.t(this.myTeamId != null ? "team.my_team" : "team.my_application"));
		this.createButton.set_hidden(this.myTeamId != null);
		this.listEmpty.set_hidden(_g.length > 0);
		this.listEmpty.set_text(this.loading ? avatar_view_social_SocialUI.t("team.loading_list") : this.teams.length == 0 ? avatar_view_social_SocialUI.t("team.empty") + "\n\n" + avatar_view_social_SocialUI.t("team.empty_detail") : avatar_view_social_SocialUI.t("social.no_results"));
		if(this.failed) {
			this.listStatus.set_text(avatar_view_social_SocialUI.t("social.load_failed"));
		}
		let _g2 = 0;
		let _g3 = this.listRows.length;
		while(_g2 < _g3) {
			let i = _g2++;
			let r = this.listRows[i];
			let t = _g[this.pager.page * 5 + i];
			r.active(t != null && this.mode == "list" && this.get_visible());
			if(t == null) {
				continue;
			}
			let id = t.id;
			r.rank.set_text(Std.string(t.rank));
			r.nameLabel.set_text("[" + t.tag + "] " + t.name);
			r.detail.set_text(avatar_view_social_SocialUI.t("team.member_count_short",{ count : t.memberCount}) + (t.id == this.myTeamId ? " · " + avatar_view_social_SocialUI.t("team.my_team") : ""));
			r.score.set_text(avatar_view_social_SocialUI.number(t.xp) + " XP");
			r.team(t);
			r.highlight(t.id == this.myTeamId);
			r.openWholeWith(function() {
				_gthis.openDetail(id);
			});
		}
	}
	openDetail(id) {
		if(id == null) {
			return;
		}
		this.selectedId = id;
		this.detailTeam = this.findTeam(id);
		this.ownerName = "";
		this.members = [];
		this.memberLoading = true;
		this.memberFailed = false;
		this.applicationTab = false;
		this.memberPager.reset();
		this.finishEditing();
		let _gthis = this;
		this.waitForData(function() {
			_gthis.memberLoading = false;
			_gthis.memberFailed = true;
			_gthis.renderMembers();
		});
		this.switchView("detail");
		this.renderHeader();
		this.renderMembers();
		this.model().sendGetTeamMembers(id);
	}
	loadDetail(data) {
		if(data == null || data.team == null || data.team.id != this.selectedId || this.mode != "detail") {
			return;
		}
		this.finishWaiting();
		this.detailTeam = data.team;
		this.members = data.members != null ? data.members : [];
		this.ownerName = data.ownerName;
		this.memberLoading = false;
		this.memberFailed = false;
		this.renderHeader();
		this.renderMembers();
	}
	renderHeader() {
		this.detailAction.set_hidden(true);
		this.editButton.set_hidden(true);
		this.detailNote.set_text("");
		if(this.detailTeam == null) {
			this.detailName.set_text(avatar_view_social_SocialUI.t("team.loading"));
			this.detailMeta.set_text("");
			this.description.set_text("");
			this.detailCrest.bind("",4);
			return;
		}
		let t = this.detailTeam;
		let mine = t.id == this.myTeamId;
		let owner = mine && this.isOwner;
		this.detailCrest.bind(t.logoSymbol,t.logoColor);
		this.detailName.set_text("[" + t.tag + "] " + t.name);
		this.detailMeta.set_text(avatar_view_social_SocialUI.t("social.team_summary",{ rank : t.rank, xp : avatar_view_social_SocialUI.number(t.xp), count : t.memberCount}) + "\n" + (this.ownerName != "" ? avatar_view_social_SocialUI.t("social.leader_name",{ name : this.ownerName}) : ""));
		if(!this.editing) {
			this.description.set_text(t.description != null && t.description != "" ? t.description : avatar_view_social_SocialUI.t("team.no_description"));
		}
		if(!owner && this.editing) {
			this.finishEditing();
		}
		this.editButton.set_hidden(!owner);
		let _gthis = this;
		if(owner) {
			this.detailNote.set_text(avatar_view_social_SocialUI.t("social.you_lead"));
		} else if(mine) {
			this.detailAction.set_hidden(false);
			this.detailAction.set_text(avatar_view_social_SocialUI.t("team.leave"));
			avatar_view_social_SocialUI.enabled(this.detailAction,true);
			this.detailAction.set_onClick(function(_) {
				_gthis.confirm(avatar_view_social_SocialUI.t("team.leave_confirm"),function() {
					_gthis.model().sendLeaveTeam();
				});
			});
		} else if(this.myTeamId != null) {
			this.detailNote.set_text(avatar_view_social_SocialUI.t("team.pending_member"));
		} else if(this.appliedTeamId == t.id) {
			let id = t.id;
			this.detailAction.set_hidden(false);
			this.detailAction.set_text(avatar_view_social_SocialUI.t("team.withdraw_application"));
			avatar_view_social_SocialUI.enabled(this.detailAction,true);
			this.detailAction.set_onClick(function(_) {
				_gthis.model().sendCancelTeamApplication(id);
			});
			this.detailNote.set_text(avatar_view_social_SocialUI.t("team.status_applied"));
		} else {
			let id = t.id;
			this.detailAction.set_hidden(false);
			this.detailAction.set_text(avatar_view_social_SocialUI.t("social.apply"));
			avatar_view_social_SocialUI.enabled(this.detailAction,true,true);
			if(this.appliedTeamId != null) {
				this.detailNote.set_text(avatar_view_social_SocialUI.t("team.application_switch_note"));
			}
			this.detailAction.set_onClick(function(_) {
				_gthis.model().sendApplyTeam(id);
			});
		}
	}
	renderMembers() {
		let owner = this.selectedId == this.myTeamId && this.isOwner;
		if(!owner) {
			this.applicationTab = false;
		}
		this.membersTab.set_text(avatar_view_social_SocialUI.t("team.members_count",{ count : this.members.length}));
		this.applicationsTab.set_hidden(!owner);
		this.applicationsTab.set_text(avatar_view_social_SocialUI.t("team.applications",{ count : this.applications.length}));
		this.membersTab.set_styleString(this.applicationTab ? "padding: 0; font-name: BilboPro; font-size: 14px; color: #4b3921; background-color: #fff9ea; border: 1px solid #bba477; border-radius: 9px;" : "padding: 0; font-name: BilboPro; font-size: 14px; color: #302414; background-color: #ffe8a6; border: 2px solid #8d6f3c; border-radius: 9px;");
		this.applicationsTab.set_styleString(this.applicationTab ? "padding: 0; font-name: BilboPro; font-size: 14px; color: #302414; background-color: #ffe8a6; border: 2px solid #8d6f3c; border-radius: 9px;" : "padding: 0; font-name: BilboPro; font-size: 14px; color: #4b3921; background-color: #fff9ea; border: 1px solid #bba477; border-radius: 9px;");
		let data = this.applicationTab ? this.applications : this.members;
		this.memberPager.update(data.length,4);
		this.memberEmpty.set_hidden(data.length > 0);
		this.memberEmpty.set_text(this.memberLoading ? avatar_view_social_SocialUI.t("team.members_loading") : avatar_view_social_SocialUI.t(this.applicationTab ? "social.no_applications" : "team.no_members"));
		if(this.memberFailed) {
			this.memberEmpty.set_text(avatar_view_social_SocialUI.t("social.load_failed"));
		}
		let _gthis = this;
		let _g = 0;
		let _g1 = this.memberRows.length;
		while(_g < _g1) {
			let i = _g++;
			let r = this.memberRows[i];
			let m = data[this.memberPager.page * 4 + i];
			r.active(m != null && this.mode == "detail" && this.get_visible());
			if(m == null) {
				continue;
			}
			let id = this.applicationTab ? m.userId : m.id;
			let name = m.name;
			r.rank.set_hidden(true);
			r.nameLabel.set_text(name);
			r.score.set_hidden(true);
			r.highlight(m.isOwner == true);
			r.detail.set_text(this.applicationTab ? avatar_view_social_SocialUI.t("social.pending_review") : avatar_view_social_SocialUI.t("profile.level",{ level : m.level}) + " · " + avatar_view_social_SocialUI.number(m.xp) + " XP" + (m.isOwner == true ? " · " + avatar_view_social_SocialUI.t("social.leader") : ""));
			if(this.get_visible() && this.mode == "detail") {
				r.player(m);
			}
			r.openWholeWith(function() {
				Action.instance.ui.playerProfileWindow.open(id,name);
			});
			r.primary.set_hidden(!(owner && (this.applicationTab || m.isOwner != true)));
			r.secondary.set_hidden(r.primary.get_hidden());
			if(this.applicationTab) {
				r.primary.set_text(avatar_view_social_SocialUI.t("social.accept"));
				r.secondary.set_text(avatar_view_social_SocialUI.t("social.reject"));
				r.primary.set_onClick(function(_) {
					_gthis.model().sendAcceptTeamApplication(id);
				});
				r.secondary.set_onClick(function(_) {
					_gthis.model().sendRejectTeamApplication(id);
				});
			} else {
				r.primary.set_text(avatar_view_social_SocialUI.t("social.promote"));
				r.secondary.set_text(avatar_view_social_SocialUI.t("social.remove"));
				r.primary.set_styleString("padding: 0; font-name: BilboPro; font-size: 14px; color: #4b3921; background-color: #fff9ea; border: 1px solid #bba477; border-radius: 9px;" + "font-size: 12px;");
				r.primary.set_onClick(function(_) {
					_gthis.confirm(avatar_view_social_SocialUI.t("team.promote_confirm",{ name : name}),function() {
						_gthis.model().sendTransferTeamOwnership(id);
					});
				});
				r.secondary.set_onClick(function(_) {
					_gthis.confirm(avatar_view_social_SocialUI.t("team.kick_confirm",{ name : name}),function() {
						_gthis.model().sendKickTeamMember(id);
					});
				});
			}
			if(this.applicationTab) {
				r.primary.set_styleString("padding: 0; font-name: BilboPro; font-size: 14px; color: #302414; background-color: #ffe8a6; border: 2px solid #8d6f3c; border-radius: 9px;");
			}
		}
	}
	confirm(message,action) {
		Action.instance.ui.actionPermission.open(message,action,function() {
		});
	}
	toggleDescription() {
		if(this.editing) {
			this.model().sendUpdateTeamDescription(StringTools.trim(this.descriptionInput.get_text()));
			this.finishEditing();
			return;
		}
		this.editing = true;
		this.description.set_hidden(true);
		this.descriptionInput.set_hidden(false);
		this.cancelEdit.set_hidden(false);
		this.descriptionInput.set_text(this.detailTeam.description == null ? "" : this.detailTeam.description);
		this.editButton.set_text(avatar_view_social_SocialUI.t("team.save_description"));
		this.descriptionInput.set_focus(true);
	}
	finishEditing() {
		this.editing = false;
		this.description.set_hidden(false);
		this.descriptionInput.set_hidden(true);
		this.cancelEdit.set_hidden(true);
		this.descriptionInput.set_focus(false);
		this.editButton.set_text(avatar_view_social_SocialUI.t("team.edit_description"));
	}
	showCreate() {
		this.formName.set_text("");
		this.formTag.set_text("");
		this.formDescription.set_text("");
		this.formError.set_text("");
		this.symbol = 0;
		this.color = 0;
		this.switchView("create");
		this.refreshPreview();
	}
	refreshPreview() {
		this.preview.bind(avatar_view_TeamList.LOGO_SYMBOLS[this.symbol],this.color);
		this.previewName.set_text((this.formTag.get_text() != null && this.formTag.get_text() != "" ? "[" + this.formTag.get_text().toUpperCase() + "]\n" : "") + (this.formName.get_text() != null && this.formName.get_text() != "" ? this.formName.get_text() : avatar_view_social_SocialUI.t("team.name_placeholder")));
		let _g = 0;
		let _g1 = this.symbolButtons.length;
		while(_g < _g1) {
			let i = _g++;
			this.symbolButtons[i].set_styleString(i == this.symbol ? "padding: 0; font-name: BilboPro; font-size: 14px; color: #302414; background-color: #ffe8a6; border: 2px solid #8d6f3c; border-radius: 9px;" : "padding: 0; font-name: BilboPro; font-size: 14px; color: #4b3921; background-color: #fff9ea; border: 1px solid #bba477; border-radius: 9px;");
		}
		let _g2 = 0;
		let _g3 = this.colorButtons.length;
		while(_g2 < _g3) {
			let i = _g2++;
			this.colorButtons[i].set_styleString("padding: 0; font-name: BilboPro; font-size: 14px; color: #302414; background-color: #ffe8a6; border: 2px solid #8d6f3c; border-radius: 9px;" + "background-color: #" + StringTools.hex(avatar_view_kit_Skin.logoFill(i),6) + ";");
			this.colorButtons[i].set_text(i == this.color ? "✓" : "");
		}
	}
	submitCreate() {
		let name = StringTools.trim(this.formName.get_text());
		let tag = StringTools.trim(this.formTag.get_text()).toUpperCase();
		if(name.length < 3) {
			this.formError.set_text(avatar_view_social_SocialUI.t("team.create_name_short"));
			return;
		}
		if(!new EReg("^[A-Z0-9]{2,5}$","").match(tag)) {
			this.formError.set_text(avatar_view_social_SocialUI.t("team.tag_invalid"));
			return;
		}
		this.formError.set_text("");
		this.model().sendCreateTeam(name,tag,StringTools.trim(this.formDescription.get_text()),avatar_view_TeamList.LOGO_SYMBOLS[this.symbol],this.color);
	}
}
