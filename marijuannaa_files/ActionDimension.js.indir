			return;
		}
		let ordered = [wearableButton,sellButton,useButton];
		let parent = wearableButton.parent;
		let nextLeft = wearableButton.getBounds(parent).x;
		let _g = 0;
		while(_g < ordered.length) {
			let button = ordered[_g];
			++_g;
			let bounds = button.getBounds(parent);
			button.set_x(button.get_x() + (nextLeft - bounds.x));
			nextLeft += bounds.width + 6.0;
		}
	}
	renderPaintballDetails(config) {
		let isWeapon = config != null && avatar_view_InventoryItemDetails.configString(config,"type") == "weapon";
		this.paintballItemDetails.set_visible(isWeapon);
