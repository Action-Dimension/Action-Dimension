		if(key >= 65 && key <= 90) {
			effectiveShift = shift != capsLock;
		}
		if(!effectiveShift) {
			switch(key) {
			case 8:
				return 8;
			case 9:
				return 9;
			case 13:
				return 13;
			case 27:
				return 27;
			case 32:
				return 32;
			case 186:
				return 59;
			case 187:
				return 61;
			case 188:
				return 44;
			case 189:
				return 45;
			case 190:
				return 46;
			case 191:
				return 47;
			case 192:
				return 96;
			case 219:
				return 91;
			case 220:
				return 92;
			case 221:
				return 93;
			case 222:
				return 39;
			}
			if(key >= 48 && key <= 57) {
