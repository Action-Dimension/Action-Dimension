		let ly = listener.get_y();
		let kind = particle.projectile_kind;
		if(kind == 1 || kind == 2 || kind == 6 || kind == 7 || kind == 12 || kind == 15 || kind == 16 || kind == 35 || kind == 53 || kind == 54) {
			switch(Math.random() * 3 | 0) {
			case 0:
				this.play_sound_execute(openfl_utils_Assets.getSound(paintball_model_SfxModel.SOUND_PATHS.h["small_gun_1"]),px,py,lx,ly);
				break;
			case 1:
				this.play_sound_execute(openfl_utils_Assets.getSound(paintball_model_SfxModel.SOUND_PATHS.h["small_gun_2"]),px,py,lx,ly);
				break;
			default:
				this.play_sound_execute(openfl_utils_Assets.getSound(paintball_model_SfxModel.SOUND_PATHS.h["small_gun_3"]),px,py,lx,ly);
			}
		}
		if(kind == 51 || kind == 52) {
			switch(Math.random() * 3 | 0) {
			case 0:
				this.play_sound_execute(openfl_utils_Assets.getSound(paintball_model_SfxModel.SOUND_PATHS.h["pistol_1"]),px,py,lx,ly);
				break;
			case 1:
				this.play_sound_execute(openfl_utils_Assets.getSound(paintball_model_SfxModel.SOUND_PATHS.h["pistol_2"]),px,py,lx,ly);
				break;
			default:
				this.play_sound_execute(openfl_utils_Assets.getSound(paintball_model_SfxModel.SOUND_PATHS.h["pistol_3"]),px,py,lx,ly);
			}
		}
		if(kind == 3) {
			this.play_sound_execute(openfl_utils_Assets.getSound(paintball_model_SfxModel.SOUND_PATHS.h["big_gun"]),px,py,lx,ly);
		}
		if(kind == 4 || kind == 5 || kind == 36) {
			this.play_sound_execute(openfl_utils_Assets.getSound(paintball_model_SfxModel.SOUND_PATHS.h["shotgun"]),px,py,lx,ly);
		}
		if(kind == 8 || kind == 34 || kind == 37) {
			this.play_sound_execute(openfl_utils_Assets.getSound(paintball_model_SfxModel.SOUND_PATHS.h["sniper"]),px,py,lx,ly);
		}
		if(kind == 9 || kind == 10 || kind == 14 || kind == 40) {
			this.play_sound_execute(openfl_utils_Assets.getSound(paintball_model_SfxModel.SOUND_PATHS.h["rocket_launcher"]),px,py,lx,ly);
		}
		if(kind == 11 || kind == 13) {
			this.play_sound_execute(openfl_utils_Assets.getSound(paintball_model_SfxModel.SOUND_PATHS.h["spray_thrower"]),px,py,lx,ly);
		}
		if(kind == 17) {
			this.play_sound_execute(openfl_utils_Assets.getSound(paintball_model_SfxModel.SOUND_PATHS.h["cyborg_rocketeer"]),px,py,lx,ly);
		}
