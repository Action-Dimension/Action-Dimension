	buildCreateView() {
		this.nameInput = this.view.findComponent("nameInput",haxe_ui_components_TextField);
		this.view.findComponent("nameLabel",haxe_ui_components_Label).set_text(core_i18n_I18n.t("room_browser.room_name"));
		this.nameInput.set_maxChars(24);
		this.nameInput.set_allowInteraction(true);
		this.nameInput.set_allowFocus(true);
		let _gthis = this;
		this.nameInput.addEventListener("mouseDown",function(_) {
			_gthis.focusNameInput(false);
		});
		this.nameInput.addEventListener("keyDown",function(event) {
			if(event.keyCode == 13) {
				_gthis.blurNameInput();
			}
		});
		this.modeField = this.view.findComponent("modeField",haxe_ui_core_Component);
		this.difficultyField = this.view.findComponent("difficultyField",haxe_ui_core_Component);
		this.mapField = this.view.findComponent("mapField",haxe_ui_core_Component);
		if(this.config.modes != null && this.config.modes.length > 1) {
			this.view.findComponent("modeLabel",haxe_ui_components_Label).set_text(core_i18n_I18n.t("room_browser.mode"));
			let _this = this.config.modes;
			let result = new Array(_this.length);
			let _g = 0;
			let _g1 = _this.length;
			while(_g < _g1) {
				let i = _g++;
				result[i] = _this[i].label;
			}
			this.modeChips = this.buildChips("modeChips",result,function(index) {
				_gthis.modeIndex = index;
				_gthis.paintChips(_gthis.modeChips,_gthis.modeIndex);
				_gthis.applyDifficultyVisibility();
			},2);
		} else {
			this.modeField.set_hidden(true);
		}
		this.view.findComponent("difficultyLabel",haxe_ui_components_Label).set_text(core_i18n_I18n.t("room_browser.difficulty"));
		this.buildDifficultyChips();
		this.view.findComponent("capacityLabel",haxe_ui_components_Label).set_text(core_i18n_I18n.t("room_browser.player_count"));
		let _this = this.config.capacities;
		let result = new Array(_this.length);
		let _g = 0;
		let _g1 = _this.length;
		while(_g < _g1) {
			let i = _g++;
			result[i] = _gthis.config.capacityLabel(_this[i]);
		}
		this.capacityChips = this.buildChips("capacityChips",result,function(index) {
			_gthis.capacityIndex = index;
			_gthis.paintChips(_gthis.capacityChips,_gthis.capacityIndex);
		},4);
		if(this.config.mapCount > 1) {
			this.buildMapTiles();
			this.view.findComponent("formFields",haxe_ui_core_Component).set_verticalAlign("top");
		} else {
			this.mapField.set_hidden(true);
			this.view.findComponent("formFields",haxe_ui_core_Component).set_verticalAlign("center");
		}
		this.backButton = this.view.findComponent("backButton",haxe_ui_components_Button);
		this.backButton.set_text(core_i18n_I18n.t("common.back"));
		this.backButton.set_onClick(function(_) {
			if(!_gthis.busy) {
				_gthis.showList();
			}
		});
		this.submitButton = this.view.findComponent("submitButton",haxe_ui_components_Button);
		this.submitButton.set_text(core_i18n_I18n.t("room_browser.start"));
		this.submitButton.set_onClick(function(_) {
			_gthis.submit();
		});
	}
	buildDifficultyChips() {
		this.view.findComponent("difficultyChips",haxe_ui_core_Component).removeAllComponents();
		this.difficultyChips = [];
		if(this.config.difficulties == null || this.config.difficulties.length == 0) {
			this.difficultyField.set_hidden(true);
			return;
		}
		let _gthis = this;
		let _this = this.config.difficulties;
		let result = new Array(_this.length);
		let _g = 0;
		let _g1 = _this.length;
		while(_g < _g1) {
			let i = _g++;
			result[i] = _this[i].label;
		}
		this.difficultyChips = this.buildChips("difficultyChips",result,function(index) {
			_gthis.difficultyIndex = index;
			_gthis.paintChips(_gthis.difficultyChips,_gthis.difficultyIndex);
		},3);
	}
	buildChips(hostId,labels,pick,perRow) {
		let host = this.view.findComponent(hostId,haxe_ui_core_Component);
		let made = [];
		let row = null;
		let _g = 0;
		let _g1 = labels.length;
		while(_g < _g1) {
			let index = _g++;
			if(index % perRow == 0) {
				row = this.addChipRow(host);
			}
			let c0 = new haxe_ui_components_Button();
			c0.set_id("chip");
			c0.set_height(34.);
			c0.set_percentWidth(100.);
			c0.set_text("");
			c0.set_styleString("padding: 0; font-size: 14px; color: #44351f; background-color: #fffaf0; background-color-end: #f7ecd4; background-gradient-style: vertical; border: 2px solid #cdb98c; border-radius: 10px;");
			c0.bindingRoot = true;
			c0.set_text(labels[index]);
			c0.set_percentWidth(100 / perRow);
			let slot = index;
			c0.set_onClick(function(_) {
				pick(slot);
			});
			row.addComponent(c0);
			made.push(c0);
		}
		let missing = labels.length % perRow;
		if(missing > 0 && row != null) {
			let _g = 0;
			let _g1 = perRow - missing;
			while(_g < _g1) {
				++_g;
				let filler = new haxe_ui_containers_Box();
				filler.set_percentWidth(100 / perRow);
				filler.set_height(34.0);
				row.addComponent(filler);
			}
		}
		this.paintChips(made,0);
		return made;
	}
	addChipRow(host) {
		let row = new haxe_ui_containers_HBox();
		row.set_percentWidth(100);
		row.set_height(34.0);
		row.set_styleString("padding: 0; vertical-spacing: 0; horizontal-spacing: 6px;");
		host.addComponent(row);
		return row;
	}
	paintChips(chips,selected) {
		let _g = 0;
		let _g1 = chips.length;
		while(_g < _g1) {
			let index = _g++;
			chips[index].set_styleString(index == selected ? "background-color: #ffe8a6; border-color: #8d6f3c; color: #302414;" : "background-color: #fffaf0; background-color-end: #f7ecd4; border-color: #cdb98c; color: #44351f;");
		}
	}
	buildMapTiles() {
		this.view.findComponent("mapLabel",haxe_ui_components_Label).set_text(this.config.mapLabel);
		let host = this.view.findComponent("mapTiles",haxe_ui_core_Component);
		let row = null;
		let _gthis = this;
		let _g = 0;
		let _g1 = this.config.mapCount;
		while(_g < _g1) {
			let index = _g++;
			if(index % 2 == 0) {
				row = new haxe_ui_containers_HBox();
				row.set_width(268.);
				row.set_height(130.0);
				row.set_styleString("padding: 0; vertical-spacing: 0; horizontal-spacing: " + 8.0 + "px;");
				host.addComponent(row);
			}
			let c0 = new haxe_ui_containers_Box();
			c0.set_id("tile");
			c0.set_width(130.);
			c0.set_height(130.);
			c0.set_styleString("padding: 0; horizontal-spacing: 0; vertical-spacing: 0; background-color: #fffaf0; border: 3px solid #cdb98c; border-radius: 12px;");
			let c01 = new haxe_ui_containers_Box();
			c01.set_id("tileArt");
			c01.set_percentWidth(100.);
			c01.set_percentHeight(100.);
			c01.set_styleString("padding: 0; horizontal-spacing: 0; vertical-spacing: 0;");
			c0.addComponent(c01);
			let c1 = new haxe_ui_components_Label();
			c1.set_id("tileBadge");
			c1.set_left(6.);
			c1.set_top(6.);
			c1.set_width(28.);
			c1.set_height(22.);
			c1.set_text("");
			c1.set_styleString("padding: 0; font-name: BilboPro; font-size: 14px; color: #302414; text-align: center; background-color: #ffe8a6; border: 2px solid #8d6f3c; border-radius: 7px;");
			c1.set_includeInLayout(false);
			c0.addComponent(c1);
			c0.bindingRoot = true;
			c0.findComponent("tileBadge",haxe_ui_components_Label).set_text(Std.string(index + 1));
			let slot = index;
			c0.registerEvent(haxe_ui_events_MouseEvent.CLICK,function(_) {
				_gthis.mapIndex = slot;
				_gthis.paintTiles();
			});
			this.pointerOn(c0);
			row.addComponent(c0);
			this.mapTiles.push(c0);
			this.paintTileArt(c0,index);
		}
		this.paintTiles();
	}
	paintTileArt(tile,index) {
		if(this.config.mapPreview == null) {
			return;
		}
		let art = tile.findComponent("tileArt",haxe_ui_core_Component);
		if(art == null) {
			return;
		}
		let clip = new openfl_display_Sprite();
		clip.set_scrollRect(new openfl_geom_Rectangle(0,0,124.,124.));
		clip.mouseEnabled = false;
		clip.mouseChildren = false;
		let canvas = new openfl_display_Sprite();
		clip.addChild(canvas);
		art.addChild(clip);
		this.config.mapPreview(index,canvas,124.,124.);
	}
	paintTiles() {
		let _g = 0;
		let _g1 = this.mapTiles.length;
		while(_g < _g1) {
			let index = _g++;
			this.mapTiles[index].set_styleString(index == this.mapIndex ? "background-color: #ffe8a6; border-color: #8d6f3c;" : "background-color: #fffaf0; border-color: #cdb98c;");
		}
	}
	applyDifficultyVisibility() {
		this.difficultyField.set_hidden(!this.difficultyApplies());
	}
	attachDrag(holder) {
		let header = this.view.findComponent("roomHeader",haxe_ui_core_Component);
		if(header == null) {
			return;
		}
		let area = new openfl_geom_Rectangle(0,0,720.0,480.0);
		new avatar_view_WindowDrag(holder,header,function() {
			return area;
		});
	}
	makeScrim(width,height) {
		let scrim = new openfl_display_Sprite();
		scrim.get_graphics().beginFill(0,0.001);
		scrim.get_graphics().drawRect(0,0,width,height);
		scrim.get_graphics().endFill();
		scrim.addEventListener("mouseDown",function(event) {
			event.stopImmediatePropagation();
		});
		return scrim;
	}
	pointerOn(target) {
		avatar_view_WindowDrag.pointerCursor(target);
	}
	showList() {
		this.selectList();
		this.dismissError();
	}
	dismissError() {
		this.errorSticky = false;
		this.clearStatus();
	}
	selectList() {
		this.listView.set_hidden(false);
		this.createView.set_hidden(true);
		this.windowTitle.set_text(this.config.title);
		this.blurNameInput();
	}
	showCreate() {
		this.dismissError();
		this.listView.set_hidden(true);
		this.createView.set_hidden(false);
		this.windowTitle.set_text(core_i18n_I18n.t("room_browser.create"));
		this.nameInput.set_text(this.config.defaultRoomName());
		this.capacityIndex = this.indexOfCapacity(this.config.defaultCapacity);
		this.paintChips(this.capacityChips,this.capacityIndex);
		if(this.modeChips.length > 0) {
			this.modeIndex = this.indexOfMode(this.config.defaultMode);
			this.paintChips(this.modeChips,this.modeIndex);
		}
		if(this.difficultyChips.length > 0) {
			this.difficultyIndex = this.indexOfDifficulty(this.config.defaultDifficulty);
			this.paintChips(this.difficultyChips,this.difficultyIndex);
		}
		this.applyDifficultyVisibility();
		this.mapIndex = 0;
		if(this.mapTiles.length > 0) {
			this.paintTiles();
		}
		this.focusNameInput(true);
	}
	indexOfCapacity(value) {
		let found = this.config.capacities.indexOf(value);
		if(found < 0) {
			return 0;
		} else {
			return found;
		}
	}
	indexOfMode(value) {
		if(this.config.modes == null || value == null) {
			return 0;
		}
		let _g = 0;
		let _g1 = this.config.modes.length;
		while(_g < _g1) {
			let index = _g++;
			if(this.config.modes[index].value == value) {
				return index;
			}
		}
		return 0;
	}
	selectedMode() {
		if(this.config.modes == null) {
			return 0;
		} else {
			return this.config.modes[this.modeChips.length == 0 ? 0 : this.modeIndex].value;
		}
	}
	setDifficulties(entries,defaultValue) {
		if(entries == null || entries.length == 0) {
			return;
		}
		let same = this.config.difficulties != null && this.config.difficulties.length == entries.length;
		if(same) {
			let _g = 0;
			let _g1 = entries.length;
			while(_g < _g1) {
				let i = _g++;
				if(this.config.difficulties[i].value != entries[i].value) {
					same = false;
					break;
				}
			}
		}
		this.config.difficulties = entries;
		this.config.defaultDifficulty = defaultValue != null ? defaultValue : entries[0].value;
		if(same) {
			return;
		}
		this.buildDifficultyChips();
		this.difficultyIndex = this.indexOfDifficulty(this.config.defaultDifficulty);
		this.paintChips(this.difficultyChips,this.difficultyIndex);
		this.applyDifficultyVisibility();
