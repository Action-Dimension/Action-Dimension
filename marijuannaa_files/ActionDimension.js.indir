class com_junkbyte_console_view_Ruler extends openfl_display_Sprite {
	constructor($console) {
		super();
		this._master = $console;
		this._config = $console.get_config();
		this.set_buttonMode(true);
		this._points = [];
		this._pointer = new openfl_display_Shape();
		this.addChild(this._pointer);
		let p = new openfl_geom_Point();
		p = this.globalToLocal(p);
		this._area = new openfl_geom_Rectangle(-$console.stage.stageWidth * 1.5 + p.x,-$console.stage.stageHeight * 1.5 + p.y,$console.stage.stageWidth * 3,$console.stage.stageHeight * 3);
		this.get_graphics().beginFill(this._config.get_style().backgroundColor,0.2);
		this.get_graphics().drawRect(this._area.x,this._area.y,this._area.width,this._area.height);
		this.get_graphics().endFill();
		this._posTxt = this._master.get_panels().get_mainPanel().makeTF("positionText",true);
		this._posTxt.set_autoSize(1);
		this.addChild(this._posTxt);
		this._zoom = new openfl_display_Bitmap();
		this._zoom.set_scaleY(this._zoom.set_scaleX(2));
		this.addChild(this._zoom);
		this.addEventListener("click",$bind(this,this.onMouseClick),false,0,true);
		this.addEventListener("mouseMove",$bind(this,this.onMouseMove),false,0,true);
		this.onMouseMove();
		if(this._config.rulerHidesMouse) {
			openfl_ui_Mouse.hide();
		}
		this._master.report("<b>Ruler started. Click on two locations to measure.</b>",-1);
	}
	onMouseMove(e) {
		this._pointer.get_graphics().clear();
		this._pointer.get_graphics().lineStyle(1,11193344,1);
		this._pointer.get_graphics().moveTo(this._area.x,this.get_mouseY());
		this._pointer.get_graphics().lineTo(this._area.x + this._area.width,this.get_mouseY());
		this._pointer.get_graphics().moveTo(this.get_mouseX(),this._area.y);
		this._pointer.get_graphics().lineTo(this.get_mouseX(),this._area.y + this._area.height);
		this._pointer.set_blendMode(6);
		this._posTxt.set_text("<low>" + this.get_mouseX() + "," + this.get_mouseY() + "</low>");
		let bmd = new openfl_display_BitmapData(30,30);
		try {
			let m = new openfl_geom_Matrix();
			m.tx = -openfl_Lib.get_current().stage.get_mouseX() + 15;
			m.ty = -openfl_Lib.get_current().stage.get_mouseY() + 15;
			bmd.draw(openfl_Lib.get_current().stage,m);
		} catch( _g ) {
			if(((haxe_Exception.caught(_g)) instanceof openfl_errors_Error)) {
				bmd = null;
			} else {
				throw _g;
			}
		}
		this._zoom.set_bitmapData(bmd);
		this._posTxt.set_x(this.get_mouseX() - this._posTxt.get_width() - 10);
		this._posTxt.set_y(this.get_mouseY() - this._posTxt.get_height() - 10);
		this._zoom.set_x(this._posTxt.get_x() + this._posTxt.get_width() - this._zoom.get_width());
		this._zoom.set_y(this._posTxt.get_y() - this._zoom.get_height());
		if(this._posTxt.get_x() < 16) {
			this._posTxt.set_x(this.get_mouseX() + 10);
			this._zoom.set_x(this._posTxt.get_x());
		}
		if(this._posTxt.get_y() < 38) {
			this._posTxt.set_y(this.get_mouseY() + 10);
			this._zoom.set_y(this._posTxt.get_y() + this._posTxt.get_height());
		}
	}
	onMouseClick(e) {
		e.stopPropagation();
		let p;
		let style = this._config.get_style();
		if(this._points.length == 0) {
			p = new openfl_geom_Point(e.localX,e.localY);
			this.get_graphics().lineStyle(1,16711680);
			this.get_graphics().drawCircle(p.x,p.y,3);
			this._points.push(p);
		} else if(this._points.length == 1) {
			this._zoom.set_bitmapData(null);
			if(this._config.rulerHidesMouse) {
				openfl_ui_Mouse.show();
			}
			this.removeChild(this._pointer);
			this.removeChild(this._posTxt);
			this.removeEventListener("mouseMove",$bind(this,this.onMouseMove));
			p = this._points[0];
			let p2 = new openfl_geom_Point(e.localX,e.localY);
			this._points.push(p2);
			this.get_graphics().clear();
			this.get_graphics().beginFill(style.backgroundColor,0.4);
			this.get_graphics().drawRect(this._area.x,this._area.y,this._area.width,this._area.height);
			this.get_graphics().endFill();
			this.get_graphics().lineStyle(1.5,16711680);
			this.get_graphics().drawCircle(p.x,p.y,4);
			this.get_graphics().lineStyle(1.5,16750848);
			this.get_graphics().drawCircle(p2.x,p2.y,4);
			let mp = openfl_geom_Point.interpolate(p,p2,0.5);
			this.get_graphics().lineStyle(1,11184810);
			this.get_graphics().drawCircle(mp.x,mp.y,4);
			let xmin = p;
			let xmax = p2;
			if(p.x > p2.x) {
				xmin = p2;
				xmax = p;
			}
			let ymin = p;
			let ymax = p2;
			if(p.y > p2.y) {
				ymin = p2;
				ymax = p;
			}
			let w = xmax.x - xmin.x;
			let h = ymax.y - ymin.y;
			let d = openfl_geom_Point.distance(p,p2);
			let txt = this.makeTxtField(style.highColor);
			txt.set_text(this.round(p.x) + "," + this.round(p.y));
			txt.set_x(p.x);
			txt.set_y(p.y - (ymin == p ? 14 : 0));
			this.addChild(txt);
			txt = this.makeTxtField(style.highColor);
			txt.set_text(this.round(p2.x) + "," + this.round(p2.y));
			txt.set_x(p2.x);
			txt.set_y(p2.y - (ymin == p2 ? 14 : 0));
			this.addChild(txt);
			if(w > 40 || h > 25) {
				txt = this.makeTxtField(style.lowColor);
				txt.set_text(this.round(mp.x) + "," + this.round(mp.y));
				txt.set_x(mp.x);
				txt.set_y(mp.y);
				this.addChild(txt);
			}
			this.get_graphics().lineStyle(1,11193344,0.5);
			this.get_graphics().moveTo(this._area.x,ymin.y);
			this.get_graphics().lineTo(this._area.x + this._area.width,ymin.y);
			this.get_graphics().moveTo(this._area.x,ymax.y);
			this.get_graphics().lineTo(this._area.x + this._area.width,ymax.y);
			this.get_graphics().moveTo(xmin.x,this._area.y);
			this.get_graphics().lineTo(xmin.x,this._area.y + this._area.height);
			this.get_graphics().moveTo(xmax.x,this._area.y);
			this.get_graphics().lineTo(xmax.x,this._area.y + this._area.height);
			let a1 = this.round(this.angle(p,p2),100);
			let a2 = this.round(this.angle(p2,p),100);
			this.get_graphics().lineStyle(1,11141120,0.8);
			this.drawCircleSegment(this.get_graphics(),10,p,a1,-90);
			this.get_graphics().lineStyle(1,13404160,0.8);
			this.drawCircleSegment(this.get_graphics(),10,p2,a2,-90);
			this.get_graphics().lineStyle(2,65280,0.7);
			this.get_graphics().moveTo(p.x,p.y);
			this.get_graphics().lineTo(p2.x,p2.y);
			this._master.report("Ruler results: (red) <b>[" + p.x + "," + p.y + "]</b> to (orange) <b>[" + p2.x + "," + p2.y + "]</b>",-2);
			this._master.report("Distance: <b>" + this.round(d,100) + "</b>",-2);
			this._master.report("Mid point: <b>[" + mp.x + "," + mp.y + "]</b>",-2);
			this._master.report("Width:<b>" + w + "</b>, Height: <b>" + h + "</b>",-2);
			this._master.report("Angle from first point (red): <b>" + a1 + "°</b>",-2);
			this._master.report("Angle from second point (orange): <b>" + a2 + "°</b>",-2);
		} else {
			this.exit();
		}
	}
	exit() {
		this._master = null;
		this.dispatchEvent(new openfl_events_Event("complete"));
	}
	makeTxtField(col,b) {
		if(b == null) {
			b = true;
		}
		let format = new openfl_text_TextFormat(this._config.get_style().menuFont,this._config.get_style().menuFontSize,col,b,true,null,null,openfl_text_TextFormatAlign.toString(4));
		let txt = new openfl_text_TextField();
		txt.set_autoSize(3);
		txt.set_selectable(false);
		txt.set_defaultTextFormat(format);
		return txt;
	}
	round(n,d) {
		if(d == null) {
			d = 10;
		}
		return UInt.toFloat(Math.round(UInt.toFloat(d) * n)) / UInt.toFloat(d);
	}
	angle(srcP,point) {
		let a = Math.atan2(point.y - srcP.y,point.x - srcP.x) / Math.PI * 180;
		a += 90;
		if(a > 180) {
			a -= 360;
		}
		return a;
	}
	drawCircleSegment(g,radius,pos,deg,startDeg) {
		if(startDeg == null) {
			startDeg = 0;
		}
		if(deg == null) {
			deg = 180;
		}
		if(deg < 0) {
			deg = Math.abs(deg);
		}
		let rad2 = startDeg * Math.PI / 180;
		let p = this.getPointOnCircle(radius,rad2);
		p.offset(pos.x,pos.y);
		g.moveTo(p.x,p.y);
		return p;
	}
	getPointOnCircle(radius,rad) {
		return new openfl_geom_Point(radius * Math.cos(rad),radius * Math.sin(rad));
	}
}
