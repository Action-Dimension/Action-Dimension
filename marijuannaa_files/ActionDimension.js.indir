		this.field.set_x(0);
		this.field.set_y(0);
		this.world.content.addTile(this.field);
		let _g = 0;
		let _g1 = soccer_view_SoccerView.GOAL_POSITIONS;
		while(_g < _g1.length) {
			let goal = _g1[_g];
			++_g;
			let clip = sheet.create("map_item");
			clip.set_x(goal.x);
			clip.set_y(goal.y);
			clip.gotoAndStop(goal.frame);
			let inner = clip._player.getSymbolByName("inner_item");
			if(inner != null) {
				let col = inner._player.getSymbolByName("col");
				if(col != null) {
					col.set_visible(false);
					col.set_alpha(0);
				}
				clip.composeRender();
			}
			this.goalClips.push(clip);
			this.world.content.addTile(clip);
		}
		let keeper = new soccer_view_SoccerPlayerClip(1);
		keeper.setAppearance("male",1,10,1,1,0,1,2,1,0);
		this.keeperClips.push(keeper);
		this.world.content.addTile(keeper);
		let keeper1 = new soccer_view_SoccerPlayerClip(2);
		keeper1.setAppearance("male",3,23,2,2,0,0,1,1,0);
		this.keeperClips.push(keeper1);
		this.world.content.addTile(keeper1);
		this.ballClip = sheet.create("ballholder");
		this.ballInner = this.ballClip._player.getSymbolByName("ball_inner");
		this.ballEffect = this.ballClip._player.getSymbolByName("ball_effect");
		this.hideBallEffect();
		this.world.content.addTile(this.ballClip);
	}
