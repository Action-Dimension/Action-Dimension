	}
	updateMenu(instant) {
		if(instant == null) {
			instant = false;
		}
		if(instant) {
			this._updateMenu();
		} else {
			this._needUpdateMenu = true;
		}
	}
	_updateMenu() {
		let str = "<r><high>";
		str = "<r><high>" + "<a href=\"event:nothing\"> </a>";
		if(this._mini || !this.get_style().topMenu) {
			str += "<menu><b> <a href=\"event:show\">‹</a>";
		} else {
			if(!this.console.get_panels().get_channelsPanel()) {
				str += this.getChannelsLink(true);
			}
			str += "<menu> <b>";
			let extra = false;
			let X_keys = Object.keys(this._extraMenus.h);
			let X_length = X_keys.length;
			let X_current = 0;
			while(X_current < X_length) {
				let X = X_keys[X_current++];
				str += "<a href=\"event:external_" + X + "\">" + X + "</a> ";
				extra = true;
			}
			if(extra) {
				str += "¦ ";
			}
			str += this.doActive("<a href=\"event:fps\">F</a>",this.console.get_fpsMonitor() == true);
			str += this.doActive(" <a href=\"event:mm\">M</a>",this.console.get_memoryMonitor() == true);
			str += this.doActive(" <a href=\"event:command\">CL</a>",this.get_commandLine());
			if(this.console.get_remoter().get_remoting() != 2) {
				if(this.get_config().displayRollerEnabled) {
					str += this.doActive(" <a href=\"event:roller\">Ro</a>",this.console.get_displayRoller());
				}
				if(this.get_config().rulerToolEnabled) {
					str += this.doActive(" <a href=\"event:ruler\">RL</a>",this.console.get_panels().get_rulerActive());
				}
			}
			str += " ¦</b>";
			str += " <a href=\"event:copy\">Sv</a>";
			str += " <a href=\"event:priority\">P" + this._priority + "</a>";
			str += this.doActive(" <a href=\"event:pause\">P</a>",this.console.get_paused());
			str += " <a href=\"event:clear\">C</a> <a href=\"event:close\">X</a> <a href=\"event:hide\">›</a>";
		}
		str += " </menu></high></r>";
		this.txtField.set_htmlText(str);
		this.txtField.set_scrollH(this.txtField.get_maxScrollH());
		this.updateTraceFHeight();
	}
	getChannelsLink(limited) {
		if(limited == null) {
			limited = false;
		}
		let str = "<chs>";
		let channels = this.console.get_logs().getChannels();
		let len = channels.length;
		if(limited && len > this.get_style().maxChannelsInMenu) {
			len = this.get_style().maxChannelsInMenu;
		}
		let filtering = this._viewingChannels.length > 0 || this._ignoredChannels.length > 0;
		let _g = 0;
		let _g1 = len;
		while(_g < _g1) {
			let i = _g++;
			let channel = channels[i];
			str += "<a href=\"event:channel_" + channel + "\">[" + (!filtering && i == 0 || filtering && i != 0 && this.chShouldShow(channel) ? "<ch><b>" + channel + "</b></ch>" : channel) + "]</a> ";
		}
		if(limited) {
			str += "<ch><a href=\"event:channels\"><b>" + (channels.length > len ? "..." : "") + "</b>^^ </a></ch>";
		}
		str += "</chs> ";
		return str;
	}
	doActive(str,b) {
		if(b) {
			return "<menuHi>" + str + "</menuHi>";
		}
		return str;
	}
	onMenuRollOverEvent(e) {
		this.onMenuRollOver(e);
	}
	onMenuRollOver(e,src) {
		if(src == null) {
			src = this;
		}
		let txt = e.text != null ? StringTools.replace(e.text,"event:","") : "";
		if(txt == "channel_" + " * ") {
			txt = "View all channels";
		} else if(txt == "channel_" + "-") {
			txt = "Default channel::Logs with no channel";
		} else if(txt == "channel_" + "C") {
			txt = "Console's channel::Logs generated from Console";
		} else if(txt == "channel_" + "~") {
			txt = this._filterRegExp != null ? js_Boot.__cast(this._filterRegExp , String) : this._filterText;
			txt = "Filtering channel" + "::*" + txt + "*";
		} else if(txt == "channel_" + "⌂") {
			txt = "Inspecting channel";
		} else if(txt.indexOf("channel_") == 0) {
			txt = "Change channel::shift: select multiple\nctrl: ignore channel";
		} else if(txt == "pause") {
			if(this.console.get_paused()) {
				txt = "Resume updates";
			} else {
				txt = "Pause updates";
			}
		} else if(txt == "close" && src == this) {
			txt = "Close::Type password to show again";
		} else if(txt.indexOf("external_") == 0) {
			let menu = this._extraMenus.h[txt.substring(9)];
			if(menu != null) {
				txt = menu[2];
			}
		} else {
			txt = Reflect.field({ fps : "Frames Per Second", mm : "Memory Monitor", roller : "Display Roller::Map the display list under your mouse", ruler : "Screen Ruler::Measure the distance and angle between two points on screen.", command : "Command Line", copy : "Save to clipboard::shift: no channel name\nctrl: use viewing filters\nalt: save to file", clear : "Clear log", priority : "Priority filter::shift: previous priority\n(skips unused priorites)", channels : "Expand channels", close : "Close"},txt);
		}
		this.console.get_panels().tooltip(txt,src);
	}
	linkHandler(e) {
		this.txtField.setSelection(0,0);
		this.stopDrag();
		let t = e.text;
		if(t == "pause") {
			if(this.console.get_paused()) {
				this.console.set_paused(false);
			} else {
				this.console.set_paused(true);
			}
			this.console.get_panels().tooltip(null);
		} else if(t == "hide") {
			this.console.get_panels().tooltip();
			this._mini = true;
			this.console.get_config().get_style().topMenu = false;
			super.set_height(this.get_height());
