	}
	updatePopularity(value) {
		if(this.popularityBar == null) {
			return;
		}
		this.popularityBar.set_scaleX(this.popularityBarScaleX * Math.max(10,Math.min(100,value)) / 100);
	}
	updatePotionEffects(effects) {
		this.potionEffectTimer.setEffects(effects);
	}
