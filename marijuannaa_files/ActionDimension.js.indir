});
class avatar_view_PetDeadMenu extends openfl_display_Sprite {
	constructor() {
		openfl_events_EventDispatcher._hx_skip_constructor = true;
		super();
		openfl_events_EventDispatcher._hx_skip_constructor = false;
		this._hx_constructor();
	}
	_hx_constructor() {
		this.revivePending = false;
		super._hx_constructor();
		this.panel = openfl_utils_Assets.getMovieClip("sportsbook_lobby:sportsbook_lobby_fla.char_menu_pet_dead_273");
		this.setText("text_petisdead",core_i18n_I18n.t("pet.dead"));
		this.setText("text_nexttime",core_i18n_I18n.t("pet.next_time"));
		this.setText("text_revivenow",core_i18n_I18n.t("pet.revive_now"));
		this.setText("text_decidelater",core_i18n_I18n.t("pet.decide_later"));
		let close = this.panel.getChildByName("close_button");
		let later = this.panel.getChildByName("decide_later");
		this.reviveButton = this.panel.getChildByName("revive_now");
		let _gthis = this;
		close.addEventListener("mouseDown",function(_) {
			_gthis.close();
		});
		later.addEventListener("mouseDown",function(_) {
			_gthis.close();
		});
		this.reviveButton.addEventListener("mouseDown",function(_) {
			if(_gthis.revivePending) {
				return;
			}
			_gthis.setRevivePending(true);
			Action.instance.petModel.revivePet();
		});
		this.panel.addEventListener("mouseDown",function(_) {
			Action.instance.ui.blockedClick = true;
		});
		let bounds = this.panel.getBounds(this.panel);
		this.panelLayoutBounds = new openfl_geom_Rectangle(bounds.x,bounds.y,bounds.width,bounds.height);
		this.addChild(this.panel);
		avatar_view_WindowDrag.attachSwf(this.panel);
		this.set_visible(false);
		this.layout();
		if(openfl_Lib.get_current().stage != null) {
			openfl_Lib.get_current().stage.addEventListener("resize",$bind(this,this.layout));
		}
	}
	open(cost) {
		this.setRevivePending(false);
		let cashText = this.panel.getChildByName("pet_revival_cash");
		cashText.set_text((cost | 0) + " Cash");
		cashText.mouseEnabled = false;
		this.layout();
		this.set_visible(true);
	}
	setRevivePending(value) {
		this.revivePending = value;
		if(this.reviveButton != null) {
			this.reviveButton.mouseEnabled = !value;
			this.reviveButton.set_alpha(value ? 0.6 : 1);
		}
	}
	close() {
		this.setRevivePending(false);
		this.set_visible(false);
	}
	setText(name,value) {
		let field = this.panel.getChildByName(name);
		field.set_text(value);
		field.mouseEnabled = false;
	}
	layout(_) {
		let stage = openfl_Lib.get_current().stage;
		if(stage == null || this.panelLayoutBounds == null) {
			return;
		}
		this.panel.set_x((stage.stageWidth - this.panelLayoutBounds.width) / 2 - this.panelLayoutBounds.x);
		this.panel.set_y((stage.stageHeight - this.panelLayoutBounds.height) / 2 - this.panelLayoutBounds.y);
	}
}
