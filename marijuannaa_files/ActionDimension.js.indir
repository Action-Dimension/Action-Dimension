	addFilterText(txt) {
		let lastIndex = 0;
		if(this._filterRegExp != null) {
			lastIndex = 0;
			let result = com_junkbyte_console_utils_FlashRegex.exec(txt,this._filterRegExp,0);
			while(result != null) {
				let i = result.index;
				let match = result.elements[0];
				if(com_junkbyte_console_utils_FlashRegex.search(match,new EReg("<|>","")) >= 0) {
					lastIndex -= match.length - com_junkbyte_console_utils_FlashRegex.search(match,new EReg("<|>",""));
				} else if(txt.lastIndexOf("<",i) <= txt.lastIndexOf(">",i)) {
					txt = txt.substring(0,i) + "<u>" + txt.substring(i,i + match.length) + "</u>" + txt.substring(i + match.length);
					lastIndex += 7;
				}
				result = com_junkbyte_console_utils_FlashRegex.exec(txt,this._filterRegExp,lastIndex);
			}
		} else if(this._filterText != null) {
			let lowercase = txt.toLowerCase();
			let j = lowercase.lastIndexOf(this._filterText);
			while(j >= 0) {
				txt = txt.substring(0,j) + "<u>" + txt.substring(j,j + this._filterText.length) + "</u>" + txt.substring(j + this._filterText.length);
				j = lowercase.lastIndexOf(this._filterText,j - 2);
