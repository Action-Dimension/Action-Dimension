				runtimeName.setTextFormat(nameFormat);
			}
			runtimeName.set_defaultTextFormat(nameFormat);
			runtimeName.setTextFormat(nameFormat);
			nameHolder.setChildIndex(runtimeName,nameHolder.get_numChildren() - 1);
			nameHolder.set_visible(false);
			nameHolder.mouseEnabled = false;
			nameHolder.mouseChildren = false;
		}
		let clickArea = slot.getChildByName("upgrade_click_area");
		let this1 = this.modkitSlotFilled;
		let key = slot.get_name();
		this1.h[key] = modkit != null;
		if(clickArea != null) {
