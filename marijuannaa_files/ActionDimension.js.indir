		this.activeEmote = emote;
		this.activeEmoteStarted = false;
		this.activeEmoteFinished = false;
	}
	hasActiveMovementTarget() {
		let stopDistance = (this.speed | 0) + 2;
		if(!(this.get_x() <= this.targetPosition.x - stopDistance || this.get_x() >= this.targetPosition.x + stopDistance || this.get_y() <= this.targetPosition.y - stopDistance)) {
			return this.get_y() >= this.targetPosition.y + stopDistance;
		} else {
			return true;
		}
	}
	currentEmote() {
		if(this.hasActiveMovementTarget()) {
