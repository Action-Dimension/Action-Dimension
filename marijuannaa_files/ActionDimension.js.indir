e Board"],["ui.swf.agility","Çeviklik","Agility"],["ui.swf.toughness","Dayanıklılık","Toughness"],["ui.swf.toughness_alt","Sertlik"],["ui.swf.intelligence","Zekâ","Intelligence"],["ui.swf.intelligence_alt","Zeka"],["ui.swf.dexterity","Yetenek","Dexterity"],["ui.swf.health","Sağlık","Health"],["ui.swf.reward_buff","Ödül Bonusu","Reward Buff"],["ui.swf.stamina","Dayanma Gücü","Stamina"],["ui.swf.red_team","Kırmızı takım","Red team","Read team"],["ui.swf.blue_team","Mavi takım","Blue team"],["ui.swf.red_won","KIRMIZI TAKIM KAZANDI!","RED TEAM WON!"],["ui.swf.blue_won","MAVİ TAKIM KAZANDI!","BLUE TEAM WON!"],["ui.swf.draw","BERABERE!","DEAD HEAT!"],["ui.swf.match_over","MAÇ SONA ERDİ!","END OF THE MATCH!"],["ui.swf.lots_of_fun","Bolca Eğlence!","Lots of Fun!"],["ui.swf.earned","Kazandıkların:","You have earned:"],["ui.swf.next_match","Sonraki maça kalan süre:","Time till the next match:"],["ui.swf.loot","Ganimet:","Loot:"],["ui.swf.select_room","Oda Seç","Select Room"],["ui.swf.create_room","Oda Oluştur","Create Room"],["ui.swf.sync_problem","Sunucu eşitleme sorunu. Yeniden eşitleniyor, lütfen bekle.","Server sync problem. Please wait, trying to re-sync."],["ui.swf.fullscreen","Tam Ekran","Fullscreen"],["ui.swf.ether_lord","Ether Lord seni alt etti.","You got owned by Ether Lord."],["ui.swf.ok","Ok"]]);
