	frame() {
		if(this.disposed) {
			return;
		}
		let nowStamp = new Date().getTime() / 1000;
		let elapsed = Math.min(0.1,Math.max(0,nowStamp - this.previousFrameTime));
		this.previousFrameTime = nowStamp;
		if(this.model.latestState != null) {
			let h = this.playerClips.h;
			let clip_keys = Object.keys(h);
			let clip_length = clip_keys.length;
			let clip_current = 0;
			while(clip_current < clip_length) h[clip_keys[clip_current++]].advance(elapsed);
			let _g = 0;
			let _g1 = this.keeperClips;
			while(_g < _g1.length) _g1[_g++].advance(elapsed);
			this.applyInterpolation(nowStamp,elapsed);
			this.sortDepth();
			this.world.syncLabels();
		}
		let now = openfl_Lib.getTimer();
		this.updateChatTimeline(now);
		this.updatePrizeAnimation(now);
		this.updateStepSounds(now);
		this.updateMatchResultTimer();
		if(this.replayBar != null) {
			this.refreshReplayBar();
		}
		if(this.model.expireChat(now)) {
			this.refreshChat();
		}
		if(this.chatAltBarClip != null) {
			let targetY = 0;
			let _g = 0;
			let _g1 = this.chatLineFields;
			while(_g < _g1.length) {
				let line = _g1[_g];
				++_g;
				if(line.get_text() != "" && line.get_text() != "undefined") {
					targetY = line.get_y() + 20;
				}
			}
			let fh = this.chatAltBarClip;
			fh.set_y(fh.get_y() + (targetY - this.chatAltBarClip.get_y()) / 4);
		}
	}
	applyInterpolation(now,elapsed) {
		if(this.model.currentSnapshot == null) {
			return;
		}
		let t = this.model.interpolationT(now);
		let id_keys = Object.keys(this.playerClips.h);
		let id_length = id_keys.length;
		let id_current = 0;
		while(id_current < id_length) {
			let id = id_keys[id_current++];
			let clip = this.playerClips.h[id];
			let pose = this.model.playerPose(id,t);
			if(clip == null || pose == null) {
				continue;
			}
			clip.set_x(pose.x);
			clip.set_y(pose.y);
		}
		let _g = 0;
		let _g1 = this.keeperClips.length;
		while(_g < _g1) {
			let index = _g++;
			let pose = this.model.keeperPose(index,t);
			if(pose == null) {
				continue;
			}
			this.keeperClips[index].set_x(pose.x);
			this.keeperClips[index].set_y(pose.y);
		}
		let ball = this.model.ballPose(t);
		if(ball != null && this.ballClip != null) {
			this.ballClip.set_x(ball.x);
			this.ballClip.set_y(ball.y);
			if(this.ballInner != null) {
				this.ballInner.set_y(ball.z);
				this.ballInner.set_rotation(ball.rotation);
			}
			if(this.ballEffect != null) {
				this.ballEffect.set_y(ball.z);
			}
			this.updateBallSpeedEffects();
			if(this.ballClip.get_visible()) {
				this.ballClip.composeRender();
			}
		}
