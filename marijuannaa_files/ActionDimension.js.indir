	onScrollerDown(e) {
		this._scrolling = true;
		if(!this.console.get_paused() && this._atBottom) {
			this._atBottom = false;
			let p = this.get_scrollPercent();
			this._updateTraces();
			this.set_scrollPercent(p);
		}
		this._scroller.startDrag(false,new openfl_geom_Rectangle(0,UInt.toFloat(this.get_style().controlSize),0,this._scrollHeight - 30 - UInt.toFloat(this.get_style().controlSize * 2)));
		this.stage.addEventListener("mouseMove",$bind(this,this.onScrollerMove),false,0,true);
