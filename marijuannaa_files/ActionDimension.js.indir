	layoutPaintballViewport(event) {
		if(this.paintballGame == null || this.stage == null) {
			return;
		}
		let viewportScale = Math.min(this.stage.stageWidth / 735,this.stage.stageHeight / 450);
		this.paintballGame.set_scaleX(viewportScale);
		this.paintballGame.set_scaleY(viewportScale);
		this.paintballGame.set_x((this.stage.stageWidth - 735 * viewportScale) / 2);
		this.paintballGame.set_y((this.stage.stageHeight - 450 * viewportScale) / 2);
	}
	layoutTennisViewport(event) {
		if(this.stage == null) {
			return;
		}
		let target = this.tennisGame != null ? this.tennisGame : this.tennisLobby;
		if(target == null) {
			return;
		}
		let viewportScale = Math.min(this.stage.stageWidth / 735,this.stage.stageHeight / 450);
		target.set_scaleX(viewportScale);
		target.set_scaleY(viewportScale);
		target.set_x((this.stage.stageWidth - 735 * viewportScale) / 2);
		target.set_y((this.stage.stageHeight - 450 * viewportScale) / 2);
	}
	layoutSoccerViewport(event) {
		if(this.stage == null) {
			return;
		}
		let target = this.soccerGame != null ? this.soccerGame : this.soccerLobby;
		if(target == null) {
			return;
		}
		let viewportScale = Math.min(this.stage.stageWidth / 735,this.stage.stageHeight / 450);
		target.set_scaleX(viewportScale);
		target.set_scaleY(viewportScale);
		target.set_x((this.stage.stageWidth - 735 * viewportScale) / 2);
		target.set_y((this.stage.stageHeight - 450 * viewportScale) / 2);
	}
	showLevelUpPrompt(data,onConfirm) {
		if(this.levelUpWindow == null || this.paintballGame != null || this.tennisGame != null || this.soccerGame != null) {
			return;
		}
		this.levelUpWindow.showPending(data,onConfirm);
		this.bringOverlaysToFront();
	}
	resolveLevelUp(data) {
		if(this.levelUpWindow == null || this.paintballGame != null || this.tennisGame != null || this.soccerGame != null) {
			return;
		}
		this.levelUpWindow.resolveConfirmation(data);
		this.bringOverlaysToFront();
	}
	bringOverlaysToFront() {
		if(this.popupMessage != null && this.popupMessage.parent == this) {
			this.setChildIndex(this.popupMessage,this.get_numChildren() - 1);
		}
		if(this.levelUpWindow != null && this.levelUpWindow.parent == this) {
			this.setChildIndex(this.levelUpWindow,this.get_numChildren() - 1);
		}
		if(this.windowHelp != null && this.windowHelp.parent == this) {
			this.setChildIndex(this.windowHelp,this.get_numChildren() - 1);
		}
		if(this.fpsCounter != null && this.fpsCounter.parent == this) {
			this.setChildIndex(this.fpsCounter,this.get_numChildren() - 1);
		}
		if(this.pingCounter != null && this.pingCounter.parent == this) {
			this.setChildIndex(this.pingCounter,this.get_numChildren() - 1);
		}
		if(this.paintballLoadingOverlay != null && this.paintballLoadingOverlay.parent == this) {
			this.setChildIndex(this.paintballLoadingOverlay,this.get_numChildren() - 1);
		}
	}
	showReconnecting(value) {
		this.reconnecting = value;
		this.applyStatsHudVisibility();
		if(this.pingCounter == null) {
			return;
		}
		if(value) {
			this.pingCounter.set_text(core_i18n_I18n.t("connection.reconnecting"));
			this.pingCounter.set_textColor(16766044);
		} else {
			this.updateNetworkPing(null);
		}
	}
	toggleStatsHud() {
		this.statsHudVisible = !this.statsHudVisible;
		this.applyStatsHudVisibility();
		this.saveStatsHudPreference();
		return this.statsHudVisible;
	}
	loadStatsHudPreference() {
		try {
			let storage = js_Browser.getLocalStorage();
			if(storage != null) {
				return storage.getItem("minetica.statsHud") == "1";
			}
		} catch( _g ) {
			haxe_NativeStackTrace.lastError = _g;
		}
		return false;
	}
	saveStatsHudPreference() {
		try {
			let storage = js_Browser.getLocalStorage();
			if(storage != null) {
				storage.setItem("minetica.statsHud",this.statsHudVisible ? "1" : "0");
			}
		} catch( _g ) {
			haxe_NativeStackTrace.lastError = _g;
		}
	}
	applyStatsHudVisibility() {
		if(this.fpsCounter != null) {
			this.fpsCounter.set_visible(this.statsHudVisible);
		}
		if(this.pingCounter != null) {
			this.pingCounter.set_visible(this.statsHudVisible || this.reconnecting);
		}
	}
	noteFrame(_) {
		let now = openfl_Lib.getTimer();
		if(this.lastFrameAt > 0) {
			this.frameGaps.push({ at : now, gap : now - this.lastFrameAt});
			while(this.frameGaps.length > 0 && now - this.frameGaps[0].at > 10000) this.frameGaps.shift();
		}
		this.lastFrameAt = now;
	}
	longestFrameGapMs() {
		let best = 0;
		let _g = 0;
		let _g1 = this.frameGaps;
		while(_g < _g1.length) {
			let entry = _g1[_g];
			++_g;
			if(entry.gap > best) {
				best = entry.gap;
			}
		}
		return Math.round(best);
	}
	updateNetworkPing(pingMs,peakMs) {
		this.wsPingMs = pingMs;
		this.wsPeakMs = peakMs;
		this.renderPing();
	}
	updateRtcPing(pingMs,provider,peakMs) {
		if(provider == null) {
			provider = "";
		}
		this.rtcPingMs = pingMs;
		this.rtcPeakMs = peakMs;
		this.rtcProvider = provider == null ? "" : provider;
		this.renderPing();
	}
	renderPing() {
		if(this.pingCounter == null || this.reconnecting) {
			return;
		}
		let viaRtc = this.rtcPingMs != null;
		let value = viaRtc ? this.rtcPingMs : this.wsPingMs;
		let peak = viaRtc ? this.rtcPeakMs : this.wsPeakMs;
		this.pingCounter.set_autoSize(1);
		if(value == null) {
			this.pingCounter.set_text("Ping: -- ms");
			this.pingCounter.set_textColor(16777215);
			return;
		}
		let peakText = peak != null && peak > value + 5 ? " (" + core_i18n_I18n.t("hud.ping_peak",{ value : peak}) + ")" : "";
		let frameGap = this.longestFrameGapMs();
		let frameText = frameGap > 100 ? " | " + core_i18n_I18n.t("hud.frame_max",{ value : frameGap}) : "";
		let route = this.rtcProvider == "cloudflare" ? "WebRTC Cloudflare" : this.rtcProvider == "direct" ? core_i18n_I18n.t("hud.route_direct") : "WebRTC";
		this.pingCounter.set_text("Ping: " + value + " ms" + peakText + (viaRtc ? " (" + route + ")" : "") + frameText);
		this.pingCounter.set_textColor(value <= 80 ? 7529842 : value <= 150 ? 16766044 : 16739179);
	}
	gameConnected(userData) {
		this.rememberCharacterName(userData);
		this.rememberTutorialRequirement(userData);
		events_GlobalEventDispatcher.addEventListener(events_ColyseusServerEvent.CONNECTED,$bind(this,this.onConnected));
		events_GlobalEventDispatcher.addEventListener(events_ColyseusServerEvent.ERROR,$bind(this,this.onErrorMessage));
		let errorEvents = openfl_Lib.get_current().get_loaderInfo() != null ? openfl_Lib.get_current().get_loaderInfo().uncaughtErrorEvents : null;
		if(errorEvents != null) {
			errorEvents.addEventListener("uncaughtError",$bind(this,this.onUncaughtError));
		}
		events_GlobalEventDispatcher.addEventListener(events_ColyseusPlayerEvent.JOINED,$bind(this,this.onJoined));
		events_GlobalEventDispatcher.addEventListener(events_ColyseusPlayerEvent.LEAVED,$bind(this,this.onLeaved));
		let connectionModel = this.serverModel;
		if(userData != null && (userData.map == "paintball" || userData.map == "tennis" || userData.map == "soccer")) {
			connectionModel.connect(userData);
			return;
		}
		let _gthis = this;
		atlas_AtlasLibrary.load("map_item_library2").onComplete(function(_) {
			atlas_AtlasLibrary.load("pet_library").onComplete(function(_) {
				atlas_AtlasLibrary.load("playable_item").onComplete(function(_) {
					connectionModel.connect(userData);
					_gthis.startLobbyScene();
				}).onError(function(error) {
					if(_gthis.popupMessage != null) {
						_gthis.popupMessage.showMessage(core_i18n_I18n.t("error.playable_assets",{ error : Std.string(error)}));
					}
				});
			}).onError(function(error) {
				if(_gthis.popupMessage != null) {
					_gthis.popupMessage.showMessage(core_i18n_I18n.t("error.pet_assets",{ error : Std.string(error)}));
				}
			});
		}).onError(function(error) {
			if(_gthis.popupMessage != null) {
				_gthis.popupMessage.showMessage(core_i18n_I18n.t("error.map_assets",{ error : Std.string(error)}));
			}
		});
	}
	showErrorAfterSceneChange(message) {
		if(message == null || message.length == 0) {
			return;
		}
		if(this.scene != null) {
			this.showError(message);
			return;
		}
		this.pendingSceneError = message;
	}
