		this.setPaintballMetric("text_ammo","ammo_bar",core_i18n_I18n.t("item.metric.ammo"),ammo / 130);
		this.setPaintballMetric("text_speed","speed_bar",core_i18n_I18n.t("item.metric.projectile_speed"),speed / 20);
		this.setPaintballMetric("text_accuracy","accuracy_bar",core_i18n_I18n.t("item.metric.accuracy"),accuracy / 20);
