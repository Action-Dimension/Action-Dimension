		openfl_events_EventDispatcher._hx_skip_constructor = true;
		super();
		openfl_events_EventDispatcher._hx_skip_constructor = false;
		this._hx_constructor(game,serverModel,characterName,onPick,onClose);
	}
	_hx_constructor(game,serverModel,characterName,onPick,onClose) {
		this.closed = false;
		super._hx_constructor();
		this.game = game;
		this.list = new avatar_model_RoomListModel(game,serverModel,game == "paintball" ? avatar_view_RoomBrowser.paintballModeLabel : null);
		if(game == "paintball") {
			this.list.difficultyLabel = avatar_view_RoomBrowser.difficultyName;
		}
		this.characterName = avatar_view_RoomBrowser.cleanRoomName(characterName,core_i18n_I18n.t("tennis_lobby.player"));
		this.onPick = onPick;
		let stageRef = openfl_Lib.get_current().stage;
		let tmp;
		switch(game) {
		case "paintball":
			tmp = avatar_view_RoomBrowser.paintballConfig($bind(this,this.defaultRoomName));
			break;
		case "soccer":
			tmp = avatar_view_RoomBrowser.soccerConfig($bind(this,this.defaultRoomName));
			break;
		default:
			tmp = avatar_view_RoomBrowser.tennisConfig($bind(this,this.defaultRoomName));
		}
		this.browser = new avatar_view_RoomBrowser(tmp,stageRef.stageWidth,stageRef.stageHeight,false);
		this.browser.onRefresh = $bind(this,this.refresh);
		let _gthis = this;
		this.browser.onClose = function() {
			_gthis.closed = true;
			_gthis.list.cancel();
			onClose();
		};
		this.browser.onJoin = function(id) {
			_gthis.pickJoin(id);
		};
		let staff = Action.instance != null && Action.instance.isStaffUser();
		this.browser.onWatch = function(id) {
			_gthis.pickJoin(id,true);
		};
		this.browser.canWatch = function(listing) {
			if(!(game == "tennis" || game == "soccer" || staff)) {
				return listing.gameType == 4;
			} else {
				return true;
			}
		};
		this.browser.onReplays = function() {
			onPick({ kind : "replays"});
		};
		this.browser.onCreate = $bind(this,this.pickCreate);
		this.addChild(this.browser);
		this.refresh();
	}
	defaultRoomName() {
		return core_i18n_I18n.t("room_browser.default_name",{ name : this.characterName});
	}
	reopen() {
		if(this.closed) {
			return;
		}
		this.set_visible(true);
		this.browser.clearStatus();
		this.refresh();
	}
	refresh() {
		if(this.closed) {
			return;
		}
		this.browser.showProgress(core_i18n_I18n.t("room_browser.refreshing"));
		let _gthis = this;
		this.list.refresh(function(error,listings) {
			if(_gthis.closed) {
				return;
			}
			if(error != null) {
				_gthis.browser.showError(core_i18n_I18n.t("tennis_lobby.list_failed"));
				return;
			}
			_gthis.browser.setRooms(listings);
			if(_gthis.game == "paintball" && Action.instance != null && Action.instance.serverModel != null) {
				_gthis.browser.setDifficulties(avatar_view_RoomBrowser.paintballDifficultiesFor(Action.instance.serverModel.paintballDifficulties));
			}
			_gthis.browser.clearStatus();
		});
	}
	pickJoin(roomId,watchOnly) {
		if(watchOnly == null) {
			watchOnly = false;
		}
		if(this.list.get(roomId) == null) {
			return;
		}
		this.browser.showProgress(core_i18n_I18n.t(watchOnly ? "room_browser.watching" : "room_browser.joining"));
		this.onPick({ kind : watchOnly ? "watch" : "join", roomId : roomId});
	}
	pickCreate(request) {
		this.browser.showProgress(core_i18n_I18n.t("room_browser.creating"));
		this.onPick({ kind : "create", request : request});
	}
}
