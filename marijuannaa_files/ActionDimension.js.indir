			optionsText.set_text(core_i18n_I18n.t("menu.settings"));
		}
		this.inventoryOpenBtn = this.menu.getChildByName("char_menu_inventory_open_button");
		let statsOpenBtn = this.menu.getChildByName("char_menu_stats_open_button");
		let skillsOpenBtn = this.menu.getChildByName("char_menu_skills_open_button");
		this.buddyListOpenBtn = this.menu.getChildByName("char_menu_buddy_list_open_button");
		this.exitBtn = this.menu.getChildByName("main_menu_admin_menu_button");
		let petMenuOpenBtn = this.menu.getChildByName("char_menu_my_pet_open_button");
		let teamOpenBtn = this.menu.getChildByName("char_menu_teams_open_button");
		let leaderboardOpenBtn = this.menu.getChildByName("char_menu_leaderboard_open_button");
		let optionsOpenBtn = this.menu.getChildByName("char_menu_options_open_button");
		this.addMenuHoverEffect(teamOpenBtn);
