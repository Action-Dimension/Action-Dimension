		this.changed = changed;
		let _gthis = this;
		this.prev = avatar_view_social_SocialUI.button(parent,"‹",34,function() {
			_gthis.go(_gthis.page - 1);
		});
		this.caption = avatar_view_social_SocialUI.label(parent,"",68,28,14,"#44351f");
		this.caption.set_verticalAlign("center");
		let fh = this.caption;
		fh.set_styleString(fh.get_styleString() + "text-align: center;");
