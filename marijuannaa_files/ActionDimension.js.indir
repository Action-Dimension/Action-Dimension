		playerClip.player_swimming = false;
		playerClip.spawn_shield.set_visible(false);
		playerClip.elevation_height = this.player_elevation_height_stand;
		playerClip.player_death_anim.set_visible(false);
		atlas_AtlasTools.child(playerClip.grenade_bar_holder,"grenade_bar").set_visible(false);
		data.camo = 0;
		data.spawn_shield_expiry = 0;
		data.spawn_shield_dimmed = false;
		if(playerClip.pholder_inner != null) {
			playerClip.pholder_inner.set_alpha(1);
		}
		data.kills = 0;
		data.deaths = 0;
		if(pl < this._paintball.matchModel.bot_player_id_start) {
			data.hp = 100;
		}
		data.healedbypl = 0;
		data.suppliedbypl = 0;
		data.weapon_rotation = 1;
		data.hpmax = 100;
		data.speed_x = 0;
		data.speed_y = 0;
		data.target_x = playerClip.get_x();
		data.target_y = playerClip.get_y();
		playerClip.sim_prev_x = playerClip.get_x();
		playerClip.sim_prev_y = playerClip.get_y();
		playerClip.sim_curr_x = playerClip.get_x();
		playerClip.sim_curr_y = playerClip.get_y();
		data.crouch = 0;
		data.killedby = 0;
		data.laser_x = 0;
		data.laser_y = 0;
		data.laser_drawn_to_indicator = "";
		playerClip.anim_mc = "p_anim1";
		playerClip.player_id = pl | 0;
		playerClip.player_name = name;
		playerClip.user_id = uid | 0;
		playerClip.animate = 1;
		playerClip.anim_reset_timer = 0;
		playerClip.roll_timer = 0;
		data.move_side = 1;
		playerClip.move_side_backup = 1;
		playerClip.swim_mask.set_visible(false);
		playerClip.step_sound_time = 0;
		let m_plid = pl | 0;
		this.player_array_map[m_plid] = this.player_array.length;
		this.player_clips[pl] = this._paintball.tileWorld.content.addTile(playerClip);
		this._paintball.tileWorld.registerCullable(playerClip);
		this._paintball.tileWorld.addAnchoredDisplay(playerClip.nameAnchorTile,playerClip.name_holder);
		this.player_array[this.player_array.length] = this.player_clips[pl];
		this._paintball.particleModel.player_utility_array_map[m_plid] = -1;
		let smallMapIndicator = new SmallMapIndicator();
