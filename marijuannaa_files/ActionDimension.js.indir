		skinNextBtn.addEventListener("mouseDown",function(e) {
			_gthis.skinIndex++;
			if(_gthis.skinIndex >= skinLength) {
				_gthis.skinIndex = 0;
			}
			_gthis.character.changeSkin(_gthis.skinIndex);
		});
		skinPrevBtn.addEventListener("mouseDown",function(e) {
			_gthis.skinIndex--;
			if(_gthis.skinIndex < 0) {
				_gthis.skinIndex = skinLength - 1;
			}
			_gthis.character.changeSkin(_gthis.skinIndex);
		});
		eyesNextBtn.addEventListener("mouseDown",function(e) {
			_gthis.eyesIndex++;
			if(_gthis.eyesIndex >= eyesLength) {
				_gthis.eyesIndex = 0;
			}
			_gthis.character.changeEyes(_gthis.eyesIndex);
		});
		eyesPrevBtn.addEventListener("mouseDown",function(e) {
			_gthis.eyesIndex--;
			if(_gthis.eyesIndex < 0) {
				_gthis.eyesIndex = eyesLength - 1;
			}
			_gthis.character.changeEyes(_gthis.eyesIndex);
		});
		mouthNextBtn.addEventListener("mouseDown",function(e) {
			_gthis.mouthIndex++;
			if(_gthis.mouthIndex >= mouthLength) {
				_gthis.mouthIndex = 0;
			}
			_gthis.character.changeMouth(_gthis.mouthIndex);
		});
		mouthPrevBtn.addEventListener("mouseDown",function(e) {
			_gthis.mouthIndex--;
			if(_gthis.mouthIndex < 0) {
				_gthis.mouthIndex = mouthLength - 1;
			}
			_gthis.character.changeMouth(_gthis.mouthIndex);
		});
		hairNextBtn.addEventListener("mouseDown",function(e) {
			_gthis.hairIndex++;
			if(_gthis.hairIndex >= hairLength) {
				_gthis.hairIndex = 0;
			}
			_gthis.character.changeHair(_gthis.hairIndex);
		});
		hairPrevBtn.addEventListener("mouseDown",function(e) {
			_gthis.hairIndex--;
			if(_gthis.hairIndex < 0) {
				_gthis.hairIndex = hairLength - 1;
			}
			_gthis.character.changeHair(_gthis.hairIndex);
		});
		genderMaleBtn.addEventListener("mouseDown",function(e) {
			_gthis.selectGender("male");
		});
		genderFemaleBtn.addEventListener("mouseDown",function(e) {
			_gthis.selectGender("female");
		});
		let popupMessage = new avatar_view_PopupMessage();
		let test = false;
		doneBtn.addEventListener("mouseDown",function(e) {
			if(test == true) {
				return;
			}
			let enteredName = characterName.get_text();
			if(StringTools.trim(enteredName).length == 0) {
				popupMessage.showMessage(core_i18n_I18n.t("character.name_required"));
				return;
			}
			if(enteredName.length < 3) {
				popupMessage.showMessage(core_i18n_I18n.t("character.name_too_short",{ count : 3}));
				return;
			}
			if(enteredName.length > 15) {
				popupMessage.showMessage(core_i18n_I18n.t("character.name_too_long",{ count : 15}));
				return;
			}
			if(new EReg("[^A-Za-z0-9]","").match(enteredName)) {
				popupMessage.showMessage(core_i18n_I18n.t("character.name_invalid"));
				return;
			}
			characterName.set_text(enteredName);
			test = true;
			Action.instance.loginRegisterModel.creatorCharacter(enteredName,_gthis.skinIndex,_gthis.hairIndex,_gthis.mouthIndex,_gthis.eyesIndex,_gthis.gender,userData,function(response) {
				if(response.error == false) {
					Action.instance.gameConnected(response.output.user);
					_gthis.set_visible(false);
				} else {
					let message = response != null && (response.messageKey != null || response.message != null) ? core_i18n_I18n.resolve(response) : "";
					popupMessage.showMessage(message.length == 0 ? core_i18n_I18n.t("character.create_failed") : message);
				}
				test = false;
			});
		});
		this.addChild(this.panel);
		avatar_view_WindowDrag.attachSwf(this.panel);
		this.addChild(popupMessage);
	}
	rememberAppearance() {
		if(this.gender == "female") {
			this.femaleSkinIndex = this.skinIndex;
			this.femaleHairIndex = this.hairIndex;
			this.femaleEyesIndex = this.eyesIndex;
			this.femaleMouthIndex = this.mouthIndex;
		} else {
			this.maleSkinIndex = this.skinIndex;
			this.maleHairIndex = this.hairIndex;
			this.maleEyesIndex = this.eyesIndex;
			this.maleMouthIndex = this.mouthIndex;
		}
	}
	restoreAppearance(nextGender) {
		if(nextGender == "female") {
			this.skinIndex = this.femaleSkinIndex;
			this.hairIndex = this.femaleHairIndex;
			this.eyesIndex = this.femaleEyesIndex;
			this.mouthIndex = this.femaleMouthIndex;
		} else {
			this.skinIndex = this.maleSkinIndex;
			this.hairIndex = this.maleHairIndex;
			this.eyesIndex = this.maleEyesIndex;
			this.mouthIndex = this.maleMouthIndex;
		}
	}
	applyAppearance() {
		this.character.changeSkin(this.skinIndex);
		this.character.changeHair(this.hairIndex);
		this.character.changeEyes(this.eyesIndex);
		this.character.changeMouth(this.mouthIndex);
	}
	selectGender(nextGender) {
		if(nextGender == this.gender) {
			return;
		}
		this.rememberAppearance();
		this.gender = nextGender;
		this.restoreAppearance(this.gender);
		this.character.changeGender(this.gender);
		this.applyAppearance();
	}
}
