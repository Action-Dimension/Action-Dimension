	sortDepth() {
		let active = [];
		let h = this.playerClips.h;
		let clip_keys = Object.keys(h);
		let clip_length = clip_keys.length;
		let clip_current = 0;
		while(clip_current < clip_length) {
			let clip = h[clip_keys[clip_current++]];
			if(clip != null && clip.parent == this.world.content) {
				active.push(clip);
			}
		}
		if(this.ballClip != null && this.ballClip.parent == this.world.content) {
			active.push(this.ballClip);
		}
		if(this.throwerClip != null && this.throwerClip.get_visible() && this.throwerClip.parent == this.world.content) {
			active.push(this.throwerClip);
		}
		if(this.railClip != null && this.railClip.get_visible() && this.railClip.parent == this.world.content) {
			active.push(this.railClip);
		}
		active.sort(function(a,b) {
			let ay = a.get_y();
			let by = b.get_y();
			if(ay < by) {
				return -1;
			} else if(ay > by) {
				return 1;
			} else {
				return 0;
			}
		});
		let index = 1;
		let _g = 0;
		while(_g < active.length) this.world.content.setTileIndex(active[_g++],index++);
	}
	removePlayer(id) {
		let clip = this.playerClips.h[id];
		if(clip != null) {
			this.world.removeContent(clip);
			HxOverrides.remove(this.depthTiles,clip);
		}
		let label = this.playerLabels.h[id];
		if(label != null) {
			this.world.removeAnchoredDisplay(label);
		}
		let _this = this.playerClips;
		if(Object.prototype.hasOwnProperty.call(_this.h,id)) {
			delete(_this.h[id]);
		}
		let _this1 = this.playerLabels;
		if(Object.prototype.hasOwnProperty.call(_this1.h,id)) {
			delete(_this1.h[id]);
		}
		this.model.forgetPlayer(id);
	}
	hideBallEffect() {
		this.updateBallEffect(0);
	}
	updateBallEffect(selectedEffect) {
		if(this.ballEffect == null) {
			return;
		}
		this.ballEffect.set_visible(selectedEffect > 0);
		this.ballEffect.set_alpha(selectedEffect > 0 ? 1 : 0);
		this.ballEffect.set_x(selectedEffect > 0 ? 0.1 : -10000);
		let _g = 0;
		let _g1 = [9,10,11,14];
		while(_g < _g1.length) {
			let effectId = _g1[_g];
			++_g;
			let effect = this.ballEffect._player.getSymbolByName("effect_" + effectId);
			if(effect == null) {
				continue;
			}
			let active = selectedEffect == effectId;
			effect.set_visible(active);
			effect.set_alpha(active ? 1 : 0);
			effect.set_x(active ? -0.65 : -10000);
		}
		if(this.ballClip != null) {
			this.ballClip.composeRender();
		}
	}
	frame() {
		if(this.disposed) {
			return;
		}
		let nowStamp = new Date().getTime() / 1000;
		let elapsed = Math.min(0.1,Math.max(0,nowStamp - this.previousFrameTime));
		this.previousFrameTime = nowStamp;
		if(this.model.latestState != null) {
			let h = this.playerClips.h;
			let clip_keys = Object.keys(h);
			let clip_length = clip_keys.length;
			let clip_current = 0;
			while(clip_current < clip_length) {
				let clip = h[clip_keys[clip_current++]];
				clip.character.updateFrame(elapsed);
				clip.character.animateHandler();
			}
			this.applyInterpolation(nowStamp);
			this.sortDepth();
			this.world.syncLabels();
		}
		let now = openfl_Lib.getTimer();
		this.updateChatTimeline(now);
		this.updatePrizeAnimation(now);
		this.updateStepSounds(now);
		if(this.model.expireChat(now)) {
			this.refreshChat();
		}
		if(this.chatAltBarClip != null) {
			let targetY = 0;
			let _g = 0;
			let _g1 = this.chatLineFields;
			while(_g < _g1.length) {
				let line = _g1[_g];
				++_g;
				if(line.get_text() != "" && line.get_text() != "undefined") {
					targetY = line.get_y() + 22;
