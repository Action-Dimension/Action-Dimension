			this.client_predicted_fire_ammo--;
			this.client_predicted_fire_timer = this._paintball.frameModel.sim_time + Math.max(1,selectedWeapon[4] | 0);
			this._paintball.playerModel.animate_weapon(this._paintball.state.playerId);
			return;
