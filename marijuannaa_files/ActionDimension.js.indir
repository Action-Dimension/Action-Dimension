		let item_current = 0;
		while(item_current < item_length) {
			let item = h1[item_keys[item_current++]];
			if(item.item_category != "suite_item" || item.suite_frames == null) {
				continue;
			}
			if(item.is_equipped == true && item.suite_frames.indexOf(itemFrame) > -1) {
				Action.instance.ui.inventoryItemsData.h[item.id].is_equipped = false;
