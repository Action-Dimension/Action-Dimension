	updateScroller() {
		if(this._traceField.get_maxScrollV() <= 1) {
			this._scroll.set_visible(false);
		} else {
			this._scroll.set_visible(true);
			if(this._atBottom) {
				this.set_scrollPercent(1);
			} else {
				this.set_scrollPercent((this._traceField.get_scrollV() - 1) / (this._traceField.get_maxScrollV() - 1));
			}
		}
	}
	onScrollbarDown(e) {
		if(this._scroller.get_visible() && this._scroller.get_mouseY() > 0 || !this._scroller.get_visible() && this._scroll.get_mouseY() > this._scrollHeight / 2) {
