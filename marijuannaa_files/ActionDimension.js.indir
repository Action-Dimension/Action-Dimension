			}
		}
		let getMapColor = this.readMapColor(x,y);
		this.mapColor = getMapColor;
		if(getMapColor == 0) {
			return true;
		}
		return false;
	}
	checkCollision() {
		let angle = this.calculateAngle(this.get_x(),this.get_y(),this.targetPosition.x,this.targetPosition.y) + 22;
		if(this.checkAllCollision(this.get_x() + this.velocity.x,this.get_y() + this.velocity.y)) {
			let _loc15_ = true;
			let _loc16_ = 1;
			let _loc12_ = 0;
			while(_loc16_ <= 6) {
				let _loc17_ = 0;
				while(_loc17_ < 2) {
					if(_loc17_ == 0) {
						_loc12_ = angle - _loc16_ * 15;
					}
					if(_loc17_ == 1) {
						_loc12_ = angle + _loc16_ * 15;
					}
					if(_loc12_ < 0) {
						_loc12_ = 360 + _loc12_;
					}
					if(_loc12_ > 360) {
						_loc12_ -= 360;
					}
					let _loc13_ = this.calculateVectorX(this.speed,_loc12_);
					let _loc14_ = this.calculateVectorY(this.speed,_loc12_);
					if(this.checkAllCollision(this.get_x() + _loc13_,this.get_y() + _loc14_) == false) {
						this.velocity.x = _loc13_;
						this.velocity.y = _loc14_;
						_loc15_ = false;
						_loc16_ = 7;
						_loc17_ = 2;
					}
					++_loc17_;
				}
				++_loc16_;
			}
			if(_loc15_) {
				this.velocity.x = 0;
				this.velocity.y = 0;
				this.targetPosition.setTo(this.get_x(),this.get_y());
			}
		}
	}
	playerMovement() {
		if(this.velocity.x == 0 && this.velocity.y == 0) {
			return;
		}
		if(this.hasActiveMovementTarget()) {
			let swim_value = avatar_view_scene_PlayerSprite.swimMaskValue(this.mapColor);
			if(swim_value > 0) {
				if(swim_value < 50) {
					if(swim_value > 35) {
						this.curAnimateState = type_PlayerAnimateState.SWIM;
					} else {
						this.curAnimateState = type_PlayerAnimateState.WALK;
					}
					this.updateSwimMask(swim_value);
				}
			} else {
				this.curAnimateState = type_PlayerAnimateState.WALK;
				this.characterIndicatorVisible = true;
				this.clearSwimMask();
			}
			if(this.isActiveJetpack) {
				this.curAnimateState = type_PlayerAnimateState.IDLE;
				if(this.jetpackFlameSprite != null) {
					this.jetpackFlameSprite.set_visible(true);
					this.jetpackFlameSprite.set_loopMode(0);
				}
				let test = (this.jetpack_flight_height - this.body.get_y()) / 25;
				let fh = this.body;
				fh.set_y(fh.get_y() + test);
				this.syncNameIndicatorY();
				if(this.body.get_y() < this.jetpack_flight_height) {
					this.body.set_y(this.jetpack_flight_height);
					this.syncNameIndicatorY();
				}
			}
			if(this.targetPosition.x != this.get_x()) {
				if(this.targetPosition.x > this.get_x()) {
					this.side = type_PlayerDirection.RIGHT;
				} else {
					this.side = type_PlayerDirection.LEFT;
				}
			}
			if(this.isNpc) {
				return;
			}
			if(this.mountingPhase != 2 && this.mountingPhase != 3) {
				this.checkCollision();
			}
		} else {
			if(this.curAnimateState != type_PlayerAnimateState.HIGHFIVE && this.curAnimateState != type_PlayerAnimateState.MAKEOUT && this.curAnimateState != type_PlayerAnimateState.SIT && this.curAnimateState != type_PlayerAnimateState.LIE_DOWN && this.curAnimateState != type_PlayerAnimateState.DANCE2) {
				this.curAnimateState = type_PlayerAnimateState.IDLE;
			}
			this.velocity.x = 0;
			this.velocity.y = 0;
		}
	}
	update() {
		if(this.mounting && this.mountingPhase == 2) {
			this.targetPosition.setTo(this.mounting_x,this.mounting_y);
		}
		let angle = this.calculateAngle(this.get_x(),this.get_y(),this.targetPosition.x,this.targetPosition.y) + 22;
		let vx = this.calculateVectorX(this.speed,angle);
		let vy = this.calculateVectorY(this.speed,angle);
		this.velocity.x = vx;
		this.velocity.y = vy;
		this.animateHandler();
		this.playerMovement();
		if(this.mounting) {
			switch(this.mountingPhase) {
			case 1:
				if(this.velocity.x == 0 && this.velocity.y == 0) {
					this.mountingPhase = 2;
					this.targetPosition.setTo(this.mounting_x,this.mounting_y);
				}
				break;
			case 2:
				if(this.velocity.x == 0 && this.velocity.y == 0) {
					this.side = this.mounting_side;
					this.curAnimateState = this.mounting_anim;
					if(!this.mountingConfirmed && this.playerConnectionState != null && this.playerConnectionState.itsMe) {
						this.mountingConfirmed = true;
						Action.instance.playerModel.confirmMounting(this.mounting_prep_x,this.mounting_prep_y,this.mounting_x,this.mounting_y,this.mounting_side == type_PlayerDirection.LEFT ? 0 : 1,this.mounting_anim == type_PlayerAnimateState.LIE_DOWN ? "lie_down" : "sit");
					}
				}
				break;
			case 3:
				if(this.velocity.x == 0 && this.velocity.y == 0) {
					this.cancelMount();
					this.move(this.mounting_backup_x,this.mounting_backup_y);
