			g.lineTo(sx,middle);
			g.lineTo(tx,middle);
		}
		g.lineTo(tx,ty);
		g.lineStyle();
		g.beginFill(15540245,0.95);
		g.moveTo(tx,ty);
		g.lineTo(tx - 17 * Math.cos(angle) + 10 * Math.sin(angle),ty - 17 * Math.sin(angle) - 10 * Math.cos(angle));
		g.lineTo(tx - 17 * Math.cos(angle) - 10 * Math.sin(angle),ty - 17 * Math.sin(angle) + 10 * Math.cos(angle));
		g.lineTo(tx,ty);
		g.endFill();
	}
	redrawIntroBackdrop(stageWidth,stageHeight) {
