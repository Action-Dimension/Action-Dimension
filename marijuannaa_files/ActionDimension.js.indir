class avatar_view_MinifalLogo extends openfl_display_Bitmap {
	constructor(targetWidth) {
		if(targetWidth == null) {
			targetWidth = 240;
		}
		super(openfl_utils_Assets.getBitmapData("assets/images/other_images/minifal_logo.png"));
		this.smoothing = true;
		if(this.get_bitmapData() != null && this.get_bitmapData().width > 0) {
			let logoScale = targetWidth / this.get_bitmapData().width;
			this.set_scaleX(logoScale);
			this.set_scaleY(logoScale);
		}
	}
}
