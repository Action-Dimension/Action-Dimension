			playerClip.set_y(0);
			data.target_x = -1000;
			data.target_y = 0;
			data.speed = 6.5;
			data.teleport = true;
		} else {
			playerClip.stamina_indicator.set_visible(true);
			if(this._paintball.state.npc_team_enabled) {
				if(pl < this._paintball.matchModel.bot_player_id_start) {
					data.tmid = 1;
				} else {
					data.tmid = 2;
				}
			} else if(this._paintball.state.teams_enabled) {
				if(this.team_1_array.length <= this.team_2_array.length) {
					data.tmid = 1;
				} else {
					data.tmid = 2;
				}
			} else {
