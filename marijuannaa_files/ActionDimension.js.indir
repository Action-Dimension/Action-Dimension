		this.panelHolder = new openfl_display_Sprite();
		this.panelHolder.addChild(this.panelView);
		this.panelHolder.set_visible(false);
		this.addChild(this.panelHolder);
		this.centerPanel();
		let header = this.panelView.findComponent("mailboxHeader",haxe_ui_core_Component);
		if(header != null) {
			let area = new openfl_geom_Rectangle(0,0,620.0,500.0);
			new avatar_view_WindowDrag(this.panelHolder,header,function() {
				return area;
			});
		}
		this.panelHolder.addEventListener("mouseDown",function(_) {
			if(Action.instance != null && Action.instance.ui != null) {
				Action.instance.ui.blockedClick = true;
			}
		});
		this.setCategory("request");
		this.showInbox();
	}
	layoutButton(x,y) {
		if(this.buttonView == null) {
			return;
		}
		this.buttonView.set_x(Math.round(x));
		this.buttonView.set_y(Math.round(y));
		if(this.panelHolder != null && this.panelHolder.get_visible()) {
			this.centerPanel();
		}
	}
	centerPanel() {
		if(this.panelHolder == null) {
			return;
		}
		let stage = openfl_Lib.get_current().stage;
		let sw = stage == null ? 1176.0 : stage.stageWidth;
		let sh = stage == null ? 720.0 : stage.stageHeight;
		let scale = Math.min(0.9,Math.min(sw * 0.8 / 620.0,sh * 0.8 / 500.0));
		this.panelHolder.set_scaleX(this.panelHolder.set_scaleY(scale));
		this.panelHolder.set_x(Math.round((sw - 620.0 * scale) / 2));
		this.panelHolder.set_y(Math.round((sh - 500.0 * scale) / 2));
	}
	refresh() {
		if(this.pending) {
			return;
		}
		this.pending = true;
		let _gthis = this;
		net_Mailbox.load(core_i18n_I18n.get_language(),function(error,view) {
			_gthis.pending = false;
			if(error != null) {
				if(_gthis.announcements.length == 0 && _gthis.threads.length == 0) {
					_gthis.showEmpty(core_i18n_I18n.t("announce.failed"));
				}
				return;
			}
			_gthis.announcements = view.announcements;
			_gthis.threads = view.threads;
			_gthis.unreadAnnouncements = _gthis.countUnreadAnnouncements();
			_gthis.unreadReplies = _gthis.countUnreadReplies();
			if(_gthis.panelHolder != null && _gthis.panelHolder.get_visible()) {
				_gthis.unreadAnnouncements = 0;
				_gthis.unreadReplies = 0;
				_gthis.render();
			}
			_gthis.setBadge(_gthis.unreadAnnouncements + _gthis.unreadReplies);
		});
	}
	onAnnouncementReceived() {
		this.refresh();
	}
	countUnreadAnnouncements() {
		let marker = core_audio_GameSettings.lastReadAnnouncement;
		if(marker == null || marker == "") {
			return this.announcements.length;
		}
		let count = 0;
		let _g = 0;
		let _g1 = this.announcements;
		while(_g < _g1.length) {
			if(_g1[_g++].id == marker) {
				return count;
			}
			++count;
		}
		return this.announcements.length;
	}
	countUnreadReplies() {
		let total = 0;
		let _g = 0;
		let _g1 = this.threads;
		while(_g < _g1.length) total += _g1[_g++].unread;
		return total;
	}
	setBadge(count) {
		if(this.badge == null) {
			return;
		}
		this.badge.set_hidden(count <= 0);
		if(this.badgeCount != null) {
			this.badgeCount.set_text(count > 9 ? 9 + "+" : count == null ? "null" : "" + count);
		}
	}
	toggle() {
		if(this.panelHolder == null) {
			return;
		}
		if(this.panelHolder.get_visible()) {
			this.hidePanel();
		} else {
			this.openPanel();
		}
	}
	openPanel() {
		if(this.panelHolder == null) {
			return;
		}
		this.centerPanel();
		this.panelHolder.set_visible(true);
		if(Action.instance != null && Action.instance.ui != null) {
			Action.instance.ui.blockedClick = true;
		}
		this.freshAnnouncements = this.unreadAnnouncements;
		this.freshThreads = new haxe_ds_StringMap();
		let _g = 0;
		let _g1 = this.threads;
		while(_g < _g1.length) {
			let thread = _g1[_g];
			++_g;
			if(thread.unread > 0) {
				this.freshThreads.h[thread.id] = true;
			}
		}
		this.showInbox();
		this.render();
		this.markRead();
		this.refresh();
	}
	hidePanel() {
		if(this.panelHolder == null) {
			return;
		}
		if(this.stage != null && this.stage.get_focus() != null && this.panelHolder.contains(this.stage.get_focus())) {
			this.stage.set_focus(null);
		}
		this.panelHolder.set_visible(false);
		avatar_view_WindowDrag.resetCursor();
		this.freshAnnouncements = 0;
		this.freshThreads = new haxe_ds_StringMap();
		if(Action.instance != null && Action.instance.ui != null) {
			Action.instance.ui.blockedClick = true;
		}
	}
	markRead() {
		if(this.announcements.length > 0) {
			core_audio_GameSettings.lastReadAnnouncement = this.announcements[0].id;
			core_audio_GameSettings.save();
		}
		if(this.unreadReplies > 0) {
			net_Mailbox.markRead();
		}
		this.unreadAnnouncements = 0;
		this.unreadReplies = 0;
		this.setBadge(0);
	}
	showInbox() {
		if(this.inboxView != null) {
			this.inboxView.set_hidden(false);
		}
		if(this.composeView != null) {
			this.composeView.set_hidden(true);
		}
		if(this.detailView != null) {
			this.detailView.set_hidden(true);
		}
		this.highlightTab(true);
	}
	showCompose() {
		if(this.inboxView != null) {
			this.inboxView.set_hidden(true);
		}
		if(this.composeView != null) {
			this.composeView.set_hidden(false);
		}
		if(this.detailView != null) {
			this.detailView.set_hidden(true);
		}
		this.highlightTab(false);
	}
	showDetail(announcement,thread) {
		if(this.detailBody == null) {
			return;
		}
		this.detailBody.removeAllComponents();
		if(announcement != null) {
			if(this.detailTag != null) {
				this.detailTag.set_text(core_i18n_I18n.t("mail.announcement"));
			}
			if(this.detailDate != null) {
				this.detailDate.set_text(this.formatDate(announcement.sentAt));
			}
			this.detailBody.addComponent(this.bubble("",announcement.text,false));
		} else if(thread != null) {
			if(this.detailTag != null) {
				this.detailTag.set_text(core_i18n_I18n.t(this.categoryKey(thread.category)));
			}
			if(this.detailDate != null) {
				this.detailDate.set_text(this.formatDate(thread.lastAt));
			}
			if(thread.entries != null) {
				let _g = 0;
				let _g1 = thread.entries;
				while(_g < _g1.length) {
					let entry = _g1[_g];
					++_g;
					let staff = entry.from == "staff";
					this.detailBody.addComponent(this.bubble((staff ? core_i18n_I18n.t("mail.staff") + " · " : "") + entry.name + "  " + this.formatDate(entry.at),entry.text,staff));
				}
			}
		}
		if(this.inboxView != null) {
			this.inboxView.set_hidden(true);
		}
		if(this.composeView != null) {
			this.composeView.set_hidden(true);
		}
		if(this.detailView != null) {
			this.detailView.set_hidden(false);
		}
	}
	bubble(title,text,staff) {
		let c0 = new haxe_ui_containers_HBox();
		c0.set_id("entryRow");
		c0.set_percentWidth(100.);
		c0.set_styleString("padding: 9px; horizontal-spacing: 9px; vertical-spacing: 0; background-color: #fffdf8; border: 2px solid #d9cba4; border-radius: 11px;");
		let c01 = new haxe_ui_containers_Box();
		c01.set_id("entryAccent");
		c01.set_width(5.);
		c01.set_percentHeight(100.);
		c01.set_styleString("padding: 0; background-color: #9eb56e; border-radius: 3px;");
		c0.addComponent(c01);
		let c1 = new haxe_ui_containers_VBox();
		c1.set_percentWidth(100.);
		c1.set_styleString("padding: 0; horizontal-spacing: 0; vertical-spacing: 4px;");
		let c2 = new haxe_ui_components_Label();
		c2.set_id("entryName");
		c2.set_percentWidth(100.);
		c2.set_text("");
		c2.set_styleString("padding: 0; font-size: 12px; color: #61733f; font-bold: true;");
		c1.addComponent(c2);
		let c3 = new haxe_ui_components_Label();
		c3.set_id("entryText");
		c3.set_percentWidth(100.);
		c3.set_text("");
		c3.set_styleString("padding: 0; font-size: 15px; color: #33280f; word-wrap: true;");
		c1.addComponent(c3);
		c0.addComponent(c1);
		c0.bindingRoot = true;
		let view = c0;
		let name = view.findComponent("entryName",haxe_ui_components_Label);
		let accent = view.findComponent("entryAccent",haxe_ui_containers_Box);
		if(name != null) {
			name.set_text(title);
			name.set_hidden(title == "");
		}
		this.setText(view,"entryText",text);
		if(staff) {
			view.get_customStyle().backgroundColor = 16774358;
			view.get_customStyle().borderColor = 14730884;
			if(name != null) {
				name.get_customStyle().color = 9071122;
			}
			if(accent != null) {
				accent.get_customStyle().backgroundColor = 13081106;
			}
			view.invalidateComponent("style",false);
			if(name != null) {
				name.invalidateComponent("style",false);
			}
			if(accent != null) {
				accent.invalidateComponent("style",false);
			}
		}
		return view;
	}
	categoryKey(category) {
		switch(category) {
		case "complaint":
			return "mail.category_complaint";
		case "notice":
			return "mail.category_notice";
		default:
			return "mail.category_request";
		}
	}
	preview(text) {
		if(text == null) {
			return "";
		}
		let single = StringTools.replace(StringTools.replace(text,"\r"," "),"\n"," ");
		if(single.length <= 110) {
			return single;
		} else {
			return HxOverrides.substr(single,0,110) + "…";
		}
	}
	highlightTab(inbox) {
		this.applyTabStyle(this.tabInbox,inbox);
		this.applyTabStyle(this.tabCompose,!inbox);
	}
	applyTabStyle(button,active) {
		if(button == null) {
			return;
		}
		button.get_customStyle().backgroundColor = active ? 7033904 : 16775920;
		button.get_customStyle().backgroundColorEnd = active ? 7033904 : 16775920;
		button.get_customStyle().borderColor = active ? 3417875 : 13482380;
		button.get_customStyle().color = active ? 16180411 : 5980704;
		button.invalidateComponent("style",false);
	}
	setCategory(value) {
		this.category = value == "complaint" ? "complaint" : "request";
		this.applyCategoryStyle(this.catRequest,this.category == "request",false);
		this.applyCategoryStyle(this.catComplaint,this.category == "complaint",true);
	}
	applyCategoryStyle(button,active,complaint) {
		if(button == null) {
			return;
		}
		button.get_customStyle().backgroundColor = active ? complaint ? 15975594 : 14412216 : 16775920;
		button.get_customStyle().backgroundColorEnd = active ? complaint ? 15050110 : 12572810 : 16775920;
		button.get_customStyle().borderColor = active ? complaint ? 11101506 : 7902024 : 13482380;
		button.get_customStyle().color = active ? complaint ? 7287841 : 3887648 : 7101757;
		button.invalidateComponent("style",false);
	}
	submit() {
		if(this.sending || this.composeText == null) {
			return;
		}
		let text = StringTools.trim(this.composeText.get_text() == null ? "" : this.composeText.get_text());
		if(text.length < 3) {
			this.setStatus(core_i18n_I18n.t("mail.too_short"),-1);
			return;
		}
		this.sending = true;
		this.paintSendButton(false);
		this.setStatus(core_i18n_I18n.t("mail.sending"));
		let _gthis = this;
		net_Mailbox.send(this.category,text,function(error) {
			_gthis.sending = false;
			_gthis.paintSendButton(true);
			if(error != null) {
				_gthis.setStatus(error == "" ? core_i18n_I18n.t("mail.send_failed") : error,-1);
				return;
			}
			_gthis.composeText.set_text("");
			_gthis.updateComposeCounter();
			_gthis.setStatus(core_i18n_I18n.t("mail.sent"),1);
			_gthis.refresh();
		});
	}
	setStatus(message,tone) {
		if(tone == null) {
			tone = 0;
		}
		if(this.composeStatus == null) {
			return;
		}
		this.composeStatus.set_text(message);
		this.composeStatus.get_customStyle().color = tone < 0 ? 10108714 : tone > 0 ? 5073711 : 8022596;
		this.composeStatus.invalidateComponent("style",false);
	}
	updateComposeCounter() {
		if(this.composeText == null) {
			return;
		}
		let value = this.composeText.get_text() == null ? "" : this.composeText.get_text();
		if(value.length > 1000) {
			value = HxOverrides.substr(value,0,1000);
			this.composeText.set_text(value);
		}
		if(this.composeCounter != null) {
			this.composeCounter.set_text(value.length + " / " + 1000);
			let tmp = value.length >= 1000 ? 10108714 : 9141083;
			this.composeCounter.get_customStyle().color = tmp;
			this.composeCounter.invalidateComponent("style",false);
		}
	}
	paintSendButton(enabled) {
		if(this.composeSend == null) {
			return;
		}
		this.composeSend.set_text(core_i18n_I18n.t(enabled ? "mail.send" : "mail.sending"));
		this.composeSend.get_customStyle().backgroundColor = enabled ? 16771238 : 14208176;
		this.composeSend.get_customStyle().backgroundColorEnd = enabled ? 16441763 : 13352349;
		this.composeSend.get_customStyle().borderColor = enabled ? 9269052 : 11115128;
		this.composeSend.get_customStyle().color = enabled ? 3154964 : 7694930;
		this.composeSend.invalidateComponent("style",false);
	}
	render() {
		if(this.list == null) {
			return;
		}
		this.list.removeAllComponents();
		let items = this.merged();
		if(items.length == 0) {
			this.showEmpty(core_i18n_I18n.t("announce.empty"));
			return;
		}
		if(this.emptyLabel != null) {
			this.emptyLabel.set_hidden(true);
		}
		let seenAnnouncements = 0;
