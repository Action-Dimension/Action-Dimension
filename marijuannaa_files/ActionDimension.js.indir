		this.bindPriceButton("item_detail_button_cash_minus_1000",-1000);
		this.bindPriceButton("item_detail_button_cash_plus_1",1);
		this.bindPriceButton("item_detail_button_cash_plus_10",10);
		this.bindPriceButton("item_detail_button_cash_plus_100",100);
