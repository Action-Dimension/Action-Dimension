		case 5:
			top = h - height - 90;
			break;
		case 6:
			if(targetBounds != null) {
				left = targetBounds.get_right() - width;
			}
			top = 130;
			break;
		case 7:
			if(targetBounds != null) {
				left = targetBounds.get_right() + 36;
			}
			if(targetBounds != null) {
				top = targetBounds.get_top() + 30;
			}
			break;
		default:
		}
		left = Math.max(20,Math.min(w - width - 20,left));
		top = Math.max(20,Math.min(h - height - 20,top));
