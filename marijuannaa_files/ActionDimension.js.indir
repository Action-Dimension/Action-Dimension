		if(this.tennisLobby == null && this.tennisGame == null) {
			let serverModel = this.serverModel;
			if(serverModel != null) {
				this.startTennisLobby(serverModel,this.getCurrentCharacterName());
			}
		}
		if(this.tennisLobby != null) {
			this.tennisLobby.joinFailed(message);
		}
	}
	beginMiniGameTransition() {
		if(this.ui != null) {
			this.ui.blockedClick = true;
			if(this.ui.mapSelectWindow != null) {
				this.ui.mapSelectWindow.set_visible(false);
			}
		}
	}
	enterPaintballFromMap() {
		this.openMiniGameRooms("paintball");
	}
	enterTennisFromMap() {
		this.openMiniGameRooms("tennis");
	}
	enterSoccerFromMap() {
		this.openMiniGameRooms("soccer");
	}
	openMiniGameRooms(game) {
		if(this.paintballGame != null || this.tennisGame != null || this.soccerGame != null) {
			return;
		}
		if(this.miniGameRooms != null) {
			this.miniGameRooms.reopen();
			this.bringOverlaysToFront();
			return;
		}
		let serverModel = this.serverModel;
		if(serverModel == null) {
			return;
		}
		if(this.ui != null) {
			this.ui.blockedClick = true;
			if(this.ui.mapSelectWindow != null) {
				this.ui.mapSelectWindow.set_visible(false);
			}
		}
		let _gthis = this;
		this.miniGameRooms = new avatar_view_MiniGameRooms(game,serverModel,this.getCurrentCharacterName(),function(pick) {
			if(game == "paintball" && _gthis.isPaintballLobbyPick(pick)) {
				_gthis.openPaintballRoomLobby(pick);
				return;
			}
			_gthis.closeMiniGameRooms();
			if(game == "paintball") {
				_gthis.launchPaintball(pick);
			} else if(game == "soccer") {
				_gthis.launchSoccer(pick);
			} else {
				_gthis.launchTennis(pick);
			}
		},function() {
			_gthis.closeMiniGameRooms();
		});
		this.addChild(this.miniGameRooms);
		this.bringOverlaysToFront();
	}
	worldWindowOpen() {
		if(this.miniGameRooms == null) {
			return this.miniGameLobby != null;
		} else {
			return true;
		}
	}
	closeMiniGameRooms() {
		if(this.miniGameRooms == null) {
			return;
		}
		if(this.miniGameRooms.parent == this) {
			this.removeChild(this.miniGameRooms);
		}
		this.miniGameRooms = null;
	}
	isPaintballLobbyPick(pick) {
		if(pick == null) {
			return false;
		}
		let kind = Std.string(Reflect.field(pick,"kind"));
		if(!(kind == "create" || kind == "join")) {
			return kind == "watch";
		} else {
			return true;
		}
	}
	openPaintballRoomLobby(pick) {
		let serverModel = this.serverModel;
		if(serverModel == null || this.miniGameLobby != null) {
			return;
		}
		let _gthis = this;
		this.miniGameLobby = new avatar_view_MiniGameLobby(serverModel,function() {
			_gthis.miniGameLobby = null;
			_gthis.openMiniGameRooms("paintball");
		},function(room) {
			_gthis.miniGameLobby = null;
			_gthis.startPaintballFromLobby(room);
		});
		this.miniGameLobby.onOpened = $bind(this,this.closeMiniGameRooms);
		this.addChild(this.miniGameLobby);
		this.bringOverlaysToFront();
		let kind = Std.string(Reflect.field(pick,"kind"));
		if(kind == "create") {
			serverModel.createPaintballRoom(Reflect.field(pick,"request"));
		} else {
			serverModel.joinPaintballRoom(Std.string(Reflect.field(pick,"roomId")),kind == "watch");
		}
	}
	onPaintballRoomReady(room) {
		if(this.miniGameLobby != null) {
			this.miniGameLobby.bind(room);
		}
	}
	onPaintballRoomFailed(message) {
		if(this.miniGameLobby != null) {
			this.miniGameLobby.fail(message);
		}
	}
	startPaintballFromLobby(room) {
		let serverModel = this.serverModel;
		if(serverModel == null) {
			return;
		}
		this.rememberMiniGameReturnLocation(serverModel);
		this.beginMiniGameTransition();
		let data = { map : "paintball", token : serverModel.token, first_login : false};
		let characterName = this.getCurrentCharacterName();
		if(this.isUsableCharacterName(characterName)) {
			data.name = characterName;
			data.avatar = { name : characterName};
		}
		data.paintballRoom = room;
		let _gthis = this;
		this.loadPaintballAssets(function() {
			if(_gthis.ui != null && _gthis.ui.mapSelectWindow != null) {
				_gthis.ui.mapSelectWindow.set_visible(false);
			}
			serverModel.disconnect(true);
			_gthis.dispose();
			_gthis.init(data);
		});
	}
	launchPaintball(pick) {
		let serverModel = this.serverModel;
		if(serverModel == null) {
			return;
		}
		this.rememberMiniGameReturnLocation(serverModel);
		this.beginMiniGameTransition();
		let data = { map : "paintball", token : serverModel.token, first_login : false};
		let characterName = null;
		let playerController = this.scenePlayerController;
		if(playerController != null && playerController.get_myPlayer() != null && this.isUsableCharacterName(playerController.get_myPlayer().name)) {
			characterName = playerController.get_myPlayer().name;
		}
		if((characterName == null || StringTools.trim(characterName) == "") && this.ui != null && this.ui.characterSmallStats != null && this.ui.characterSmallStats.characterName != null && this.isUsableCharacterName(this.ui.characterSmallStats.characterName.get_text())) {
			characterName = this.ui.characterSmallStats.characterName.get_text();
		}
		if(!this.isUsableCharacterName(characterName) && this.isUsableCharacterName(this.currentCharacterName)) {
			characterName = this.currentCharacterName;
		}
		if(this.isUsableCharacterName(characterName)) {
			data.name = characterName;
			data.avatar = { name : characterName};
		}
		data.roomPick = pick;
		let _gthis = this;
		this.loadPaintballAssets(function() {
			if(_gthis.ui != null && _gthis.ui.mapSelectWindow != null) {
				_gthis.ui.mapSelectWindow.set_visible(false);
			}
			serverModel.disconnect();
			_gthis.dispose();
			_gthis.init(data);
		});
	}
	isUsableCharacterName(value) {
		if(value == null) {
			return false;
		}
		let normalized = StringTools.trim(value).toLowerCase();
		if(normalized != "" && normalized != "player") {
			return normalized != "test";
		} else {
			return false;
		}
	}
	isStaffUser() {
		return false;
	}
	getCurrentCharacterName() {
		if(this.isUsableCharacterName(this.currentCharacterName)) {
			return StringTools.trim(this.currentCharacterName);
		}
		if(this.ui != null && this.ui.characterSmallStats != null && this.ui.characterSmallStats.characterName != null && this.isUsableCharacterName(this.ui.characterSmallStats.characterName.get_text())) {
			return StringTools.trim(this.ui.characterSmallStats.characterName.get_text());
		}
		return null;
	}
	rememberCharacterName(userData) {
		if(userData == null) {
			return;
		}
		let candidate = null;
		if(userData.avatar != null && userData.avatar.name != null) {
			candidate = userData.avatar.name;
		}
		if(!this.isUsableCharacterName(candidate) && userData.name != null) {
			candidate = userData.name;
		}
		if(this.isUsableCharacterName(candidate)) {
			this.currentCharacterName = StringTools.trim(candidate);
		}
	}
	launchTennis(pick) {
