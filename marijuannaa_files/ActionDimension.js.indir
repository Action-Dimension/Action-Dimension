	runtimeLootField(lootMenu,name,nativeField,color,size,bold,italic) {
		let field = lootMenu.getChildByName(name);
		if(field == null) {
			field = new openfl_text_TextField();
			field.set_name(name);
			field.set_selectable(false);
			field.mouseEnabled = false;
			field.set_embedFonts(false);
			field.set_multiline(true);
			field.set_wordWrap(true);
			if(nativeField != null) {
				let bounds = nativeField.getBounds(lootMenu);
				field.set_x(bounds.x);
				field.set_y(bounds.y);
				field.set_width(bounds.width);
				field.set_height(bounds.height + 4);
				nativeField.set_visible(false);
			} else if(name == "runtime_loot_name") {
				field.set_x(43.2);
				field.set_y(-33.9);
				field.set_width(269.75);
				field.set_height(24.5);
			} else {
				field.set_x(-31.8);
				field.set_y(-5.9);
				field.set_width(342.75);
				field.set_height(50.15);
			}
			field.set_defaultTextFormat(new openfl_text_TextFormat("_sans",size,color,bold,italic));
			lootMenu.addChild(field);
		}
		field.set_visible(true);
		field.set_alpha(1);
		lootMenu.setChildIndex(field,lootMenu.get_numChildren() - 1);
		return field;
	}
	handleLevelUpResult(data) {
		if(data == null || Action.instance == null) {
