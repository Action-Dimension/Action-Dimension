	set_width(value) {
		this._lockScrollUpdate = true;
		super.set_width(value);
		this._traceField.set_width(value - 4);
		this.txtField.set_width(value - 6);
		this._cmdField.set_width(this.get_width() - 15 - this._cmdField.get_x());
		this._cmdBG.set_width(value);
		this._bottomLine.get_graphics().clear();
		this._bottomLine.get_graphics().lineStyle(1,this.get_style().controlColor);
		this._bottomLine.get_graphics().moveTo(10,-1);
		this._bottomLine.get_graphics().lineTo(value - 10,-1);
		this._scroll.set_x(value);
		this._atBottom = true;
		this.updateCLSize();
		this._needUpdateMenu = true;
		this._needUpdateTrace = true;
		this._lockScrollUpdate = false;
		return value;
	}
	set_height(value) {
		this._lockScrollUpdate = true;
		let fsize = this.get_style().menuFontSize;
		let msize = fsize + 6 + this.get_style().traceFontSize;
		if(this.get_height() != value) {
			this._mini = value < (this._cmdField.get_visible() ? msize + fsize + 4 : msize);
		}
		super.set_height(value);
		let mini = this._mini || !this.get_style().topMenu;
		this.updateTraceFHeight();
		this._traceField.set_y(mini ? 0 : fsize);
		this._traceField.set_height(value - (this._cmdField.get_visible() ? fsize + 4 : 0) - (mini ? 0 : fsize));
		let cmdy = value - (fsize + 6);
		this._cmdField.set_y(cmdy);
		this._cmdPrefx.set_y(cmdy);
		this._hintField.set_y(this._cmdField.get_y() - this._hintField.get_height());
		this._cmdBG.set_y(cmdy);
		this._bottomLine.set_y(this._cmdField.get_visible() ? cmdy : value);
		this._scroll.set_y(mini ? 6 : fsize + 4);
		let ctrlSize = this.get_style().controlSize;
		this._scrollHeight = this._bottomLine.get_y() - (this._cmdField.get_visible() ? 0 : ctrlSize * 2) - this._scroll.get_y();
		this._scroller.set_visible(this._scrollHeight > 40);
		this._scroll.get_graphics().clear();
		if(this._scrollHeight >= 10) {
			this._scroll.get_graphics().beginFill(this.get_style().controlColor,0.7);
			this._scroll.get_graphics().drawRect(-ctrlSize,0,UInt.toFloat(ctrlSize),UInt.toFloat(ctrlSize));
			let tmp = this._scrollHeight - UInt.toFloat(ctrlSize);
			this._scroll.get_graphics().drawRect(-ctrlSize,tmp,UInt.toFloat(ctrlSize),UInt.toFloat(ctrlSize));
			this._scroll.get_graphics().beginFill(this.get_style().controlColor,0.25);
			let tmp1 = this._scrollHeight - UInt.toFloat(ctrlSize * 2);
			this._scroll.get_graphics().drawRect(-ctrlSize,UInt.toFloat(ctrlSize),UInt.toFloat(ctrlSize),tmp1);
			this._scroll.get_graphics().beginFill(0,0);
			this._scroll.get_graphics().drawRect(-ctrlSize * 2,UInt.toFloat(ctrlSize * 2),UInt.toFloat(ctrlSize * 2),this._scrollHeight - UInt.toFloat(ctrlSize * 2));
			this._scroll.get_graphics().endFill();
		}
		this._atBottom = true;
		this._needUpdateTrace = true;
