	open(npcId) {
		this.set_visible(true);
		Action.instance.ui.blockedClick = true;
		this.loading.set_visible(true);
		Action.instance.npcModel.getShopItems(npcId);
		this.curPage = 1;
		this.shopCurPage = 1;
		this.activeTab = 0;
		this.inventoryTabs.gotoAndStop(1);
		this.ItemsOrder();
	}
	loadShopItems(itemsData) {
		this.shopItemData = itemsData;
		this.ShopItemsOrder();
	}
	ItemsOrder() {
		let itemCount = 0;
		let start = (this.curPage - 1) * 9;
		let end = start + 9;
		let activeItemCount = 0;
		let h = this.items.h;
		let item_keys = Object.keys(h);
		let item_length = item_keys.length;
		let item_current = 0;
		while(item_current < item_length) h[item_keys[item_current++]].item_container.set_visible(false);
		let i = -1;
		let h1 = Action.instance.ui.inventoryItemsData.h;
		let item_keys1 = Object.keys(h1);
		let item_length1 = item_keys1.length;
		let item_current1 = 0;
		while(item_current1 < item_length1) {
			let item = h1[item_keys1[item_current1++]];
			let mainCategory = 0;
			let categoryName = item.item_category == null ? "null" : "" + item.item_category;
			if(categoryName.indexOf("handwear") > -1) {
				mainCategory = 4;
			} else if(categoryName.indexOf("wear") > -1) {
				mainCategory = 1;
			} else if(categoryName.indexOf("modkit") > -1 || categoryName.indexOf("weapon") > -1 || categoryName.indexOf("armor") > -1) {
				mainCategory = 2;
			} else if(categoryName.indexOf("suite") > -1) {
				mainCategory = 3;
				if(item.is_equipped == true) {
					continue;
				}
			} else if(categoryName == "consumable" || categoryName == "playable_item" || categoryName.indexOf("food_") == 0) {
				mainCategory = 4;
			}
			if(this.activeTab == mainCategory || this.activeTab == 0) {
				++i;
				++itemCount;
				if(i < start || i >= end) {
					continue;
				}
				if(activeItemCount > 8) {
					continue;
				}
				this.items.h["inv_item_" + activeItemCount].setItem(item,"equip_takeoff",item.is_equipped == true);
				this.items.h["inv_item_" + activeItemCount].item_container.set_visible(true);
				++activeItemCount;
			}
		}
		this.maxPage = Math.ceil(itemCount / 9);
		this.pageText.set_text(Std.string(this.curPage) + "/" + Std.string(this.maxPage));
	}
	ShopItemsOrder() {
		let itemCount = 0;
		let start = (this.shopCurPage - 1) * 9;
		let end = start + 9;
		let h = this.shopItems.h;
		let shopItem_keys = Object.keys(h);
		let shopItem_length = shopItem_keys.length;
		let shopItem_current = 0;
		while(shopItem_current < shopItem_length) h[shopItem_keys[shopItem_current++]].item_container.set_visible(false);
		let _g = 0;
		let _g1 = this.shopItemData.length;
		while(_g < _g1) {
			let i = _g++;
			if(Object.prototype.hasOwnProperty.call(this.shopItems.h,"a" + this.shopItemData[i].item_id)) {
				continue;
			}
			if(start > i || i >= end) {
				continue;
			}
			if(itemCount > 8) {
				break;
			}
			this.shopItems.h["vend_item_" + itemCount].setItem(this.shopItemData[i],"buy_sell",true);
			this.shopItems.h["vend_item_" + itemCount].item_container.set_visible(true);
			++itemCount;
		}
		this.loading.set_visible(false);
		this.shopMaxPage = Math.ceil(this.shopItemData.length / 9);
		this.shopPageText.set_text(Std.string(this.shopCurPage) + "/" + Std.string(this.shopMaxPage));
	}
}
