class avatar_view_WindowDrag {
	constructor(target,handle,bounds) {
		this.wasDragged = false;
		this.target = target;
		core_audio_GameAudio.watchWindow(target);
		this.bounds = bounds;
		handle.set_buttonMode(true);
		handle.addEventListener("mouseDown",$bind(this,this.begin));
		target.addEventListener("removedFromStage",$bind(this,this.end));
	}
	begin(event) {
		this.end();
		this.wasDragged = false;
		if(this.target.stage == null || this.target.parent == null) {
			return;
		}
		if(Action.instance != null && Action.instance.ui != null) {
			Action.instance.ui.blockedClick = true;
		}
		this.dragStage = this.target.stage;
		this.pointer = new openfl_geom_Point(event.stageX,event.stageY);
		let area = this.bounds();
		let topLeft = this.target.parent.globalToLocal(this.target.localToGlobal(new openfl_geom_Point(area.get_left(),area.get_top())));
		let bottomRight = this.target.parent.globalToLocal(this.target.localToGlobal(new openfl_geom_Point(area.get_right(),area.get_bottom())));
		let screenTop = this.target.parent.globalToLocal(new openfl_geom_Point(0,0));
		let screenBottom = this.target.parent.globalToLocal(new openfl_geom_Point(this.dragStage.stageWidth,this.dragStage.stageHeight));
		let minX = this.target.get_x() + screenTop.x - topLeft.x;
		let minY = this.target.get_y() + screenTop.y - topLeft.y;
		let maxX = this.target.get_x() + screenBottom.x - bottomRight.x;
		let maxY = this.target.get_y() + screenBottom.y - bottomRight.y;
		if(maxX < minX) {
			minX = this.target.get_x() + screenTop.x + 80 - bottomRight.x;
			maxX = this.target.get_x() + screenBottom.x - 80 - topLeft.x;
		}
		if(maxY < minY) {
			maxY = this.target.get_y() + screenBottom.y - 32 - topLeft.y;
		}
		this.target.startDrag(false,new openfl_geom_Rectangle(minX,minY,Math.max(0,maxX - minX),Math.max(0,maxY - minY)));
		this.dragStage.addEventListener("mouseMove",$bind(this,this.moved));
		this.dragStage.addEventListener("mouseUp",$bind(this,this.end),true,3000);
		this.dragStage.addEventListener("mouseLeave",$bind(this,this.end));
		this.dragStage.addEventListener("deactivate",$bind(this,this.end));
		this.target.addEventListener("enterFrame",$bind(this,this.checkVisible));
	}
	moved(event) {
		if(Math.abs(event.stageX - this.pointer.x) > 3 || Math.abs(event.stageY - this.pointer.y) > 3) {
			this.wasDragged = true;
		}
	}
	checkVisible(_) {
		let current = this.target;
		while(current != null) {
			if(!current.get_visible()) {
				this.end();
				return;
			}
			current = current.parent;
		}
	}
	end(_) {
		if(this.dragStage == null) {
			return;
		}
		this.target.stopDrag();
		this.dragStage.removeEventListener("mouseMove",$bind(this,this.moved));
		this.dragStage.removeEventListener("mouseUp",$bind(this,this.end),true);
		this.dragStage.removeEventListener("mouseLeave",$bind(this,this.end));
		this.dragStage.removeEventListener("deactivate",$bind(this,this.end));
		this.target.removeEventListener("enterFrame",$bind(this,this.checkVisible));
		this.dragStage = null;
	}
	static resetCursor() {
		openfl_ui_Mouse.set_cursor("arrow");
		openfl_ui_Mouse.set_cursor("auto");
	}
	static pointerCursor(target) {
		if(((target) instanceof haxe_ui_core_Component)) {
			let component = target;
			component.set_onMouseOver(function(_) {
				openfl_ui_Mouse.set_cursor("button");
			});
			component.set_onMouseOut(function(_) {
				avatar_view_WindowDrag.resetCursor();
			});
			return;
		}
		target.addEventListener("mouseOver",function(event) {
			openfl_ui_Mouse.set_cursor("button");
			event.stopPropagation();
		});
		target.addEventListener("mouseOut",function(event) {
			avatar_view_WindowDrag.resetCursor();
			event.stopPropagation();
		});
	}
	static attachSwf(panel,headerHeight) {
		if(headerHeight == null) {
			headerHeight = 32;
		}
		let surface = panel.getChildAt(0).getBounds(panel);
		let right = surface.get_right();
		let _g = 0;
		let _g1 = panel.get_numChildren();
		while(_g < _g1) {
			let child = panel.getChildAt(_g++);
			if(child.get_name() == "mini_instruction_button" || child.get_name().indexOf("close_button") >= 0) {
				let button = child.getBounds(panel);
				if(button.width > 0 && button.get_top() < surface.get_top() + headerHeight && button.get_bottom() > surface.get_top()) {
					right = Math.min(right,button.get_left() - 2);
				}
			}
		}
		let handle = new openfl_display_Sprite();
		handle.set_name("window_drag_handle");
		handle.get_graphics().beginFill(0,0);
		handle.get_graphics().drawRect(surface.get_left(),surface.get_top(),right - surface.get_left(),Math.min(headerHeight,surface.height));
		handle.get_graphics().endFill();
		panel.addChild(handle);
		return new avatar_view_WindowDrag(panel,handle,function() {
			return surface.clone();
		});
	}
}
