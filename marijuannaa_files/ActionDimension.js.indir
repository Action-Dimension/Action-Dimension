class com_junkbyte_console_view_RollerPanel extends com_junkbyte_console_view_ConsolePanel {
	constructor(m) {
		super(m);
		this.set_name("rollerPanel");
		this.init(60,100,false);
		this.txtField = this.makeTF("rollerPrints");
		this.txtField.set_multiline(true);
		this.txtField.set_autoSize(1);
		this.registerTFRoller(this.txtField,$bind(this,this.onMenuRollOver),$bind(this,this.linkHandler));
		this.registerDragger(this.txtField);
