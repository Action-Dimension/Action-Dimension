class avatar_controller_ServerPetController {
	constructor() {
		this.disposed = false;
		this.pendingPositionUpdates = new haxe_ds_StringMap();
	}
	onPetAdded(pet,key) {
		if(this.disposed || pet == null || Action.instance == null || Action.instance.petModel == null) {
			return;
		}
		let petModel = Action.instance.petModel;
		if(petModel.getPet(key) != null) {
			return;
		}
		petModel.addPet(pet);
		let roomController = Action.instance.serverRoomController;
		let _gthis = this;
		if(roomController != null && roomController.room != null) {
			let callbacks = io_colyseus_serializer_schema_Callbacks.get(roomController.room);
			callbacks.listen(pet,"x",function(newValue,oldValue) {
				_gthis.schedulePositionUpdate(pet);
			});
			callbacks.listen(pet,"y",function(newValue,oldValue) {
				_gthis.schedulePositionUpdate(pet);
			});
			callbacks.listen(pet,"target_x",function(newValue,oldValue) {
				_gthis.schedulePositionUpdate(pet);
			});
			callbacks.listen(pet,"target_y",function(newValue,oldValue) {
				_gthis.schedulePositionUpdate(pet);
			});
			callbacks.listen(pet,"side",function(newValue,oldValue) {
				_gthis.schedulePositionUpdate(pet);
			});
		}
		let collyseusPetEvent = new events_ColyseusPetEvent(events_ColyseusPetEvent.JOINED);
		collyseusPetEvent.pet = pet;
		events_GlobalEventDispatcher.dispatchEvent(collyseusPetEvent);
	}
	onPetRemove(pet,key) {
		if(this.disposed || pet == null || Action.instance == null || Action.instance.petModel == null) {
			return;
		}
		Action.instance.petModel.removePet(pet);
		if(this.pendingPositionUpdates != null) {
			let key = pet.id;
			let _this = this.pendingPositionUpdates;
			if(Object.prototype.hasOwnProperty.call(_this.h,key)) {
				delete(_this.h[key]);
			}
		}
		let collyseusPetEvent = new events_ColyseusPetEvent(events_ColyseusPetEvent.LEAVED);
		collyseusPetEvent.pet = pet;
		events_GlobalEventDispatcher.dispatchEvent(collyseusPetEvent);
	}
	schedulePositionUpdate(pet) {
		if(this.disposed || pet == null || this.pendingPositionUpdates == null || Object.prototype.hasOwnProperty.call(this.pendingPositionUpdates.h,pet.id)) {
			return;
		}
		this.pendingPositionUpdates.h[pet.id] = true;
		let _gthis = this;
		haxe_Timer.delay(function() {
			if(_gthis.disposed || _gthis.pendingPositionUpdates == null) {
				return;
			}
			let key = pet.id;
			let _this = _gthis.pendingPositionUpdates;
			if(Object.prototype.hasOwnProperty.call(_this.h,key)) {
				delete(_this.h[key]);
			}
			if(Action.instance == null) {
				return;
			}
			let scenePetController = Action.instance.scenePetController;
			if(scenePetController != null) {
				scenePetController.changePosition(pet,parseFloat((pet.x == null ? "null" : "" + pet.x)),parseFloat((pet.y == null ? "null" : "" + pet.y)),parseFloat((pet.target_x == null ? "null" : "" + pet.target_x)),parseFloat((pet.target_y == null ? "null" : "" + pet.target_y)),pet.side);
			}
		},0);
	}
	onMyPet(data) {
		Action.instance.ui.petMenuWindow.loadPet(data);
		Action.instance.ui.petInfoMenu.refresh();
	}
	onPetActionResult(data) {
		let action = data == null ? null : data.action;
		if(data == null || !data.success) {
			if(Action.instance.scene != null) {
				Action.instance.scene.releasePetActionLock();
			}
			if(Action.instance.ui != null && Action.instance.ui.petDeadWindow != null && action == "revive") {
				Action.instance.ui.petDeadWindow.setRevivePending(false);
			}
			let failureMessage = data == null ? null : core_i18n_I18n.resolve(data);
			if(failureMessage != null && Action.instance.ui != null && Action.instance.ui.popupMessage != null) {
