				offerCash += 1;
				_gthis.setCashMenuText.set_text(offerCash == null ? "null" : "" + offerCash);
			}
		});
		setCashBtnPlus10.addEventListener("mouseDown",function(e) {
			if(Std.parseInt(StringTools.replace(_gthis.cashText.get_text(),"Cash: ","")) > offerCash + 9) {
