		c4.set_text("");
		c4.set_styleString("padding: 0; font-name: BilboPro; font-size: 17px; color: #302414;");
		c4.set_verticalAlign("center");
		c3.addComponent(c4);
		let c5 = new haxe_ui_components_Label();
