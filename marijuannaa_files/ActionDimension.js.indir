class sim_logic_MatchRules {
	static decreaseTickets(state,teamId,amount) {
		if(teamId == 1) {
			state.team1Tickets -= amount;
		} else if(teamId == 2) {
			state.team2Tickets -= amount;
		}
		if(state.npcTeamEnabled && state.team2Tickets != 0) {
			state.team2Tickets = state.team2TicketMax / 5 | 0;
