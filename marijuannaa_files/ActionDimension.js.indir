			this._selectionStart = -1;
		}
	}
	updateFull() {
		let text = "";
		let line = this.console.get_logs().first;
		let showch = this._viewingChannels.length != 1;
		let viewingAll = this._priority == 0 && this._viewingChannels.length == 0;
		while(line != null) {
			if(viewingAll || this.lineShouldShow(line)) {
				text += this.makeLine(line,showch);
			}
			line = line.next;
		}
		this._lockScrollUpdate = true;
		this._traceField.set_htmlText("<logs>" + text + "</logs>");
		this._lockScrollUpdate = false;
		this.updateScroller();
	}
	setPaused(b) {
