class paintball_controller_UIController extends openfl_events_EventDispatcher {
	constructor(paintball,model) {
		super();
		this.paintball = paintball;
		this.chat_holder = paintball.chat_holder;
	}
	init() {
	}
	serverSyncErrorInfoButtonPressed(evt) {
		this.dispatchEvent(new events_UIEvent("uiShowError",false,false,core_i18n_I18n.t("paintball.sync_help")));
	}
	chat_write_bar() {
		if(this.paintball.inputModel.enter_pressed) {
			this.paintball.inputModel.enter_pressed = false;
			if(this.chat_holder.get_currentFrame() != 6) {
				this.paintball.inputModel.suspendGameplayForChat();
				this.chat_holder.play();
			} else {
				let chat_text = this.chat_holder.getChildByName("chat_text");
				if(chat_text.get_text() != "" && !this.paintball.chatModel.handleLocalCommand(chat_text.get_text())) {
					this.dispatchEvent(new events_UIEvent("uiChatSend",false,false,this.paintball.state.my_user_name + ": " + chat_text.get_text()));
				}
				chat_text.set_text("");
				if(this.chat_holder.stage != null && this.chat_holder.stage.get_focus() == chat_text) {
					this.chat_holder.stage.set_focus(null);
				}
				this.chat_holder.play();
			}
		}
	}
}
