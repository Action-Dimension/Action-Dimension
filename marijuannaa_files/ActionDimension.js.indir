			if(upgradesTitle != null) {
				upgradesTitle.set_text(core_i18n_I18n.t("item.attachments"));
				upgradesTitle.set_visible(true);
				upgradesTitle.mouseEnabled = false;
			}
			let _g = 0;
			while(_g < slotCount) {
				let slotIndex = _g++;
				let slot = this.paintballItemDetails.getChildByName("upgrade" + (slotIndex + 1));
				if(slot == null) {
					continue;
				}
				slot.set_visible(true);
				this.renderModkitSlot(slot,installed != null && slotIndex < installed.length ? installed[slotIndex] : null);
			}
		}
		let isShield = avatar_view_InventoryItemDetails.configNumber(config,"trajectory_type") == 4;
		let _g = 0;
		let _g1 = avatar_view_InventoryItemDetails.PAINTBALL_METRIC_CHILDREN;
		while(_g < _g1.length) this.setPaintballChildVisible(_g1[_g++],!isShield);
		if(isShield) {
			this.setPaintballChildVisible("text_damage",true);
			this.setPaintballChildVisible("damage_bar",true);
			let blockAngle = avatar_view_InventoryItemDetails.configNumber(config,"projectile_enabled");
			this.setPaintballMetric("text_damage","damage_bar",core_i18n_I18n.t("item.metric.block_angle"),blockAngle / 180);
			return;
		}
		let pellets = avatar_view_InventoryItemDetails.configNumber(config,"pellets",1);
		let damage = avatar_view_InventoryItemDetails.configNumber(config,"damage") * pellets;
