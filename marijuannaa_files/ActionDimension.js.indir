		this.panel.getChildByName("text_skin").set_text(core_i18n_I18n.t("character.skin"));
		let textEyes = this.panel.getChildByName("text_eyes");
		textEyes.set_text(core_i18n_I18n.t("character.eyes"));
		let textMouth = this.panel.getChildByName("text_mouth");
