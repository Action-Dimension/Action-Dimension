	remove_all_players() {
		let ids = [];
		let _g = 0;
		let _g1 = this.player_array;
		while(_g < _g1.length) {
			let clip = _g1[_g];
			++_g;
			if(clip != null) {
				ids.push(clip.player_id);
			}
		}
		let _g2 = 0;
		while(_g2 < ids.length) this.remove_player(ids[_g2++]);
	}
	remove_player(pl) {
		let playerId = 0;
		let leavingPlayer = this.player(pl);
		if(leavingPlayer != null) {
			this._paintball.particleModel.remove_utility_item(pl);
			this._paintball.tileWorld.removeAnchoredDisplay(leavingPlayer.name_holder);
			this._paintball.tileWorld.removeContent(leavingPlayer);
			this._paintball.particleModel.player_utility_array_map[pl] = 0;
			this.player_array = [];
			this.player_array_map[pl] = -1;
			this.player_clips[pl] = null;
			playerId = 1;
			while(playerId < this._paintball.state.total_player) {
				if(this.player_array_map[playerId] != -1) {
					let remainingPlayer = this.player_clips[playerId];
					if(remainingPlayer != null && (remainingPlayer != null && remainingPlayer.parent == this._paintball.tileWorld.content)) {
						this.player_array_map[playerId] = this.player_array.length;
						this.player_array.push(remainingPlayer);
					} else {
						this.player_array_map[playerId] = -1;
					}
				}
				++playerId;
			}
			let value = this._paintball.small_map.getChildByName("small_map_inner");
			let small_map_inner = ((value) instanceof openfl_display_MovieClip) ? value : null;
			if(small_map_inner != null) {
				let indicator = this.getPlayer(pl).small_map_indicator;
				if(indicator != null) {
					small_map_inner.removeChild(indicator);
				}
			}
		}
	}
	animate_player(pl,steps) {
		if(steps == null) {
			steps = 1;
		}
		let currentPlayer = this.player(pl);
		if(currentPlayer == null || !currentPlayer.char_loaded) {
			return;
		}
		let currentAnimationClip = atlas_AtlasTools.child(this.player_array[this.player_array_map[pl]].pholder_inner,currentPlayer.anim_mc);
		if(currentAnimationClip == null) {
			return;
		}
		let animationIndex = currentPlayer.animate - 1;
		let startFrame = this.pl_anim_array[animationIndex][0];
		let endFrame = this.pl_anim_array[animationIndex][1];
		let total = currentAnimationClip.get_numFrames();
		if(total > 0 && endFrame > total) {
			endFrame = total;
		}
		if(startFrame > total) {
			startFrame = total;
		}
		let cf = currentAnimationClip.get_currentFrame();
		if(cf < startFrame || cf > endFrame) {
			currentAnimationClip.gotoAndStop(startFrame);
			return;
		}
		if(startFrame == endFrame || steps <= 0) {
			return;
		}
		currentAnimationClip.gotoAndStop(startFrame + (cf - startFrame + steps) % (endFrame - startFrame + 1));
	}
	check_player_collision_for_projectile(projectileIdx,offX,offY) {
		if(offY == null) {
			offY = 0;
		}
		if(offX == null) {
			offX = 0;
		}
		let particle = this._paintball.particleModel.projectile_array[projectileIdx];
		let particleX = particle.get_x() + offX;
		let particleY = particle.get_y() + offY;
		let hasCollision = false;
		let worldContent = this._paintball.tileWorld.content;
		let bucketItems = this._paintball.mapModel.collision_bucket_items[this._paintball.mapModel.collision_bucket_index(particleX)];
		let itemIndex = 0;
		while(itemIndex < bucketItems.length) {
			let mapItemPaintball = bucketItems[itemIndex];
			if(mapItemPaintball.has_collision_bounds && mapItemPaintball.item_height >= (particle.elevation * -1 | 0) && particleX >= mapItemPaintball.collision_min_x && particleX <= mapItemPaintball.collision_max_x && particleY >= mapItemPaintball.collision_min_y && particleY <= mapItemPaintball.collision_max_y) {
				if(atlas_AtlasHitTest.hitTestWorld(mapItemPaintball.get_col_shape(),worldContent,particleX,particleY,true)) {
					hasCollision = true;
					if(particle.rot <= 130 || particle.rot >= 290) {
						if(mapItemPaintball.splat_map_cnt != 0) {
							let shooterPlayer = this.getPlayer(particle.shooter);
							let tmid = shooterPlayer != null ? shooterPlayer.tmid : 0;
							let splatMapIndex = 1;
							while(splatMapIndex <= mapItemPaintball.splat_map_cnt) {
								let splatMap;
								switch(splatMapIndex) {
								case 1:
									splatMap = mapItemPaintball.get_splat_map_1();
									break;
								case 2:
									splatMap = mapItemPaintball.get_splat_map_2();
									break;
								case 3:
									splatMap = mapItemPaintball.get_splat_map_3();
									break;
								default:
									splatMap = null;
								}
								let splatBitmapData;
								switch(splatMapIndex) {
								case 1:
									splatBitmapData = mapItemPaintball.splat_bitmapdata_1;
									break;
								case 2:
									splatBitmapData = mapItemPaintball.splat_bitmapdata_2;
									break;
								case 3:
									splatBitmapData = mapItemPaintball.splat_bitmapdata_3;
									break;
								default:
									splatBitmapData = null;
								}
								let localSplatPoint = atlas_AtlasHitTest.worldToLocal(splatMap,worldContent,particle.get_x(),particle.get_y() + particle.elevation);
								this._paintball.particleModel.splat(splatBitmapData,this._paintball.utilityModel.getBitmapData("PrtSplatTeam" + tmid + ((Math.random() * this._paintball.particleModel.total_projectile_splat_bitmap | 0) + 1)),localSplatPoint.x,localSplatPoint.y);
								++splatMapIndex;
							}
						}
					}
				}
			}
			++itemIndex;
		}
		return hasCollision;
	}
	player_login_handler(playerId,userName,userId) {
		if(this.player(playerId) == null) {
			if(playerId != this._paintball.state.playerId) {
				this.resend_my_variables();
				this.create_player(playerId,userName,userId);
			}
		}
	}
	player_logout_handler(playerId) {
		if(playerId != this._paintball.state.playerId) {
			this.remove_player(playerId);
		}
	}
	update_my_stat_affected_variables(speedExtra,hpExtra,staminaExtra,buffExtra) {
		let speedBonus = 0;
		let staminaBonus = 0;
		let hpBonus = 0;
		let intelligenceStatCap = 250;
		if(this._paintball.state.my_agility == null) {
			this._paintball.state.my_agility = 50;
			this._paintball.state.my_toughness = 50;
			this._paintball.state.my_intelligence = 50;
			this._paintball.state.my_dexterity = 50;
		}
		speedBonus = ((sim_logic_PhysicsUtils.curvedStatBonus(1.5,this._paintball.state.my_agility,250) + speedExtra) * 1000 | 0) / 1000;
		this._paintball.state.my_player_speed = Math.min(4 + speedBonus,5.5);
		staminaBonus = sim_logic_PhysicsUtils.curvedStatBonus(25,this._paintball.state.my_dexterity,250) + staminaExtra | 0;
		this.my_player_stamina_max = Math.min(20 + staminaBonus,55) | 0;
		hpBonus = sim_logic_PhysicsUtils.curvedStatBonus(30,this._paintball.state.my_toughness,250) + hpExtra | 0;
		this._paintball.state.my_hp_max = Math.min(101 + hpBonus,140) | 0;
		let intelligence = Math.max(0,Math.min(this._paintball.state.my_intelligence,intelligenceStatCap));
		this.stat_bonus_buff = Math.min(50,Math.floor((intelligence + (intelligenceStatCap - intelligence) / 10) / intelligenceStatCap * 40) + Math.max(0,buffExtra));
		this._paintball.uiModel.updateStatsMenuTexts(this._paintball.state.my_agility,this._paintball.state.my_toughness,this._paintball.state.my_intelligence,this._paintball.state.my_dexterity,4,speedBonus,20,staminaBonus,101,hpBonus,this.stat_bonus_buff);
	}
	calculate_stat_bonus(armorId) {
		let speedBonus = 0;
		let hpBonus = 0;
