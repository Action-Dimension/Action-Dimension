class avatar_view_kit_MapPreview {
	static paintball(index,target,width,height) {
		avatar_view_kit_MapPreview.thumb("paintball",index,target,width,height);
	}
	static tennis(index,target,width,height) {
		avatar_view_kit_MapPreview.thumb("tennis",index,target,width,height);
	}
	static thumb(prefix,index,target,width,height) {
		let id = "assets/images/room_thumbs/" + prefix + "_" + (index + 1) + ".png";
		if(!openfl_utils_Assets.exists(id)) {
			return;
		}
		openfl_utils_Assets.loadBitmapData(id).onComplete(function(data) {
			if(data == null || target == null || data.width <= 0 || data.height <= 0) {
				return;
			}
			let scale = Math.max(width / data.width,height / data.height);
			let bitmap = new openfl_display_Bitmap(data,1,true);
			bitmap.set_scaleX(scale);
			bitmap.set_scaleY(scale);
			bitmap.set_x((width - data.width * scale) / 2);
			bitmap.set_y((height - data.height * scale) / 2);
			target.addChild(bitmap);
		});
	}
}
