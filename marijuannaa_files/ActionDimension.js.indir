			return;
		}
		this.setPaintballChildVisible("upgrade" + 1,false);
		this.setPaintballChildVisible("upgrade" + 2,false);
		this.setPaintballChildVisible("upgrade" + 3,false);
		this.setPaintballChildVisible("upgrade" + 4,false);
		this.setPaintballChildVisible("upgrade" + 5,false);
		this.setPaintballChildVisible("text_upgrades",false);
		let slotCount = Math.max(0,Math.min(5,avatar_view_InventoryItemDetails.configNumber(config,"modkit_slots",1))) | 0;
		let installed = this.itemData.installed_modkits;
		if(slotCount > 0) {
