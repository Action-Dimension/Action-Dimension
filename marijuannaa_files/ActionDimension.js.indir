			let player_name = name_holder.player_name;
			let team_name_indicator = name_holder.team_name_indicator;
			let name_symbol = name_holder.name_symbol;
			if(player_name.get_text() != currentPlayer.player_name) {
				player_name.set_text(currentPlayer.player_name);
				team_name_indicator.set_width(player_name.get_textWidth() + 10);
				name_symbol.set_x(player_name.get_textWidth() / 2 + 15);
				name_symbol.set_visible(false);
