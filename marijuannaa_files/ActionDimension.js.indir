		let ammo = avatar_view_InventoryItemDetails.configNumber(config,"ammo");
		let speed = avatar_view_InventoryItemDetails.configNumber(config,"projectile_speed");
		let accuracy = avatar_view_InventoryItemDetails.configNumber(config,"accuracy");
		let scope = avatar_view_InventoryItemDetails.configNumber(config,"scope_zoom");
		this.setPaintballMetric("text_damage","damage_bar",core_i18n_I18n.t("item.metric.damage"),damage / 100);
