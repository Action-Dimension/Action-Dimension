				_gthis.setCashMenuText.set_text(offerCash == null ? "null" : "" + offerCash);
			}
		});
		setCashBtnPlus100.addEventListener("mouseDown",function(e) {
			if(Std.parseInt(StringTools.replace(_gthis.cashText.get_text(),"Cash: ","")) > offerCash + 99) {
				offerCash += 100;
				_gthis.setCashMenuText.set_text(offerCash == null ? "null" : "" + offerCash);
