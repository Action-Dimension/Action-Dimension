					}
					let ind;
					if(dolink && this.console.get_config().useObjectLinking) {
						ind = this.console.get_refs().setLogRef(obj);
						n = "<a href='event:cl_" + (ind == null ? "null" : Std.string(UInt.toFloat(ind))) + "'>" + n + "</a> " + this.console.get_refs().makeRefTyped(obj);
					} else {
						n = n + " (" + com_junkbyte_console_core_LogReferences.ShortClassName(obj) + ")";
					}
					if(obj == stg) {
						ind = this.console.get_refs().setLogRef(stg);
						if(ind != 0) {
							str += "<p3><a href='event:cl_" + (ind == null ? "null" : Std.string(UInt.toFloat(ind))) + "'><i>Stage</i></a> ";
						} else {
							str += "<p3><i>Stage</i> ";
						}
						str += "[" + stg.get_mouseX() + "," + stg.get_mouseY() + "]</p3><br/>";
					} else if(i == len - 1) {
						str += "<p5>" + n + "</p5><br/>";
					} else {
						str += "<p2><i>" + n + "</i></p2><br/>";
					}
					if(this.console.get_config().displayRollerTilemapCapturingEnabled && ((obj) instanceof openfl_display_Tilemap)) {
						str += this.__processTilemapString(obj,dolink,i + 1);
					}
				}
			}
		}
		return str;
	}
	__processTilemapString(tilemap,dolink,depth) {
		if(depth == null) {
			depth = 0;
		}
		let str = "";
		let parentBlackList = [];
		let tileDepthArray = com_junkbyte_console_core_TileTools.hitList(tilemap);
		if(tileDepthArray != null) {
			let _g = 0;
			while(_g < tileDepthArray.length) {
				let tileDepth = tileDepthArray[_g];
				++_g;
				let tiles = [tileDepth.tile];
				if(tileDepth.tile.parent != null && parentBlackList.indexOf(tileDepth.tile.parent) == -1) {
					let tile = tileDepth.tile.parent;
					while(tile != null) {
						if(parentBlackList.indexOf(tile) != -1) {
							break;
						}
						parentBlackList.push(tile);
						tiles.splice(0,0,tile);
						if(tile.parent != null) {
							tile = tile.parent;
						} else {
							break;
						}
					}
				}
				let tempDepth = tileDepth.depth - (tiles.length - 1);
				let _g1 = 0;
				while(_g1 < tiles.length) {
					let tile = tiles[_g1];
					++_g1;
					++tempDepth;
					let j = tempDepth + depth;
					while(j > 0) {
						str += j == 1 ? " ∟" : " -";
						--j;
					}
					let n;
					if(Object.prototype.hasOwnProperty.call(tile,"name")) {
						n = Reflect.field(tile,"name");
					} else if(((tile) instanceof openfl_display_Tile)) {
						n = "Tile";
					} else if(((tile) instanceof openfl_display_TileContainer)) {
						n = "TileContainer";
					} else {
						n = "?";
					}
					let ind;
					if(dolink && this.console.get_config().useObjectLinking) {
						ind = this.console.get_refs().setLogRef(tile);
						n = "<a href='event:cl_" + (ind == null ? "null" : Std.string(UInt.toFloat(ind))) + "'>" + n + "</a> " + this.console.get_refs().makeRefTyped(tile);
					} else {
						n = n + " (" + com_junkbyte_console_core_LogReferences.ShortClassName(tile) + ")";
					}
					str += "<p2><i>" + n + "</i></p2><br/>";
				}
			}
		}
		return str;
	}
	close() {
		this.cancelCaptureKeySet();
		this.removeListeners();
		super.close();
		this.console.get_panels().updateMenu();
	}
	onMenuRollOver(e) {
		let txt = e.text != null ? StringTools.replace(e.text,"event:","") : "";
		if(txt == "close") {
			txt = "Close";
		} else if(txt == "capture") {
			let key = this.console.get_rollerCaptureKey();
			if(key != null) {
				txt = "Unassign key ::" + key.get_key();
			} else {
				txt = "Assign key";
			}
		} else if(txt == "cancel") {
			txt = "Cancel assign key";
