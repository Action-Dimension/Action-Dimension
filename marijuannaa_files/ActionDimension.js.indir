						reloadRemaining = _this.weapon2reload;
						break;
					case 3:
						reloadRemaining = _this.weapon3reload;
						break;
					case 4:
						reloadRemaining = _this.weapon4reload;
						break;
					default:
						reloadRemaining = 0;
					}
					let reloadRemaining1 = reloadRemaining - paintball_model_FrameModel.SIM_DT_MS;
					if(reloadRemaining1 < 0) {
						reloadRemaining1 = 0;
					}
					let _this1 = this._paintball.loadoutModel;
					switch(selected_slot) {
					case 1:
						_this1.weapon1reload = reloadRemaining1;
						break;
					case 2:
						_this1.weapon2reload = reloadRemaining1;
						break;
					case 3:
						_this1.weapon3reload = reloadRemaining1;
						break;
					case 4:
						_this1.weapon4reload = reloadRemaining1;
						break;
					default:
					}
					ammo_bar.set_scaleX(reloadDuration > 0 ? 1 - reloadRemaining1 / reloadDuration : 0);
				} else {
					let _this = this._paintball.loadoutModel;
					let tmp;
					switch(selected_slot) {
					case 1:
						tmp = _this.weapon1ammo;
						break;
					case 2:
						tmp = _this.weapon2ammo;
						break;
					case 3:
						tmp = _this.weapon3ammo;
						break;
					case 4:
						tmp = _this.weapon4ammo;
						break;
					default:
						tmp = 0;
					}
					ammo_bar.set_scaleX(tmp / wArr[2]);
				}
			}
			let clip_bar = this._paintball.clip_bar_holder.getChildByName("clip_bar");
			if(clip_bar != null) {
				let _this = this._paintball.loadoutModel;
				let tmp;
				switch(selected_slot) {
				case 1:
					tmp = _this.weapon1clip;
