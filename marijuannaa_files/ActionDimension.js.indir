	static traceSegment(world,ax,ay,bx,by) {
		if(world == null) {
			return -1;
		}
		let best = -1.0;
		let s = world.collisions.iterator();
		while(s.hasNext()) {
			let s1 = s.next();
			if((s1.flags & 1) == 0) {
				continue;
			}
			if(s1.type == 1) {
				let b = sim_logic_SegmentCollision.circle(ax,ay,bx,by,s1.x,s1.y,s1.w);
				if(b >= 0 && (best < 0 || b < best)) {
					best = b;
				}
			} else if(s1.type == 0) {
				let interval = sim_logic_SegmentCollision.rect(ax,ay,bx,by,s1.x,s1.y,s1.x + s1.w,s1.y + s1.h);
