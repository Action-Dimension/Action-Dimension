			surface.registerEvent(haxe_ui_events_UIEvent.RESIZE,function(_) {
				_gthis.placeBadge(surface);
			});
			surface.registerEvent(haxe_ui_events_UIEvent.READY,function(_) {
				_gthis.placeBadge(surface);
			});
			this.placeBadge(surface);
		}
		this.setBadge(0);
		this.buildPanel();
	}
	placeBadge(surface) {
		if(this.badge == null || surface == null || surface.get_width() <= 0) {
			return;
		}
		this.badge.set_left(surface.get_left() + surface.get_width() - this.badge.get_width() * 0.55);
		this.badge.set_top(0);
	}
