			haxe_NativeStackTrace.lastError = _g;
		}
	}
	run_particles() {
		let particleIndex = this.projectile_array.length - 1;
		let catchupSteps = 0;
		let simulationStep = 0;
		this.my_create_particle_listener();
		this._paintball.playerModel.handle_my_grenade();
		let arr = this.projectile_array;
		let i = 0;
		while(i < arr.length) {
			let p = arr[i];
			if(p.server_birth_time_ms >= 0) {
				++i;
				continue;
			}
			p.set_x(p.sim_curr_x);
			p.set_y(p.sim_curr_y);
			p.elevation = p.sim_curr_elevation;
			p.sim_prev_x = p.sim_curr_x;
			p.sim_prev_y = p.sim_curr_y;
			p.sim_prev_elevation = p.sim_curr_elevation;
			++i;
		}
		while(particleIndex >= 0) {
			let particle = this.projectile_array[particleIndex];
			if(particle.delay_turn <= 0) {
				this._paintball.sfxModel.handle_particle_sound(particleIndex);
				catchupSteps = particle.projectile_time_dif / 8 | 0;
				particle.projectile_time_dif -= catchupSteps;
				simulationStep = 0;
				while(simulationStep <= catchupSteps) {
					try {
						this.run_this_particle(particleIndex);
					} catch( _g ) {
						haxe_NativeStackTrace.lastError = _g;
					}
					++simulationStep;
				}
			} else {
				particle.delay_turn -= 1;
			}
			--particleIndex;
		}
		let arr1 = this.projectile_array;
		let i1 = 0;
		while(i1 < arr1.length) {
			let p = arr1[i1];
			if(p.server_birth_time_ms >= 0) {
				++i1;
				continue;
			}
			p.sim_curr_x = p.get_x();
			p.sim_curr_y = p.get_y();
			p.sim_curr_elevation = p.elevation;
			++i1;
