		let W = this.get_width() - this.startOffset | 0;
		let H = this.get_height() - this.graph.get_y() | 0;
		let lowest = group.low;
		let diffGraph = group.hi - lowest;
		let listchanged = false;
		if(draw) {
			(js_Boot.__cast(group.inv ? this.highTxt : this.lowTxt , openfl_text_TextField)).set_text(group.low == null ? "null" : "" + group.low);
			(js_Boot.__cast(group.inv ? this.lowTxt : this.highTxt , openfl_text_TextField)).set_text(group.hi == null ? "null" : "" + group.hi);
			this.graph.get_graphics().clear();
		}
		let _g = 0;
		while(_g < interests.length) {
			this._interest = interests[_g++];
			let n = this._interest.key;
			let info = this._infoMap.h[n];
			if(info == null) {
				listchanged = true;
				info = [StringTools.hex(this._interest.col),[]];
				this._infoMap.h[n] = info;
			}
			let history = info[1];
			if(push == 1) {
				if(group.type == 1) {
					let frames = Math.floor(group.hi / this._interest.v);
					if(frames > 30) {
						frames = 30;
					}
					while(frames > 0) {
						history.push(this._interest.v);
						--frames;
					}
				} else {
					history.push(this._interest.v);
				}
			}
			let maxLen = Math.floor(W) + 10;
			while(history.length > maxLen) history.shift();
			if(draw) {
				let len = history.length;
				this.graph.get_graphics().lineStyle(1,this._interest.col);
				let Y;
				let _g = 1;
				let _g1 = W > len ? len : W;
				while(_g < _g1) {
					let i = _g++;
					Y = (diffGraph != 0 ? (history[len - i] - lowest) / diffGraph : 0.5) * H;
					if(!group.inv) {
						Y = H - Y;
					}
					if(Y < 0) {
						Y = 0;
					}
					if(Y > H) {
						Y = H;
					}
					if(i == 1) {
						this.graph.get_graphics().moveTo(this.get_width(),Y);
					}
					this.graph.get_graphics().lineTo(W - i,Y);
				}
				let f = this._interest.avg;
				if(isNaN(f) && diffGraph != 0) {
					Y = (this._interest.avg - lowest) / diffGraph * H;
					if(!group.inv) {
						Y = H - Y;
					}
					if(Y < 0) {
						Y = 0;
					}
					if(Y > H) {
						Y = H;
					}
					this.graph.get_graphics().lineStyle(1,this._interest.col,0.3);
					this.graph.get_graphics().moveTo(0,Y);
					this.graph.get_graphics().lineTo(W,Y);
				}
			}
		}
		let X_keys = Object.keys(this._infoMap.h);
		let X_length = X_keys.length;
		let X_current = 0;
		while(X_current < X_length) {
			let X = X_keys[X_current++];
			let found = false;
			let _g = 0;
			while(_g < interests.length) if(interests[_g++].key == X) {
				found = true;
			}
			if(!found) {
				listchanged = true;
				let _this = this._infoMap;
				if(Object.prototype.hasOwnProperty.call(_this.h,X)) {
					delete(_this.h[X]);
				}
			}
		}
		if(draw && (listchanged || this._type != null)) {
			this.updateKeyText();
		}
	}
	updateKeyText() {
		let str = "<r><low>";
		if(this._type != null) {
			let f = this._interest.v;
			if(isNaN(f)) {
				str = "<r><low>" + "no input";
			} else if(this._type == "fpsPanel") {
				str = "<r><low>" + Std.string(this._interest.avg | 0);
			} else if(this._type == "memoryPanel") {
				str = "<r><low>" + (this._interest.v + "mb");
			}
		} else {
			let X_keys = Object.keys(this._infoMap.h);
			let X_length = X_keys.length;
			let X_current = 0;
			while(X_current < X_length) {
				let X = X_keys[X_current++];
				str += " <font color='#" + Std.string(this._infoMap.h[X][0]) + "'>" + X + "</font>";
			}
			str += " |";
		}
		this.txtField.set_htmlText(str + this._menuString);
		this.txtField.set_scrollH(this.txtField.get_maxScrollH());
	}
	linkHandler(e) {
		(js_Boot.__cast(e.currentTarget , openfl_text_TextField)).setSelection(0,0);
		if(e.text == "reset") {
			this.reset();
		} else if(e.text == "close") {
			if(this._type == "fpsPanel") {
				this.console.set_fpsMonitor(false);
			} else if(this._type == "memoryPanel") {
				this.console.set_memoryMonitor(false);
			} else {
				this.stop();
			}
			this.console.get_panels().removeGraph(this._group);
		} else if(e.text == "gc") {
			this.console.gc();
		}
		e.stopPropagation();
	}
	onMenuRollOver(e) {
		let txt = e.text != null ? StringTools.replace(e.text,"event:","") : "";
		if(txt == "gc") {
			txt = "Garbage collect::Requires debugger version of flash player";
		}
		this.console.get_panels().tooltip(txt,this);
	}
}
