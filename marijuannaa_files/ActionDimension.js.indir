class avatar_view_scene_PlayableItemSprite extends openfl_display_TileContainer {
	constructor(state,ownerId) {
		openfl_display_Tile._hx_skip_constructor = true;
		super();
		openfl_display_Tile._hx_skip_constructor = false;
		this._hx_constructor(state,ownerId);
	}
	_hx_constructor(state,ownerId) {
		this.lastCatcherId = "";
		this.wasHeld = true;
		super._hx_constructor();
		this.state = state;
		this.ownerId = ownerId;
		this.clip = atlas_AtlasLibrary.sheets.h["playable_item"].create("Symbol 208");
		this.clip.gotoAndStop(state.frame | 0);
		this.inner = this.clip._player.getSymbolByName("playable_item_inner");
		this.addTile(this.clip);
		this.set_x(state.x);
		this.set_y(state.y);
		this.wasHeld = state.held;
		this.lastCatcherId = state.catcher_id;
		this.syncVisual(true);
	}
	get_depthY() {
		return this.get_y();
	}
	get_depthOrder() {
		return 4;
	}
	updateFrame(delta) {
		if(this.state == null || this.clip == null) {
			return;
		}
		let held = this.state.held;
		if(this.wasHeld && !held) {
			let thrower = this.playerSprite(this.lastCatcherId);
			if(thrower != null) {
				thrower.forceEmote(26,1000);
			}
			core_audio_GameAudio.play("frisbee");
			if(this.inner != null) {
				this.inner.play();
			}
		} else if(!this.wasHeld && held) {
			if(this.inner != null) {
				this.inner.stop();
			}
			let catcher = this.playerSprite(this.state.catcher_id);
			if(catcher != null) {
				catcher.forceEmote(10,700);
			}
		}
		this.syncVisual(false);
		this.wasHeld = held;
		this.lastCatcherId = this.state.catcher_id;
		this.clip.updateFrame(delta);
	}
	syncVisual(force) {
		if(this.state.held) {
			let catcher = this.playerSprite(this.state.catcher_id);
			if(catcher != null) {
				this.set_x(catcher.get_x());
				this.set_y(catcher.get_y() + 1);
			} else {
				this.set_x(this.state.x);
				this.set_y(this.state.y);
			}
			if(this.inner != null) {
				this.inner.set_y(-15);
				this.inner.set_rotation(30);
			}
			return;
		}
		let dx = this.state.x - this.get_x();
		let dy = this.state.y - this.get_y();
		if(force || dx * dx + dy * dy > 40000) {
			this.set_x(this.state.x);
			this.set_y(this.state.y);
		} else {
			this.set_x(this.get_x() + dx * 0.45);
			this.set_y(this.get_y() + dy * 0.45);
		}
		if(this.inner != null) {
			this.inner.set_y(-this.state.elevation);
			this.inner.set_rotation(0);
		}
	}
	playerSprite(id) {
		if(Action.instance == null || Action.instance.scenePlayerController == null) {
			return null;
		}
		return Action.instance.scenePlayerController.getPlayerSpriteById(id);
	}
}
