		this.stage.removeEventListener("mouseUp",$bind(this,this.onScrollBarUp));
	}
	get_scrollPercent() {
		return (this._scroller.get_y() - UInt.toFloat(this.get_style().controlSize)) / (this._scrollHeight - 30 - UInt.toFloat(this.get_style().controlSize * 2));
	}
	set_scrollPercent(per) {
		let tmp = this._scroller;
		let a = this.get_style().controlSize;
		let b = (this._scrollHeight - 30 - UInt.toFloat(this.get_style().controlSize * 2)) * per;
		tmp.set_y(UInt.toFloat(a) + b);
		return per;
