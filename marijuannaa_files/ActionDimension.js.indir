			this._paintball.health_indicator.set_visible(confirmedHealInRange && this._paintball.playerModel.can_i_be_healed());
			this._paintball.supply_indicator.set_visible(confirmedSupplyInRange && this._paintball.playerModel.can_i_be_supplied());
		}
	}
	clear_transient_visuals() {
		let index = this.projectile_array.length - 1;
		while(index >= 0) {
			this.remove_particle(index);
			--index;
		}
		this.server_projectile_map = new haxe_ds_IntMap();
		let _g = 0;
		let _g1 = this.water_effect_array;
		while(_g < _g1.length) _g1[_g++].set_visible(false);
		let _g2 = 0;
		let _g3 = this.explosion_ground_effect_array;
		while(_g2 < _g3.length) _g3[_g2++].set_visible(false);
		let _g4 = 0;
		let _g5 = this.explosion_water_effect_array;
		while(_g4 < _g5.length) _g5[_g4++].set_visible(false);
	}
	remove_particle(idx) {
		if(idx < 0 || idx >= this.projectile_array.length) {
			return;
		}
		let prt = this.projectile_array[idx];
		if(prt != null && prt.server_id >= 0) {
			this.server_projectile_map.remove(prt.server_id);
		}
		if(prt != null && (prt != null && prt.parent == this._paintball.tileWorld.content)) {
			this._paintball.tileWorld.removeContent(prt);
		}
		this.projectile_array.splice(idx,1);
		if(prt != null) {
			this.recycleParticle(prt);
		}
	}
	run_server_particle_visual(particle,idx) {
		if(particle.death_timer != 0) {
			let timeline = particle.get_prt();
			if(timeline != null && timeline.get_currentFrame() == 1) {
				timeline.gotoAndPlay(2);
			}
			if(particle.death_timer < this._paintball.frameModel.sim_time) {
				this.remove_particle(idx);
			}
			return;
		}
		if(openfl_Lib.getTimer() - particle.server_snapshot_local_time_ms > 30000) {
			this.remove_particle(idx);
			return;
		}
		if(particle.server_birth_time_ms >= 0) {
			this.ensure_server_particle_steps(particle);
		} else {
			this.step_server_particle_physics(particle);
		}
		let currentRotation = particle.rot - 27;
		if(this._paintball.cameraModel.is_this_bg_item_in_camera_view(particle.get_x(),particle.get_y())) {
			let visualRotation = particle.rot - 27;
			while(visualRotation < 0) visualRotation += 360;
			while(visualRotation >= 360) visualRotation -= 360;
			if(visualRotation < 180) {
				currentRotation = visualRotation + particle.elevation_speed * 5;
			} else {
				currentRotation = visualRotation - particle.elevation_speed * 5;
			}
			let shadowAlpha = 1 + particle.elevation / 70;
			let shadowScale = Math.max(0.05,0.6 - particle.elevation / 50);
			if(shadowAlpha < 0.1) {
				shadowAlpha = 0.1;
			}
			particle.prt_shadow.set_scaleX(shadowScale);
			particle.prt_shadow.set_scaleY(shadowScale);
			particle.prt_shadow.set_alpha(shadowAlpha);
		}
		particle.prt_inner.set_y(particle.elevation);
		particle.prt_inner.set_rotation(currentRotation);
		if(!particle.get_visible()) {
			particle.set_visible(true);
		}
	}
	step_server_particle_physics(particle) {
		let previousX = particle.get_x();
		let previousY = particle.get_y();
		let previousElevation = particle.elevation;
		let k = paintball_model_FrameModel.DT_SCALE;
		particle.set_x(particle.get_x() + particle.speed * Math.cos(Math.PI / 180 * particle.rot - 90) * k);
		particle.set_y(particle.get_y() + particle.speed * Math.sin(Math.PI / 180 * particle.rot - 90) * k);
		if(particle.gravity_enabled == 1) {
			particle.elevation_speed += this.projectile_gravity * k;
		}
		particle.elevation += particle.elevation_speed * k;
		if(particle.speed > 0.5) {
			particle.speed -= 0.03 * k;
		}
		if(this.clamp_visual_wall_collision(particle,previousX,previousY,previousElevation)) {
			particle.prediction_render_offset_x = 0;
			particle.prediction_render_offset_y = 0;
			particle.prediction_render_offset_elevation = 0;
			let currentRotation = particle.rot - 27;
			if(this._paintball.cameraModel.is_this_bg_item_in_camera_view(particle.get_x(),particle.get_y())) {
				let visualRotation = particle.rot - 27;
				while(visualRotation < 0) visualRotation += 360;
				while(visualRotation >= 360) visualRotation -= 360;
				if(visualRotation < 180) {
					currentRotation = visualRotation + particle.elevation_speed * 5;
				} else {
					currentRotation = visualRotation - particle.elevation_speed * 5;
				}
				let shadowAlpha = 1 + particle.elevation / 70;
				let shadowScale = Math.max(0.05,0.6 - particle.elevation / 50);
				if(shadowAlpha < 0.1) {
					shadowAlpha = 0.1;
				}
				particle.prt_shadow.set_scaleX(shadowScale);
				particle.prt_shadow.set_scaleY(shadowScale);
				particle.prt_shadow.set_alpha(shadowAlpha);
			}
			particle.prt_inner.set_y(particle.elevation);
			particle.prt_inner.set_rotation(currentRotation);
			particle.set_visible(true);
			if(particle.death_timer == 0) {
				particle.death_timer = this._paintball.frameModel.sim_time + this.projectile_death_timer_max;
				let timeline = particle.get_prt();
				if(timeline != null && timeline.get_currentFrame() == 1) {
					timeline.gotoAndPlay(2);
				}
			}
			return;
		}
		if(particle.elevation >= 0) {
			if(this.check_if_swimming(particle.get_x(),particle.get_y()) < 10 && particle.projectile_bounces_left > 0) {
				particle.elevation = -1;
				particle.elevation_speed *= -0.9;
				particle.projectile_bounces_left--;
			} else {
				particle.elevation = 0;
				particle.elevation_speed = 0;
			}
		}
	}
	ensure_server_particle_steps(p) {
		if(p.server_birth_time_ms < 0 || p.death_timer != 0 || p.visual_wall_blocked) {
			return;
		}
		let t = (this._paintball.predictionModel.estimatedServerTimeMs() - p.server_birth_time_ms) / paintball_model_FrameModel.SIM_DT_MS;
		let target = t < 0 ? 1 : 1 + (Math.floor(t) | 0);
		if(target - p.sim_steps > 40) {
			target = p.sim_steps + 40;
		}
		while(p.sim_steps < target) {
			p.sim_prev_x = p.sim_curr_x;
			p.sim_prev_y = p.sim_curr_y;
			p.sim_prev_elevation = p.sim_curr_elevation;
			p.set_x(p.sim_curr_x);
			p.set_y(p.sim_curr_y);
			p.elevation = p.sim_curr_elevation;
			this.step_server_particle_physics(p);
			p.sim_curr_x = p.get_x();
			p.sim_curr_y = p.get_y();
			p.sim_curr_elevation = p.elevation;
			p.sim_steps++;
			if(p.death_timer != 0 || p.visual_wall_blocked) {
				break;
			}
		}
	}
	server_particle_alpha(p) {
		let t = (this._paintball.predictionModel.estimatedServerTimeMs() - p.server_birth_time_ms) / paintball_model_FrameModel.SIM_DT_MS;
		if(t < 0) {
			return 0;
		}
		let whole = Math.floor(t);
		if(p.sim_steps < 1 + whole) {
			return 1;
		}
		return t - whole;
	}
	place_server_particle_visual_at(serverId,visibleX,visibleY) {
		let particle = this.server_projectile_map.h[serverId];
		if(particle == null || particle.server_birth_time_ms < 0 || particle.death_timer != 0) {
			return;
		}
		this.ensure_server_particle_steps(particle);
		let a = this.server_particle_alpha(particle);
		particle.prediction_render_offset_x = visibleX - (particle.sim_prev_x + (particle.sim_curr_x - particle.sim_prev_x) * a);
		particle.prediction_render_offset_y = visibleY - (particle.sim_prev_y + (particle.sim_curr_y - particle.sim_prev_y) * a);
	}
	apply_server_particle_checkpoint(serverId,x,y,elevation,speed,elevationSpeed,rot,bounces,timeMs) {
		let particle = this.server_projectile_map.h[serverId];
		if(particle == null || particle.death_timer != 0) {
			return;
		}
		particle.server_snapshot_local_time_ms = openfl_Lib.getTimer();
		particle.server_has_snapshot = true;
		let serverClocked = particle.server_birth_time_ms >= 0;
		let errorX = (serverClocked ? particle.sim_prev_x : particle.sim_curr_x) - x;
		let errorY = (serverClocked ? particle.sim_prev_y : particle.sim_curr_y) - y;
		let errorElevation = (serverClocked ? particle.sim_prev_elevation : particle.sim_curr_elevation) - elevation;
		if(errorX * errorX + errorY * errorY + errorElevation * errorElevation <= 9216) {
			return;
		}
		let visibleX = particle.get_x();
		let visibleY = particle.get_y();
		let visibleElevation = particle.elevation;
		particle.set_x(x);
		particle.set_y(y);
		particle.elevation = elevation;
		particle.sim_prev_x = x;
		particle.sim_prev_y = y;
		particle.sim_prev_elevation = elevation;
		particle.sim_curr_x = x;
		particle.sim_curr_y = y;
		particle.sim_curr_elevation = elevation;
		particle.speed = speed;
		particle.elevation_speed = elevationSpeed;
		particle.rot = rot;
		particle.projectile_bounces_left = bounces;
		let drawnX = x;
		let drawnY = y;
		let drawnElevation = elevation;
		if(serverClocked) {
			particle.sim_steps = Math.round((timeMs - particle.server_birth_time_ms) / paintball_model_FrameModel.SIM_DT_MS) | 0;
			if(particle.sim_steps < 0) {
				particle.sim_steps = 0;
			}
			this.ensure_server_particle_steps(particle);
			let a = this.server_particle_alpha(particle);
			drawnX = particle.sim_prev_x + (particle.sim_curr_x - particle.sim_prev_x) * a;
			drawnY = particle.sim_prev_y + (particle.sim_curr_y - particle.sim_prev_y) * a;
			drawnElevation = particle.sim_prev_elevation + (particle.sim_curr_elevation - particle.sim_prev_elevation) * a;
		}
		particle.prediction_render_offset_x = visibleX - drawnX;
		particle.prediction_render_offset_y = visibleY - drawnY;
		particle.prediction_render_offset_elevation = visibleElevation - drawnElevation;
	}
	sync_server_utility(active,owner,team,kind,x,y,expiryTimeMs) {
		this.remove_utility_item(owner);
		if(!active) {
			return;
		}
		this.create_particle(x,y,0,0,0,0,kind,this._paintball.state.timeMs,owner,0,0,0,0,0,1,0);
		let index = this.player_utility_array_map[owner];
		if(index >= 0 && index < this.player_utility_array.length) {
			let utility = this.player_utility_array[index];
			utility.tmid = team;
			let remaining = expiryTimeMs - this._paintball.predictionModel.last_server_snapshot_time_ms;
			if(remaining < 0) {
				remaining = 0;
			}
			utility.time_out = this._paintball.frameModel.sim_time + remaining;
		}
	}
	trigger_server_particle_death(particle,reason) {
		let visualDeathAlreadyStarted = particle.death_timer != 0 && particle.visual_wall_blocked;
		if(particle.death_timer != 0 && !visualDeathAlreadyStarted) {
			return;
		}
		if(reason == 4) {
			let particleIndex = this.projectile_array.indexOf(particle);
			if(particleIndex >= 0) {
				this._paintball.playerModel.check_player_collision_for_projectile(particleIndex);
			}
		}
		if(particle.projectile_exp > 0) {
			if(reason == 7) {
				this.cast_explosion_water_effect(particle.get_x() | 0,particle.get_y() | 0);
			} else {
				let shooterPlayer = this._paintball.playerModel.getPlayer(particle.shooter);
				let explosionTeam = shooterPlayer != null ? shooterPlayer.tmid : 0;
				this.cast_explosion_ground_effect(particle.get_x(),particle.get_y(),explosionTeam);
			}
			this._paintball.sfxModel.play_explosion_sound(particle.get_x(),particle.get_y());
		}
		if(reason == 1) {
			this.auto_splat(particle);
		} else if(reason == 7) {
			this.cast_water_effect(particle.get_x(),particle.get_y());
		}
		if(reason == 7) {
			particle.death_timer = 1;
		} else if(!visualDeathAlreadyStarted) {
			particle.death_timer = this._paintball.frameModel.sim_time + this.projectile_death_timer_max;
		}
		particle.visual_wall_blocked = false;
	}
	auto_splat(prt) {
		let shooter = this._paintball.playerModel.getPlayer(prt.shooter);
		let team = shooter != null ? shooter.tmid : 1;
		let variant = (Math.random() * this.total_projectile_splat_bitmap | 0) + 1;
		let x = prt.get_x();
		let y = prt.get_y();
		let tmp;
		if(this.backgroundSplatLayer == null) {
			tmp = false;
		} else {
			let tileId = this.backgroundSplatTileIds.h[team + ":" + variant];
			if(tileId == null) {
				tmp = false;
			} else {
				let rect = atlas_AtlasLibrary.sheets.h["sportsbook_paintball_secure"].sheet.tileset.getRect(tileId);
				let tile = new openfl_display_Tile(tileId,x,y,1,1,0);
				if(rect != null) {
					tile.set_originX(rect.width / 2);
					tile.set_originY(rect.height / 2);
				}
				this.backgroundSplatLayer.addTile(tile);
				tmp = true;
			}
		}
		if(!tmp) {
			this.splat(this.splat_bitmapdata_bg,this._paintball.utilityModel.getBitmapData("PrtSplatTeam" + team + variant),prt.get_x(),prt.get_y());
		}
	}
	splat(target,source,x,y) {
		this.splatSourceRect.setTo(0,0,source.width,source.height);
		this.splatTargetPoint.setTo(x - source.width / 2,y - source.height / 2);
		this.splatAlphaPoint.setTo(0,0);
		target.copyPixels(source,this.splatSourceRect,this.splatTargetPoint,source,this.splatAlphaPoint,true);
	}
	check_if_swimming(x,y) {
		return UInt.toFloat(this._paintball.mapModel.collision_bitmapdata.getPixel32(x / 4 | 0,y / 4 | 0) & 255);
	}
	check_optimized_bitmap_collision(x,y,bitmapData) {
		let px = x / 4 | 0;
		let py = y / 4 | 0;
		if(px < 0 || py < 0 || px >= bitmapData.width || py >= bitmapData.height) {
			return true;
		}
		return UInt.gt(255,bitmapData.getPixel32(px,py) >>> 24 & 255);
	}
	check_map_item_collision(x,y) {
		let bucketItems = this._paintball.mapModel.collision_bucket_items[this._paintball.mapModel.collision_bucket_index(x)];
		if(bucketItems == null || bucketItems.length == 0) {
			return false;
		}
		let itemIndex = 0;
		while(itemIndex < bucketItems.length) {
			let item = bucketItems[itemIndex];
			if(item.has_collision_bounds && x >= item.collision_min_x && x <= item.collision_max_x && y >= item.collision_min_y && y <= item.collision_max_y) {
				if(atlas_AtlasHitTest.hitTestWorld(item.get_col_shape(),this._paintball.tileWorld.content,x,y,true)) {
					return true;
				}
			}
			++itemIndex;
		}
		return false;
	}
	muzzle_blocked_by_wall(bodyX,bodyY,anchorX,anchorY,elevation) {
		return this.trace_projectile_wall(bodyX,bodyY,elevation,anchorX,anchorY,elevation) != null;
	}
	trace_projectile_wall(ax,ay,az,bx,by,bz) {
		let hit = null;
		let bitmap = this._paintball.mapModel.collision_bitmapdata;
		if(bitmap != null) {
			let terrainT = sim_logic_SegmentCollision.terrain(ax,ay,bx,by,function(x,y) {
				if(x < 0 || y < 0 || x >= bitmap.width || y >= bitmap.height) {
					return 0;
				}
				return bitmap.getPixel32(x,y) >>> 24 & 255;
			});
			if(terrainT >= 0) {
				hit = { t : terrainT, reason : 2};
			}
		}
		if(this._paintball.tileWorld != null && this._paintball.mapModel.map_item_collision_database != null) {
			let _g = 0;
			let _g1 = this._paintball.mapModel.map_item_collision_database;
			while(_g < _g1.length) {
				let item = _g1[_g];
				++_g;
				if(!item.has_collision_bounds) {
					continue;
				}
				let bounds = sim_logic_SegmentCollision.rect(ax,ay,bx,by,item.collision_min_x,item.collision_min_y,item.collision_max_x,item.collision_max_y);
				if(bounds == null || hit != null && bounds.enter > hit.t) {
					continue;
				}
				if(sim_logic_SegmentCollision.heightHit(az,bz,item.item_height,bounds.enter,bounds.exit) < 0) {
					continue;
				}
				let t = atlas_AtlasHitTest.traceWorld(item.get_col_shape(),this._paintball.tileWorld.content,ax,ay,az,bx,by,bz,item.item_height);
				if(t >= 0 && (hit == null || t < hit.t)) {
					hit = { t : t, reason : 4};
				}
			}
		}
		if(this._paintball.collisionModel != null) {
			let t = this._paintball.collisionModel.traceSegment(ax,ay,bx,by);
			if(t >= 0 && (hit == null || t < hit.t)) {
				hit = { t : t, reason : 8};
			}
		}
		return hit;
	}
	clamp_visual_wall_collision(particle,startX,startY,startElevation) {
		if(particle.visual_wall_blocked) {
			particle.set_x(startX);
			particle.set_y(startY);
			particle.elevation = startElevation;
			return true;
		}
		let hit = this.trace_projectile_wall(startX,startY,startElevation,particle.get_x(),particle.get_y(),particle.elevation);
		if(hit == null) {
			return false;
		}
		particle.set_x(startX + (particle.get_x() - startX) * hit.t);
		particle.set_y(startY + (particle.get_y() - startY) * hit.t);
		particle.elevation = startElevation + (particle.elevation - startElevation) * hit.t;
		particle.visual_wall_blocked = true;
		return true;
	}
	cast_water_effect(x,y) {
		let waterEffect = this.water_effect_array[this.water_effect_turn];
		waterEffect.set_x(x);
		waterEffect.set_y(y);
		waterEffect.gotoAndPlay(1);
		waterEffect.set_visible(true);
		this.water_effect_turn++;
		if(this.water_effect_turn >= this.water_effect_amount) {
			this.water_effect_turn = 0;
		}
	}
	create_water_effects() {
		if(this.water_effect_array != null) {
			let _g = 0;
			let _g1 = this.water_effect_array;
			while(_g < _g1.length) this._paintball.tileWorld.removeContent(_g1[_g++]);
		}
		this.water_effect_array = [];
		this.water_effect_turn = 0;
		let waterEffect = null;
		let effectIndex = 0;
		while(effectIndex < this.water_effect_amount) {
			waterEffect = new PbWaterEffect();
			waterEffect.set_visible(false);
			waterEffect.set_x(0);
			waterEffect.set_y(0);
			this._paintball.tileWorld.content.addTile(waterEffect);
			this.water_effect_array.push(waterEffect);
			++effectIndex;
		}
	}
	cast_explosion_ground_effect(x,y,colorType) {
		let effect = this.explosion_ground_effect_array[this.explosion_ground_effect_turn];
		effect.set_x(x);
		effect.set_y(y);
		effect.gotoAndPlay(1);
		effect.set_visible(true);
		if(colorType == 1) {
			this._paintball.utilityModel.tintTile(effect,16583580,0.7);
		} else {
			this._paintball.utilityModel.tintTile(effect,16744704,0.7);
		}
		this.explosion_ground_effect_turn++;
		if(this.explosion_ground_effect_turn >= this.explosion_ground_effect_amount) {
			this.explosion_ground_effect_turn = 0;
		}
	}
	create_explosion_ground_effects() {
		if(this.explosion_ground_effect_array != null) {
			let _g = 0;
			let _g1 = this.explosion_ground_effect_array;
			while(_g < _g1.length) this._paintball.tileWorld.removeContent(_g1[_g++]);
		}
		this.explosion_ground_effect_array = [];
		this.explosion_ground_effect_turn = 0;
		let groundEffect = null;
		let effectIndex = 0;
		while(effectIndex < this.explosion_ground_effect_amount) {
			groundEffect = new PbExplosionGroundEffect();
			groundEffect.set_visible(false);
			groundEffect.set_x(0);
			groundEffect.set_y(0);
			this._paintball.tileWorld.content.addTile(groundEffect);
			this.explosion_ground_effect_array.push(groundEffect);
			++effectIndex;
		}
	}
	cast_explosion_water_effect(x,y) {
		let explosionWaterEffect = this.explosion_water_effect_array[this.explosion_water_effect_turn];
		explosionWaterEffect.set_x(x);
		explosionWaterEffect.set_y(y);
		explosionWaterEffect.gotoAndPlay(1);
		explosionWaterEffect.set_visible(true);
		this.explosion_water_effect_turn++;
		if(this.explosion_water_effect_turn >= this.explosion_water_effect_amount) {
			this.explosion_water_effect_turn = 0;
		}
	}
	create_explosion_water_effects() {
		if(this.explosion_water_effect_array != null) {
			let _g = 0;
			let _g1 = this.explosion_water_effect_array;
			while(_g < _g1.length) this._paintball.tileWorld.removeContent(_g1[_g++]);
		}
		this.explosion_water_effect_array = [];
		this.explosion_water_effect_turn = 0;
		let waterExplosionEffect = null;
		let effectIndex = 0;
		while(effectIndex < this.explosion_water_effect_amount) {
			waterExplosionEffect = new PbExplosionWaterEffect();
			waterExplosionEffect.set_visible(false);
			waterExplosionEffect.set_x(0);
			waterExplosionEffect.set_y(0);
			this._paintball.tileWorld.content.addTile(waterExplosionEffect);
			this.explosion_water_effect_array.push(waterExplosionEffect);
			++effectIndex;
		}
	}
	create_map_item_collision_array(source,target) {
		let itemIndex = 0;
		let splatIndex = 0;
		while(target.length > 0) target.pop();
		itemIndex = 0;
		while(itemIndex < source.length) {
			let mapItemPaintball = source[itemIndex];
			if(mapItemPaintball.get_height_mark() != null) {
				mapItemPaintball.item_height = mapItemPaintball.get_height_mark().get_y() * -1 | 0;
			}
			if(mapItemPaintball.get_col_shape() != null && mapItemPaintball.get_col_shape().get_width() != 0) {
				target.push(mapItemPaintball);
			}
			if(mapItemPaintball.splat_map_cnt != 0) {
				splatIndex = 1;
				while(splatIndex <= mapItemPaintball.splat_map_cnt) {
					let splatMap;
					switch(splatIndex) {
					case 1:
						splatMap = mapItemPaintball.get_splat_map_1();
						break;
					case 2:
						splatMap = mapItemPaintball.get_splat_map_2();
						break;
					case 3:
						splatMap = mapItemPaintball.get_splat_map_3();
