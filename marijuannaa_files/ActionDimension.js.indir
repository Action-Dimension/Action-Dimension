		if(atlas_MapItemFrames.parseSuiteObjectName(object.Objname) != null) {
			return true;
		}
		if(object.Objname.startsWith("koltuk")) {
			return true;
		}
		let h = Action.instance.ui.inventoryItemsData.h;
		let item_keys = Object.keys(h);
		let item_length = item_keys.length;
		let item_current = 0;
		while(item_current < item_length) {
			let item = h[item_keys[item_current++]];
			if(item.item_category != "suite_item" || item.suite_frames == null) {
				continue;
			}
			if(item.suite_frames.indexOf(object.Objname) >= 0) {
				return true;
			}
		}
		return false;
