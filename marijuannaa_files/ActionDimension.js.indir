			let myWeapon = animMC != null ? atlas_AtlasTools.child(animMC,"my_weapon") : null;
			let weaponHolder = myWeapon != null ? atlas_AtlasTools.child(myWeapon,"weapon_holder") : null;
			let fireIndicator = weaponHolder != null ? atlas_AtlasTools.child(weaponHolder,"fire_indicator") : null;
			if(weaponHolder == null) {
