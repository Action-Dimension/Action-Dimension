			existing.y = y;
			existing.w = w;
			existing.h = h;
			existing.flags = flags;
			return existing;
		}
		let shape = new sim_state_CollisionShape(id,type,x,y,w,h,flags);
		world.collisions.h[id] = shape;
		world.pendingCollisionCreates.push(shape);
		return shape;
	}
	static move(world,id,x,y) {
		let shape = world.collisions.h[id];
