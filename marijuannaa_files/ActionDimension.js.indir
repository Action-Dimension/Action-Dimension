		avatar_view_WindowHelp.bind(this.panel,"settings");
		this.addEventListener("removedFromStage",$bind(this,this.endSlide));
		this.addEventListener("enterFrame",$bind(this,this.checkDrag));
		this.set_visible(false);
	}
	refreshLabels() {
		this.setText("text_title",core_i18n_I18n.t("settings.title"));
		this.setText("text_done",core_i18n_I18n.t("common.done"));
		this.setText("text_antialiasing",core_i18n_I18n.t("settings.quality"));
		this.setText("text_soundvolume",core_i18n_I18n.t("settings.effects"));
		this.setText("text_musicvolume",core_i18n_I18n.t("settings.music"));
	}
	setText(name,value) {
		let field = this.panel.getChildByName(name);
		field.set_text(value);
		field.mouseEnabled = false;
		field.set_selectable(false);
	}
	valueLabel(bar) {
		let text = new openfl_text_TextField();
		text.set_defaultTextFormat(new openfl_text_TextFormat("_sans",10,3355443));
		text.set_x(bar.get_x() + 125);
		text.set_y(bar.get_y() - 8);
		text.set_width(40);
		text.set_height(20);
		text.mouseEnabled = false;
		text.set_selectable(false);
		this.panel.addChild(text);
		return text;
	}
	consumeClick() {
		if(Action.instance == null) {
			return;
		}
		if(Action.instance.ui != null) {
			Action.instance.ui.blockedClick = true;
		}
		if(Action.instance.scene != null) {
			Action.instance.scene.cancelMovementPointer();
		}
	}
	bindSlider(target,kind) {
		target.set_buttonMode(true);
		target.mouseChildren = false;
		let _gthis = this;
		target.addEventListener("mouseDown",function(e) {
			_gthis.endSlide();
			_gthis.consumeClick();
			_gthis.dragging = kind;
			_gthis.dragStage = openfl_Lib.get_current().stage;
			_gthis.dragStage.addEventListener("mouseMove",$bind(_gthis,_gthis.slide),true,3000);
			_gthis.dragStage.addEventListener("mouseUp",$bind(_gthis,_gthis.endSlide),true,3000);
			_gthis.dragStage.addEventListener("mouseLeave",$bind(_gthis,_gthis.endSlide));
			_gthis.dragStage.addEventListener("deactivate",$bind(_gthis,_gthis.endSlide));
			_gthis.slide(e);
		});
	}
	slide(e) {
		if(this.dragging == null) {
			return;
		}
		let value = core_audio_GameSettings.volume((this.panel.globalToLocal(new openfl_geom_Point(e.stageX,e.stageY)).x - (this.dragging == "effects" ? this.sfxBar : this.musicBar).get_x()) / 100,0);
		if(this.dragging == "effects") {
			core_audio_GameSettings.effectsVolume = value;
		} else {
			core_audio_GameSettings.musicVolume = value;
		}
		core_audio_GameAudio.applyVolumes();
		this.refresh();
	}
	endSlide(_) {
		if(this.dragStage == null) {
			return;
		}
		this.dragStage.removeEventListener("mouseMove",$bind(this,this.slide),true);
		this.dragStage.removeEventListener("mouseUp",$bind(this,this.endSlide),true);
		this.dragStage.removeEventListener("mouseLeave",$bind(this,this.endSlide));
		this.dragStage.removeEventListener("deactivate",$bind(this,this.endSlide));
		if(this.dragging == "effects") {
			core_audio_GameAudio.play("open_menu");
		}
		this.dragging = null;
		this.dragStage = null;
		core_audio_GameSettings.save();
	}
	checkDrag(_) {
		if(this.dragging != null && !avatar_view_WindowHelp.isShown(this)) {
			this.endSlide();
		}
	}
	refresh() {
		this.sfxGrip.set_x(this.sfxBar.get_x() + core_audio_GameSettings.effectsVolume * 100);
		this.musicGrip.set_x(this.musicBar.get_x() + core_audio_GameSettings.musicVolume * 100);
		this.sfxValue.set_text((Math.round(core_audio_GameSettings.effectsVolume * 100) | 0) + "%");
		this.musicValue.set_text((Math.round(core_audio_GameSettings.musicVolume * 100) | 0) + "%");
		this.panel.getChildByName("anti_aliasing").gotoAndStop(core_audio_GameSettings.quality);
	}
	open() {
		this.consumeClick();
		if(!this.get_visible()) {
			let bounds = this.panel.getChildAt(0).getBounds(this.panel);
			let stage = openfl_Lib.get_current().stage;
			this.panel.set_x(stage.stageWidth / 2 - (bounds.x + bounds.width / 2) * this.panel.get_scaleX());
			this.panel.set_y(stage.stageHeight / 2 - (bounds.y + bounds.height / 2) * this.panel.get_scaleY());
		}
		this.refresh();
		this.set_visible(true);
	}
	close() {
		this.endSlide();
		core_audio_GameSettings.save();
		this.set_visible(false);
	}
}
