class sim_GameLogic {
	constructor(collision,time) {
		this.accumulator = 0;
		this.world = new sim_state_WorldState();
		this.collisionBitmap = collision;
		this.time = time;
		this.inputs = new haxe_ds_IntMap();
	}
	setTickRate(rate) {
		let r = sim_GameLogic.clampTickRate(rate);
		this.world.tickRate = r;
		this.world.dtMs = 1000 / r;
		this.world.dtScale = 20 / r;
	}
	maxTicksPerFrame() {
		return Math.ceil(250 / this.world.dtMs) | 0;
	}
	nextTickTimeMs() {
		return Math.round((this.world.tickCount + 1) * this.world.dtMs);
	}
	update(dt) {
		this.accumulator += dt;
		let ticks = 0;
		let maxTicks = this.maxTicksPerFrame();
		while(this.accumulator >= this.world.dtMs && ticks < maxTicks) {
			this.tick();
			this.accumulator -= this.world.dtMs;
			++ticks;
		}
		if(ticks == maxTicks) {
			this.accumulator = 0;
		}
	}
	tick() {
		this.world.tickCount++;
		this.world.simTime = Math.round(this.world.tickCount * this.world.dtMs);
		if(this.onTick != null) {
			this.onTick(this.world);
		}
	}
	setInput(playerId,input) {
		this.inputs.h[playerId] = input;
	}
	getInput(playerId) {
		return this.inputs.h[playerId];
	}
	getRenderAlpha() {
		return this.accumulator / this.world.dtMs;
	}
	getCollisionBitmap() {
		return this.collisionBitmap;
	}
	setCollisionBitmap(collision) {
		this.collisionBitmap = collision;
	}
	getTimeProvider() {
		return this.time;
	}
	static clampTickRate(rate) {
		if(rate < 10) {
			return 10;
		}
		if(rate > 120) {
			return 120;
		}
		return rate;
	}
}
