		let victimPlayer = paintball.playerModel.getPlayer(packet.victim);
		if(victimPlayer != null) {
			victimPlayer.deaths = packet.deaths;
			victimPlayer.killedby = packet.shooter;
			victimPlayer.killed_by_time_ms = packet.timeMs;
