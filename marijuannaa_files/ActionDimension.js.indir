class avatar_view_Settings extends openfl_display_Sprite {
	constructor() {
		super();
		core_audio_GameSettings.load();
		this.panel = openfl_utils_Assets.getMovieClip("sportsbook_lobby:sportsbook_lobby_fla.char_menu_options_352");
		this.panel.stop();
		this.panel.set_scaleX(this.panel.set_scaleY(1.4));
		this.addChild(this.panel);
		this.refreshLabels();
		this.sfxBar = this.panel.getChildByName("sfx_volume_bar");
		this.musicBar = this.panel.getChildByName("music_volume_bar");
		this.sfxGrip = this.panel.getChildByName("sfx_volume_grip");
		this.musicGrip = this.panel.getChildByName("music_volume_grip");
		this.sfxValue = this.valueLabel(this.sfxBar);
		this.musicValue = this.valueLabel(this.musicBar);
		this.bindSlider(this.sfxBar,"effects");
		this.bindSlider(this.sfxGrip,"effects");
		this.bindSlider(this.musicBar,"music");
		this.bindSlider(this.musicGrip,"music");
		let _gthis = this;
		let choice = this.panel.getChildByName("anti_aliasing_" + 1);
		choice.set_buttonMode(true);
		choice.mouseChildren = false;
		choice.addEventListener("mouseDown",function(_) {
			_gthis.consumeClick();
			core_audio_GameSettings.quality = 1;
			core_audio_GameSettings.applyQuality();
			core_audio_GameSettings.save();
			_gthis.refresh();
		});
		let choice1 = this.panel.getChildByName("anti_aliasing_" + 2);
		choice1.set_buttonMode(true);
		choice1.mouseChildren = false;
		choice1.addEventListener("mouseDown",function(_) {
			_gthis.consumeClick();
			core_audio_GameSettings.quality = 2;
			core_audio_GameSettings.applyQuality();
			core_audio_GameSettings.save();
