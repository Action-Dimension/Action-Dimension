			_gthis.close();
		});
		this.buttons.h["item_detail_button_use"].addEventListener("click",function(e) {
			if(_gthis.itemData == null) {
				return;
			}
			let consumable = _gthis.itemData.consumable;
			if((consumable == null ? "" : consumable.type) == "crystal_voucher") {
				let voucherItemId = _gthis.itemPrivateID;
				Action.instance.ui.actionPermission.open(core_i18n_I18n.t("item.voucher_confirm",{ amount : consumable.crystal_amount}),function() {
					Action.instance.ui.transferLoader.set_visible(true);
					Action.instance.playerModel.redeemCrystalVoucher(voucherItemId);
					_gthis.close();
				},function() {
				});
			} else if(_gthis.itemData.item_category.indexOf("modkit") > -1) {
				let selectedModkit = _gthis.itemData;
				Action.instance.ui.inventoryWindow.close();
				Action.instance.ui.modkitUpgradeWindow.open(selectedModkit);
			} else if(_gthis.itemData.item_category == "consumable") {
				Action.instance.ui.transferLoader.set_visible(true);
				Action.instance.playerModel.useStatPotion(_gthis.itemPrivateID);
				_gthis.close();
			}
		});
		this.buttons.h["item_detail_button_play"].addEventListener("click",function(e) {
			if(_gthis.itemPrivateID == null) {
				return;
			}
			Action.instance.playerModel.playPlayableItem(_gthis.itemPrivateID);
			_gthis.close();
		});
		this.buttons.h["item_detail_button_stop_play"].addEventListener("click",function(e) {
			Action.instance.playerModel.stopPlayableItem();
			_gthis.close();
		});
		details.addEventListener("mouseDown",function(e) {
			Action.instance.ui.blockedClick = true;
		});
	}
	open(item,image,buttonType,buttonValue) {
		this.itemData = item;
		this.currentButtonType = buttonType;
		this.itemPrivateID = item.id;
		this.set_visible(true);
		this.itemID = item.item_id;
		this.itemName.set_text(core_i18n_I18n.itemName(item));
		this.itemPriceValue = item.price;
		this.itemPriceType = item.price_type;
		let consumableConfig = item.consumable;
		let isCrystalVoucher = consumableConfig != null && consumableConfig.type == "crystal_voucher";
		this.itemSellValue = isCrystalVoucher ? consumableConfig.crystal_amount : item.price == null ? 0 : Math.floor(item.price * 0.5);
		if(item.price != null && buttonType == "equip_takeoff") {
			this.itemPrice.set_text(core_i18n_I18n.t("item.sale_price") + this.itemSellValue + (item.price_type == 2 ? " Crystal" : " Cash"));
			this.itemPriceIcon.set_x(this.itemPrice.get_x() + this.itemPrice.get_width() - 90);
			this.itemPriceIcon.gotoAndStop(item.price_type);
			this.itemPriceIcon.set_visible(true);
		} else if(item.price != null) {
			this.itemPrice.set_text(core_i18n_I18n.t("item.price") + item.price + (item.price_type == 2 ? " Crystal" : " Cash"));
			this.itemPriceIcon.set_x(this.itemPrice.get_x() + this.itemPrice.get_width() - 90);
			this.itemPriceIcon.gotoAndStop(item.price_type);
			this.itemPriceIcon.set_visible(true);
		} else {
			this.itemPrice.set_text("");
			this.itemPriceIcon.set_x(this.itemPrice.get_x() + this.itemPrice.get_width() - 90);
			this.itemPriceIcon.set_visible(false);
		}
		let paintballConfig = item.paintball;
		let paintballType = avatar_view_InventoryItemDetails.configString(paintballConfig,"type");
		let descriptionText = core_i18n_I18n.itemDescription(item);
		if(descriptionText.length == 0 && paintballConfig != null) {
			descriptionText = core_i18n_I18n.itemDescription({ item_id : item.item_id, desc : avatar_view_InventoryItemDetails.configString(paintballConfig,"description"), description_en : avatar_view_InventoryItemDetails.configString(paintballConfig,"description_en")});
		}
		let sellerName = item.seller_name;
		if((buttonType == "market_buy" || buttonType == "market_own") && sellerName != null && StringTools.trim(sellerName == null ? "null" : "" + sellerName) != "") {
			let sellerLine = core_i18n_I18n.t("market.seller",{ name : sellerName == null ? "null" : "" + sellerName});
			descriptionText = descriptionText.length > 0 ? sellerLine + "\n" + descriptionText : sellerLine;
		}
		this.itemInfoText.set_text(descriptionText);
		while(this.itemImage.get_numChildren() > 0) this.itemImage.removeChildAt(0);
		let bitmap = new openfl_display_Bitmap(image);
		if(isCrystalVoucher) {
			let content = image.getColorBoundsRect(-16777216,0,false);
			if(content != null && content.width > 0) {
				bitmap.set_x(28 - (content.x + content.width / 2));
			}
		}
		this.itemImage.addChild(bitmap);
