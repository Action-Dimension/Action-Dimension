class avatar_view_PaintballModkitUpgrade extends openfl_display_Sprite {
	constructor() {
		openfl_events_EventDispatcher._hx_skip_constructor = true;
		super();
		openfl_events_EventDispatcher._hx_skip_constructor = false;
		this._hx_constructor();
	}
	_hx_constructor() {
		this.basePanelWidth = 0;
		this.waitingForServer = false;
		this.currentPage = 1;
		this.weapons = [];
		this.itemSlots = [];
		super._hx_constructor();
		this.panel = openfl_utils_Assets.getMovieClip("sportsbook_lobby:sportsbook_lobby_fla.char_menu_item_upgrade_179");
		this.panel.set_scaleX(1.2);
		this.panel.set_scaleY(1.2);
		this.addChild(this.panel);
		avatar_view_WindowDrag.attachSwf(this.panel);
		this.title = this.panel.getChildByName("text_pickanitemtoupgrade");
		this.title.set_text(this.selectionTitle());
		this.title.mouseEnabled = false;
		this.pageText = this.panel.getChildByName("inv_inventory_page_text");
		let itemSlot = new avatar_view_InventoryItem(this.panel.getChildByName("inv_item_" + 0));
		itemSlot.selectionHandler = $bind(this,this.selectWeapon);
		itemSlot.item_container.set_visible(false);
		this.itemSlots.push(itemSlot);
		let itemSlot1 = new avatar_view_InventoryItem(this.panel.getChildByName("inv_item_" + 1));
		itemSlot1.selectionHandler = $bind(this,this.selectWeapon);
		itemSlot1.item_container.set_visible(false);
		this.itemSlots.push(itemSlot1);
		let itemSlot2 = new avatar_view_InventoryItem(this.panel.getChildByName("inv_item_" + 2));
		itemSlot2.selectionHandler = $bind(this,this.selectWeapon);
		itemSlot2.item_container.set_visible(false);
		this.itemSlots.push(itemSlot2);
		let itemSlot3 = new avatar_view_InventoryItem(this.panel.getChildByName("inv_item_" + 3));
		itemSlot3.selectionHandler = $bind(this,this.selectWeapon);
		itemSlot3.item_container.set_visible(false);
		this.itemSlots.push(itemSlot3);
		let itemSlot4 = new avatar_view_InventoryItem(this.panel.getChildByName("inv_item_" + 4));
		itemSlot4.selectionHandler = $bind(this,this.selectWeapon);
		itemSlot4.item_container.set_visible(false);
		this.itemSlots.push(itemSlot4);
		let itemSlot5 = new avatar_view_InventoryItem(this.panel.getChildByName("inv_item_" + 5));
		itemSlot5.selectionHandler = $bind(this,this.selectWeapon);
		itemSlot5.item_container.set_visible(false);
		this.itemSlots.push(itemSlot5);
		let previous = this.panel.getChildByName("inv_item_prev");
		let next = this.panel.getChildByName("inv_item_next");
		let _gthis = this;
		previous.addEventListener("click",function(_) {
			_gthis.changePage(-1);
		});
		next.addEventListener("click",function(_) {
			_gthis.changePage(1);
		});
		this.panel.getChildByName("close_button").addEventListener("click",function(_) {
			_gthis.close();
		});
		this.confirmation = this.panel.getChildByName("are_you_sure");
		this.confirmation.set_visible(false);
		this.setConfirmationText("text_yes",core_i18n_I18n.t("common.yes"));
		this.setConfirmationText("text_no",core_i18n_I18n.t("common.no"));
		let yesButton = this.confirmation.getChildByName("button_yes");
		let noButton = this.confirmation.getChildByName("button_no");
		yesButton.addEventListener("click",$bind(this,this.confirmSelection));
		noButton.addEventListener("click",function(_) {
			_gthis.confirmation.set_visible(false);
		});
		let confirmationIndex = this.panel.getChildIndex(this.confirmation);
		this.panel.removeChild(this.confirmation);
		let bounds = this.panel.getBounds(this);
		this.basePanelWidth = bounds.width;
		this.panel.addChildAt(this.confirmation,confirmationIndex);
		let fh = this.panel;
		fh.set_x(fh.get_x() - (bounds.x + bounds.width / 2));
		let fh1 = this.panel;
		fh1.set_y(fh1.get_y() - (bounds.y + bounds.height / 2));
		this.alignToLeft();
		this.set_y(openfl_Lib.get_current().stage.stageHeight / 2);
		this.set_visible(false);
		this.addEventListener("mouseDown",function(_) {
			if(Action.instance != null && Action.instance.ui != null) {
				Action.instance.ui.blockedClick = true;
			}
		});
	}
	open(modkitItem) {
		this.modkit = modkitItem;
		this.selectedWeapon = null;
		this.waitingForServer = false;
		this.currentPage = 1;
		this.confirmation.set_visible(false);
		this.title.set_text(this.selectionTitle());
		this.collectWeapons();
		this.renderPage();
		this.alignToLeft();
		this.set_visible(true);
		if(this.parent != null) {
			this.parent.setChildIndex(this,this.parent.get_numChildren() - 1);
		}
	}
	close() {
		if(this.waitingForServer) {
			return;
		}
		this.set_visible(false);
		this.confirmation.set_visible(false);
		this.selectedWeapon = null;
		this.modkit = null;
	}
	handleResult(data) {
		this.waitingForServer = false;
		if(data != null && data.success == true) {
			this.set_visible(false);
			this.confirmation.set_visible(false);
			this.selectedWeapon = null;
			this.modkit = null;
			return;
		}
		this.confirmation.set_visible(false);
		this.collectWeapons();
		this.renderPage();
	}
	collectWeapons() {
		this.weapons = [];
		if(Action.instance == null || Action.instance.ui == null) {
			return;
		}
		let h = Action.instance.ui.inventoryItemsData.h;
		let item_keys = Object.keys(h);
		let item_length = item_keys.length;
		let item_current = 0;
		while(item_current < item_length) {
			let item = h[item_keys[item_current++]];
			let config = item.paintball;
			if(config == null || Std.string(config["type"]) != "weapon") {
				continue;
			}
			let installed = item.installed_modkits;
			if(this.isRemovalKit()) {
				if(installed == null || installed.length == 0) {
					continue;
				}
			} else if((installed == null ? 0 : installed.length) >= avatar_view_PaintballModkitUpgrade.readCapacity(item)) {
				continue;
			}
			this.weapons.push(item);
		}
		this.weapons.sort(function(left,right) {
			let leftName = core_i18n_I18n.itemName(left);
			let rightName = core_i18n_I18n.itemName(right);
			if(leftName < rightName) {
				return -1;
			} else if(leftName > rightName) {
				return 1;
			} else {
				return 0;
			}
		});
	}
	renderPage() {
		let _g = 0;
		let _g1 = this.itemSlots;
		while(_g < _g1.length) _g1[_g++].item_container.set_visible(false);
		let maxPage = Math.max(1,Math.ceil(this.weapons.length / 6));
		if(this.currentPage > maxPage) {
			this.currentPage = maxPage | 0;
		}
		if(this.currentPage < 1) {
			this.currentPage = 1;
		}
		let start = (this.currentPage - 1) * 6;
		let _g2 = 0;
		while(_g2 < 6) {
			let slotIndex = _g2++;
			let weaponIndex = start + slotIndex;
			if(weaponIndex >= this.weapons.length) {
				break;
			}
			let slot = this.itemSlots[slotIndex];
			slot.setItem(this.weapons[weaponIndex],"modkit_target",false);
			slot.item_container.set_visible(true);
		}
		this.pageText.set_text(this.currentPage + "/" + (maxPage | 0));
		if(this.weapons.length == 0) {
			this.title.set_text(this.isRemovalKit() ? core_i18n_I18n.t("paintball.modkit_remove_empty") : core_i18n_I18n.t("paintball.modkit_slot_empty"));
		} else {
			this.title.set_text(this.selectionTitle());
		}
	}
	changePage(direction) {
		let maxPage = Math.max(1,Math.ceil(this.weapons.length / 6)) | 0;
		this.currentPage += direction;
		if(this.currentPage < 1) {
			this.currentPage = maxPage;
		}
		if(this.currentPage > maxPage) {
			this.currentPage = 1;
		}
		this.renderPage();
	}
	selectWeapon(weapon) {
		if(weapon == null || this.modkit == null || this.waitingForServer) {
			return;
		}
		let installed = weapon.installed_modkits;
		let installedCount = installed == null ? 0 : installed.length;
		let capacity = avatar_view_PaintballModkitUpgrade.readCapacity(weapon);
		if(!this.isRemovalKit() && installedCount >= capacity) {
			Action.instance.ui.popupMessage.showMessage(core_i18n_I18n.t("modkit.slot_full"));
			return;
		}
		this.selectedWeapon = weapon;
		let weaponName = core_i18n_I18n.itemName(weapon);
		if(this.isRemovalKit()) {
			this.setConfirmationText("areyousuretext",core_i18n_I18n.t("paintball.modkit_remove_confirm",{ weapon : weaponName}));
			this.setConfirmationText("pricetext",core_i18n_I18n.t("paintball.modkit_remove_count",{ count : installedCount}));
		} else {
			this.setConfirmationText("areyousuretext",core_i18n_I18n.t("paintball.modkit_install_confirm",{ modkit : core_i18n_I18n.itemName(this.modkit), weapon : weaponName}));
			this.setConfirmationText("pricetext",core_i18n_I18n.t("paintball.modkit_slots_used",{ used : installedCount, capacity : capacity}));
		}
		this.confirmation.set_visible(true);
	}
	confirmSelection(_) {
		if(this.waitingForServer || this.selectedWeapon == null || this.modkit == null) {
			return;
		}
		this.waitingForServer = true;
		this.confirmation.set_visible(false);
		Action.instance.ui.transferLoader.set_visible(true);
		Action.instance.playerModel.usePaintballModkit(this.modkit.id,this.selectedWeapon.id);
	}
	setConfirmationText(name,value) {
		let field = this.confirmation.getChildByName(name);
		if(field != null) {
			field.set_text(value);
			field.mouseEnabled = false;
		}
	}
	alignToLeft() {
		this.set_x(this.basePanelWidth / 2);
	}
	isRemovalKit() {
		if(this.modkit == null) {
			return false;
		}
		let config = this.modkit.paintball;
		if(config != null) {
			return Std.string(config["type"]) == "modkit_remover";
		} else {
			return false;
		}
	}
	selectionTitle() {
		if(this.isRemovalKit()) {
			return core_i18n_I18n.t("paintball.equipment_select");
		} else {
			return core_i18n_I18n.t("paintball.upgrade_select");
		}
	}
	static readCapacity(weapon) {
		let value = weapon.modkit_slots;
		if(value == null && weapon.paintball != null) {
			value = weapon.paintball["modkit_slots"];
		}
		let parsed = Std.parseInt(Std.string(value == null ? 1 : value));
		if(parsed == null) {
			return 1;
		}
		return Math.max(0,Math.min(5,parsed)) | 0;
	}
}
