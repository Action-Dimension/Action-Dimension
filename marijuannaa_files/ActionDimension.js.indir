				Action.instance.ui.transferLoader.set_visible(true);
			} else {
				if(avatar_view_ItemTransferPolicy.isTransferBlocked(_gthis.itemData)) {
					Action.instance.ui.popupMessage.showMessage(core_i18n_I18n.t("market.crystal_blocked_client"));
					return;
