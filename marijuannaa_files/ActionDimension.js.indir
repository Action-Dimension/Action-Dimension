		let collisionBounds = atlas_AtlasHitTest.worldBounds(mapItemPaintball.get_col_shape(),this._paintball.tileWorld.content);
		mapItemPaintball.has_collision_bounds = true;
		mapItemPaintball.collision_min_x = collisionBounds.get_left();
		mapItemPaintball.collision_min_y = collisionBounds.get_top();
		mapItemPaintball.collision_max_x = collisionBounds.get_right();
		mapItemPaintball.collision_max_y = collisionBounds.get_bottom();
		leftBucketId = this._paintball.mapModel.collision_bucket_index(collisionBounds.get_left());
		rightBucketId = this._paintball.mapModel.collision_bucket_index(collisionBounds.get_right());
		let bucketId = leftBucketId;
		while(bucketId <= rightBucketId) {
			let bucket = this._paintball.mapModel.collision_bucket_items[bucketId];
			if(bucket == null) {
				bucket = [];
				this._paintball.mapModel.collision_bucket_items[bucketId] = bucket;
			}
			bucket.push(mapItemPaintball);
			++bucketId;
		}
