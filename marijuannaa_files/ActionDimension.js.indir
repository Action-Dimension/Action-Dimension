				c1.set_width(28.);
				c1.set_height(21.);
				c1.set_styleString("padding: 0; background-color: #fffaf0; border: 2px solid #8d6f3c; border-radius: 5px;");
				c1.set_includeInLayout(false);
				c01.addComponent(c1);
				let c2 = new haxe_ui_containers_Box();
				c2.set_left(13.);
				c2.set_top(17.);
				c2.set_width(18.);
				c2.set_height(3.);
				c2.set_styleString("padding: 0; background-color: #c79a12; border-radius: 2px;");
				c2.set_includeInLayout(false);
				c01.addComponent(c2);
				let c3 = new haxe_ui_containers_Box();
				c3.set_left(13.);
				c3.set_top(24.);
				c3.set_width(13.);
				c3.set_height(3.);
				c3.set_styleString("padding: 0; background-color: #c79a12; border-radius: 2px;");
				c3.set_includeInLayout(false);
				c01.addComponent(c3);
				let c4 = new haxe_ui_containers_Box();
				c4.set_id("annUnread");
				c4.set_left(34.);
				c4.set_top(2.);
				c4.set_width(10.);
				c4.set_height(10.);
