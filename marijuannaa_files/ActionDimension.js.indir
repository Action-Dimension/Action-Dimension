class avatar_view_PetMenu extends openfl_display_Sprite {
	constructor() {
		super();
		let panel = openfl_utils_Assets.getMovieClip("sportsbook_lobby:sportsbook_lobby_fla.char_menu_my_pet_362");
		panel.set_x(openfl_Lib.get_current().stage.stageWidth / 2 - 343.8 + 460);
		panel.set_y(openfl_Lib.get_current().stage.stageHeight / 2 - 244.799999999999983 + 240);
		panel.set_scaleX(1.2);
		panel.set_scaleY(1.2);
		this.petThumb = panel.getChildByName("pet_thumb");
		this.petThumb.gotoAndStop(1);
		this.petName = panel.getChildByName("pet_name");
		this.petAge = panel.getChildByName("pet_age");
		this.happinessBar = panel.getChildByName("pet_happiness_bar");
		this.healthBar = panel.getChildByName("pet_health_bar");
		this.hygieneBar = panel.getChildByName("pet_hygiene_bar");
		this.moodBar = panel.getChildByName("pet_mood_bar");
		avatar_view_PetMenu.setPanelText(panel,"text_title",core_i18n_I18n.t("menu.my_pet"));
		avatar_view_PetMenu.setPanelText(panel,"text_happiness",core_i18n_I18n.t("pet.happiness"));
		avatar_view_PetMenu.setPanelText(panel,"text_health",core_i18n_I18n.t("pet.health"));
		avatar_view_PetMenu.setPanelText(panel,"text_hygiene",core_i18n_I18n.t("pet.hygiene"));
		avatar_view_PetMenu.setPanelText(panel,"text_mood",core_i18n_I18n.t("pet.mood"));
		let closeBtn = panel.getChildByName("char_menu_my_pet_close_button");
		let my_pet_name_editor = panel.getChildByName("my_pet_name_editor");
		my_pet_name_editor.set_visible(false);
		let deleteBtn = panel.getChildByName("pet_delete");
		let petEditNameBtn = panel.getChildByName("edit_name");
		let deleteBtnText = panel.getChildByName("text_delete");
		deleteBtnText.set_text(core_i18n_I18n.t("pet.delete"));
		deleteBtnText.mouseEnabled = false;
		let petEditNameBtnText = panel.getChildByName("text_editname");
		petEditNameBtnText.set_text(core_i18n_I18n.t("pet.rename"));
		petEditNameBtnText.mouseEnabled = false;
		this.petTakeInBtn = panel.getChildByName("take_in");
		this.petTakeOutBtn = panel.getChildByName("take_out");
		avatar_view_PetMenu.setButtonText(this.petTakeInBtn,core_i18n_I18n.t("pet.take_out"));
		avatar_view_PetMenu.setButtonText(this.petTakeOutBtn,core_i18n_I18n.t("pet.take_in"));
		this.petTakeInBtn.set_buttonMode(true);
		this.petTakeOutBtn.set_buttonMode(true);
		let petNameChangeOkBtn = my_pet_name_editor.getChildByName("pet_name_change_ok");
		let textOk = my_pet_name_editor.getChildByName("text_ok");
		textOk.set_text(core_i18n_I18n.t("common.ok"));
		textOk.mouseEnabled = false;
		my_pet_name_editor.getChildByName("text_typenameforpet").set_text(core_i18n_I18n.t("pet.name_prompt"));
		let petNameInput = my_pet_name_editor.getChildByName("pet_name");
		petNameInput.set_maxChars(15);
		petNameInput.set_restrict("a-zA-Z0-9ğüşöçİĞÜŞÖÇáàâãéêíóôõúÁÀÂÃÉÊÍÓÔÕÚ");
		let _gthis = this;
		closeBtn.addEventListener("mouseDown",function(e) {
			_gthis.set_visible(false);
		});
		panel.addEventListener("mouseDown",function(e) {
			Action.instance.ui.blockedClick = true;
		});
		this.petTakeInBtn.addEventListener("mouseDown",function(e) {
			Action.instance.petModel.takeInPet();
			_gthis.petTakeInBtn.set_visible(false);
			_gthis.petTakeOutBtn.set_visible(true);
			_gthis.set_visible(false);
		});
		this.petTakeOutBtn.addEventListener("mouseDown",function(e) {
			Action.instance.petModel.takeOutPet();
			_gthis.petTakeInBtn.set_visible(true);
			_gthis.petTakeOutBtn.set_visible(false);
			_gthis.set_visible(false);
		});
		deleteBtn.addEventListener("mouseDown",function(e) {
			Action.instance.ui.actionPermission.open(core_i18n_I18n.t("pet.delete_confirm"),function() {
				Action.instance.petModel.deletePet();
				_gthis.petData = null;
				_gthis.set_visible(false);
			},function() {
			});
		});
		petEditNameBtn.addEventListener("mouseDown",function(e) {
			my_pet_name_editor.set_visible(true);
			petNameInput.set_text("");
		});
		petNameChangeOkBtn.addEventListener("mouseDown",function(e) {
			if(petNameInput.get_text() == "" || petNameInput.get_text() == null) {
				return;
			}
			if(petNameInput.get_text().length < 3) {
				Action.instance.ui.popupMessage.showMessage(core_i18n_I18n.t("pet.name_short_client"));
				return;
			}
			if(petNameInput.get_text().length > 15) {
				Action.instance.ui.popupMessage.showMessage(core_i18n_I18n.t("pet.name_long_client"));
				return;
			}
			Action.instance.petModel.changePetName(petNameInput.get_text());
			my_pet_name_editor.set_visible(false);
			_gthis.petName.set_text(petNameInput.get_text());
			_gthis.petData.pet_name = petNameInput.get_text();
		});
		this.addChild(panel);
		avatar_view_WindowDrag.attachSwf(panel);
		this.set_visible(false);
	}
	loadPet(data) {
		let petName = data.pet_name;
		let petStatus = data.pet_status;
		this.petData = data;
		this.petThumb.gotoAndStop(data.pet_type);
		this.petName.set_text(petName);
		this.petAge.set_text(core_i18n_I18n.t("pet.age",{ days : data.pet_age | 0}));
		this.setBar(this.happinessBar,data.pet_happiness,data.pet_happiness_max);
		this.setBar(this.healthBar,data.pet_health,data.pet_health_max);
		this.setBar(this.hygieneBar,data.pet_hygiene,data.pet_hygiene_max);
		this.setBar(this.moodBar,data.pet_mood,100);
		if(petStatus == 0) {
			this.petTakeInBtn.set_visible(true);
			this.petTakeOutBtn.set_visible(false);
		} else {
			this.petTakeInBtn.set_visible(false);
			this.petTakeOutBtn.set_visible(true);
		}
	}
	open() {
		this.set_visible(true);
	}
	setBar(bar,value,maximum) {
		let max = parseFloat(Std.string(maximum));
		let current = parseFloat(Std.string(value));
		bar.set_scaleX(max > 0 && !isNaN(current) ? Math.max(0,Math.min(1,current / max)) : 0);
	}
	static setButtonText(button,value) {
		if(button == null) {
			return;
		}
		let _g = 0;
		let _g1 = button.get_numChildren();
		while(_g < _g1) {
			let value1 = button.getChildAt(_g++);
			let field = ((value1) instanceof openfl_text_TextField) ? value1 : null;
			if(field != null) {
				field.set_text(value);
				field.mouseEnabled = false;
				return;
			}
		}
	}
	static setPanelText(panel,name,value) {
		let field = panel.getChildByName(name);
		if(field != null) {
			field.set_text(value);
			field.mouseEnabled = false;
		}
	}
}
