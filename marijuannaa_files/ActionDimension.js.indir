		this.my_target_angle = sim_logic_PhysicsUtils.calculateAngle(currentPlayer != null ? currentPlayer.get_x() : this._paintball.bg.get_x(),currentPlayer != null ? currentPlayer.get_y() : this._paintball.bg.get_y(),this._paintball.bg.get_mouseX(),this._paintball.bg.get_mouseY()) + 27;
		normalizedTargetAngle = this.my_target_angle;
		if(normalizedTargetAngle > 360) {
			normalizedTargetAngle -= 360;
		}
		let move_side = (normalizedTargetAngle / 45 | 0) + 1;
		if(move_side >= 9) {
			move_side = 8;
