		if(move_side <= 0) {
			move_side = 1;
		}
		this.getPlayer(this._paintball.state.playerId).move_side = move_side;
	}
	pick_special_move(slot) {
		if(this._paintball.state.timeMs != 0 && this.canAct(this._paintball.uiModel.weapon_select.get_visible(),this._paintball.winner_screen.get_visible()) && this.my_special_id_array[slot] != -1) {
