		this.view.set_percentWidth(null);
		this.view.set_percentHeight(null);
		this.view.set_width(720.0);
		this.view.set_height(480.0);
		let scale = Math.min(Math.min(viewportWidth * 0.80 / 720.0,viewportHeight * 0.80 / 480.0),1.0);
		let holder = new openfl_display_Sprite();
		holder.set_scaleX(scale);
		holder.set_scaleY(scale);
		holder.set_x(Math.round((viewportWidth - 720.0 * scale) / 2));
		holder.set_y(Math.round((viewportHeight - 480.0 * scale) / 2));
		holder.addChild(this.view);
		this.addChild(holder);
		this.bind();
		this.attachDrag(holder);
	}
	bind() {
		this.roomTitle = this.view.findComponent("roomTitle",haxe_ui_components_Label);
		this.roomMeta = this.view.findComponent("roomMeta",haxe_ui_components_Label);
		this.note = this.view.findComponent("lobbyNote",haxe_ui_components_Label);
		this.bench1 = this.view.findComponent("bench1",haxe_ui_core_Component);
		this.bench2 = this.view.findComponent("bench2",haxe_ui_core_Component);
		this.botPanel = this.view.findComponent("botPanel",haxe_ui_core_Component);
		this.benchName1 = this.view.findComponent("benchName1",haxe_ui_components_Label);
		this.benchName2 = this.view.findComponent("benchName2",haxe_ui_components_Label);
		this.benchCount1 = this.view.findComponent("benchCount1",haxe_ui_components_Label);
		this.benchCount2 = this.view.findComponent("benchCount2",haxe_ui_components_Label);
		this.join1 = this.view.findComponent("join1",haxe_ui_components_Button);
		this.join1.set_text(core_i18n_I18n.t("paintball_lobby.join_team"));
		let _gthis = this;
		this.join1.set_onClick(function(_) {
			if(_gthis.onPickTeam != null) {
				_gthis.onPickTeam(1);
			}
		});
		this.join2 = this.view.findComponent("join2",haxe_ui_components_Button);
		this.join2.set_text(core_i18n_I18n.t("paintball_lobby.join_team"));
		this.join2.set_onClick(function(_) {
			if(_gthis.onPickTeam != null) {
				_gthis.onPickTeam(2);
			}
		});
		this.crest1 = this.view.findComponent("crest1",haxe_ui_core_Component);
		this.botArtHost = this.view.findComponent("botArt",haxe_ui_core_Component);
		this.botArtHost.registerEvent(haxe_ui_events_UIEvent.RESIZE,function(_) {
			_gthis.refreshBotArt();
		});
		this.botArtHost.registerEvent(haxe_ui_events_UIEvent.READY,function(_) {
			_gthis.refreshBotArt();
		});
		this.view.findComponent("botName",haxe_ui_components_Label).set_text(core_i18n_I18n.t("paintball_lobby.bot_team"));
		this.view.findComponent("botDetail",haxe_ui_components_Label).set_text(core_i18n_I18n.t("paintball_lobby.bot_detail"));
		this.leaveButton = this.view.findComponent("leaveButton",haxe_ui_components_Button);
		this.leaveButton.set_text(core_i18n_I18n.t("paintball_lobby.leave"));
		this.leaveButton.set_onClick(function(_) {
			if(_gthis.onLeave != null) {
				_gthis.onLeave();
			}
		});
		this.startButton = this.view.findComponent("startButton",haxe_ui_components_Button);
		this.startButton.set_text(core_i18n_I18n.t("paintball_lobby.start"));
		this.startButton.set_onClick(function(_) {
			if(_gthis.onStart != null) {
				_gthis.onStart();
			}
		});
		let closeButton = this.view.findComponent("closeButton",haxe_ui_components_Button);
		closeButton.set_onClick(function(_) {
			if(_gthis.onLeave != null) {
				_gthis.onLeave();
			}
		});
		closeButton.addEventListener("mouseDown",function(event) {
			event.stopPropagation();
		});
		avatar_view_WindowDrag.pointerCursor(closeButton);
	}
	attachDrag(holder) {
		let header = this.view.findComponent("lobbyHeader",haxe_ui_core_Component);
		if(header == null) {
			return;
		}
		let area = new openfl_geom_Rectangle(0,0,720.0,480.0);
		new avatar_view_WindowDrag(holder,header,function() {
			return area;
		});
	}
	makeScrim(width,height) {
		let scrim = new openfl_display_Sprite();
		scrim.get_graphics().beginFill(0,0.001);
		scrim.get_graphics().drawRect(0,0,width,height);
		scrim.get_graphics().endFill();
		scrim.addEventListener("mouseDown",function(event) {
			event.stopImmediatePropagation();
		});
		return scrim;
	}
	apply(state) {
		this.roomTitle.set_text(state.roomName);
		this.roomMeta.set_text(this.metaText(state));
		let twoBenches = this.teamPickEnabled(state.gameType);
		let cyborg = state.gameType == 4;
		this.bench2.set_hidden(!twoBenches);
		this.botPanel.set_hidden(!cyborg);
		this.crest1.set_styleString(twoBenches ? "background-color: #ff9999;" : "background-color: #b6b8a9;");
		if(cyborg) {
			this.wantedMapId = state.mapId;
			this.refreshBotArt();
		}
		this.benchName1.set_text(this.benchLabel(state.gameType,1));
		this.benchName2.set_text(this.benchLabel(state.gameType,2));
		let perBench = twoBenches ? Math.ceil(state.playerLimit / 2) : state.playerLimit;
		this.ensureSlots(perBench | 0);
		let _this = state.members;
		let _g = [];
		let _g1 = 0;
		while(_g1 < _this.length) {
			let v = _this[_g1];
			++_g1;
			if(v.team != 2) {
				_g.push(v);
			}
		}
		let _this1 = state.members;
		let _g2 = [];
		let _g3 = 0;
		while(_g3 < _this1.length) {
			let v = _this1[_g3];
			++_g3;
			if(v.team == 2) {
				_g2.push(v);
			}
		}
		this.fillBench(this.slots1,twoBenches ? _g : state.members,state);
		if(twoBenches) {
			this.fillBench(this.slots2,_g2,state);
		}
		this.benchCount1.set_text((twoBenches ? _g.length : state.members.length) + " / " + (perBench | 0));
		this.benchCount2.set_text(_g2.length + " / " + (perBench | 0));
		let spectator = state.youPlayerId == 0;
		let mine = this.myTeam(state);
		this.join1.set_hidden(!twoBenches || spectator);
		this.join2.set_hidden(!twoBenches || spectator);
		this.paintPick(this.join1,mine == 1,_g.length >= perBench);
		this.paintPick(this.join2,mine == 2,_g2.length >= perBench);
		let owner = !spectator && state.youPlayerId == state.ownerPlayerId;
		this.startButton.set_disabled(!owner);
		this.startButton.set_styleString(owner ? "background-color: #ffe8a6; background-color-end: #fae1a3; border-color: #8d6f3c; color: #302414;" : "background-color: #e4dac2; background-color-end: #d8cdb4; border-color: #b9aa89; color: #887b61;");
		this.applyKickButtons(owner,state.youPlayerId);
		if(!this.errorSticky) {
			this.note.set_styleString("background-opacity: 0; color: #6d6049;");
			this.note.set_text(spectator ? core_i18n_I18n.t("paintball_lobby.spectating") : owner ? "" : core_i18n_I18n.t("paintball_lobby.waiting_owner"));
		}
	}
	showError(message) {
		this.errorSticky = true;
		this.note.set_styleString("background-opacity: 1; background-color: #e5ad79; color: #302414;");
		this.note.set_text(message);
	}
	showStarting() {
		this.errorSticky = false;
		this.startButton.set_disabled(true);
		this.note.set_styleString("background-opacity: 0; color: #6d6049;");
		this.note.set_text(core_i18n_I18n.t("paintball_lobby.starting"));
	}
	dismissError() {
		this.errorSticky = false;
	}
	ensureSlots(perBench) {
		if(perBench == this.slotsPerBench) {
			return;
		}
		this.slotsPerBench = perBench;
		this.slots1 = this.rebuildBench("slots1",perBench,1);
		this.slots2 = this.rebuildBench("slots2",perBench,2);
	}
	rebuildBench(hostId,count,team) {
		let host = this.view.findComponent(hostId,haxe_ui_core_Component);
		host.removeAllComponents();
		let made = [];
		let _g = 0;
		while(_g < count) {
			++_g;
			let c0 = new haxe_ui_containers_HBox();
			c0.set_id("slotRow");
			c0.set_height(40.);
			c0.set_percentWidth(100.);
			c0.set_styleString("padding: 0; padding-left: 8px; padding-right: 6px; vertical-spacing: 0; horizontal-spacing: 8px; background-color: #f4e9c9; border: 2px solid #e2d3ab; border-radius: 9px;");
			let c01 = new haxe_ui_components_Label();
			c01.set_id("slotCrown");
			c01.set_text("★");
			c01.set_styleString("padding: 0; font-size: 14px; color: #c9962a;");
			c01.set_verticalAlign("center");
			c0.addComponent(c01);
			let c1 = new haxe_ui_components_Label();
			c1.set_id("slotName");
			c1.set_percentWidth(100.);
			c1.set_text("");
			c1.set_styleString("padding: 0; font-size: 15px; color: #302414;");
			c1.set_verticalAlign("center");
			c0.addComponent(c1);
			let c2 = new haxe_ui_components_Label();
			c2.set_id("slotLevel");
			c2.set_text("");
			c2.set_styleString("padding: 0; font-size: 12px; color: #6d6552;");
			c2.set_verticalAlign("center");
			c0.addComponent(c2);
			let c3 = new haxe_ui_components_Button();
			c3.set_id("slotKick");
			c3.set_width(24.);
			c3.set_height(22.);
			c3.set_text("✕");
			c3.set_styleString("padding: 0; font-size: 12px; color: #fdf0e4; background-color: #b3724a; border: 2px solid #7d4b2c; border-radius: 6px;");
			c3.set_verticalAlign("center");
			c0.addComponent(c3);
			c0.bindingRoot = true;
			host.addComponent(c0);
			made.push({ playerId : 0, root : c0, crown : c0.findComponent("slotCrown",haxe_ui_components_Label), name : c0.findComponent("slotName",haxe_ui_components_Label), level : c0.findComponent("slotLevel",haxe_ui_components_Label), kick : c0.findComponent("slotKick",haxe_ui_components_Button)});
		}
		return made;
	}
	fillBench(slots,members,state) {
		let _gthis = this;
		let _g = 0;
		let _g1 = slots.length;
		while(_g < _g1) {
			let index = _g++;
			let slot = slots[index];
			let member = index < members.length ? members[index] : null;
			if(member == null) {
				slot.playerId = 0;
				slot.name.set_text(core_i18n_I18n.t("paintball_lobby.empty_slot"));
				slot.name.set_styleString("color: #9b917a;");
				slot.level.set_text("");
				slot.crown.set_hidden(true);
				slot.kick.set_hidden(true);
				slot.kick.set_onClick(null);
				slot.root.set_styleString("background-color: #efe4c1; border-color: #e2d3ab;");
				continue;
			}
			slot.playerId = member.playerId;
			slot.name.set_text(member.name);
			slot.name.set_styleString("color: #302414;");
			slot.level.set_text(core_i18n_I18n.t("character.level",{ level : member.level}));
			slot.crown.set_hidden(member.playerId != state.ownerPlayerId);
			slot.root.set_styleString(member.playerId == state.youPlayerId ? "background-color: #ffe8a6; border-color: #c9962a;" : "background-color: #f4e9c9; border-color: #e2d3ab;");
			let target = member.playerId;
			slot.kick.set_onClick(function(_) {
				if(_gthis.onKick != null) {
					_gthis.onKick(target);
				}
			});
			slot.kick.set_hidden(true);
		}
	}
	applyKickButtons(owner,youPlayerId) {
		let slots = this.slots1;
		let _g = 0;
		while(_g < slots.length) {
			let slot = slots[_g];
			++_g;
			slot.kick.set_hidden(!owner || slot.playerId == 0 || slot.playerId == youPlayerId);
		}
		let slots1 = this.slots2;
		let _g1 = 0;
		while(_g1 < slots1.length) {
			let slot = slots1[_g1];
			++_g1;
			slot.kick.set_hidden(!owner || slot.playerId == 0 || slot.playerId == youPlayerId);
		}
	}
	myTeam(state) {
		let _g = 0;
		let _g1 = state.members;
		while(_g < _g1.length) {
			let member = _g1[_g];
			++_g;
			if(member.playerId == state.youPlayerId) {
				return member.team;
			}
		}
		return 0;
	}
	paintPick(button,mine,full) {
		button.set_styleString(mine ? "background-color: #cbdfb5; border-color: #849e6c; color: #3d4d24;" : "background-color: #fffaf0; border-color: #cdb98c; color: #44351f;");
		button.set_text(mine ? core_i18n_I18n.t("paintball_lobby.here") : full ? core_i18n_I18n.t("paintball_lobby.team_full") : core_i18n_I18n.t("paintball_lobby.join_team"));
		button.set_disabled(mine || full);
	}
	teamPickEnabled(gameType) {
		if(gameType != 2) {
			return gameType == 5;
		} else {
			return true;
		}
	}
	benchLabel(gameType,team) {
		if(gameType == 3 || gameType == 4) {
			return core_i18n_I18n.t("paintball_lobby.roster");
		}
		return core_i18n_I18n.t(team == 2 ? "paintball_lobby.team2" : "paintball_lobby.team1");
	}
	metaText(state) {
		let parts = [avatar_view_RoomBrowser.paintballModeLabel(state.gameType)];
		let difficulty = avatar_view_RoomBrowser.difficultyName(state.difficulty);
		if(difficulty != "") {
			parts.push(difficulty);
		}
		parts.push(core_i18n_I18n.t("room_browser.map_number",{ number : state.mapId}));
		if(state.spectators > 0) {
			parts.push(core_i18n_I18n.t("room_browser.spectators",{ count : state.spectators}));
		}
		return parts.join("   ");
	}
	refreshBotArt() {
		if(this.botArtHost == null || this.wantedMapId == 0) {
			return;
		}
		let width = this.botArtHost.get_width() - 4;
		let height = this.botArtHost.get_height() - 4;
		if(width <= 0 || height <= 0) {
			return;
		}
		if(this.paintedMapId == this.wantedMapId && this.paintedWidth == width) {
			return;
		}
		this.paintedMapId = this.wantedMapId;
		this.paintedWidth = width;
		if(this.botArt != null && this.botArt.parent != null) {
			this.botArt.parent.removeChild(this.botArt);
		}
		let clip = new openfl_display_Sprite();
		clip.set_x(2);
		clip.set_y(2);
		clip.set_scrollRect(new openfl_geom_Rectangle(0,0,width,height));
		clip.mouseEnabled = false;
		clip.mouseChildren = false;
		let canvas = new openfl_display_Sprite();
		clip.addChild(canvas);
		this.botArtHost.addChild(clip);
		this.botArt = clip;
		avatar_view_kit_MapPreview.paintball(this.wantedMapId - 1,canvas,width,height);
	}
}
